<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Valour.Client.Photino</RootNamespace>
        <AssemblyName>Valour</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Version>0.9.9</Version>
        <!-- Photino.Blazor is built against an older Components.WebView. -->
        <NoWarn>$(NoWarn);NU1603;NU1608</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Photino.Blazor" Version="4.0.13" />
        <!-- The bundled blazor.webview.js must match the Components.Web runtime
             that Valour.Client uses, so the WebView package is pinned here. -->
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView" Version="11.0.0-rc.1.26425.128" />
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="11.0.0-rc.1.26425.128" />
    </ItemGroup>

    <ItemGroup>
        <None Include="valour.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Client\Valour.Client.csproj" />
    </ItemGroup>

</Project>
