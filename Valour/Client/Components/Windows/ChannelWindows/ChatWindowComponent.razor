    /// <summary>
    /// Handles a swipe-left-to-reply gesture on a message (touch only).
    /// Element ids are in the format m-{channelId}-{messageId}.
    /// </summary>
    private async Task OnMessageSwipeReply(string elementId)
    {
        if (_disposed || InputComponent is null || string.IsNullOrEmpty(elementId))
            return;

        var lastDash = elementId.LastIndexOf('-');
        if (lastDash < 0 || !long.TryParse(elementId[(lastDash + 1)..], out var messageId))
            return;

        var message = DisplayedMessages.FirstOrDefault(x => x.Id == messageId);
        if (message is null)
            return;

        await InvokeAsync(async () => await InputComponent.SetReplyMessage(message));
    }
    
