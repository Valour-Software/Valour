    public async Task OnNodeReconnect(Node node)
    {
        await InvokeAsync(async () =>
        {
            if (Channel.PlanetId is null)
            {
                if (node.Name == Client.PrimaryNode.Name)
                {
                    await RecoverMissedMessages();
                }
            }
            else
            {
                if (node.Name == Channel.Planet.NodeName)
                {
                    await RecoverMissedMessages();
                }
            }
        });
    }

    private DateTime _lastRecoverAttempt = DateTime.MinValue;
    private bool _recoveringMessages;

    private async Task OnBrowserFocused()
    {
        await InvokeAsync(async () =>
        {
            // Wait for the relevant node to finish reconnecting before we attempt recovery.
            // On mobile resume, CheckConnections() is fired by BrowserUtils.OnRefocus but
            // the SignalR reconnection is async. If we recover too early, we'll fetch stale
            // data and miss messages that arrived during the reconnection gap.
            var node = Channel?.PlanetId is not null
                ? Channel.Planet?.Node
                : Client.PrimaryNode;

            if (node?.IsReconnecting == true)
            {
                // Give the reconnect up to 5 seconds before proceeding anyway.
                for (var i = 0; i < 50 && node.IsReconnecting; i++)
                    await Task.Delay(100);

                if (node.IsReconnecting)
                {
                    Client.Logger.Log<ChatWindowComponent>(
                        "Node still reconnecting after focus; attempting message recovery anyway.", "yellow");
                }
            }

            if (Channel?.PlanetId is not null && Channel.ChannelType == ChannelTypeEnum.PlanetChat)
            {
                try
                {
                    var joinResult = await Channel.ConnectToRealtime();
                    if (!joinResult.Success)
                    {
                        Client.Logger.Log<ChatWindowComponent>(
                            $"Channel rejoin check failed for {Channel.Id}: {joinResult.Message}", "yellow");
                    }
                }
                catch (Exception e)
                {
                    Client.Logger.Log<ChatWindowComponent>(
                        $"Channel rejoin check threw for {Channel?.Id}: {e.Message}", "yellow");
                }
            }

            await RecoverMissedMessages();
            await UpdateActiveViewingLeaseStateAsync();
        });
    }

    private async Task OnBrowserBlurred()
    {
        await InvokeAsync(UpdateActiveViewingLeaseStateAsync);
    }

    private async Task OnFocusedTabChanged(WindowTab tab)
    {
        await InvokeAsync(UpdateActiveViewingLeaseStateAsync);
    }

    /// <summary>
    /// Marks a reply or mention in this channel read when it arrives while the
    /// user is looking at the latest messages. Messages mark their own
    /// notification read when they first render, but the notification is
    /// created after the message is relayed and usually arrives later.
    /// </summary>
    private void OnNotificationReceived(Notification notification)
    {
        if (notification.TimeRead is not null || notification.ChannelId != Channel?.Id)
            return;

        if (!_isCaughtUp || !IsActivelyVisibleToUser())
            return;

        _ = Client.NotificationService.MarkNotificationRead(notification, true);
    }

    private bool IsActivelyVisibleToUser()
    {
        if (_disposed || _loading || Channel is null || !BrowserUtils.IsFocused)
            return false;

        var tab = WindowCtx?.Tab;
        if (tab is null)
            return Embedded;

        if (tab.IsFloating)
            return true;

        return tab.Layout?.FocusedTab == tab;
    }

    private Node GetActiveViewNode()
    {
        if (Channel?.PlanetId is not null)
            return Channel.Planet?.Node;

        return Client.PrimaryNode;
    }

    private async Task UpdateActiveViewingLeaseStateAsync()
    {
        if (IsActivelyVisibleToUser())
        {
            await StartActiveViewingLeaseAsync();
        }
        else
        {
            await StopActiveViewingLeaseAsync();
        }
    }

    private async Task StartActiveViewingLeaseAsync()
    {
        if (!_activeViewLeaseActive)
        {
            _activeViewLeaseActive = true;
            _activeViewTimer = new Timer(OnActiveViewTimer, null, ActiveViewRefreshInterval, ActiveViewRefreshInterval);
        }

        await RefreshActiveViewingLeaseAsync();
    }

    private async Task StopActiveViewingLeaseAsync()
    {
        if (!_activeViewLeaseActive)
            return;

        _activeViewLeaseActive = false;
        _activeViewTimer?.Dispose();
        _activeViewTimer = null;

        try
        {
            var node = GetActiveViewNode();
            if (node is not null)
                await node.ClearActiveChannelView(Channel.Id);
        }
        catch (Exception e)
        {
            Client.Logger.Log<ChatWindowComponent>(
                $"Failed clearing active channel view for {Channel?.Id}: {e.Message}", "yellow");
        }
    }

    private void OnActiveViewTimer(object state)
    {
        _ = RefreshActiveViewingLeaseAsync();
    }

    private async Task RefreshActiveViewingLeaseAsync()
    {
        if (!IsActivelyVisibleToUser())
        {
            await StopActiveViewingLeaseAsync();
            return;
        }

        if (Interlocked.Exchange(ref _activeViewRefreshInFlight, 1) == 1)
            return;

        try
        {
            var node = GetActiveViewNode();
            if (node is null)
                return;

            var result = await node.RefreshActiveChannelView(Channel.Id);
            if (!result.Success)
            {
                Client.Logger.Log<ChatWindowComponent>(
                    $"Failed refreshing active channel view for {Channel.Id}: {result.Message}", "yellow");
            }
        }
        catch (Exception e)
        {
            Client.Logger.Log<ChatWindowComponent>(
                $"Failed refreshing active channel view for {Channel?.Id}: {e.Message}", "yellow");
        }
        finally
        {
            Interlocked.Exchange(ref _activeViewRefreshInFlight, 0);
        }
    }

    private async Task RecoverMissedMessages()
    {
        if (_loading || Channel is null || _jsService is null || _recoveringMessages)
            return;

        // Avoid hammering the API when focus/reconnect events happen in a burst.
        if ((DateTime.UtcNow - _lastRecoverAttempt).TotalMilliseconds < 750)
            return;

        // A window that is not at the present picks up newer messages through
        // forward loading; adding the latest ones here would leave a gap.
        if (!_isCaughtUp)
            return;

        _lastRecoverAttempt = DateTime.UtcNow;
        _recoveringMessages = true;

        try
        {
            long maxDisplayedId = DisplayedMessages
                .Where(x => x.Id > 0 && x.Id < long.MaxValue)
                .Select(x => x.Id)
                .DefaultIfEmpty(0)
                .Max();

            var latest = await GetRecoveryCandidates(maxDisplayedId);
            if (latest.Count == 0)
                return;

            var toAdd = latest
                .Where(m => m.Id > maxDisplayedId)
                .OrderBy(m => m.Id)
                .ToList();

            if (toAdd.Count == 0)
                return;

            await HydrateRecoveredMessageAuthorsAsync(toAdd);

            var atBottom = await _jsService.InvokeAsync<bool>("isAtBottom");
            if (!atBottom && DisplayedMessages.Count + toAdd.Count > MaxRenderedMessages)
            {
                _isCaughtUp = false;
                return;
            }

            await AddMessages(toAdd, render: false, scroll: false);

            if (atBottom)
                TrimDisplayedMessages(TrimEnd.Oldest);

            await ReRender();

            if (atBottom)
                await ScrollToBottom();

            _isCaughtUp = true;
        }
        catch (Exception e)
        {
            Client.Logger.Log<ChatWindowComponent>($"Failed recovering missed messages: {e.Message}", "yellow");
        }
        finally
        {
            _recoveringMessages = false;
        }
    }

    /// <summary>
    /// Restores only the planet members needed to render the recovered chat
    /// batch, using one exact-id request regardless of the number of authors.
    /// </summary>
    private async Task HydrateRecoveredMessageAuthorsAsync(IReadOnlyCollection<Message> messages)
    {
        var planet = Channel?.Planet;
        if (planet is null)
            return;

        var missingAuthorIds = GetMissingRecoveredAuthorIds(messages, planet);

        if (missingAuthorIds.Count == 0)
            return;

        var result = await planet.FetchMembersAsync(missingAuthorIds);

        if (!result.Success)
        {
            Client.Logger.Log<ChatWindowComponent>(
                $"Failed hydrating recovered message authors: {result.Message}",
                "yellow");
        }
    }

    internal static List<long> GetMissingRecoveredAuthorIds(
        IEnumerable<Message> messages,
        Planet planet)
    {
        if (messages is null || planet is null)
            return [];

        return messages
            .Where(x => x?.AuthorMemberId.HasValue == true &&
                        !planet.Members.ContainsId(x.AuthorMemberId.Value))
            .Select(x => x.AuthorMemberId!.Value)
            .Distinct()
            .ToList();
    }

    private async Task<List<Message>> GetRecoveryCandidates(long maxDisplayedId)
    {
        var latest = await Channel.GetLastMessagesAsync(64);
        if (latest is null || latest.Count == 0)
            return [];

        if (maxDisplayedId == 0)
            return latest;

        var recovered = new List<Message>(latest);
        var earliestId = latest[0].Id;
        var rounds = 0;

        // Bridge larger gaps by walking backwards in batches.
        while (earliestId > maxDisplayedId + 1 && rounds < 12)
        {
            var older = await Channel.GetMessagesAsync(earliestId, 64);
            if (older is null || older.Count == 0)
                break;

            recovered.InsertRange(0, older);

            var newEarliest = older[0].Id;
            if (newEarliest >= earliestId)
                break;

            earliestId = newEarliest;
            rounds++;

            if (older.Any(x => x.Id <= maxDisplayedId))
                break;
        }

        return recovered;
    }
    
    /////////////
    // Cleanup //
    /////////////
    
    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        _disposed = true;

        if (Channel is null)
            return;

        Channel.MessageDeleted -= OnDeleteMessage;
        Channel.MessageReceived -= OnReceiveMessage;
        Channel.MessageEdited -= OnReceiveMessageEdit;

        if (WindowCtx?.Tab is not null)
            WindowCtx.Tab.OnStartFloating -= OnStartFloating;
        Client.NodeService.NodeReconnected -= OnNodeReconnect;
        Client.BlockService.BlocksChanged -= OnBlocksChanged;
        BrowserUtils.Focused -= OnBrowserFocused;
        BrowserUtils.Blurred -= OnBrowserBlurred;
        WindowService.FocusedTabChanged -= OnFocusedTabChanged;
        Client.NotificationService.NotificationReceived -= OnNotificationReceived;
        
        if (Channel.PlanetId is not null)
        {
            Channel.Planet.Deleted -= OnPlanetDeleted;
            Channel.Deleted -= OnChannelDeleted;
            
            if (Channel.Planet.MyMember is not null)
                Channel.Planet.MyMember.Deleted -= OnSelfMemberDeleted;
        }

        await StopActiveViewingLeaseAsync();
        await Channel.Close(WindowChannelKey);
        
        _thisRef.Dispose();

        if (_touchSlide is not null)
        {
            _touchSlide.SlideAction -= OnMessageSwipeReply;
            await _touchSlide.DisposeAsync();
        }

        if (_jsModule is not null)
        {
            await _jsModule.DisposeAsync();
        }
        
        if (_jsService is not null)
        {
            await _jsService.DisposeAsync();
        }
    }
}
