@inherits WindowContentComponent<Channel>
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject ValourClient Client
@inject UnreadService UnreadService
@inject RecentChatService RecentChatService
@using Valour.Client.Emojis
@using Valour.Sdk.Nodes
@using Valour.Shared.Models
@using Channel = Valour.Sdk.Models.Channel

<div class="chat-window-root @(Embedded ? "embedded" : string.Empty)">
    @if (_loading)
    {
        <Loading Title="Loading chat..." Spin="@true" />
    }
    else if (!string.IsNullOrWhiteSpace(_setupError))
    {
        <div class="chat-setup-error" role="alert">
            <i class="bi bi-exclamation-triangle"></i>
            <h3>Couldn't load this channel</h3>
            <p>@_setupError</p>
            <button type="button"
                    class="v-btn primary"
                    disabled="@_retryingSetup"
                    @onclick="RetrySetupAsync">
                @(_retryingSetup ? "Retrying..." : "Retry")
            </button>
        </div>
    }
    else
    {
        @if (!HideHeader)
        {
            <ChatHeaderComponent Channel="@Channel" ChatComponent="@this" />
        }
        <div class="chat-member-wrapper @(HideMemberList ? "member-list-hidden" : string.Empty)">
            <div class="chat-scroll-region">
                <div @ref="@MessageWrapperEl" class="chat-holder mt-auto">
                    <!-- Pushes messages to bottom -->
                    <div class="pusher"></div>

                    @if (_reachedStart && Channel is not null)
                    {
                        <div class="channel-start">
                            <SkyMoment Pose="SkyMoment.VictorPose.Peeking" Banner="true" Height="150"
                                       Seed="@ChannelStartSeed"
                                       Eyebrow="@ChannelStartEyebrow"
                                       Title="@ChannelStartTitle"
                                       Description="@ChannelStartDescription" />
                        </div>
                    }

                    <!-- Actual messages -->
                    @MessagesFragment

                    <div class="anchor"></div>
                </div>
                <button type="button"
                        class="scroll-to-bottom-button @(_showJumpToBottom ? "visible" : string.Empty)"
                        title="Jump to bottom"
                        aria-label="Jump to bottom"
                        @onclick="@JumpToBottomAsync"
                        @onclick:stopPropagation="true">
                    <i class="bi bi-arrow-down"></i>
                </button>
                <ControlledRenderWrapper @ref="@_reactionSelectorRenderWrapper">
                    <div class="reaction-selector-wrapper" style="bottom: @(_reactionSelectorTop); right: @(_reactionSelectorLeft);">
                        <EmojiMart @ref="@_reactionSelector" StartShown="false" OnClickOutside="@OnClickOutsideReactionPicker" OnEmojiClick="@OnReactionSelectedAsync"/>
                    </div>
                </ControlledRenderWrapper>
            </div>
            @if (!HideMemberList)
            {
                <MemberListComponent @ref="@MemberListComponent" Channel="@Channel"/>
            }
        </div>
    }

    @if (!_loading && string.IsNullOrWhiteSpace(_setupError) && Channel is not null)
    {
        <ChatEncryptionNotice Channel="@Channel" AdmissionChanged="@OnEncryptionAdmissionChanged" />
    }
    <InputComponent @ref="@InputComponent" ChatComponent="@this" />
</div>


@code {

    private EmojiMart _reactionSelector;
    private ControlledRenderWrapper _reactionSelectorRenderWrapper;
    private Message _currentlyReactingMessage;
    private string _reactionSelectorLeft;
    private string _reactionSelectorTop;
    private bool _pendingReactionEmojiRefresh;
    private bool _showJumpToBottom;
    private bool _scrollLatestWindowAfterNextRender;
    private bool _scaleScrollAfterNextRender;
    private bool _trimBottomAfterScale;
    private bool _trimTopAfterNextRender;
    private DateTime _suppressBottomPagingUntil = DateTime.MinValue;
    
    private bool _loading = true;
    private bool _disposed;
    private bool _retryingSetup;
    private string _setupError;
    private long? _pendingScrollToMessageId;
    private TouchSlide _touchSlide;
    private Timer _activeViewTimer;
    private bool _activeViewLeaseActive;
    private int _activeViewRefreshInFlight;
    private static readonly TimeSpan ActiveViewRefreshInterval = TimeSpan.FromSeconds(15);

    [Parameter]
    public bool Embedded { get; set; }

    [Parameter]
    public bool HideHeader { get; set; }

    [Parameter]
    public bool HideMemberList { get; set; }

    public Channel Channel;
    public PermissionsNode ChannelPermissions { get; set; }
    
    // Virtual window constants and state.
    // MaxRenderedMessages is the most messages the window keeps in the DOM once a
    // load or live arrival has settled. When it is exceeded, the end farthest from
    // the reader is cut in blocks of TrimStep, so trimming happens once per block
    // of arrivals rather than on every message.
    private const int InitialMessageCount = 32;
    private const int MessagePageSize = 64;
    private const int MaxRenderedMessages = 250;
    private const int TrimStep = 50;
    private static readonly TimeSpan HighlightProtectionTime = TimeSpan.FromSeconds(4);
    private long? _highlightedMessageId;
    private DateTime _highlightedUntil = DateTime.MinValue;
    private static readonly TimeSpan SealedIndexDelay = TimeSpan.FromSeconds(5);
    private bool _isCaughtUp = true;
    private bool _loadingForward = false;
    private bool _loadingBackward = false;

    // True once the oldest message of the channel is on screen, so the start of
    // the channel can be shown above it.
    private bool _reachedStart;

    private string ChannelStartSeed => Channel.PlanetId is null
        ? Channel.Id.ToString()
        : Channel.Planet is { } planet
            ? NebulaPalettes.WorldSeed(planet)
            : Channel.PlanetId.Value.ToString();

    private string ChannelStartEyebrow => Channel?.PlanetId is null
        ? "Direct message"
        : Channel.Planet?.Name;

    private string ChannelStartTitle => Channel?.PlanetId is null
        ? "The start of your conversation"
        : $"Welcome to #{Channel?.Name}";

    private string ChannelStartDescription => Channel?.PlanetId is null
        ? "Messages here are end-to-end encrypted. Only the people in this chat can read them."
        : "This is the very beginning. Someone's already peeking.";

    /// <summary>
    /// When true, suppresses auto-scroll behaviors (ShiftScrollPosition, ScrollToBottom)
    /// so that LoadAroundMessageAsync / ScrollToMessage isn't fought by loading messages.
    /// </summary>
    public bool SuppressAutoScroll { get; set; }

    // Stores for messages (Always initialized so don't bother null checking)
    // TODO: Replace with CircularBuffer
    public List<Message> DisplayedMessages { get; set; } = new();
    public List<Message> QueuedMessages { get; set; } = new();
    public List<MessageComponent> RenderedMessages { get; set; } = new();

    // Interop references
    public ElementReference MessageWrapperEl;
    private DotNetObjectReference<ChatWindowComponent> _thisRef;
    private IJSObjectReference _jsModule;
    private IJSObjectReference _jsService;
    
    // Child references
    public InputComponent InputComponent;

    /// <summary>
    /// True when this person has not been admitted to an invite-only planet's
    /// encryption yet, so its messages explain that an admin must admit them.
    /// </summary>
    public bool AwaitingEncryptionAdmission { get; private set; }

    private async Task OnEncryptionAdmissionChanged(bool awaiting)
    {
        if (AwaitingEncryptionAdmission == awaiting)
            return;

        AwaitingEncryptionAdmission = awaiting;
        foreach (var message in RenderedMessages.ToList())
        {
            if (message.ParamData.Message.IsEncrypted)
                await message.ReRender();
        }
    }
    public MemberListComponent MemberListComponent;
    
    // Used for locking channel connection while window is open
    private readonly string _instanceId = Guid.NewGuid().ToString();
    private string WindowChannelKey => _instanceId;

    // Runs when page is initialized
    protected override void OnInitialized()
    {
        Channel = Data;

        if (Channel is null)
        {
            Client.Logger.Log<ChatWindowComponent>("Channel is null, cannot initialize.", "red");
            return;
        }
        
        _thisRef = DotNetObjectReference.Create(this);
        
        Client.Logger.Log<ChatWindowComponent>("Initializing channel window component.", "cyan");
        
        Client.NodeService.NodeReconnected += OnNodeReconnect;
        Client.BlockService.BlocksChanged += OnBlocksChanged;
        BrowserUtils.Focused += OnBrowserFocused;
        BrowserUtils.Blurred += OnBrowserBlurred;
        WindowService.FocusedTabChanged += OnFocusedTabChanged;
        Client.NotificationService.NotificationReceived += OnNotificationReceived;
        
        Channel.MessageReceived += OnReceiveMessage;
        Channel.MessageEdited += OnReceiveMessageEdit;
        Channel.MessageDeleted += OnDeleteMessage;

        if (WindowCtx?.Tab is not null)
            WindowCtx.Tab.OnStartFloating += OnStartFloating;
    }

    private async Task OnReactionSelectedAsync(EmojiClickEvent e)
    {
        // toggle visible
        _reactionSelector.ToggleVisible();
        
        if (_currentlyReactingMessage is null) return;

        var reactionValue = e.IsCustom
            ? (e.Token ?? e.Shortcodes)
            : e.Native;

        if (string.IsNullOrWhiteSpace(reactionValue))
            return;

        await _currentlyReactingMessage.AddReactionAsync(reactionValue);
    }

    private Task RefreshReactionEmojiPickerAsync()
    {
        if (_reactionSelector is null)
        {
            _pendingReactionEmojiRefresh = true;
            return Task.CompletedTask;
        }

        var custom = PlanetEmojiMapper.GetPickerItems(Channel?.Planet);
        var categoryName = string.IsNullOrWhiteSpace(Channel?.Planet?.Name) ? "Planet" : Channel.Planet.Name;
        var categoryIcon = Channel?.Planet?.GetIconUrl(IconFormat.Webp64);
        return _reactionSelector.SetCustomEmojisAsync(custom, categoryIcon, categoryName);
    }
    
    private Task OnClickOutsideReactionPicker(OutsidePickerClickEvent e)
    {
        if ((e.Target ?? string.Empty).ToLower().Contains("option"))
            return Task.CompletedTask;
        
        _reactionSelector.ToggleVisible();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Opens the emoji reaction picker for the given message, positioned near the given client coordinates.
    /// </summary>
    public void OpenReactionPicker(Message message, double clientX, double clientY)
    {
        _currentlyReactingMessage = message;

        _reactionSelectorLeft = (BrowserUtils.WindowDimensions.Width - clientX) + "px";
        _reactionSelectorTop = Math.Min(BrowserUtils.WindowDimensions.Height - clientY, 350) + "px";

        // Re-render JUST the emoji selector
        _reactionSelectorRenderWrapper?.ReRender();

        _ = RefreshReactionEmojiPickerAsync();

        _reactionSelector?.ToggleVisible();
    }
    
    public async Task<bool> SetupNewChannelAsync()
    {
        if (Channel is null)
        {
            Client.Logger.Log<ChatWindowComponent>("Cannot set up chat window because channel data is null.", "red");
            _setupError = "The channel data is unavailable. Please reopen the channel.";
            _loading = false;
            await ReRender();
            return false;
        }

        _setupError = null;

        if (!_loading)
        {
            _loading = true;
            await ReRender();
        }

        var succeeded = false;
        try
        {
            var openResult = await Channel.OpenWithResult(WindowChannelKey);
            if (!openResult.Success)
                throw new Exception($"Failed to open channel connection: {openResult.Message}");

            if (Channel.Node is null)
                throw new Exception("Channel node is unavailable after opening connection.");

            _ = RecentChatService.RecordOpenedAsync(Channel);

            Task<PermissionsNode> permissionsTask = null;

            // Planet stuff
            if (Channel.PlanetId is not null)
            {
                await Channel.Planet.EnsureReadyAsync();
                var myMember = Channel.Planet.MyMember;
                if (myMember is null)
                {
                    throw new Exception("Planet membership was not found while setting up this channel.");
                }

                // Setup can be retried after a transient failure. Remove first
                // so retries never register duplicate handlers.
                Channel.Planet.Deleted -= OnPlanetDeleted;
                Channel.Planet.Deleted += OnPlanetDeleted;
                myMember.Deleted -= OnSelfMemberDeleted;
                myMember.Deleted += OnSelfMemberDeleted;
                Channel.Deleted -= OnChannelDeleted;
                Channel.Deleted += OnChannelDeleted;
                permissionsTask = Channel.GetFlattenedPermissionsAsync(myMember.Id).AsTask();
            }

            Channel.Updated -= OnChatChannelUpdate;
            Channel.Updated += OnChatChannelUpdate;

            ClearMessages(false);
            _isCaughtUp = true;
            _loadingForward = false;

            // Check if we should load around a specific message (e.g. from notification)
            var targetMessageId = (WindowCtx as Content)?.TargetMessageId;
            var loadingAround = targetMessageId is not null && targetMessageId.Value != 0;

            // Permissions load alongside history; Task.WhenAll observes both outcomes.
            var historyTask = loadingAround
                ? LoadAroundMessageAsync(targetMessageId.Value)
                : LoadRecentMessages(InitialMessageCount);
            await Task.WhenAll(historyTask, permissionsTask ?? Task.CompletedTask);

            var historyResult = historyTask.Result;
            if (!historyResult.Success)
            {
                throw new Exception($"Failed to load channel history: {historyResult.Message}");
            }

            if (permissionsTask is not null)
                ChannelPermissions = permissionsTask.Result;

            // Clear so re-setup doesn't re-navigate
            if (loadingAround)
                ((Content)WindowCtx).TargetMessageId = null;

            _ = Channel.UpdateUserState(DateTime.UtcNow);
            succeeded = true;
        }
        catch (Exception e)
        {
            Client.Logger.Log<ChatWindowComponent>($"Error setting up channel: {e}", "red");
            _setupError = "The channel couldn't finish loading. Check your connection and try again.";
        }

        _loading = false;
        _pendingReactionEmojiRefresh = true;

        if (succeeded && InputComponent is not null)
        {
            try
            {
                await InputComponent.NotifyChannelLoadedAsync();
            }
            catch (Exception e)
            {
                Client.Logger.Log<ChatWindowComponent>($"Error initializing channel input: {e}", "red");
                _setupError = "The channel couldn't finish loading. Check your connection and try again.";
                succeeded = false;
            }
        }

        await ReRender();

        // A target can arrive after setup already started loading recent history
        if (succeeded && WindowCtx is Content { TargetMessageId: { } lateTarget } lateContent)
        {
            lateContent.TargetMessageId = null;
            if (lateTarget != 0)
                await LoadAroundMessageAsync(lateTarget);
        }

        return succeeded;
    }

    /// <summary>
    /// Loads the channel around a message and highlights it. While the channel
    /// is still being set up, the message is kept as the target so setup loads
    /// around it instead.
    /// </summary>
    public async Task ShowMessageAsync(long messageId)
    {
        if (_loading || _setupError is not null || Channel is null)
        {
            if (WindowCtx is Content content)
                content.TargetMessageId = messageId;
            return;
        }

        await LoadAroundMessageAsync(messageId);
    }

    private async Task RetrySetupAsync()
    {
        if (_retryingSetup || _disposed)
            return;

        _retryingSetup = true;
        _setupError = null;
        _loading = true;
        await ReRender();

        try
        {
            if (await SetupNewChannelAsync() && !_disposed)
                await InitializeChatInteropAsync();
        }
        finally
        {
            _retryingSetup = false;
            if (!_disposed)
                await ReRender();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Channel is null)
        {
            await base.OnAfterRenderAsync(firstRender);
            return;
        }

        if (firstRender)
        {
            // Setup must run first: MessageWrapperEl only exists in the DOM
            // once _loading is false, so the JS init has to wait for it.
            var setupSucceeded = await SetupNewChannelAsync();

            // The window may have been closed while messages were loading;
            // _thisRef is disposed then, and serializing it to JS throws
            // ObjectDisposedException and crashes the app (#1554, #1566)
            if (_disposed || !setupSucceeded)
                return;

            await InitializeChatInteropAsync();
        }

        if (_pendingReactionEmojiRefresh && !_loading && _reactionSelector is not null)
        {
            _pendingReactionEmojiRefresh = false;
            await RefreshReactionEmojiPickerAsync();
        }

        if (_trimTopAfterNextRender && _jsService is not null)
        {
            _trimTopAfterNextRender = false;
            await UpdateScrollPosition();
            TrimDisplayedMessages(TrimEnd.Oldest);
            _scaleScrollAfterNextRender = true;
            await ReRender();
        }
        else if (_scaleScrollAfterNextRender && _jsService is not null)
        {
            _scaleScrollAfterNextRender = false;
            await ScaleScrollPosition();

            if (_trimBottomAfterScale)
            {
                _trimBottomAfterScale = false;
                TrimDisplayedMessages(TrimEnd.Newest);
                await ReRender();
            }

            _loadingBackward = false;
            _loadingForward = false;
        }

        if (_scrollLatestWindowAfterNextRender && _jsService is not null)
        {
            _scrollLatestWindowAfterNextRender = false;
            await ScrollFromTopToBottomAnimated();
        }
        
        UnreadService.MarkChannelRead(Channel.PlanetId, Channel.Id);
        
        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task InitializeChatInteropAsync()
    {
        if (_disposed || _jsService is not null)
            return;

        try
        {
            _jsModule ??= await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Valour.Client/Components/Windows/ChannelWindows/ChatWindowComponent.razor.js");
            if (_disposed)
                return;

            _jsService = await _jsModule.InvokeAsync<IJSObjectReference>("init", _thisRef, MessageWrapperEl);
            if (_disposed)
                return;

            // Swipe-left-to-reply for touch devices. The :not() filters keep
            // inner reply previews and ghost messages from being targets.
            _touchSlide = new TouchSlide();
            _touchSlide.SlideAction += OnMessageSwipeReply;
            await _touchSlide.Initialize(MessageWrapperEl, ".message:not(.reply):not(.ghost)", JsRuntime);
            if (_disposed)
                return;

            if (_pendingScrollToMessageId is not null)
            {
                var target = _pendingScrollToMessageId.Value;
                _pendingScrollToMessageId = null;
                await ScrollToMessage(target, highlight: true);
            }
            else
            {
                await ScrollToBottom(true);
            }

            await UpdateActiveViewingLeaseStateAsync();
        }
        catch (ObjectDisposedException)
        {
            // The tab was closed during initialization.
        }
        catch (JSDisconnectedException)
        {
            // The WebView/browser disconnected during initialization.
        }
        catch (JSException e)
        {
            Client.Logger.Log<ChatWindowComponent>($"Error initializing channel UI: {e}", "red");
            await ResetChatInteropAfterFailureAsync();
            _setupError = "The channel loaded, but its interface couldn't start. Please try again.";
            await ReRender();
        }
    }

    private async Task ResetChatInteropAfterFailureAsync()
    {
        if (_touchSlide is not null)
        {
            _touchSlide.SlideAction -= OnMessageSwipeReply;
            try
            {
                await _touchSlide.DisposeAsync();
            }
            catch (JSException)
            {
                // The failed JS context may already be gone.
            }
            catch (ObjectDisposedException)
            {
                // The failed JS context may already be gone.
            }

            _touchSlide = null;
        }

        if (_jsService is not null)
        {
            try
            {
                await _jsService.DisposeAsync();
            }
            catch (JSException)
            {
                // The failed JS context may already be gone.
            }
            catch (ObjectDisposedException)
            {
                // The failed JS context may already be gone.
            }

            _jsService = null;
        }
    }

    public async Task OpenEditMode(MessageComponent message)
    {
        await InputComponent.OnBeginEdit(message, message.ParamData.Message);
    }

    public async Task CloseEditMode(bool cancel = false)
    {
        await InputComponent.OnStopEdit(cancel);
    }
    
    public async Task OnChatChannelUpdate(ModelUpdatedEvent<Channel> eventData)
    {
        await ReRender();
    }

    public async Task OnBlocksChanged()
    {
        await InvokeAsync(async () =>
        {
            if (!ApplyBlockFilteringToVisibleMessages())
                return;

            await ReRender();

            if (InputComponent?.PreviewMessageComponent is not null)
            {
                InputComponent.PreviewMessageComponent.SetLast(GetLastMessage());
                InputComponent.PreviewMessageComponent.CheckMinimal();
                await InputComponent.PreviewMessageComponent.ReRender();
            }
        });
    }

    public virtual async Task OnReceiveMessage(Message? message)
    {
        if (_disposed || message is null || Channel is null)
            return;

        // Ignore messages not meant for this channel
        if (message.ChannelId != Channel.Id)
            return;

        if (IsBlockedMessage(message))
            return;

        StripBlockedReplyPreview(message);

        // Skip real-time messages when we're scrolled away from the present —
        // they'll be fetched via forward loading when the user scrolls back down.
        if (!_isCaughtUp)
            return;

        await InvokeAsync(async () =>
        {
            // TODO: Eventually move to message render with a specific time of message sent
            UnreadService.MarkChannelRead(Channel.PlanetId, Channel.Id);

            await AddMessage(message);
            if (InputComponent?.PreviewMessageComponent is not null)
            {
                InputComponent.PreviewMessageComponent.SetLast(GetLastMessage());
                InputComponent.PreviewMessageComponent.CheckMinimal();
                await InputComponent.PreviewMessageComponent.ReRender();
            }
        });
    }
    
    public virtual async Task OnReceiveMessageEdit(Message? message)
    {
        if (_disposed || message is null || Channel is null)
            return;

        // Ignore messages not meant for this channel
        if (message.ChannelId != Channel.Id)
            return;

        if (IsBlockedMessage(message))
        {
            await OnDeleteMessage(message);
            return;
        }

        StripBlockedReplyPreview(message);

        await InvokeAsync(async () =>
        {
            foreach (var messageComponent in RenderedMessages)
            {
                var displayed = messageComponent.ParamData.Message;
                var updatedTarget = ApplyMessageEditToDisplayedMessage(displayed, message);
                if (updatedTarget is null)
                    continue;

                if (ReferenceEquals(updatedTarget, displayed) && messageComponent.Edit)
                    await messageComponent.CloseEditMode();

                messageComponent.BuildMessage(true);
            }
        });
    }

    internal static Message? ApplyMessageEditToDisplayedMessage(Message displayed, Message edit)
    {
        var target = displayed.Id == edit.Id
            ? displayed
            : displayed.ReplyTo?.Id == edit.Id
                ? displayed.ReplyTo
                : null;

        if (target is null)
            return null;

        target.EditedTime = edit.EditedTime ?? DateTime.UtcNow;
        target.Content = edit.Content;
        target.Attachments = edit.Attachments;
        target.Mentions = edit.Mentions;
        return target;
    }

    public async Task OnClickWindow()
    {
        if (WindowCtx?.Tab is not null)
            await WindowCtx.Tab.NotifyFocused();

        await UpdateActiveViewingLeaseStateAsync();
    }
    
    public async Task OnStartFloating()
    {
        await ScrollToBottom();
    }

    public Task OnPlanetDeleted()
    {
        if (WindowCtx?.Tab is null)
            return Task.CompletedTask;

        return WindowCtx.Tab.SetContent(HomeWindowComponent.DefaultContent);
    }

    public Task OnSelfMemberDeleted()
    {
        if (WindowCtx?.Tab is null)
            return Task.CompletedTask;

        return WindowCtx.Tab.SetContent(HomeWindowComponent.DefaultContent);
    }

    public Task OnChannelDeleted()
    {
        if (WindowCtx?.Tab is null)
            return Task.CompletedTask;
        
        WindowContent<ThreadsWindowComponent, ThreadsWindowData> content = Channel?.PlanetId is not null
            ? ThreadsWindowComponent.GetDefaultContent(Channel.Planet)
            : ThreadsWindowComponent.DefaultContent;
        
        return WindowCtx.Tab.SetContent(content);
    }
    
    public async Task<List<PlanetMember>> GetLastChatMembers(int count)
    {
        // Not applicable for non-planet channels
        if (Channel.PlanetId is null)
            return new List<PlanetMember>();
        
        var lastMessages = DisplayedMessages.TakeLast(20).Reverse();
        List<PlanetMember> chatters = new();

        foreach (var message in lastMessages)
        {
            // System, error, and departed-member messages have no member.
            var member = await message.FetchAuthorMemberAsync();
            if (member is null || chatters.Contains(member))
                continue;

            chatters.Add(member);
            if (chatters.Count >= count)
                break;
        }

        return chatters;
    }
    
    ///////////////////////
    // Message Rendering //
    ///////////////////////

    private HashSet<long> _messageSet = new();

    /// <summary>
    /// Ids of messages that arrived live (vs loaded as history) and should
    /// play an entrance animation when first rendered.
    /// </summary>
    private readonly HashSet<long> _liveArrivalIds = new();
    
    private RenderFragment MessagesFragment => builder =>
    {
        _messageSet.Clear();

        Message lastMessage = null;
        var sequence = 0;

        // Displayed messages
        foreach (var message in DisplayedMessages)
        {
            if (_messageSet.Contains(message.Id))
            {
                Console.WriteLine("[SEVERE] Duplicate message detected: " + message.Id);
                continue;
            }

            var showDateDivider = ShouldShowDateDivider(message, lastMessage);
            if (showDateDivider)
                RenderDateDivider(builder, ref sequence, message);

            var messageParams = new MessageComponent.Params()
            {
                ChatComponent = this,
                Message = message,
                IsInnerReply = false,
                LastMessage = showDateDivider ? null : lastMessage,
                Ghost = false,
                AnimateIn = _liveArrivalIds.Contains(message.Id),
            };

            builder.OpenComponent<MessageComponent>(sequence++);
            builder.AddAttribute(sequence++, "ParamData", messageParams);
            builder.SetKey(message.Id);
            builder.CloseComponent();

            lastMessage = message;

            _messageSet.Add(message.Id);
        }

        // Queued (ghost) messages — ghosts are removed from this list
        // before rendering when their real message arrives, so no
        // fingerprint-skip logic is needed here.
        foreach (var message in QueuedMessages)
        {
            var showDateDivider = ShouldShowDateDivider(message, lastMessage);
            if (showDateDivider)
                RenderDateDivider(builder, ref sequence, message);

            var messageParams = new MessageComponent.Params()
            {
                ChatComponent = this,
                Message = message,
                IsInnerReply = false,
                LastMessage = showDateDivider ? null : lastMessage,
                Ghost = true,
                AnimateIn = true,
            };

            builder.OpenComponent<MessageComponent>(sequence++);
            builder.AddAttribute(sequence++, "ParamData", messageParams);
            builder.SetKey($"q-{message.Fingerprint}");
            builder.CloseComponent();

            lastMessage = message;
        }

        // The message being typed, where it will appear once sent. It is a
        // sibling of the messages above, so it gets the same width, spacing
        // and grouping as the message that replaces it. It shares the key of
        // the ghost it becomes when sent, so the same element stays in place.
        var draft = InputComponent?.DraftPreview;
        InputComponent?.OnDraftRendered(draft is not null);
        if (draft is not null)
        {
            var showDateDivider = ShouldShowDateDivider(draft, lastMessage);
            if (showDateDivider)
                RenderDateDivider(builder, ref sequence, draft);

            var messageParams = new MessageComponent.Params()
            {
                ChatComponent = this,
                Message = draft,
                IsInnerReply = false,
                LastMessage = showDateDivider ? null : lastMessage,
                Ghost = true,
                Draft = true,
            };

            var input = InputComponent;
            builder.OpenComponent<MessageComponent>(sequence++);
            builder.AddAttribute(sequence++, "ParamData", messageParams);
            builder.SetKey($"q-{draft.Fingerprint}");
            builder.AddComponentReferenceCapture(sequence++, component => input.PreviewMessageComponent = (MessageComponent)component);
            builder.CloseComponent();
        }

    };

    private static bool ShouldShowDateDivider(Message message, Message lastMessage)
    {
        if (message is null)
            return false;

        if (lastMessage is null)
            return true;

        return message.TimeSent.ToLocalTime().Date != lastMessage.TimeSent.ToLocalTime().Date;
    }

    private static string GetDateDividerText(DateTime timeSent)
    {
        var date = timeSent.ToLocalTime().Date;
        var today = DateTime.Now.Date;

        if (date == today)
            return "Today";

        if (date == today.AddDays(-1))
            return "Yesterday";

        return date.Year == today.Year
            ? date.ToString("MMM d")
            : date.ToString("MMM d, yyyy");
    }

    private static string GetDateDividerTitle(DateTime timeSent)
    {
        return timeSent.ToLocalTime().Date.ToString("dddd, MMMM d, yyyy");
    }

    private static void RenderDateDivider(
        Microsoft.AspNetCore.Components.Rendering.RenderTreeBuilder builder,
        ref int sequence,
        Message message)
    {
        var label = GetDateDividerText(message.TimeSent);

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "message-date-divider");
        builder.AddAttribute(sequence++, "role", "separator");
        builder.AddAttribute(sequence++, "title", GetDateDividerTitle(message.TimeSent));
        builder.AddAttribute(sequence++, "aria-label", $"Messages from {label}");

        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "message-date-divider-line");
        builder.CloseElement();

        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "message-date-divider-label");
        builder.AddContent(sequence++, label);
        builder.CloseElement();

        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "message-date-divider-line");
        builder.CloseElement();

        builder.CloseElement();
    }
    
