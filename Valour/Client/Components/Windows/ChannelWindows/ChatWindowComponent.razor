    public async Task<TaskResult> LoadRecentMessages(int count)
    {
        var result = await Channel.GetMessagesWithResultAsync(long.MaxValue, count);
        if (!result.Success)
            return TaskResult.FromFailure(result);

        _reachedStart = (result.Data?.Count ?? 0) < count;

        await AddMessages(result.Data, true, true);

        // Opening an encrypted channel is a good moment to share its key with
        // members who asked while this device was offline, and to index
        // history the server sealed, in the background. Indexing decrypts
        // hundreds of messages, so it waits until the channel has finished
        // opening rather than competing with it for the browser's thread.
        if (Channel.IsEncrypted && Client.E2eeService.Status == E2eeStatus.Ready)
        {
            var channel = Channel;
            _ = Task.Run(async () =>
            {
                await Client.E2eeService.ServeChannelAsync(channel);
                await Task.Delay(SealedIndexDelay);
                await Client.E2eeService.IndexSealedHistoryAsync(channel);
            });
        }

        return TaskResult.SuccessResult;
    }

    /// <summary>
    /// Loads messages around a target message and highlights it.
    /// Used for notification click-through and search result navigation.
    /// </summary>
    public async Task<TaskResult> LoadAroundMessageAsync(long messageId)
    {
        ClearMessages(false);
        _isCaughtUp = false;
        _loadingForward = false;
        SuppressAutoScroll = true;

        // Fetch messages up to and including the target (Id < messageId+1 gets Id <= messageId)
        var beforeTask = Channel.GetMessagesWithResultAsync(messageId + 1, 32);

        // Fetch messages after the target
        var afterTask = Channel.GetMessagesAfterWithResultAsync(messageId, 32);

        await Task.WhenAll(beforeTask, afterTask);
        var beforeResult = beforeTask.Result;
        var afterResult = afterTask.Result;

        if (!beforeResult.Success)
            return TaskResult.FromFailure(beforeResult);

        if (!afterResult.Success)
            return TaskResult.FromFailure(afterResult);

        var before = beforeResult.Data;
        var after = afterResult.Data;
        _reachedStart = before is null || before.Count < 32;

        var combined = new List<Message>();
        if (before is not null)
            combined.AddRange(before);
        if (after is not null)
            combined.AddRange(after);

        if (combined.Count == 0)
        {
            // Target not found — fall back to recent messages
            _isCaughtUp = true;
            SuppressAutoScroll = false;
            return await LoadRecentMessages(InitialMessageCount);
        }

        await AddMessages(combined, render: false, scroll: false);

        // If we got fewer than requested after, we're caught up to the present
        if (after is null || after.Count < 32)
            _isCaughtUp = true;

        await ReRender();

        // Scroll to the target message and trigger highlight animation.
        // Uses instant scroll so it can't be interrupted by DOM changes.
        // The highlight class is added/removed by JS after scrolling.
        // During first-time window setup the JS service doesn't exist yet,
        // so defer the scroll to OnAfterRenderAsync.
        if (_jsService is null)
            _pendingScrollToMessageId = messageId;
        else
            await ScrollToMessage(messageId, highlight: true);

        // Keep suppressing auto-scroll while messages finish loading
        // (avatars, embeds, etc. trigger ShiftScrollPosition which would
        // fight our position). Release after content has settled.
        _ = ReleaseSuppressAfterDelay();
        return TaskResult.SuccessResult;
    }

    private async Task ReleaseSuppressAfterDelay()
    {
        await Task.Delay(1500);
        SuppressAutoScroll = false;
    }

    public async Task AddQueuedMessage(Message message)
    {
        // If not caught up, snap back to live mode before sending
        if (!_isCaughtUp)
        {
            _isCaughtUp = true;
            ClearMessages(false);
            await LoadRecentMessages(InitialMessageCount);
        }

        // Guard against duplicate if already pre-queued (e.g. from OnChatboxSubmit)
        if (!QueuedMessages.Contains(message))
            QueuedMessages.Add(message);

        await ReRender();
        await ScrollToBottom();
    }

    public void RemoveQueuedMessage(string fingerprint)
    {
        
        var queued = QueuedMessages.FirstOrDefault(x => x.Fingerprint == fingerprint);
        if (queued != null)
        {
            //Console.WriteLine("Removed Queued Message");
            QueuedMessages.Remove(queued);
            _ = ReRender();
        }
    }

    public void RemoveErrorMessage()
    {
        var error = DisplayedMessages.FirstOrDefault(x => x.Id == long.MaxValue);
        if (error != null) { 
            //Console.WriteLine("Removed error message");
            DisplayedMessages.Remove(error); 
            _ = ReRender();
        }
    }
    
