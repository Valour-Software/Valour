    [JSInvokable("OnScrollBottomInvoke")]
    public async Task OnScrollBottom()
    {
        if (DateTime.UtcNow < _suppressBottomPagingUntil)
            return;

        if (_isCaughtUp || _loadingForward)
            return;

        if (_loadingBackward || _scaleScrollAfterNextRender || _trimBottomAfterScale || _trimTopAfterNextRender)
            return;

        if (DisplayedMessages == null || DisplayedMessages.Count == 0)
            return;

        await LoadNextPageAsync();
    }

    private async Task LoadNextPageAsync()
    {
        if (Channel is null || DisplayedMessages.Count == 0)
            return;

        _loadingForward = true;

        try
        {
            var lastId = DisplayedMessages[^1].Id;
            var beforeCount = DisplayedMessages.Count;
            var messages = await Channel.GetMessagesAfterAsync(lastId, MessagePageSize);

            if (messages is null || messages.Count == 0)
            {
                _isCaughtUp = true;
                return;
            }

            await AddMessages(messages, render: false, scroll: false);

            if (messages.Count < MessagePageSize)
                _isCaughtUp = true;

            if (DisplayedMessages.Count == beforeCount)
                return;

            _trimTopAfterNextRender = DisplayedMessages.Count > MaxRenderedMessages;
            await ReRender();
        }
        finally
        {
            if (!_trimTopAfterNextRender && !_scaleScrollAfterNextRender)
                _loadingForward = false;
        }
    }

    private async Task LoadLatestWindowAsync()
    {
        if (Channel is null)
            return;

        _loadingForward = true;

        try
        {
            var queuedMessages = QueuedMessages.ToList();
            var messages = await Channel.GetLastMessagesAsync(MessagePageSize);

            if (messages is not { Count: > 0 })
                return;

            _isCaughtUp = true;
            ClearMessages(false);
            _reachedStart = messages.Count < MessagePageSize;

            await AddMessages(messages, render: false, scroll: false);

            if (queuedMessages.Count > 0)
            {
                var fingerprints = DisplayedMessages
                    .Where(x => !string.IsNullOrEmpty(x.Fingerprint))
                    .Select(x => x.Fingerprint)
                    .ToHashSet();

                QueuedMessages.AddRange(queuedMessages.Where(x =>
                    string.IsNullOrEmpty(x.Fingerprint) || !fingerprints.Contains(x.Fingerprint)));
            }

            _showJumpToBottom = false;
            _scrollLatestWindowAfterNextRender = true;
            await ReRender();
        }
        finally
        {
            _loadingForward = false;
        }
    }

    [JSInvokable("OnBottomStickinessChanged")]
    public async Task OnBottomStickinessChanged(bool isAtBottom)
    {
        var shouldShowJumpButton = !isAtBottom;
        if (_showJumpToBottom == shouldShowJumpButton)
            return;

        _showJumpToBottom = shouldShowJumpButton;
        await ReRender();
    }

    private enum TrimEnd
    {
        Oldest,
        Newest
    }

    /// <summary>
    /// Cuts the displayed messages back to <see cref="MaxRenderedMessages"/> from
    /// the given end, in whole blocks of <see cref="TrimStep"/>. Cutting the oldest
    /// end means the start of the channel is no longer on screen, and cutting the
    /// newest end means the window is no longer caught up to the present; both
    /// are restored by the normal paging paths. The cut stops short of any message
    /// the reader is working with. Returns how many messages were removed.
    /// </summary>
    private int TrimDisplayedMessages(TrimEnd end)
    {
        var excess = DisplayedMessages.Count - MaxRenderedMessages;
        if (excess <= 0)
            return 0;

        // A queued message belongs after the newest displayed one, so the
        // newest end stays contiguous with it until it is delivered.
        if (end == TrimEnd.Newest && QueuedMessages.Count > 0)
            return 0;

        var wanted = Math.Min((excess + TrimStep - 1) / TrimStep * TrimStep, DisplayedMessages.Count);
        var count = 0;
        while (count < wanted)
        {
            var index = end == TrimEnd.Oldest ? count : DisplayedMessages.Count - 1 - count;
            if (IsProtectedFromTrim(DisplayedMessages[index].Id))
                break;

            count++;
        }

        if (count == 0)
            return 0;

        if (end == TrimEnd.Oldest)
        {
            DisplayedMessages.RemoveRange(0, count);
            _reachedStart = false;
        }
        else
        {
            DisplayedMessages.RemoveRange(DisplayedMessages.Count - count, count);
            _isCaughtUp = false;
            _suppressBottomPagingUntil = DateTime.UtcNow.AddMilliseconds(600);
        }

        if (_liveArrivalIds.Count > 0)
        {
            var remaining = DisplayedMessages.Select(x => x.Id).ToHashSet();
            _liveArrivalIds.RemoveWhere(id => !remaining.Contains(id));
        }

        return count;
    }

    private bool IsProtectedFromTrim(long id)
    {
        if (id == long.MaxValue || id == _pendingScrollToMessageId)
            return true;

        if (id == _highlightedMessageId && DateTime.UtcNow < _highlightedUntil)
            return true;

        if (InputComponent is null)
            return false;

        return id == InputComponent.EditingMessageComponent?.ParamData?.Message?.Id ||
               id == InputComponent.ReplyTargetId;
    }
    

    [JSInvokable("OnScrollTopInvoke")]
    public async Task OnScrollTop()
    {
        if (_disposed) return;
        _scrollLatestWindowAfterNextRender = false;

        if (_loadingBackward || _loadingForward)
            return;

        if (DisplayedMessages == null ||
            DisplayedMessages.Count == 0)
        {
            return;
        }

        _loadingBackward = true;

        try
        {
            var firstId = DisplayedMessages[0].Id;

            Client.Logger.Log<ChatWindowComponent>($"Fetching older messages from id {firstId} for window {WindowCtx.Id}", "cyan");

            var messages = await Channel.GetMessagesAsync(firstId, MessagePageSize);

            if (_disposed || messages is null)
                return;

            if (messages.Count == 0)
            {
                if (!_reachedStart)
                {
                    _reachedStart = true;
                    await ReRender();
                }

                return;
            }

            if (messages.Count < MessagePageSize)
                _reachedStart = true;

            // Insert older messages above, then preserve the viewport after the DOM has rendered them.
            await UpdateScrollPosition();
            if (_disposed) return;
            DisplayedMessages.InsertRange(0, messages);
            _scaleScrollAfterNextRender = true;
            _trimBottomAfterScale = DisplayedMessages.Count > MaxRenderedMessages;
            await ReRender();
        }
        finally
        {
            if (!_scaleScrollAfterNextRender)
                _loadingBackward = false;
        }
    }
    
