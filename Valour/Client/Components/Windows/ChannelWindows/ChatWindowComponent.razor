    private bool IsBlockedMessage(Message message)
    {
        if (message is null)
            return false;

        return Client.BlockService.IsBlocked(message.AuthorUserId);
    }

    private bool StripBlockedReplyPreview(Message message)
    {
        if (message?.ReplyTo is null)
            return false;

        if (!Client.BlockService.IsBlocked(message.ReplyTo.AuthorUserId))
            return false;

        message.ReplyTo = null;
        message.ReplyToId = null;
        return true;
    }

    private bool ApplyBlockFilteringToVisibleMessages()
    {
        var changed = false;

        if (DisplayedMessages.RemoveAll(IsBlockedMessage) > 0)
            changed = true;

        if (QueuedMessages.RemoveAll(IsBlockedMessage) > 0)
            changed = true;

        foreach (var message in DisplayedMessages)
        {
            if (StripBlockedReplyPreview(message))
                changed = true;
        }

        return changed;
    }
    
    public async Task AddMessages(List<Message> messages, bool render = true, bool scroll = false)
    {
        if (messages is null || messages.Count == 0)
            return;

        var existingIds = DisplayedMessages.Select(x => x.Id).ToHashSet();
        var uniqueNew = new List<Message>(messages.Count);

        foreach (var msg in messages)
        {
            if (msg is null)
                continue;

            if (IsBlockedMessage(msg))
                continue;

            StripBlockedReplyPreview(msg);

            if (existingIds.Add(msg.Id))
                uniqueNew.Add(msg);
        }

        if (uniqueNew.Count == 0)
            return;

        DisplayedMessages.AddRange(uniqueNew);
        DisplayedMessages.Sort(MessageComparerInstance);

        if (render)
        {
            await ReRender();
        }

        if (scroll)
        {
            await ScrollToBottom();
        }

        InputComponent.Refresh();
    }

    public void InsertMessages(int position, List<Message> messages, bool render = true)
    {
        DisplayedMessages.InsertRange(position, messages);

        if (render)
        {
            _ = ReRender();
        }
    }

    public async Task AddMessage(Message? message, bool render = true)
    {
        if (_disposed || message is null)
            return;

        if (IsBlockedMessage(message))
            return;

        StripBlockedReplyPreview(message);

        //Get current window scroll pos
        var atBottom = _jsService is not null && await _jsService.InvokeAsync<bool>("isAtBottom");

        // Remove the matching ghost BEFORE rendering so the ghost removal and
        // real message insertion appear in the same render frame with no gap.
        var replacedGhost = false;
        if (!string.IsNullOrEmpty(message.Fingerprint))
            replacedGhost = QueuedMessages.RemoveAll(x => x.Fingerprint == message.Fingerprint) > 0;

        // Live arrivals get an entrance animation — unless they replace a
        // ghost, in which case the ghost already animated in and the swap
        // should stay seamless.
        if (!replacedGhost)
        {
            // A reader who is scrolled up in a full window is not shown the new
            // message. Forward loading fetches it when they scroll back down.
            if (!atBottom && DisplayedMessages.Count >= MaxRenderedMessages)
            {
                _isCaughtUp = false;
                return;
            }

            _liveArrivalIds.Add(message.Id);
        }

        DisplayedMessages.Add(message);

        // A reader at the live bottom loses the oldest messages from the DOM;
        // scrolling up loads them again.
        if (atBottom)
            TrimDisplayedMessages(TrimEnd.Oldest);

        // Flag for UI refresh
        if (render)
        {
            await ReRender();
        }

        await ScrollToBottom();
    }
    
