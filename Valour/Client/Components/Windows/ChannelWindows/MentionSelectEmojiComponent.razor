<div class="@("item " + SelectedClass)" @onmousedown:preventDefault="true" @ontouchstart="OnClickAsync" @onclick="OnClickAsync">
    @if (_customSrc is not null)
    {
        <img class="icon emoji-icon" src="@_customSrc" alt="@_displayCode" title="@($":{_displayCode}:")" />
    }
    else
    {
        <span class="icon emoji-icon emoji" role="img" aria-label="@_displayCode" title="@($":{_displayCode}:")">@Emoji?.Native</span>
    }
    <p class="title noselect">:@_displayCode:</p>
</div>

@code {
    private string _customSrc;
    private string _displayCode;

    [Parameter]
    public int Index { get; set; }

    [Parameter]
    public MentionSelectComponent Parent { get; set; }

    [Parameter]
    public EmojiClickEvent Emoji { get; set; }

    [Parameter]
    public bool Selected { get; set; }

    private string SelectedClass
    {
        get
        {
            if (Selected)
                return "selected";

            return "";
        }
    }

    protected override void OnParametersSet()
    {
        _displayCode = Emoji?.Id;
        if (string.IsNullOrWhiteSpace(_displayCode) && Emoji?.Aliases is not null && Emoji.Aliases.Length > 0)
            _displayCode = Emoji.Aliases[0];
        if (string.IsNullOrWhiteSpace(_displayCode))
            _displayCode = "emoji";

        _customSrc = Emoji?.IsCustom == true && !string.IsNullOrWhiteSpace(Emoji.Src)
            ? Emoji.Src
            : null;
    }

    private async Task OnClickAsync()
    {
        Parent.Selected = Index;
        await Parent.Submit();
    }
}
