@inherits WindowContentComponent<Planet>
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject Valour.Sdk.Services.VillageService VillageService
@inject Valour.Client.Components.Calls.GlobalCallSessionService CallSession
@inject Valour.Sdk.Services.MessageService MessageService
@inject ValourClient Client
@using System.Text.Json
@using Valour.Shared.Villages
@using Channel = Valour.Sdk.Models.Channel

@if (_loading)
{
    <Loading Title="Loading village..." Spin="@true" />
}
else if (_error is not null)
{
    <div class="village-empty-state">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@_error</span>
    </div>
}
else
{
    <div class="village-window">
        <canvas id="@_canvasId" class="village-canvas"></canvas>

        <div class="village-overlay overlay-top-left">
            <div class="overlay-card village-brand-card">
                <div class="village-kicker">Valour Village Proof Of Concept</div>
                <div class="village-title">@_scene!.Title</div>
                <div class="village-subtitle">@_scene.Subtitle</div>
            </div>
            <div class="overlay-inline-group">
                <span class="hud-chip">@(_currentMap?.Name ?? "Unknown Map")</span>
                <span class="hud-chip">@(_currentMap?.MapKind ?? "Map")</span>
            </div>
        </div>

        <div class="village-overlay overlay-top-right">
            <div class="overlay-card village-actions-card">
                <div class="overlay-card-title">Controls</div>
                <div class="overlay-inline-group">
                    <span class="hud-chip">WASD / Arrows</span>
                    <span class="hud-chip">Step To Doors</span>
                    <span class="hud-chip">Click To Inspect</span>
                </div>
                <div class="overlay-toggle-row">
                    <label class="village-toggle">
                        <input type="checkbox" checked="@_proximityVoice" @onchange="OnToggleProximityVoice" />
                        <span>Proximity voice</span>
                    </label>
                    <label class="village-toggle">
                        <input type="checkbox" checked="@_autoJoinVoice" @onchange="OnToggleAutoJoin" />
                        <span>Auto-join rooms</span>
                    </label>
                </div>
                @if (_activeVoiceBuildingName is not null)
                {
                    <div class="village-voice-status">
                        <i class="bi bi-mic-fill"></i>
                        <span>In voice: @_activeVoiceBuildingName</span>
                        <button class="v-btn tiny" @onclick="LeaveVoiceAsync">Leave</button>
                    </div>
                }
                <div class="overlay-button-row">
                    <button class="v-btn secondary" @onclick="ResetViewAsync">Center Camera</button>
                    @if (_currentMap?.MapKind == "Interior")
                    {
                        <button class="v-btn secondary" @onclick="ReturnOutsideAsync">Leave Building</button>
                    }
                </div>
            </div>
        </div>

        <div class="village-overlay overlay-bottom-left">
            <div class="overlay-card village-lore-card">
                <div class="overlay-card-title">World Layer</div>
                <div class="overlay-card-body">
                    This is the direction: the game fills the window, and Valour features become part of the world instead of living in side menus.
                </div>
            </div>
        </div>

        <div class="village-overlay overlay-bottom-right">
            <div class="overlay-card village-building-card @(_selectedBuilding is null ? "is-empty" : string.Empty)">
                <div class="overlay-card-title">Selected Place</div>
                @if (_selectedBuilding is null)
                {
                    <div class="overlay-card-body">Walk around and click a building to inspect it.</div>
                }
                else
                {
                    <div class="sidebar-building-name">@_selectedBuilding.Name</div>
                    @if (!string.IsNullOrWhiteSpace(_selectedBuilding.Hint))
                    {
                        <div class="overlay-card-body">@_selectedBuilding.Hint</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_selectedBuilding.ChannelName))
                    {
                        <div class="sidebar-meta">Linked to @(_selectedBuilding.ChannelName)</div>
                    }
                    <div class="overlay-button-column">
                        @if (_selectedBuilding.InteriorMapId is not null)
                        {
                            <button class="v-btn" @onclick="EnterSelectedBuildingAsync">Enter Interior</button>
                        }
                        @if (_selectedBuilding.ChannelId is not null)
                        {
                            <button class="v-btn secondary" @onclick="OpenSelectedChannelAsync">Open Linked Channel</button>
                        }
                        @if (CanHostVoice(_selectedBuilding) && _activeVoiceBuildingId != _selectedBuilding.Id)
                        {
                            <button class="v-btn secondary" @onclick="() => JoinBuildingVoiceAsync(_selectedBuilding)">Join Voice Here</button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private readonly string _canvasId = $"village-canvas-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private IJSObjectReference? _runtime;
    private DotNetObjectReference<VillageWindowComponent>? _selfRef;
    private VillagePocScene? _scene;
    private VillagePocMap? _currentMap;
    private VillagePocBuilding? _selectedBuilding;
    private bool _loading = true;
    private bool _initializing;
    private bool _disposed;
    private string? _error;
    private bool _proximityVoice;
    private bool _autoJoinVoice;
    private long? _currentBuildingId;
    private long? _activeVoiceBuildingId;
    private string? _activeVoiceBuildingName;

    protected override async Task OnInitializedAsync()
    {
        Instances.Add(this);
        SelectionsChanged?.Invoke();

        _loading = true;
        _error = null;

        if (Data is null)
        {
            _error = "Village demo could not resolve the target planet.";
            _loading = false;
            await ReRender();
            return;
        }

        var result = await VillageService.FetchProofOfConceptSceneAsync(Data.Id);
        if (!result.Success || result.Data is null)
        {
            _error = result.Message ?? "Village demo failed to load.";
            _loading = false;
            await ReRender();
            return;
        }

        _scene = result.Data;
        _currentMap = _scene.Maps.FirstOrDefault(x => x.Id == _scene.StartingMapId);
        _loading = false;
        await ReRender();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scene is null || _error is not null || _runtime is not null || _initializing || _disposed)
            return;

        // The scene arrives after the first render, so we cannot key off firstRender.
        // _runtime is only assigned after two awaits, so it cannot guard re-entry on its own.
        _initializing = true;
        try
        {
            _selfRef = DotNetObjectReference.Create(this);
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Valour.Client/Components/Windows/Villages/VillageWindowComponent.razor.js");

            if (_disposed)
                return;

            _runtime = await _module.InvokeAsync<IJSObjectReference>("init", _canvasId, _selfRef, _scene);

            if (_disposed)
            {
                await ShutdownRuntimeAsync();
                return;
            }

            VillageService.PresenceChanged += OnPresenceChanged;
            MessageService.MessageReceived += OnMessageReceived;
            await JoinCurrentMapAsync();
        }
        finally
        {
            _initializing = false;
        }
    }

    [JSInvokable]
    public async Task OnBuildingSelected(long? buildingId, long currentMapId)
    {
        if (_scene is null || _disposed)
            return;

        _currentMap = _scene.Maps.FirstOrDefault(x => x.Id == currentMapId) ?? _currentMap;
        _selectedBuilding = _scene.Maps
            .SelectMany(x => x.Buildings)
            .FirstOrDefault(x => x.Id == buildingId);
        await ReRender();
    }

    [JSInvokable]
    public async Task OnMapChanged(long mapId)
    {
        if (_scene is null || _disposed)
            return;

        _currentMap = _scene.Maps.FirstOrDefault(x => x.Id == mapId) ?? _currentMap;

        // Stepping back outside clears the inspector; the building panel only makes
        // sense while its own interior is the active map.
        if (_currentMap?.MapKind == "Outdoor" && _selectedBuilding?.InteriorMapId != mapId)
            _selectedBuilding = null;

        // Presence is per-map, so stepping through a door moves us between
        // realtime groups as well as between maps.
        await JoinCurrentMapAsync();
        await ReRender();
    }

    /// <summary>
    /// Announces us on the map we are standing on and seeds everyone already
    /// there. Called on open and again whenever we walk through a door, since
    /// presence is scoped per map rather than per planet.
    /// </summary>
    private async Task JoinCurrentMapAsync()
    {
        if (Data is null || _currentMap is null || _disposed)
            return;

        var spawn = _currentMap.SpawnTile;
        await VillageService.JoinMapAsync(Data, _currentMap.Id, spawn?.X ?? 0, spawn?.Y ?? 0);
        await PushPresencesAsync();
    }

    /// <summary>
    /// Surfaces chat as a bubble above the speaker, but only for people who are
    /// actually standing in this village. A planet's channels carry far more
    /// traffic than the map has occupants, so anything else would be noise from
    /// members who are not even here.
    /// </summary>
    private void OnMessageReceived(Message message)
    {
        if (_disposed || _runtime is null || message is null)
            return;

        if (string.IsNullOrWhiteSpace(message.Content))
            return;

        // Only chat from the room the member is standing in, plus their own
        // messages, belongs on the map.
        if (!IsMessageAudibleHere(message))
            return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await _runtime.InvokeVoidAsync("pushBubble", message.AuthorUserId, message.Content);
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        });
    }

    private bool IsMessageAudibleHere(Message message)
    {
        var isLocal = message.AuthorUserId == Client.Me?.Id;
        var speakerIsHere = isLocal || VillageService.Presences.Any(x => x.UserId == message.AuthorUserId);

        if (!speakerIsHere)
            return false;

        // A message counts when it was sent in the channel bound to the building
        // the speaker is standing in.
        var speakerBuildingId = isLocal
            ? _currentBuildingId
            : VillageService.Presences.FirstOrDefault(x => x.UserId == message.AuthorUserId)?.BuildingId;

        if (speakerBuildingId is null)
            return false;

        var building = _scene?.Maps
            .SelectMany(x => x.Buildings)
            .FirstOrDefault(x => x.Id == speakerBuildingId);

        return building?.ChannelId == message.ChannelId;
    }

    private void OnPresenceChanged()
    {
        // Fired from the hub, so hop back onto the renderer's context.
        _ = InvokeAsync(async () => await PushPresencesAsync());
    }

    /// <summary>
    /// Hands the current occupancy to the canvas runtime. The runtime owns
    /// interpolation, so it receives target tiles rather than pixel positions.
    /// </summary>
    private async Task PushPresencesAsync()
    {
        if (_runtime is null || _disposed)
            return;

        var others = VillageService.Presences
            .Select(x => new
            {
                userId = x.UserId,
                name = x.Name,
                avatarUrl = x.AvatarUrl,
                x = x.X,
                y = x.Y,
                facing = (int)x.Facing,
                buildingId = x.BuildingId,
            })
            .ToArray();

        try
        {
            await _runtime.InvokeVoidAsync("setPresences", others);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    /// <summary>
    /// Called by the runtime each time the local player finishes a step.
    /// </summary>
    [JSInvokable]
    public async Task OnLocalMoved(int x, int y, int facing, long? buildingId)
    {
        if (_disposed)
            return;

        VillageService.ReportMove(x, y, (VillageFacing)facing, buildingId);

        if (buildingId == _currentBuildingId)
            return;

        _currentBuildingId = buildingId;
        await OnBuildingContextChangedAsync();
    }

    /// <summary>
    /// A building can host voice when it is bound to a real channel. Rooms that
    /// spin up on demand need an ephemeral-channel concept that does not exist
    /// yet, so those are treated as not hosting rather than silently doing
    /// nothing on entry.
    /// </summary>
    private bool CanHostVoice(VillagePocBuilding building) => building.ChannelId is not null;

    /// <summary>
    /// Walking in or out of a building follows the voice room, but only once the
    /// member has opted in. Joining a call the moment someone wanders through a
    /// door would open their microphone without them asking.
    /// </summary>
    private async Task OnBuildingContextChangedAsync()
    {
        if (!_autoJoinVoice)
            return;

        var building = _currentBuildingId is null
            ? null
            : _scene?.Maps.SelectMany(x => x.Buildings).FirstOrDefault(x => x.Id == _currentBuildingId);

        if (building is null || !CanHostVoice(building))
        {
            if (_activeVoiceBuildingId is not null)
                await LeaveVoiceAsync();

            return;
        }

        if (_activeVoiceBuildingId == building.Id)
            return;

        await JoinBuildingVoiceAsync(building);
    }

    private async Task JoinBuildingVoiceAsync(VillagePocBuilding building)
    {
        if (Data is null || building.ChannelId is null)
            return;

        var channel = await Data.FetchChannelAsync(building.ChannelId.Value);
        if (channel is null)
            return;

        await CallSession.InitializeAsync(channel, videoMode: false);

        _activeVoiceBuildingId = building.Id;
        _activeVoiceBuildingName = building.Name;
        await ReRender();
    }

    private async Task LeaveVoiceAsync()
    {
        _activeVoiceBuildingId = null;
        _activeVoiceBuildingName = null;

        await CallSession.LeaveAsync(clearChannel: true);
        await ReRender();
    }

    private async Task OnToggleProximityVoice(ChangeEventArgs e)
    {
        _proximityVoice = e.Value is true;

        if (_runtime is not null)
            await _runtime.InvokeVoidAsync("setSpatialAudioEnabled", _proximityVoice);
    }

    private async Task OnToggleAutoJoin(ChangeEventArgs e)
    {
        _autoJoinVoice = e.Value is true;

        // Entering the toggle while already standing inside a room should take
        // effect immediately rather than on the next step.
        await OnBuildingContextChangedAsync();
    }

    private async Task ResetViewAsync()
    {
        if (_runtime is not null)
            await _runtime.InvokeVoidAsync("resetView");
    }

    private async Task ReturnOutsideAsync()
    {
        if (_runtime is not null && _scene is not null)
            await _runtime.InvokeVoidAsync("setMap", _scene.StartingMapId);
    }

    private async Task EnterSelectedBuildingAsync()
    {
        if (_runtime is null || _selectedBuilding?.InteriorMapId is null)
            return;

        await _runtime.InvokeVoidAsync("setMap", _selectedBuilding.InteriorMapId.Value);
    }

    private async Task OpenSelectedChannelAsync()
    {
        if (_selectedBuilding?.ChannelId is null || Data is null)
            return;

        Channel? channel = await Data.FetchChannelAsync(_selectedBuilding.ChannelId.Value);
        if (channel is null)
            return;

        var content = await ChatWindowComponent.GetDefaultContent(channel);
        await WindowService.OpenWindowAtFocused(content);
    }

    /////////////////////////////
    // Open-selection registry //
    /////////////////////////////

    // Lets the channel list highlight the village row while a village window for
    // the planet is open. Blazor WASM is single-threaded, so a plain list is safe.
    private static readonly List<VillageWindowComponent> Instances = new();

    /// <summary>
    /// Fired whenever any village window opens or closes
    /// </summary>
    public static event Action SelectionsChanged;

    /// <summary>
    /// True while any village window for this planet is open - drives the
    /// channel-list row's open highlight
    /// </summary>
    public static bool IsOpenForPlanet(long planetId)
    {
        foreach (var window in Instances)
        {
            if (window.Data?.Id == planetId)
                return true;
        }

        return false;
    }

    public class SavedState
    {
        public long PlanetId { get; set; }
    }

    public class Content : WindowContent<VillageWindowComponent, Planet>
    {
        public override async Task ImportData(string data, ValourClient client)
        {
            var saved = JsonSerializer.Deserialize<SavedState>(data);
            if (saved is null)
                return;

            Data = await client.PlanetService.FetchPlanetAsync(saved.PlanetId);
        }

        public override string ExportData(ValourClient client)
        {
            if (Data is null)
                return string.Empty;

            return JsonSerializer.Serialize(new SavedState
            {
                PlanetId = Data.Id
            });
        }
    }

    public static Content GetDefaultContent(Planet planet)
    {
        return new Content
        {
            Data = planet,
            PlanetId = planet.Id,
            Icon = planet.GetIconUrl(IconFormat.Webp128),
            Title = $"{planet.Name} Village"
        };
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        VillageService.PresenceChanged -= OnPresenceChanged;
        MessageService.MessageReceived -= OnMessageReceived;
        await VillageService.LeaveMapAsync();

        // Closing the village must not leave the member sitting in a call they
        // can no longer see.
        if (_activeVoiceBuildingId is not null)
            await CallSession.LeaveAsync(clearChannel: true);

        if (Instances.Remove(this))
            SelectionsChanged?.Invoke();

        await ShutdownRuntimeAsync();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }

            _module = null;
        }

        _selfRef?.Dispose();
        _selfRef = null;
    }

    /// <summary>
    /// Tears down the JS runtime. The runtime owns a rAF loop and window-level key
    /// listeners, so releasing the .NET reference alone would leave both running
    /// against a detached canvas for the lifetime of the page.
    /// </summary>
    private async ValueTask ShutdownRuntimeAsync()
    {
        if (_runtime is null)
            return;

        var runtime = _runtime;
        _runtime = null;

        try
        {
            await runtime.InvokeVoidAsync("dispose");
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }

        try
        {
            await runtime.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
