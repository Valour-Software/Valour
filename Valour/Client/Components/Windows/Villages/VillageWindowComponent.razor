@inherits WindowContentComponent<Planet>
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject Valour.Sdk.Services.VillageService VillageService
@inject Valour.Client.Components.Calls.GlobalCallSessionService CallSession
@inject Valour.Sdk.Services.MessageService MessageService
@inject ValourClient Client
@inject Valour.Client.Storage.IAppStorage LocalStorage
@using System.Text.Json
@using Valour.Shared.Models
@using Valour.Shared.Villages
@using Channel = Valour.Sdk.Models.Channel

@if (_loading)
{
    <Loading Title="Loading village..." Spin="@true" />
}
else if (_error is not null)
{
    <div class="village-empty-state" role="alert">
        <i aria-hidden="true" class="bi bi-exclamation-triangle-fill"></i>
        <span>@_error</span>
        @if (Data?.EnableVillage == true)
        {
            <button class="v-btn" disabled="@_loading" @onclick="RetryLoadAsync">
                <i aria-hidden="true" class="bi bi-arrow-clockwise"></i> Retry
            </button>
        }
    </div>
}
else
{
    <div class="village-window @(_buildMode ? "build-mode-active" : string.Empty) @(_adminMode ? "admin-mode-active" : string.Empty) @(HandheldControlsVisible ? "handheld-controls-active" : string.Empty)">
        <canvas id="@_canvasId"
                class="village-canvas"
                tabindex="0"
                role="application"
                aria-label="Interactive village map"
                aria-describedby="@_canvasInstructionsId"
                aria-keyshortcuts="W A S D ArrowUp ArrowDown ArrowLeft ArrowRight"></canvas>
        <span id="@_canvasInstructionsId" class="village-sr-only">
            Use W A S D or the arrow keys to move. Use the Places button to inspect buildings and parcels without the pointer.
        </span>

        @if (!_presenceConnected)
        {
            <div class="village-connection-banner" role="status" aria-live="polite">
                <i aria-hidden="true" class="bi bi-wifi-off"></i>
                <span>@(_presenceConnecting ? "Connecting to village presence…" : _presenceError ?? "Village presence is offline.")</span>
                <button disabled="@_presenceConnecting" @onclick="RetryPresenceAsync">
                    <i aria-hidden="true" class="bi bi-arrow-clockwise"></i>
                    <span>@(_presenceConnecting ? "Connecting…" : "Retry")</span>
                </button>
            </div>
        }

        <div class="village-topbar">
        <div class="village-overlay village-world-header">
            <div class="overlay-card village-brand-card @(_currentMap?.MapKind == "Interior" || _buildMode ? "compact" : string.Empty)">
                <div class="village-kicker">Valour Village</div>
                <div class="village-title">@_scene!.Title</div>
                <div class="village-subtitle">@_scene.Subtitle</div>
            </div>
            <div class="overlay-inline-group">
                <span class="hud-chip"><i aria-hidden="true" class="bi bi-geo-alt-fill"></i> @(_currentMap?.Name ?? "Unknown Map")</span>
                <span class="hud-chip @(_presenceConnected ? "live" : "offline")">
                    <span class="live-dot"></span>
                    @(_presenceConnected ? $"{VillageService.Presences.Count + 1} here" : "Presence offline")
                </span>
            </div>
        </div>

        <div class="village-overlay village-quick-controls">
            <div class="quick-control-bar">
                <button class="village-icon-button @(_placesPanelOpen ? "active" : string.Empty)"
                        @onclick="TogglePlacesPanel"
                        title="Browse places"
                        aria-label="Browse village places"
                        aria-expanded="@_placesPanelOpen"
                        aria-controls="@_placesPanelId">
                    <i aria-hidden="true" class="bi bi-list-ul"></i>
                </button>
                @if (DeviceInfo.IsMobile)
                {
                    <button class="village-icon-button @(_handheldControls ? "active" : string.Empty)"
                            @onclick="ToggleHandheldControlsAsync"
                            title="@(_handheldControls ? "Use floating joystick" : "Use handheld controls")"
                            aria-label="@(_handheldControls ? "Switch to floating joystick controls" : "Switch to handheld controls")"
                            aria-pressed="@_handheldControls">
                        <i aria-hidden="true" class="bi bi-controller"></i>
                    </button>
                }
                @if (CanBuildCurrentMap)
                {
                    <button class="village-icon-button @(_buildMode ? "active" : string.Empty)"
                            @onclick="ToggleBuildModeAsync"
                            title="@(_buildMode ? "Close build mode" : "Furnish and paint")"
                            aria-label="@(_buildMode ? "Close build mode" : "Open build mode")">
                        <i aria-hidden="true" class="bi bi-hammer"></i>
                    </button>
                }
                @if (_scene?.CanManageVillage == true)
                {
                    <button class="village-icon-button @(_adminMode ? "active" : string.Empty)"
                            @onclick="ToggleAdminModeAsync"
                            title="Village administration" aria-label="Open village administration">
                        <i aria-hidden="true" class="bi bi-shield-lock-fill"></i>
                    </button>
                }
                <div class="village-zoom-control" role="group" aria-label="Map zoom">
                    <button class="village-zoom-button"
                            disabled="@(_zoomPercent <= 50)"
                            @onclick="ZoomOutAsync"
                            title="Zoom out (or scroll down)"
                            aria-label="Zoom out">
                        <i aria-hidden="true" class="bi bi-dash-lg"></i>
                    </button>
                    <button class="village-zoom-level"
                            @onclick="ResetZoomAsync"
                            title="Reset zoom to 100%"
                            aria-label="Reset zoom to 100 percent">
                        @_zoomPercent%
                    </button>
                    <button class="village-zoom-button"
                            disabled="@(_zoomPercent >= 200)"
                            @onclick="ZoomInAsync"
                            title="Zoom in (or scroll up)"
                            aria-label="Zoom in">
                        <i aria-hidden="true" class="bi bi-plus-lg"></i>
                    </button>
                </div>
                @if (_currentMap?.MapKind == "Interior")
                {
                    <button class="village-icon-button" @onclick="ReturnOutsideAsync" title="Leave building" aria-label="Leave building">
                        <i aria-hidden="true" class="bi bi-door-open-fill"></i>
                    </button>
                }
                @if (CurrentSpaceCanHostVoice)
                {
                    <button class="village-icon-button voice-space-button @(IsVoiceActiveHere ? "active" : string.Empty)"
                            @onclick="ToggleCurrentVoiceAsync"
                            title="@(IsVoiceActiveHere ? "Leave nearby voice" : $"Join nearby voice in {CurrentSpaceName}")"
                            aria-label="@(IsVoiceActiveHere ? "Leave nearby voice" : $"Join nearby voice in {CurrentSpaceName}")"
                            aria-pressed="@IsVoiceActiveHere">
                        <i aria-hidden="true" class="bi @(IsVoiceActiveHere ? "bi-telephone-x-fill" : "bi-headset")"></i>
                    </button>
                }
                <label class="village-icon-toggle @(_proximityVoice ? "active" : string.Empty)"
                       title="Spatial sound: nearby voices are louder and voices beyond 16 tiles fade out">
                    <input type="checkbox" checked="@_proximityVoice" @onchange="OnToggleProximityVoice" />
                    <i aria-hidden="true" class="bi bi-soundwave"></i>
                    <span>Spatial sound</span>
                </label>
                <label class="village-icon-toggle @(_autoJoinVoice ? "active" : string.Empty)" title="Automatically follow nearby voice between village spaces">
                    <input type="checkbox" checked="@_autoJoinVoice" @onchange="OnToggleAutoJoin" />
                    <i aria-hidden="true" class="bi bi-mic-fill"></i>
                    <span>Auto join</span>
                </label>
            </div>
        </div>

        </div>

        @if (_placesPanelOpen && !_buildMode && !_adminMode)
        {
            <aside id="@_placesPanelId" class="village-places-panel" aria-label="Places on this map">
                <div class="places-panel-header">
                    <div>
                        <span class="eyebrow">Places</span>
                        <strong>@(_currentMap?.Name ?? "Map")</strong>
                    </div>
                    <button class="village-icon-button compact" @onclick="TogglePlacesPanel" title="Close places" aria-label="Close places">
                        <i aria-hidden="true" class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div class="places-panel-list">
                    @if (ParentBuilding is { } parentBuilding)
                    {
                        <button class="place-list-item" @onclick="() => SelectBuildingFromPlacesAsync(parentBuilding)">
                            <i aria-hidden="true" class="bi bi-house-gear"></i>
                            <span><strong>@parentBuilding.Name</strong><small>Room settings · channels and ownership</small></span>
                        </button>
                    }
                    @foreach (var building in _currentMap?.Buildings ?? [])
                    {
                        <button class="place-list-item @(_selectedBuilding?.Id == building.Id ? "active" : string.Empty)"
                                aria-pressed="@(_selectedBuilding?.Id == building.Id)"
                                @onclick="() => SelectBuildingFromPlacesAsync(building)">
                            <i aria-hidden="true" class="bi bi-building-fill"></i>
                            <span><strong>@building.Name</strong><small>@(building.Hint ?? "Building")</small></span>
                        </button>
                    }
                    @foreach (var plot in _currentMap?.Plots ?? [])
                    {
                        <button class="place-list-item @(_selectedPlot?.Id == plot.Id ? "active" : string.Empty)"
                                aria-pressed="@(_selectedPlot?.Id == plot.Id)"
                                @onclick="() => SelectPlotFromPlacesAsync(plot)">
                            <i aria-hidden="true" class="bi bi-bounding-box"></i>
                            <span><strong>@plot.Name</strong><small>Land parcel · @plot.Width × @plot.Height tiles</small></span>
                        </button>
                    }
                    @if (ParentBuilding is null && (_currentMap?.Buildings.Count ?? 0) == 0 && (_currentMap?.Plots.Count ?? 0) == 0)
                    {
                        <div class="places-panel-empty">There are no named places on this map yet.</div>
                    }
                </div>
            </aside>
        }

        @if (_activeVoiceChannel is not null)
        {
            <aside class="village-nearby-people" aria-label="Nearby call">
                <CallPanelComponent @key="_activeVoiceChannel.Id"
                                    Channel="_activeVoiceChannel"
                                    VideoMode="_activeVoiceVideoMode"
                                    NearbyMode="true"
                                    IsNearbyUser="IsUserInHearingRange" />
            </aside>
        }

        @if (!_buildMode && !_adminMode && (_selectedBuilding is not null || _selectedPlot is not null))
        {
            <aside class="village-overlay village-inspector">
                <div class="overlay-card village-building-card">
                    @if (_selectedBuilding is not null)
                    {
                        <div class="inspector-heading">
                            <div class="place-icon"><i aria-hidden="true" class="bi bi-building-fill"></i></div>
                            <div>
                                <div class="overlay-card-title">Place</div>
                                <div class="sidebar-building-name">@_selectedBuilding.Name</div>
                            </div>
                            <button class="village-icon-button compact" @onclick="ClearPlaceSelectionAsync" aria-label="Close place details" title="Close place details"><i aria-hidden="true" class="bi bi-x-lg"></i></button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_selectedBuilding.Hint))
                        {
                            <div class="overlay-card-body">@_selectedBuilding.Hint</div>
                        }
                        <div class="place-facts">
                            @if (_selectedBuilding.IsOwnedByLocalMember)
                            {
                                <span class="place-fact owned"><i aria-hidden="true" class="bi bi-key-fill"></i> Yours</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(_selectedBuilding.OwnerName))
                            {
                                <span class="place-fact"><i aria-hidden="true" class="bi bi-person-fill"></i> @_selectedBuilding.OwnerName</span>
                            }
                            else
                            {
                                <span class="place-fact"><i aria-hidden="true" class="bi bi-people-fill"></i> Community property</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(_selectedBuilding.ChannelName))
                            {
                                <span class="place-fact"><i aria-hidden="true" class="bi bi-hash"></i> @_selectedBuilding.ChannelName</span>
                            }
                            else if (_selectedBuilding.VoiceMode == VillageVoiceMode.AutoRoom)
                            {
                                <span class="place-fact"><i aria-hidden="true" class="bi bi-stars"></i> Private area room</span>
                            }
                            @if (_selectedBuilding.ForSale)
                            {
                                <span class="place-fact sale"><i aria-hidden="true" class="bi bi-tag-fill"></i> @FormatPrice(_selectedBuilding.Price)</span>
                            }
                        </div>
                        @if (CanEditProperty(_selectedBuilding.IsOwnedByLocalMember))
                        {
                            <button class="manage-toggle @(_editingProperty ? "open" : string.Empty)" @onclick="ToggleEditProperty">
                                <i aria-hidden="true" class="bi bi-gear-fill"></i>
                                @(_editingProperty ? "Close manage panel" : "Manage this building")
                            </button>
                        }
                        @if (_editingProperty && CanEditProperty(_selectedBuilding.IsOwnedByLocalMember))
                        {
                            <div class="manage-editor">
                                <label class="manage-field">
                                    <span>Name</span>
                                    <input maxlength="48"
                                           value="@_editName"
                                           @oninput="e => _editName = e.Value?.ToString() ?? string.Empty"
                                           aria-label="Building name" />
                                </label>
                                <label class="manage-field">
                                    <span>Description</span>
                                    <textarea maxlength="256"
                                              rows="2"
                                              value="@_editDescription"
                                              @oninput="e => _editDescription = e.Value?.ToString() ?? string.Empty"
                                              aria-label="Building description"></textarea>
                                </label>
                                @if (_scene?.CanManageVillage == true)
                                {
                                    <label class="manage-field">
                                        <span>Linked channel</span>
                                        <select value="@_editChannelValue"
                                                @onchange="e => _editChannelValue = e.Value?.ToString() ?? string.Empty"
                                                aria-label="Linked channel">
                                            <option value="">None — private area room</option>
                                            @foreach (var channel in GetLinkableChannels())
                                            {
                                                <option value="@channel.Id">@ChannelOptionLabel(channel)</option>
                                            }
                                        </select>
                                    </label>
                                }
                                <button class="v-btn secondary"
                                        disabled="@_editInProgress"
                                        @onclick="SaveSelectedBuildingEditsAsync">
                                    @(_editInProgress ? "Saving…" : "Save changes")
                                </button>
                            </div>
                        }
                        @if (CanEditProperty(_selectedBuilding.IsOwnedByLocalMember))
                        {
                            <div class="listing-editor">
                                <div class="listing-price-field">
                                    <span>@(_scene?.CurrencySymbol ?? string.Empty)</span>
                                    <input type="number"
                                           min="0"
                                           step="any"
                                           value="@_listingPriceText"
                                           @oninput="OnListingPriceChanged"
                                           aria-label="Building sale price" />
                                </div>
                                <button class="v-btn secondary"
                                        disabled="@_listingInProgress"
                                        @onclick="() => SetSelectedBuildingListingAsync(true)">
                                    @(_selectedBuilding.ForSale ? "Update listing" : "List for sale")
                                </button>
                                @if (_selectedBuilding.ForSale)
                                {
                                    <button class="listing-remove" @onclick="() => SetSelectedBuildingListingAsync(false)">Remove</button>
                                }
                            </div>
                        }
                        <div class="overlay-button-column">
                            @if (_selectedBuilding.ForSale && !_selectedBuilding.IsOwnedByLocalMember)
                            {
                                <button class="v-btn village-primary-action"
                                        disabled="@_purchaseInProgress"
                                        @onclick="ConfirmPurchaseSelectedBuilding">
                                    <i aria-hidden="true" class="bi bi-bag-check-fill"></i>
                                    @(_purchaseInProgress ? "Completing purchase…" : $"Buy for {FormatPrice(_selectedBuilding.Price)}")
                                </button>
                            }
                            @if (_selectedBuilding.InteriorMapId is not null && _selectedBuilding.InteriorMapId != _currentMap?.Id)
                            {
                                <button class="v-btn" @onclick="EnterSelectedBuildingAsync">
                                    <i aria-hidden="true" class="bi bi-door-open-fill"></i> Enter
                                </button>
                            }
                            @if (CanOpenChat(_selectedBuilding))
                            {
                                <button class="v-btn secondary" @onclick="OpenSelectedChannelAsync">
                                    <i aria-hidden="true" class="bi bi-chat-left-text-fill"></i>
                                    @(_selectedBuilding.ChannelId is null ? "Open area chat" : "Open channel")
                                </button>
                            }
                            @if (CanJoinVoiceFromHere(_selectedBuilding) && _activeVoiceBuildingId != _selectedBuilding.Id)
                            {
                                <button class="v-btn secondary" @onclick="() => JoinBuildingVoiceAsync(_selectedBuilding)">
                                    <i aria-hidden="true" class="bi bi-headset"></i> Join meeting here
                                </button>
                            }
                        </div>
                    }
                    else if (_selectedPlot is not null)
                    {
                        <div class="inspector-heading">
                            <div class="place-icon plot"><i aria-hidden="true" class="bi bi-bounding-box"></i></div>
                            <div>
                                <div class="overlay-card-title">Land parcel</div>
                                <div class="sidebar-building-name">@_selectedPlot.Name</div>
                            </div>
                            <button class="village-icon-button compact" @onclick="ClearPlaceSelectionAsync" aria-label="Close place details" title="Close place details"><i aria-hidden="true" class="bi bi-x-lg"></i></button>
                        </div>
                        <div class="place-facts">
                            <span class="place-fact"><i aria-hidden="true" class="bi bi-aspect-ratio-fill"></i> @_selectedPlot.Width × @_selectedPlot.Height tiles</span>
                            @if (_selectedPlot.IsOwnedByLocalMember)
                            {
                                <span class="place-fact owned"><i aria-hidden="true" class="bi bi-key-fill"></i> Yours</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(_selectedPlot.OwnerName))
                            {
                                <span class="place-fact"><i aria-hidden="true" class="bi bi-person-fill"></i> @_selectedPlot.OwnerName</span>
                            }
                            else
                            {
                                <span class="place-fact"><i aria-hidden="true" class="bi bi-people-fill"></i> Community land</span>
                            }
                            @if (_selectedPlot.ForSale)
                            {
                                <span class="place-fact sale"><i aria-hidden="true" class="bi bi-tag-fill"></i> @FormatPrice(_selectedPlot.Price)</span>
                            }
                        </div>
                        @if (CanEditProperty(_selectedPlot.IsOwnedByLocalMember))
                        {
                            <button class="manage-toggle @(_editingProperty ? "open" : string.Empty)" @onclick="ToggleEditProperty">
                                <i aria-hidden="true" class="bi bi-gear-fill"></i>
                                @(_editingProperty ? "Close manage panel" : "Manage this parcel")
                            </button>
                        }
                        @if (_editingProperty && CanEditProperty(_selectedPlot.IsOwnedByLocalMember))
                        {
                            <div class="manage-editor">
                                <label class="manage-field">
                                    <span>Name</span>
                                    <input maxlength="48"
                                           value="@_editName"
                                           @oninput="e => _editName = e.Value?.ToString() ?? string.Empty"
                                           aria-label="Parcel name" />
                                </label>
                                <button class="v-btn secondary"
                                        disabled="@_editInProgress"
                                        @onclick="SaveSelectedPlotEditsAsync">
                                    @(_editInProgress ? "Saving…" : "Save changes")
                                </button>
                            </div>
                        }
                        @if (CanEditProperty(_selectedPlot.IsOwnedByLocalMember))
                        {
                            <div class="listing-editor">
                                <div class="listing-price-field">
                                    <span>@(_scene?.CurrencySymbol ?? string.Empty)</span>
                                    <input type="number"
                                           min="0"
                                           step="any"
                                           value="@_listingPriceText"
                                           @oninput="OnListingPriceChanged"
                                           aria-label="Parcel sale price" />
                                </div>
                                <button class="v-btn secondary"
                                        disabled="@_listingInProgress"
                                        @onclick="() => SetSelectedPlotListingAsync(true)">
                                    @(_selectedPlot.ForSale ? "Update listing" : "List for sale")
                                </button>
                                @if (_selectedPlot.ForSale)
                                {
                                    <button class="listing-remove" @onclick="() => SetSelectedPlotListingAsync(false)">Remove</button>
                                }
                            </div>
                        }
                        @if (_selectedPlot.ForSale && !_selectedPlot.IsOwnedByLocalMember)
                        {
                            <button class="v-btn village-primary-action"
                                    disabled="@_purchaseInProgress"
                                    @onclick="ConfirmPurchaseSelectedPlot">
                                <i aria-hidden="true" class="bi bi-bag-check-fill"></i>
                                @(_purchaseInProgress ? "Claiming parcel…" : $"Claim for {FormatPrice(_selectedPlot.Price)}")
                            </button>
                        }
                    }
                </div>
            </aside>
        }

        @if (_adminMode)
        {
            <aside class="village-admin-panel" aria-label="Village administration">
                <div class="build-panel-header">
                    <div><span class="eyebrow">Village admin</span><strong>@(_currentMap?.Name ?? "Map")</strong></div>
                    <button class="village-icon-button compact" @onclick="ToggleAdminModeAsync" title="Close admin panel"><i aria-hidden="true" class="bi bi-x-lg"></i></button>
                </div>
                <div class="admin-panel-body">
                    <section class="admin-section">
                        <div class="admin-section-heading">
                            <div><strong>Parcels</strong><small>Editable land regions</small></div>
                            <button class="admin-primary @(_adminDrawing ? "active" : string.Empty)" @onclick="BeginParcelDrawAsync">
                                <i aria-hidden="true" class="bi bi-bounding-box-circles"></i> @(_adminDrawing ? "Drag on map…" : "Draw parcel")
                            </button>
                        </div>
                        <div class="admin-parcel-list">
                            @foreach (var plot in _currentMap?.Plots ?? [])
                            {
                                <button class="admin-parcel-row @(_adminSelectedPlotId == plot.Id ? "active" : string.Empty)" @onclick="() => SelectAdminPlotAsync(plot)">
                                    <span>@plot.Name</span><small>@plot.Width×@plot.Height at @plot.X,@plot.Y</small>
                                </button>
                            }
                            @if ((_currentMap?.Plots.Count ?? 0) == 0)
                            {
                                <div class="admin-empty">No parcels yet. Draw one directly on the map.</div>
                            }
                        </div>
                    </section>
                    @if (AdminSelectedPlot is not null)
                    {
                        <section class="admin-section admin-properties">
                            <label><span>Name</span><input maxlength="48" @bind="_adminPlotName" /></label>
                            <div class="admin-geometry-grid">
                                <label><span>X</span><input type="number" min="0" @bind="_adminPlotX" /></label>
                                <label><span>Y</span><input type="number" min="0" @bind="_adminPlotY" /></label>
                                <label><span>Width</span><input type="number" min="1" @bind="_adminPlotWidth" /></label>
                                <label><span>Height</span><input type="number" min="1" @bind="_adminPlotHeight" /></label>
                            </div>
                            <label><span>Who can edit</span>
                                <select @bind="_adminPlotEditMode">
                                    <option value="@VillageEditMode.Owner">Owner</option>
                                    <option value="@VillageEditMode.Everyone">Everyone</option>
                                    <option value="@VillageEditMode.Managers">Managers only</option>
                                </select>
                            </label>
                            <div class="admin-actions">
                                <button class="admin-primary" disabled="@_adminSaving" @onclick="SaveAdminPlotAsync">Save changes</button>
                                <button class="admin-danger" disabled="@_adminSaving" @onclick="ConfirmDeleteAdminPlot">Delete</button>
                            </div>
                        </section>
                    }
                    @if (!string.IsNullOrWhiteSpace(_adminStatus))
                    {
                        <div class="admin-status @(_adminStatusError ? "error" : string.Empty)">@_adminStatus</div>
                    }
                </div>
            </aside>
        }

        @if (_buildMode)
        {
            <aside class="village-build-panel" aria-label="Village build mode">
                <div class="build-panel-header">
                    <div>
                        <span class="eyebrow">Build mode</span>
                        <strong>@GetBuildScopeLabel()</strong>
                    </div>
                    <div class="build-panel-actions">
                        @if (_buildEditInProgress)
                        {
                            <span class="build-saving"><i aria-hidden="true" class="bi bi-arrow-repeat"></i> Saving</span>
                        }
                        <button class="village-icon-button compact" @onclick="ToggleBuildModeAsync" title="Done building">
                            <i aria-hidden="true" class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>

                <div class="build-tool-row" role="tablist" aria-label="Build tools">
                    <button class="@GetBuildToolClass("Furnish")" @onclick='() => SetBuildToolAsync("Furnish")'>
                        <i aria-hidden="true" class="bi bi-lamp-fill"></i><span>Furnish</span>
                    </button>
                    <button class="@GetBuildToolClass("Paint")" @onclick='() => SetBuildToolAsync("Paint")'>
                        <i aria-hidden="true" class="bi bi-paint-bucket"></i><span>Paint</span>
                    </button>
                    <button class="@GetBuildToolClass("Walls")" @onclick='() => SetBuildToolAsync("Walls")'>
                        <i aria-hidden="true" class="bi bi-bricks"></i><span>Walls</span>
                    </button>
                    <button class="@GetBuildToolClass("Pan")" @onclick='() => SetBuildToolAsync("Pan")'>
                        <i aria-hidden="true" class="bi bi-hand-index"></i><span>Pan</span>
                    </button>
                    <button class="@GetBuildToolClass("Move")" @onclick='() => SetBuildToolAsync("Move")'>
                        <i aria-hidden="true" class="bi bi-arrows-move"></i><span>Move</span>
                    </button>
                    <button class="@GetBuildToolClass("Erase")" @onclick='() => SetBuildToolAsync("Erase")'>
                        <i aria-hidden="true" class="bi bi-eraser-fill"></i><span>Erase</span>
                    </button>
                </div>

                @if (_buildTool is "Erase" or "Move" or "Pan")
                {
                    <div class="build-erase-hint">
                        <i aria-hidden="true" class="bi bi-cursor-fill"></i>
                        <span>@(_buildTool == "Pan" ? "Drag to explore the map. You can also hold Space and drag with any build tool." : _buildTool == "Move" ? "Select furniture, then click its new position. Press Escape to cancel." : "Select furniture, a wall, or a painted tile to remove it.")</span>
