    private string GetBuildPreviewStyle(VillagePocCatalogItem item)
        => GetBuildPreviewStyle(item.X, item.Y, item.Width, item.Height);

    private string GetBuildPreviewStyle(VillagePocTerrainItem item)
        => GetBuildPreviewStyle(item.X, item.Y, item.Width, item.Height);

    private string GetBuildBrushPreviewStyle(VillagePocBrushItem brush)
    {
        var tileSize = Math.Max(1, _scene?.BuildCatalogTileSize ?? 16);
        var sourceSize = Math.Max(1, brush.Size) * tileSize;
        var scale = Math.Min(2d, 52d / sourceSize);
        return string.Create(System.Globalization.CultureInfo.InvariantCulture,
            $"width:{sourceSize}px;height:{sourceSize}px;grid-template-columns:repeat({Math.Max(1, brush.Size)},{tileSize}px);grid-auto-rows:{tileSize}px;transform:translate(-50%,-50%) scale({scale:0.###});");
    }

    private string GetBuildBrushCellStyle(VillagePocBrushCell cell)
    {
        var definition = _scene?.BuildCatalog.FirstOrDefault(x => x.Key == cell.DefinitionKey);
        if (definition is null)
            return "visibility:hidden;";

        var tileSize = Math.Max(1, _scene?.BuildCatalogTileSize ?? 16);
        var image = (_scene?.BuildCatalogImageUrl ?? string.Empty)
            .Replace("'", "\\'", StringComparison.Ordinal);
        return string.Create(System.Globalization.CultureInfo.InvariantCulture,
            $"width:{tileSize}px;height:{tileSize}px;background-image:url('{image}');background-position:{-definition.X * tileSize}px {-definition.Y * tileSize}px;");
    }

    private string GetBuildPreviewStyle(int x, int y, int width, int height)
    {
        var tileSize = Math.Max(1, _scene?.BuildCatalogTileSize ?? 16);
        var sourceWidth = Math.Max(1, width) * tileSize;
        var sourceHeight = Math.Max(1, height) * tileSize;
        var scale = Math.Min(2d, 52d / Math.Max(sourceWidth, sourceHeight));
        var image = (_scene?.BuildCatalogImageUrl ?? string.Empty)
            .Replace("'", "\\'", StringComparison.Ordinal);

        return string.Create(System.Globalization.CultureInfo.InvariantCulture,
            $"width:{sourceWidth}px;height:{sourceHeight}px;background-image:url('{image}');background-position:{-x * tileSize}px {-y * tileSize}px;transform:translate(-50%,-50%) scale({scale:0.###});");
    }

    private async Task SyncBuildModeAsync()
    {
        if (_runtime is null)
            return;

        await _runtime.InvokeVoidAsync("setBuildMode", new
        {
            enabled = _buildMode,
            tool = _buildTool,
            definition = SelectedBuildPreviewItem,
            selectionKey = _selectedBuildKey,
            brush = SelectedBuildBrush,
        });
    }

    [JSInvokable]
    public async Task OnBuildTileSelected(int x, int y, string? objectIdRaw)
    {
        if (!_buildMode || _buildEditInProgress || Data is null || _currentMap is null)
            return;

        if (_buildTool == "Paint")
            return;

        var selectedItem = SelectedBuildItem;
        if (_buildTool == "Furnish" && selectedItem is null)
            return;

        var request = new VillageBuildRequest
        {
            Action = _buildTool == "Erase" ? VillageBuildAction.Erase : VillageBuildAction.Furnish,
            DefinitionKey = _buildTool == "Furnish" ? selectedItem?.Key : null,
            X = x,
            Y = y,
            ObjectId = ParseId(objectIdRaw),
        };

        await SubmitBuildRequestAsync(
            _currentMap,
            request,
            request.Action == VillageBuildAction.Erase
                ? "Item removed."
                : $"{selectedItem?.Name ?? "Item"} placed.");
    }

    [JSInvokable]
    public async Task OnBuildTerrainStrokeSelected(
        List<VillageBuildCell>? cells,
        string? selectionKey)
    {
        if (!_buildMode || _buildEditInProgress || Data is null || _currentMap is null ||
            cells is null || cells.Count == 0)
        {
            return;
        }

        var terrain = _scene?.BuildTerrains.FirstOrDefault(x => x.Key == selectionKey);
        var brush = _scene?.BuildBrushes.FirstOrDefault(x => x.Key == selectionKey);
        if (terrain is null && brush is null)
            return;

        await SubmitBuildRequestAsync(
            _currentMap,
            new VillageBuildRequest
            {
                Action = VillageBuildAction.Paint,
                TerrainKey = terrain?.Key,
                BrushKey = brush?.Key,
                Cells = cells,
                X = cells[0].X,
                Y = cells[0].Y,
            },
            brush is not null
                ? $"{brush.Name} stamped {cells.Count} time{(cells.Count == 1 ? string.Empty : "s")} as an exact manual pattern."
                : $"{terrain!.Name} painted across {cells.Count} tile{(cells.Count == 1 ? string.Empty : "s")} with connected edges.");
    }

    private async Task SubmitBuildRequestAsync(
        VillagePocMap map,
        VillageBuildRequest request,
        string successStatus)
    {
        if (Data is null)
            return;

        _buildEditInProgress = true;
        _buildStatus = "Saving…";
        await ReRender();

        // Suppress the realtime echo before sending; it can arrive a few
        // milliseconds before the HTTP response that carries the same delta.
        _ignoreObjectRefreshUntil = DateTime.UtcNow.AddSeconds(1);
        TaskResult<VillageBuildResult>? result = null;
        try
        {
            result = await VillageService.EditMapAsync(Data, map.Id, request);
        }
        catch
        {
            // The JavaScript caller also owns a finally-path rollback, but the
            // component must clear its busy flag so a transient transport
            // failure cannot leave build mode permanently locked.
        }
        finally
        {
            _buildEditInProgress = false;
        }

        if (result is null)
        {
            _ignoreObjectRefreshUntil = DateTime.MinValue;
            if (_runtime is not null)
                await _runtime.InvokeVoidAsync("rollbackBuildPreview");
            _buildStatus = "The edit could not reach the server. Your preview was restored.";
            ShowActionMessage(_buildStatus, isError: true);
            await ReRender();
            return;
        }

        var completedResult = result.Value;
        if (!completedResult.Success || completedResult.Data is null)
        {
            _ignoreObjectRefreshUntil = DateTime.MinValue;
            if (_runtime is not null)
                await _runtime.InvokeVoidAsync("rollbackBuildPreview");
            _buildStatus = completedResult.Message ?? "That edit could not be applied.";
            ShowActionMessage(_buildStatus, isError: true);
            await ReRender();
            return;
        }

        if (completedResult.Data.SceneChanged)
        {
            await RefreshSceneAsync(null, null);
        }
        else
        {
            ApplyBuildResult(map, completedResult.Data);
            if (_runtime is not null)
                await _runtime.InvokeVoidAsync("applyBuildResult", completedResult.Data);
        }

        _buildStatus = successStatus;
        await ReRender();
    }

    private static void ApplyBuildResult(VillagePocMap map, VillageBuildResult result)
    {
        var removed = result.RemovedObjectIds.ToHashSet();
        map.GroundTiles.RemoveAll(x => removed.Contains(x.Id));
        map.Decorations.RemoveAll(x => removed.Contains(x.Id));

        var changed = result.Decorations.ToList();
        if (result.Decoration is not null && changed.All(x => x.Id != result.Decoration.Id))
            changed.Add(result.Decoration);

        foreach (var decoration in changed)
        {
            map.GroundTiles.RemoveAll(x => x.Id == decoration.Id);
            map.Decorations.RemoveAll(x => x.Id == decoration.Id);
            if (decoration.ZIndex < 0)
                map.GroundTiles.Add(decoration);
            else
                map.Decorations.Add(decoration);
        }
    }

    private string FormatPrice(decimal price)
    {
        if (price <= 0)
            return "Free";

        var decimals = Math.Clamp(_scene?.CurrencyDecimalPlaces ?? 0, 0, 8);
        var amount = decimal.Round(price, decimals).ToString($"F{decimals}");
        var symbol = _scene?.CurrencySymbol ?? string.Empty;
        var code = _scene?.CurrencyShortCode ?? string.Empty;
        return string.IsNullOrWhiteSpace(code)
            ? $"{symbol}{amount}"
            : $"{symbol}{amount} {code}";
    }

    private int _actionMessageToken;

    private void ShowActionMessage(string message, bool isError = false)
    {
        _actionMessage = message;
        _actionIsError = isError;

        // Toasts expire on their own: they sit over the world's zoom controls,
        // and a stale success message reads as a response to the next action.
        var token = ++_actionMessageToken;
        _ = Task.Delay(5000).ContinueWith(_ => InvokeAsync(async () =>
        {
            if (_disposed || token != _actionMessageToken || _actionMessage is null)
                return;

            _actionMessage = null;
            _actionIsError = false;
            await ReRender();
        }));
    }

    private async Task DismissActionMessage()
    {
        _actionMessageToken++;
        _actionMessage = null;
        _actionIsError = false;
        await ReRender();
    }

