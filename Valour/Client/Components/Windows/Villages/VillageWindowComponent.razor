    private string GetBuildScopeLabel()
    {
        if (_currentMap?.MapKind == "Interior")
            return $"Furnishing {_currentMap.Name}";
        if (_currentMap?.CanEdit == true)
            return $"Editing all of {_currentMap.Name}";

        var count = _currentMap?.Plots.Count(x => x.CanEdit) ?? 0;
        return count == 1 ? "Editing your parcel" : $"Editing {count} parcels";
