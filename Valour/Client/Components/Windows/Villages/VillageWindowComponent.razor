    private async Task SaveAdminPlotAsync()
    {
        if (Data is null || AdminSelectedPlot is null || _adminSaving) return;
        _adminSaving = true;
        var result = await VillageService.UpdatePlotGeometryAsync(Data, AdminSelectedPlot.Id, new VillagePlotUpdateRequest
        {
            Name = _adminPlotName,
            X = _adminPlotX, Y = _adminPlotY,
            Width = _adminPlotWidth, Height = _adminPlotHeight,
            EditMode = _adminPlotEditMode,
        });
        _adminSaving = false;
        _adminStatusError = !result.Success;
        _adminStatus = result.Success ? "Parcel updated." : result.Message ?? "Could not update parcel.";
        if (result.Success)
        {
            var id = _adminSelectedPlotId;
            await RefreshSceneAsync(null, id);
            var updated = _currentMap?.Plots.FirstOrDefault(p => p.Id == id);
            if (updated is not null) await SelectAdminPlotAsync(updated);
