    private async Task RefreshSceneAsync(long? selectedBuildingId, long? selectedPlotId)
    {
        if (Data is null)
            return;

        var currentMapId = _currentMap?.Id;
        var result = await VillageService.FetchProofOfConceptSceneAsync(Data.Id);
        if (!result.Success || result.Data is null)
        {
            ShowActionMessage(result.Message ?? "The world changed, but the latest scene could not be loaded.", isError: true);
            return;
        }

        _scene = result.Data;
        var previousMapWasArchived = currentMapId is not null &&
                                     _scene.Maps.All(x => x.Id != currentMapId.Value);
        _currentMap = _scene.Maps.FirstOrDefault(x => x.Id == currentMapId)
            ?? _scene.Maps.FirstOrDefault(x => x.Id == _scene.StartingMapId);
        _selectedBuilding = selectedBuildingId is null
            ? null
            : _scene.Maps.SelectMany(x => x.Buildings).FirstOrDefault(x => x.Id == selectedBuildingId.Value);
        _selectedPlot = selectedPlotId is null
            ? null
            : _scene.Maps.SelectMany(x => x.Plots).FirstOrDefault(x => x.Id == selectedPlotId.Value);

        if (_runtime is not null)
            await _runtime.InvokeVoidAsync("replaceScene", _scene);

        if (_buildMode && !CanBuildCurrentMap)
            _buildMode = false;
        await SyncBuildModeAsync();

        if (previousMapWasArchived && _currentMap is not null)
        {
            _currentBuildingId = _currentMap.ParentBuildingId;
            await JoinCurrentMapAsync(_currentMap.SpawnTile?.X, _currentMap.SpawnTile?.Y);
        }

        // Channel bindings and voice mode are scene data. Reconcile the live
        // area context after replacing them so chat/calls cannot remain on a
        // room that was just retired by a manager edit.
        await OnBuildingContextChangedAsync();
    }

