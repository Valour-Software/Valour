    private void OnPlanetUpdated(ModelUpdatedEvent<Planet> eventData)
    {
        if (_disposed || (eventData.Changes is not null && !eventData.Changes.On(x => x.EnableVillage)))
            return;

        _ = InvokeAsync(async () =>
        {
            if (Data?.EnableVillage == true)
            {
                if (_error == VillageDisabledMessage)
                    await RetryLoadAsync();
                return;
            }

            _error = VillageDisabledMessage;
            _loading = false;
            _presenceConnected = false;
            _presenceConnecting = false;
            _presenceError = null;
            _placesPanelOpen = false;
            _sceneRefreshCts?.Cancel();
            UnhookVillageEvents();
            await VillageService.LeaveMapAsync();
            await ClearPresenceDependentContextAsync();
            await ShutdownRuntimeAsync();
            _scene = null;
            _currentMap = null;
            _selectedBuilding = null;
            _selectedPlot = null;
            await ReRender();
        });
    }

    /// <summary>
    /// Surfaces chat as a bubble above the speaker, but only for people who are
    /// actually standing in this village. A planet's channels carry far more
    /// traffic than the map has occupants, so anything else would be noise from
    /// members who are not even here.
    /// </summary>
    private void OnMessageReceived(Message message)
    {
        if (_disposed || _runtime is null || message is null)
            return;

        if (string.IsNullOrWhiteSpace(message.Content))
            return;

        // Only chat from the room the member is standing in, plus their own
        // messages, belongs on the map.
        if (!IsMessageAudibleHere(message))
            return;

        var bubbleText = MarkdownManager.GetPlainText(message.Content);
        if (string.IsNullOrWhiteSpace(bubbleText))
            return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await _runtime.InvokeVoidAsync("pushBubble", message.AuthorUserId.ToString(), bubbleText, message.Id.ToString());
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        });
    }

    private bool IsMessageAudibleHere(Message message)
    {
        var isLocal = message.AuthorUserId == Client.Me?.Id;
        var speakerIsHere = isLocal || VillageService.Presences.Any(x => x.UserId == message.AuthorUserId);

        if (!speakerIsHere)
            return false;

        // A message counts when it was sent in the channel bound to the building
        // the speaker is standing in.
        var speakerBuildingId = isLocal
            ? _currentBuildingId
            : VillageService.Presences.FirstOrDefault(x => x.UserId == message.AuthorUserId)?.BuildingId;

        if (speakerBuildingId is null)
            return _currentBuildingId is null &&
                   (_ephemeralRoom?.ChatChannelId == message.ChannelId ||
                    _scene?.DefaultChatChannelId == message.ChannelId);

        var building = _scene?.Maps
            .SelectMany(x => x.Buildings)
            .FirstOrDefault(x => x.Id == speakerBuildingId);

        if (building?.ChatChannelId == message.ChannelId)
            return true;

        return speakerBuildingId == _ephemeralRoomBuildingId &&
               _ephemeralRoom?.ChatChannelId == message.ChannelId;
    }

    private CancellationTokenSource? _sceneRefreshCts;

    private void OnVillageBuildingChanged(Valour.Sdk.ModelLogic.IModelEvent<VillageBuilding> _) =>
        QueueSceneRefresh();

    private void OnVillagePlotChanged(Valour.Sdk.ModelLogic.IModelEvent<VillagePlot> _) =>
        QueueSceneRefresh();

    private void OnVillageMemberChanged(Valour.Sdk.ModelLogic.IModelEvent<PlanetMember> eventData)
    {
        if (eventData is Valour.Sdk.ModelLogic.IModelInsertionEvent<PlanetMember> insertion &&
            insertion.GetModel().Id == _scene?.LocalMemberId &&
            (eventData is not ModelUpdatedEvent<PlanetMember> updated ||
             updated.Changes is null || updated.Changes.On(x => x.RoleMembership)))
            QueueSceneRefresh();
    }

    private void OnVillageRoleChanged(Valour.Sdk.ModelLogic.IModelEvent<PlanetRole> _) =>
        QueueSceneRefresh();

    private void OnVillageObjectChanged(
        Valour.Sdk.ModelLogic.IModelEvent<Valour.Sdk.Models.VillageObject> _)
    {
        // The edit response already contains the exact local delta. Ignore our
        // own immediately echoed model event; remote edits still refresh once.
        if (DateTime.UtcNow >= _ignoreObjectRefreshUntil)
            QueueSceneRefresh();
    }

    /// <summary>
    /// Property changes arrive over the realtime hub whenever anyone buys,
    /// lists, or edits a building or parcel. The scene is refetched rather than
    /// patched - ownership changes ripple into names, prices, and tint colors -
    /// and the delay coalesces bursts (a purchase updates several models).
    /// </summary>
    private void QueueSceneRefresh()
    {
        if (_disposed)
            return;

        _sceneRefreshCts?.Cancel();
        var cts = new CancellationTokenSource();
        _sceneRefreshCts = cts;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(400, cts.Token);
            }
            catch (TaskCanceledException)
            {
                return;
            }

            if (_disposed || cts.IsCancellationRequested)
                return;

            await RefreshSceneAsync(_selectedBuilding?.Id, _selectedPlot?.Id);
            await ReRender();
        });
    }

    private void OnPresenceChanged()
    {
        // Fired from the hub, so hop back onto the renderer's context.
        _ = InvokeAsync(async () =>
        {
            await PushPresencesAsync();
            await ReRender();
        });
    }

    private void OnVillageMapRejoinFailed(string message)
    {
        if (_disposed)
            return;

        _ = InvokeAsync(async () =>
        {
            _presenceConnected = false;
            _presenceConnecting = false;
            _presenceError = message;
            await ClearPresenceDependentContextAsync();
            await ReRender();
        });
    }

    /// <summary>
    /// A SignalR reconnect drops server-side presence and temporary-room
    /// occupancy. Presence has already been restored by VillageService; renew
    /// the room lease as well, and only rebuild the call when the server had to
    /// replace its ephemeral channel during a restart.
    /// </summary>
    private async Task OnVillageMapRejoined()
    {
        if (_disposed)
            return;

        await InvokeAsync(async () =>
        {
            _presenceConnected = true;
            _presenceConnecting = false;
            _presenceError = null;
            var usesEphemeralRoom = CurrentBuilding is null ||
                                    (CurrentBuilding.VoiceMode == VillageVoiceMode.AutoRoom &&
                                     CurrentBuilding.ChannelId is null);

            // The server released this user's lease on disconnect. Clearing
            // the local handle forces EnsureCurrentSpaceRoomAsync to reacquire it
            // instead of returning the now-stale cached response.
            if (usesEphemeralRoom)
            {
                _ephemeralRoom = null;
                _ephemeralRoomBuildingId = null;
                _ephemeralRoomMapId = null;
            }

            await OnBuildingContextChangedAsync();

            await PushPresencesAsync();
            await ReRender();
        });
    }

    /// <summary>
    /// Hands the current occupancy to the canvas runtime. The runtime owns
    /// interpolation, so it receives target tiles rather than pixel positions.
    /// </summary>
    private async Task PushPresencesAsync()
    {
        if (_runtime is null || _disposed)
            return;

        // Ids go over as strings: snowflakes overflow JS number precision, and
        // the runtime only ever compares them for equality anyway.
        var others = VillageService.Presences
            .Select(x => new
            {
                userId = x.UserId.ToString(),
                name = x.Name,
                avatarUrl = x.AvatarUrl,
                x = x.X,
                y = x.Y,
                facing = (int)x.Facing,
                buildingId = x.BuildingId?.ToString(),
            })
            .ToArray();

        try
        {
            await _runtime.InvokeVoidAsync("setPresences", (object)others);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    /// <summary>
    /// Called by the runtime each time the local player finishes a step.
    /// </summary>
    [JSInvokable]
    public async Task OnLocalMoved(int x, int y, int facing, string? buildingIdRaw, string? mapIdRaw)
    {
        if (_disposed || _presenceConnecting || ParseId(mapIdRaw) != _currentMap?.Id)
            return;

        var buildingId = ParseId(buildingIdRaw);
        _playerX = x;
        _playerY = y;

        // Await the hub send when changing spatial context so the server sees us
        // inside the area before its room lease request arrives over HTTP.
        await VillageService.ReportMoveAsync(x, y, (VillageFacing)facing, buildingId);

        if (buildingId == _currentBuildingId)
        {
            if (_activeVoiceChannel is not null)
                await ReRender();
            return;
        }

        _currentBuildingId = buildingId;
        await OnBuildingContextChangedAsync();
    }

    private static bool CanHostVoice(VillagePocBuilding building) =>
        building.VoiceMode == VillageVoiceMode.AutoRoom ||
        (building.ChannelId is not null &&
         building.ChannelType is not null &&
         ISharedChannel.VoiceChannelTypes.Contains(building.ChannelType.Value));

    private bool CanOpenChat(VillagePocBuilding building) =>
        building.ChatChannelId is not null ||
        (building.VoiceMode == VillageVoiceMode.AutoRoom &&
         building.Id == _currentBuildingId);

    private bool CanJoinVoiceFromHere(VillagePocBuilding building) =>
        _presenceConnected &&
        CanHostVoice(building) &&
        building.Id == _currentBuildingId;

    private VillagePocBuilding? CurrentBuilding => _currentBuildingId is null
        ? null
        : _scene?.Maps.SelectMany(x => x.Buildings).FirstOrDefault(x => x.Id == _currentBuildingId);

    private bool CurrentSpaceCanHostVoice =>
        _presenceConnected &&
        _currentMap is not null &&
        (CurrentBuilding is null || CanHostVoice(CurrentBuilding));

    private bool IsVoiceActiveHere =>
        _activeVoiceChannel is not null &&
        (_currentBuildingId is not null
            ? _activeVoiceBuildingId == _currentBuildingId
            : _activeVoiceBuildingId is null && _activeVoiceMapId == _currentMap?.Id);

    private string CurrentSpaceName => CurrentBuilding?.Name ?? _currentMap?.Name ?? "Village";

    private async Task SetActiveChatChannelAsync(Channel? channel)
    {
        await _chatConnectionGate.WaitAsync();
        try
        {
            if ((_disposed && channel is not null) || _activeChatChannel?.Id == channel?.Id)
                return;
            var previous = _activeChatChannel;
            _activeChatChannel = null;
            if (previous is not null)
                await previous.Close(_canvasId);
            if (channel is not null)
            {
                var result = await channel.OpenWithResult(_canvasId);
                if (result.Success)
                    _activeChatChannel = channel;
                else
                    ShowActionMessage(result.Message ?? "Nearby chat could not connect.", isError: true);
            }
        }
        finally
        {
            _chatConnectionGate.Release();
        }
    }

    private async Task ClearPresenceDependentContextAsync()
    {
        await SetActiveChatChannelAsync(null);
        _currentBuildingName = null;

        if (_activeVoiceChannel is not null)
            await LeaveVoiceAsync();

        // The server expires map-scoped room leases on disconnect or when the
        // planet is disabled. Forget the local handle without issuing another
        // request through a connection that is already known to be unavailable.
        _ephemeralRoom = null;
        _ephemeralRoomBuildingId = null;
        _ephemeralRoomMapId = null;
    }

    /// <summary>
    /// Walking out of a voice space leaves its call. Auto-join may then enter
    /// the next space; otherwise the microphone stays disconnected until the
    /// member explicitly joins again. A map transition within the same building
    /// keeps its existing call.
    /// </summary>
    private async Task OnBuildingContextChangedAsync()
    {
        if (!_presenceConnected)
        {
            await ClearPresenceDependentContextAsync();
            await ReRender();
            return;
        }

        var building = CurrentBuilding;
        var mapId = _currentMap?.Id;
        var usesEphemeralRoom = building is null ||
                                (building.VoiceMode == VillageVoiceMode.AutoRoom && building.ChannelId is null);
        var activeVoiceWasHere = _activeVoiceChannel is not null &&
                                 (building is not null
                                     ? _activeVoiceBuildingId == building.Id
                                     : _activeVoiceBuildingId is null && _activeVoiceMapId == mapId);
        var ephemeralRoomIsHere = building is not null
            ? _ephemeralRoomBuildingId == building.Id
            : _ephemeralRoomBuildingId is null && _ephemeralRoomMapId == mapId;

        if (_ephemeralRoom is not null &&
            (!ephemeralRoomIsHere || !usesEphemeralRoom))
        {
            if (_activeVoiceChannel?.Id == _ephemeralRoom.ChannelId)
                await LeaveVoiceAsync();

            await ReleaseEphemeralRoomAsync();
        }

        if (_activeVoiceChannel is not null && !activeVoiceWasHere)
            await LeaveVoiceAsync();

        _currentBuildingName = building?.Name;

        long? chatChannelId;
        VillageEphemeralRoom? room = null;
        if (usesEphemeralRoom)
        {
            room = await EnsureCurrentSpaceRoomAsync();
            chatChannelId = room?.ChatChannelId;
            if (chatChannelId is null && building is null)
                chatChannelId = _scene?.DefaultChatChannelId;
        }
        else
        {
            chatChannelId = building?.ChatChannelId;
        }

        var contextChannel = chatChannelId is not null && Data is not null
            ? await Data.FetchChannelAsync(chatChannelId.Value)
            : null;
        if (_disposed || _currentMap?.Id != mapId)
            return;
        await SetActiveChatChannelAsync(contextChannel?.IsChatChannel == true ? contextChannel : null);

        var expectedVoiceChannelId = building is null
            ? room?.ChannelId
            : CanHostVoice(building) ? building.ChannelId ?? room?.ChannelId : null;

        // A scene refresh can rebind this same building to a different channel.
        // Building-id equality alone is not enough: preserve the user's active
        // call intent while moving the call to the new authoritative channel.
        if (activeVoiceWasHere && _activeVoiceChannel?.Id != expectedVoiceChannelId)
        {
            if (_activeVoiceChannel is not null)
                await LeaveVoiceAsync();

            if (expectedVoiceChannelId is not null)
                await JoinCurrentVoiceAsync();
        }

        if (!_autoJoinVoice)
        {
            await ReRender();
            return;
        }

        if (expectedVoiceChannelId is null)
        {
            if (_activeVoiceChannel is not null)
                await LeaveVoiceAsync();

            await ReRender();
            return;
        }

        if (IsVoiceActiveHere)
            return;

        await JoinCurrentVoiceAsync();
    }

    private async Task JoinBuildingVoiceAsync(VillagePocBuilding building)
    {
        if (building.Id != _currentBuildingId)
            return;

        await JoinCurrentVoiceAsync();
    }

    private async Task ToggleCurrentVoiceAsync()
    {
        if (IsVoiceActiveHere)
            await LeaveVoiceAsync();
        else
            await JoinCurrentVoiceAsync();
    }

    private async Task JoinCurrentVoiceAsync()
    {
        if (Data is null || _currentMap is null || !CurrentSpaceCanHostVoice)
            return;

        if (_runtime is not null)
            await _runtime.InvokeVoidAsync("resumeSpatialAudio");

        var building = CurrentBuilding;
        var channelId = building?.ChannelId;
        if (building is null || (channelId is null && building.VoiceMode == VillageVoiceMode.AutoRoom))
        {
            var room = await EnsureCurrentSpaceRoomAsync();
            channelId = room?.ChannelId;
        }

        if (channelId is null)
            return;

        var channel = await Data.FetchChannelAsync(channelId.Value);
        if (channel is null || !ISharedChannel.VoiceChannelTypes.Contains(channel.ChannelType))
            return;

        _activeVoiceBuildingId = building?.Id;
        _activeVoiceMapId = _currentMap.Id;
        _activeVoiceBuildingName = CurrentSpaceName;
        _activeVoiceChannel = channel;
        _activeVoiceVideoMode = channel.ChannelType == ChannelTypeEnum.PlanetVideo;
        await CallSession.InitializeAsync(channel, _activeVoiceVideoMode);
        await PushVoicePeersAsync();
        await ReRender();
    }

    private async Task<VillageEphemeralRoom?> EnsureCurrentSpaceRoomAsync()
    {
        if (Data is null || _currentMap is null)
            return null;

        var building = CurrentBuilding;
        var roomMatchesSpace = building is not null
            ? _ephemeralRoomBuildingId == building.Id
            : _ephemeralRoomBuildingId is null && _ephemeralRoomMapId == _currentMap.Id;
        if (roomMatchesSpace && _ephemeralRoom is not null)
            return _ephemeralRoom;

        if (_ephemeralRoom is not null)
            await ReleaseEphemeralRoomAsync();

        var result = building is null
            ? await VillageService.AcquireMapRoomAsync(Data, _currentMap.Id)
            : await VillageService.AcquireBuildingRoomAsync(Data, building.Id);
        if (!result.Success || result.Data is null)
        {
            ShowActionMessage(result.Message ?? "Could not open this area's temporary room.", true);
            return null;
        }

        _ephemeralRoom = result.Data;
        _ephemeralRoomBuildingId = building?.Id;
        _ephemeralRoomMapId = result.Data.MapId;
        return _ephemeralRoom;
    }

    private async Task ReleaseEphemeralRoomAsync()
    {
        var buildingId = _ephemeralRoomBuildingId;
        var mapId = _ephemeralRoomMapId;
        _ephemeralRoom = null;
        _ephemeralRoomBuildingId = null;
        _ephemeralRoomMapId = null;

        if (Data is null)
            return;

        if (buildingId is not null)
            await VillageService.ReleaseBuildingRoomAsync(Data, buildingId.Value);
        else if (mapId is not null)
            await VillageService.ReleaseMapRoomAsync(Data, mapId.Value);
    }

    private async Task LeaveVoiceAsync()
    {
        _activeVoiceBuildingId = null;
        _activeVoiceMapId = null;
        _activeVoiceBuildingName = null;
        _activeVoiceChannel = null;
        _activeVoiceVideoMode = false;

        await CallSession.LeaveAsync(clearChannel: true);
        await PushVoicePeersAsync();
        await ReRender();
    }

    private void OnCallSessionStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await PushVoicePeersAsync();
            await ReRender();
        });
    }

    private async Task PushVoicePeersAsync()
    {
        if (_runtime is null || _disposed)
            return;

        var peers = CallSession.ParticipantsSnapshot?.Participants
            .Where(x => !x.IsSelf && !string.IsNullOrWhiteSpace(x.PeerId))
            .Select(x => new
            {
                userId = ResolveVoiceUserId(x.CustomParticipantId, x.UserId),
                peerId = x.PeerId,
            })
            .Where(x => x.userId > 0)
            .Select(x => new { userId = x.userId.ToString(), x.peerId })
            .ToArray() ?? [];

        try
        {
            await _runtime.InvokeVoidAsync("setVoicePeers", (object)peers);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private static long ResolveVoiceUserId(string? customParticipantId, string? userId)
    {
        var source = string.IsNullOrWhiteSpace(customParticipantId) ? userId : customParticipantId;
        if (string.IsNullOrWhiteSpace(source))
            return 0;

        var separator = source.IndexOf(':');
        var value = separator > 0 ? source[..separator] : source;
        return long.TryParse(value, out var parsed) ? parsed : 0;
    }

    private bool IsUserInHearingRange(long userId)
    {
        if (!_proximityVoice)
            return true;

        var presence = VillageService.Presences.FirstOrDefault(p => p.UserId == userId);
        return presence is not null && _playerX is { } x && _playerY is { } y &&
               Math.Pow(presence.X - x, 2) + Math.Pow(presence.Y - y, 2) < 16 * 16;
    }

    private async Task OnToggleProximityVoice(ChangeEventArgs e)
    {
        _proximityVoice = e.Value is true;

        if (_runtime is not null)
        {
            await _runtime.InvokeVoidAsync("setSpatialAudioEnabled", _proximityVoice);
            await PushVoicePeersAsync();
        }

        // The toggle's active styling tracks this flag, and the window base
        // suppresses automatic renders.
        await ReRender();
    }

    private async Task OnToggleAutoJoin(ChangeEventArgs e)
    {
        _autoJoinVoice = e.Value is true;

        // Entering the toggle while already standing inside a room should take
        // effect immediately rather than on the next step.
        await OnBuildingContextChangedAsync();
        await ReRender();
    }

    // The send button's disabled state tracks the draft, so each keystroke must
    // render or the button never lights up.
    private async Task OnChatDraftChanged(ChangeEventArgs e)
    {
        _chatDraft = e.Value?.ToString() ?? string.Empty;
        await ReRender();
    }

    private async Task OnChatKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendVillageMessageAsync();
    }

    private async Task SendVillageMessageAsync()
    {
        var channel = _activeChatChannel;
        var content = _chatDraft.Trim();
        if (channel is null || string.IsNullOrWhiteSpace(content) || _sendingChat)
            return;

        _sendingChat = true;
        _chatDraft = string.Empty;
        await ReRender();

        var result = await channel.SendMessageAsync(content);
        if (!result.Success)
        {
            _chatDraft = content;
            ShowActionMessage(result.Message ?? "That message could not be sent.", isError: true);
        }
        else if (result.Data is not null)
        {
            OnMessageReceived(result.Data);
        }

        _sendingChat = false;
        await ReRender();
    }

    /// <summary>
    /// Money moves on confirm, so the platform's confirmation modal sits
    /// between the button and the transaction - a mis-tap in the world must
    /// not spend someone's currency.
    /// </summary>
    private void ConfirmPurchaseSelectedBuilding()
    {
        if (_selectedBuilding is null)
            return;

        var building = _selectedBuilding;
        var modalData = new ConfirmModalComponent.ModalParams(
            $"Buy {building.Name}?",
            building.Price > 0
                ? $"This will transfer {FormatPrice(building.Price)} from your account to the seller."
                : "This property is free to claim.",
            building.Price > 0 ? "Confirm purchase" : "Claim it",
            "Cancel",
            PurchaseSelectedBuildingAsync,
            () => Task.CompletedTask);

        ModalRoot.Instance?.OpenModal<ConfirmModalComponent>(modalData);
    }

    private void ConfirmPurchaseSelectedPlot()
    {
        if (_selectedPlot is null)
            return;

        var plot = _selectedPlot;
        var modalData = new ConfirmModalComponent.ModalParams(
            $"Claim {plot.Name}?",
            plot.Price > 0
                ? $"This will transfer {FormatPrice(plot.Price)} from your account to the seller."
                : "This parcel is free to claim.",
            plot.Price > 0 ? "Confirm purchase" : "Claim it",
            "Cancel",
            PurchaseSelectedPlotAsync,
            () => Task.CompletedTask);

        ModalRoot.Instance?.OpenModal<ConfirmModalComponent>(modalData);
    }

