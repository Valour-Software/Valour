    [JSInvokable]
    public async Task OnAdminParcelDrawn(int x, int y, int width, int height)
    {
        if (!_adminMode || Data is null || _currentMap is null) return;
        _adminDrawing = false;
        _adminSaving = true;
        _adminStatusError = false;
        _adminStatus = "Creating parcel…";
        await ReRender();
        var result = await VillageService.CreatePlotAsync(Data, _currentMap.Id, new VillagePlotCreateRequest
        {
            Name = $"Parcel {_currentMap.Plots.Count + 1}",
            X = x, Y = y, Width = width, Height = height,
            EditMode = VillageEditMode.Owner,
        });
        _adminSaving = false;
        if (!result.Success || result.Data is null)
        {
            _adminStatusError = true;
            _adminStatus = result.Message ?? "Could not create parcel.";
            await ReRender();
            return;
        }
        await RefreshSceneAsync(null, result.Data.Id);
        var created = _currentMap?.Plots.FirstOrDefault(p => p.Id == result.Data.Id);
        if (created is not null) await SelectAdminPlotAsync(created);
        _adminStatus = "Parcel created.";
        await ReRender();
    }

