                    <button class="dpad-key dpad-left" aria-label="Move left"
                            @onpointerdown='() => SetHandheldDirectionAsync("left", true)'
                            @onpointerup='() => SetHandheldDirectionAsync("left", false)'
                            @onpointercancel='() => SetHandheldDirectionAsync("left", false)'
                            @onpointerleave='() => SetHandheldDirectionAsync("left", false)'
                            @onclick='() => NudgeHandheldDirectionAsync("left")'><i aria-hidden="true" class="bi bi-caret-left-fill"></i></button>
                    <span class="dpad-center" aria-hidden="true"></span>
                    <button class="dpad-key dpad-right" aria-label="Move right"
                            @onpointerdown='() => SetHandheldDirectionAsync("right", true)'
                            @onpointerup='() => SetHandheldDirectionAsync("right", false)'
                            @onpointercancel='() => SetHandheldDirectionAsync("right", false)'
                            @onpointerleave='() => SetHandheldDirectionAsync("right", false)'
                            @onclick='() => NudgeHandheldDirectionAsync("right")'><i aria-hidden="true" class="bi bi-caret-right-fill"></i></button>
                    <button class="dpad-key dpad-down" aria-label="Move down"
                            @onpointerdown='() => SetHandheldDirectionAsync("down", true)'
                            @onpointerup='() => SetHandheldDirectionAsync("down", false)'
                            @onpointercancel='() => SetHandheldDirectionAsync("down", false)'
                            @onpointerleave='() => SetHandheldDirectionAsync("down", false)'
                            @onclick='() => NudgeHandheldDirectionAsync("down")'><i aria-hidden="true" class="bi bi-caret-down-fill"></i></button>
                </div>

                <div class="handheld-system-buttons">
                    <button @onclick="FocusVillageChatAsync" disabled="@(_activeChatChannel is null)" aria-label="Focus nearby chat">
                        <span></span><small>Select</small>
                    </button>
                    <button @onclick="TogglePlacesPanel" aria-label="Open or close Places">
                        <span></span><small>Start</small>
                    </button>
                </div>

                <div class="handheld-action-buttons" role="group" aria-label="Action buttons">
                    <button class="handheld-action b-button" @onclick="HandheldBackAsync" aria-label="Back or leave building">
                        <strong>B</strong><small>Back</small>
                    </button>
                    <button class="handheld-action a-button" @onclick="HandheldInteractAsync" aria-label="Interact with nearby place">
                        <strong>A</strong><small>Action</small>
                    </button>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_actionMessage))
        {
            <div class="village-toast @(_actionIsError ? "error" : string.Empty)">
                <i aria-hidden="true" class="bi @(_actionIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i>
                <span>@_actionMessage</span>
                <button @onclick="DismissActionMessage" aria-label="Dismiss"><i aria-hidden="true" class="bi bi-x-lg"></i></button>
            </div>
        }

        <div class="village-movement-hint @((_buildMode || _adminMode) ? "building" : string.Empty)">
            @if (_adminMode)
            {
                <i aria-hidden="true" class="bi bi-bounding-box-circles"></i><span>Parcel admin mode · movement is paused while editing</span>
            }
            else if (_buildMode)
            {
                <i aria-hidden="true" class="bi bi-grid-3x3-gap-fill"></i><span>Editable tiles glow · choose Done to walk normally</span>
            }
            else if (DeviceInfo.IsMobile)
            {
                @if (_handheldControls)
                {
                    <i aria-hidden="true" class="bi bi-controller"></i><span>D-pad to move · A to interact</span>
                }
                else
                {
                    <i aria-hidden="true" class="bi bi-hand-index-thumb-fill"></i><span>Drag anywhere to move · tap places to inspect</span>
                }
            }
            else
            {
                <span class="keycap">W</span><span class="keycap">A</span><span class="keycap">S</span><span class="keycap">D</span>
                <span>Move · walk into glowing doors</span>
            }
        </div>
        <a class="village-art-credit" href="https://limezu.itch.io/" target="_blank" rel="noopener noreferrer">Art by LimeZu</a>
    </div>
}

@code {
    private const string VillageDisabledMessage = "The village is disabled for this planet.";
    private readonly string _canvasId = $"village-canvas-{Guid.NewGuid():N}";
    private readonly string _canvasInstructionsId = $"village-instructions-{Guid.NewGuid():N}";
    private readonly string _placesPanelId = $"village-places-{Guid.NewGuid():N}";
    private ElementReference _chatInput;
    private IJSObjectReference? _module;
    private IJSObjectReference? _runtime;
    private Dictionary<string, string> _buildPreviewImages = new();
    private DotNetObjectReference<VillageWindowComponent>? _selfRef;
    private VillagePocScene? _scene;
    private VillagePocMap? _currentMap;
    private VillagePocBuilding? _selectedBuilding;
    private VillagePocPlot? _selectedPlot;
    private bool _loading = true;
    private bool _initializing;
    private bool _disposed;
    private bool _villageEventsHooked;
    private string? _error;
    private bool _presenceConnected;
    private bool _presenceConnecting;
    private string? _presenceError;
    private int? _playerX;
    private int? _playerY;
    private bool _placesPanelOpen;
    private bool _handheldControls = DevicePreferences.VillageHandheldControls;
    private bool HandheldControlsActive => DeviceInfo.IsMobile && _handheldControls;
    private bool HandheldControlsVisible => HandheldControlsActive && !_buildMode && !_adminMode;
    private bool _proximityVoice = true;
    private bool _autoJoinVoice;
    private int _zoomPercent = 65;
    private long? _currentBuildingId;
    private string? _currentBuildingName;
    private long? _activeVoiceBuildingId;
    private long? _activeVoiceMapId;
    private string? _activeVoiceBuildingName;
    private Channel? _activeVoiceChannel;
    private Channel? _activeChatChannel;
    private VillageEphemeralRoom? _ephemeralRoom;
    private long? _ephemeralRoomBuildingId;
    private long? _ephemeralRoomMapId;
    private bool _activeVoiceVideoMode;
    private string _chatDraft = string.Empty;
    private readonly SemaphoreSlim _chatConnectionGate = new(1, 1);
    private bool _sendingChat;
    private bool _purchaseInProgress;
    private bool _listingInProgress;
    private string _listingPriceText = "0";
    private bool _editingProperty;
    private bool _editInProgress;
    private string _editName = string.Empty;
    private string _editDescription = string.Empty;
    private string _editChannelValue = string.Empty;
    private string? _actionMessage;
    private bool _actionIsError;
    private bool _buildMode;
    private bool _buildEditInProgress;
    private string _buildTool = "Furnish";
    private string _buildCategory = "All";
    private string _buildSearch = string.Empty;
    private string _selectedBuildKey = string.Empty;
    private string _buildStatus = string.Empty;
    private DateTime _ignoreObjectRefreshUntil;
    private bool _adminMode;
    private bool _adminDrawing;
    private bool _adminSaving;
    private long? _adminSelectedPlotId;
    private string _adminPlotName = string.Empty;
    private int _adminPlotX;
    private int _adminPlotY;
    private int _adminPlotWidth = 1;
    private int _adminPlotHeight = 1;
    private VillageEditMode _adminPlotEditMode = VillageEditMode.Owner;
    private string _adminStatus = string.Empty;
    private bool _adminStatusError;
    private VillagePocPlot? AdminSelectedPlot =>
        _currentMap?.Plots.FirstOrDefault(x => x.Id == _adminSelectedPlotId);

    protected override async Task OnInitializedAsync()
    {
        Instances.Add(this);
        SelectionsChanged?.Invoke();
        CallSession.StateChanged += OnCallSessionStateChanged;

        if (Data is null)
        {
            _error = "Village demo could not resolve the target planet.";
            _loading = false;
            await ReRender();
            return;
        }

        Data.Updated += OnPlanetUpdated;
        await LoadVillageAsync();
        await ReRender();
    }

    private async Task LoadVillageAsync()
    {
        if (Data is null || _disposed)
            return;

        _loading = true;
        _error = null;
        _presenceConnected = false;
        _presenceError = null;

        if (!Data.EnableVillage)
        {
            _error = VillageDisabledMessage;
            _loading = false;
            return;
        }

        try
        {
            var result = await VillageService.FetchProofOfConceptSceneAsync(Data.Id);
            if (!result.Success || result.Data is null)
            {
                _error = result.Message ?? "The village failed to load.";
                return;
            }

            _scene = result.Data;
            _currentMap = _scene.Maps.FirstOrDefault(x => x.Id == _scene.StartingMapId);
            if (_currentMap is null)
            {
                _error = "The village has no outdoor map to open.";
                _scene = null;
                return;
            }

            _playerX = _currentMap.SpawnTile?.X ?? 0;
            _playerY = _currentMap.SpawnTile?.Y ?? 0;
            _selectedBuildKey = _scene.BuildCatalog
                .FirstOrDefault(x => string.Equals(x.Kind, "Sprite", StringComparison.OrdinalIgnoreCase))?.Key
                ?? _scene.BuildCatalog.FirstOrDefault()?.Key
                ?? string.Empty;

            // A restored window can reach this point before the planet's channel
            // list has loaded, and the manage panel's channel picker needs it.
            if (Data.Channels.Count == 0)
                await Data.FetchChannelsAsync();
        }
        catch (Exception)
        {
            _error = "The village could not be reached. Check your connection and try again.";
            _scene = null;
            _currentMap = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RetryLoadAsync()
    {
        await ShutdownRuntimeAsync();
        UnhookVillageEvents();
        await LoadVillageAsync();
        await ReRender();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scene is null || _error is not null || _runtime is not null || _initializing || _disposed)
            return;

        // The scene arrives after the first render, so we cannot key off firstRender.
        // _runtime is only assigned after two awaits, so it cannot guard re-entry on its own.
        _initializing = true;
        try
        {
            _selfRef?.Dispose();
            _selfRef = DotNetObjectReference.Create(this);
            _module ??= await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Valour.Client/Components/Windows/Villages/VillageWindowComponent.razor.js");

            if (_disposed)
                return;

            _runtime = await _module.InvokeAsync<IJSObjectReference>("init", _canvasId, _selfRef, _scene, DeviceInfo.IsMobile);

            if (_disposed)
            {
                await ShutdownRuntimeAsync();
                return;
            }

            await _runtime.InvokeVoidAsync("setTouchControlMode", HandheldControlsActive ? "handheld" : "floating");
            await _runtime.InvokeVoidAsync("setSpatialAudioEnabled", _proximityVoice);
            await LoadBuildPreviewImagesAsync();
            if (_disposed) return;
            HookVillageEvents();
            if (await JoinCurrentMapAsync())
            {
                await OnBuildingContextChangedAsync();
                await PushVoicePeersAsync();
            }

            await ReRender();
        }
        finally
        {
            _initializing = false;
        }
    }

    private void HookVillageEvents()
    {
        if (_villageEventsHooked || Data is null)
            return;

        VillageService.PresenceChanged += OnPresenceChanged;
        VillageService.MapRejoined += OnVillageMapRejoined;
        VillageService.MapRejoinFailed += OnVillageMapRejoinFailed;
        MessageService.MessageReceived += OnMessageReceived;
        Data.VillageBuildings.Changed += OnVillageBuildingChanged;
        Data.VillagePlots.Changed += OnVillagePlotChanged;
        Data.VillageObjects.Changed += OnVillageObjectChanged;
        Data.Members.Changed += OnVillageMemberChanged;
        Data.Roles.Changed += OnVillageRoleChanged;
        _villageEventsHooked = true;
    }

    private void UnhookVillageEvents()
    {
        if (!_villageEventsHooked)
            return;

        VillageService.PresenceChanged -= OnPresenceChanged;
        VillageService.MapRejoined -= OnVillageMapRejoined;
        VillageService.MapRejoinFailed -= OnVillageMapRejoinFailed;
        MessageService.MessageReceived -= OnMessageReceived;
        if (Data is not null)
        {
            Data.VillageBuildings.Changed -= OnVillageBuildingChanged;
            Data.VillagePlots.Changed -= OnVillagePlotChanged;
            Data.VillageObjects.Changed -= OnVillageObjectChanged;
            Data.Members.Changed -= OnVillageMemberChanged;
            Data.Roles.Changed -= OnVillageRoleChanged;
        }

        _villageEventsHooked = false;
    }

    // Snowflake ids exceed JavaScript's 2^53 float precision, so the runtime
    // traffics in string ids: a rounded double coming back from JS would fail
    // every exact lookup below and the inspector would never open.
    private static long? ParseId(string? id) =>
        long.TryParse(id, out var parsed) ? parsed : null;

    [JSInvokable]
    public async Task OnBuildingSelected(string? buildingIdRaw, string? currentMapIdRaw)
    {
        if (_scene is null || _disposed)
            return;

        var buildingId = ParseId(buildingIdRaw);
        var currentMapId = ParseId(currentMapIdRaw);

        _currentMap = _scene.Maps.FirstOrDefault(x => x.Id == currentMapId) ?? _currentMap;
        var previousId = _selectedBuilding?.Id;
        _selectedBuilding = _scene.Maps
            .SelectMany(x => x.Buildings)
            .FirstOrDefault(x => x.Id == buildingId);
        if (_selectedBuilding is not null)
        {
            _selectedPlot = null;
            _listingPriceText = _selectedBuilding.Price.ToString(System.Globalization.CultureInfo.InvariantCulture);
            if (previousId != _selectedBuilding.Id)
                _editingProperty = false;
        }

        await ReRender();
    }

    [JSInvokable]
    public async Task OnPlotSelected(string? plotIdRaw, string? currentMapIdRaw)
    {
        if (_scene is null || _disposed)
            return;

        var plotId = ParseId(plotIdRaw);
        var currentMapId = ParseId(currentMapIdRaw);

        _currentMap = _scene.Maps.FirstOrDefault(x => x.Id == currentMapId) ?? _currentMap;
        var previousId = _selectedPlot?.Id;
        _selectedPlot = _scene.Maps
            .SelectMany(x => x.Plots)
            .FirstOrDefault(x => x.Id == plotId);
        if (_selectedPlot is not null)
        {
            _selectedBuilding = null;
            _listingPriceText = _selectedPlot.Price.ToString(System.Globalization.CultureInfo.InvariantCulture);
            if (previousId != _selectedPlot.Id)
                _editingProperty = false;
        }

        await ReRender();
    }

    [JSInvokable]
    public async Task<bool> OnMapChanged(string? mapIdRaw, int x, int y)
    {
        if (_scene is null || _disposed)
            return false;

        var mapId = ParseId(mapIdRaw);

        _currentMap = _scene.Maps.FirstOrDefault(x => x.Id == mapId) ?? _currentMap;
        _currentBuildingId = _currentMap?.ParentBuildingId;
        _placesPanelOpen = false;
        _selectedBuilding = null;
        _selectedPlot = null;
        _editingProperty = false;
        _buildMode = false;
        _adminMode = false;
        _adminDrawing = false;
        _buildCategory = "All";
        _buildSearch = string.Empty;
        if (_buildTool == "Furnish" && !GetBuildItemsForTool(_buildTool).Any(item => item.Key == _selectedBuildKey))
            _selectedBuildKey = GetBuildItemsForTool(_buildTool).FirstOrDefault()?.Key ?? string.Empty;
        _playerX = x;
        _playerY = y;

        if (_buildMode && !CanBuildCurrentMap)
            _buildMode = false;
        await SyncBuildModeAsync();

        if (_adminMode && !_scene.CanManageVillage)
        {
            _adminMode = false;
            _adminDrawing = false;
            if (_runtime is not null)
                await _runtime.InvokeVoidAsync("setAdminMode", false);
        }

        if (_editingProperty && !CanEditProperty(
                _selectedBuilding?.IsOwnedByLocalMember == true || _selectedPlot?.IsOwnedByLocalMember == true))
            _editingProperty = false;

        // The room endpoint only leases to members who are actually present in
        // the area. Join at the runtime's real destination before resolving the
        // area's temporary chat/call.
        var joined = await JoinCurrentMapAsync(x, y);
        if (joined)
            await OnBuildingContextChangedAsync();
        else
            await ClearPresenceDependentContextAsync();

        // Stepping back outside clears the inspector; the building panel only makes
        // sense while its own interior is the active map.
        if (_currentMap?.MapKind == "Outdoor" && _selectedBuilding?.InteriorMapId != mapId)
            _selectedBuilding = null;

        // Presence is per-map, so stepping through a door moves us between
        // realtime groups as well as between maps.
        await ReRender();
        return joined;
    }

    [JSInvokable]
    public async Task OnZoomChanged(int percent)
    {
        if (_disposed)
            return;

        _zoomPercent = Math.Clamp(percent, 50, 200);
        await ReRender();
    }

    /// <summary>
    /// Announces us on the map we are standing on and seeds everyone already
    /// there. Called on open and again whenever we walk through a door, since
    /// presence is scoped per map rather than per planet.
    /// </summary>
    private async Task<bool> JoinCurrentMapAsync(int? x = null, int? y = null)
    {
        if (Data is null || _currentMap is null || _disposed)
            return false;

        var spawn = _currentMap.SpawnTile;
        var joinX = x ?? _playerX ?? spawn?.X ?? 0;
        var joinY = y ?? _playerY ?? spawn?.Y ?? 0;
        _presenceConnecting = true;
        _presenceError = null;
        await ReRender();

        try
        {
            var result = await VillageService.JoinMapAsync(
                Data,
                _currentMap.Id,
                joinX,
                joinY,
                _currentBuildingId);
            _presenceConnected = result.Success;
            _presenceError = result.Success
                ? null
                : result.Message ?? "Could not join village presence.";
            if (!result.Success)
                return false;

            _playerX = joinX;
            _playerY = joinY;
            await PushPresencesAsync();
            return true;
        }
        catch (Exception)
        {
            _presenceConnected = false;
            _presenceError = "Village presence could not be reached.";
            return false;
        }
        finally
        {
            _presenceConnecting = false;
        }
    }

    private async Task RetryPresenceAsync()
    {
        if (_presenceConnecting || _disposed)
            return;

        if (await JoinCurrentMapAsync())
        {
            await OnBuildingContextChangedAsync();
            await PushVoicePeersAsync();
        }

        await ReRender();
    }

