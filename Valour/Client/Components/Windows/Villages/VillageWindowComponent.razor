    private async Task OpenSelectedChannelAsync()
    {
        if (_selectedBuilding is null || Data is null)
            return;

        long? channelId = _selectedBuilding.ChatChannelId ?? _selectedBuilding.ChannelId;
        if (channelId is null && _selectedBuilding.VoiceMode == VillageVoiceMode.AutoRoom)
        {
            var room = await EnsureCurrentSpaceRoomAsync();
            channelId = room?.ChatChannelId;
        }

        if (channelId is null)
            return;

        Channel? channel = await Data.FetchChannelAsync(channelId.Value);
        if (channel is null)
            return;

        var content = await ChatWindowComponent.GetDefaultContent(channel);
        await WindowService.OpenWindowAtFocused(content);
    }

    /////////////////////////////
    // Open-selection registry //
    /////////////////////////////

    // Lets the channel list highlight the village row while a village window for
    // the planet is open. Blazor WASM is single-threaded, so a plain list is safe.
    private static readonly List<VillageWindowComponent> Instances = new();

    /// <summary>
    /// Fired whenever any village window opens or closes
    /// </summary>
    public static event Action SelectionsChanged;

    /// <summary>
    /// True while any village window for this planet is open - drives the
    /// channel-list row's open highlight
    /// </summary>
    public static bool IsOpenForPlanet(long planetId)
    {
        foreach (var window in Instances)
        {
            if (window.Data?.Id == planetId)
                return true;
        }

        return false;
    }

    public class SavedState
    {
        public long PlanetId { get; set; }
    }

    public class Content : WindowContent<VillageWindowComponent, Planet>
    {
        public override async Task ImportData(string data, ValourClient client)
        {
            var saved = JsonSerializer.Deserialize<SavedState>(data);
            if (saved is null)
                return;

            Data = await client.PlanetService.FetchPlanetAsync(saved.PlanetId);
        }

        public override string ExportData(ValourClient client)
        {
            if (Data is null)
                return string.Empty;

            return JsonSerializer.Serialize(new SavedState
            {
                PlanetId = Data.Id
            });
        }
    }

    public static Content GetDefaultContent(Planet planet)
    {
        return new Content
        {
            Data = planet,
            PlanetId = planet.Id,
            Icon = planet.GetIconUrl(IconFormat.Webp128),
            Title = $"{planet.Name} Village"
        };
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        UnhookVillageEvents();
        CallSession.StateChanged -= OnCallSessionStateChanged;
        _sceneRefreshCts?.Cancel();
        if (Data is not null)
            Data.Updated -= OnPlanetUpdated;

        await SetActiveChatChannelAsync(null);
        await VillageService.LeaveMapAsync();

        // Closing the village must not leave the member sitting in a call they
        // can no longer see.
        if (_activeVoiceChannel is not null)
            await CallSession.LeaveAsync(clearChannel: true);

        await ReleaseEphemeralRoomAsync();

        if (Instances.Remove(this))
            SelectionsChanged?.Invoke();

        await ShutdownRuntimeAsync();

        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }

            _module = null;
        }

        _selfRef?.Dispose();
        _selfRef = null;
    }

    /// <summary>
    /// Tears down the JS runtime. The runtime owns a rAF loop and window-level key
    /// listeners, so releasing the .NET reference alone would leave both running
    /// against a detached canvas for the lifetime of the page.
    /// </summary>
    private async ValueTask ShutdownRuntimeAsync()
    {
        if (_runtime is null)
            return;

        var runtime = _runtime;
        _runtime = null;

        try
        {
            await runtime.InvokeVoidAsync("dispose");
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }

        try
        {
            await runtime.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
