    private IEnumerable<VillagePocCatalogItem> GetBuildItemsForTool(string tool)
    {
        return (_scene?.BuildCatalog ?? [])
            .Where(x => string.Equals(x.Kind, "Sprite", StringComparison.OrdinalIgnoreCase));
    }

    private IEnumerable<VillagePocCatalogItem> GetVisibleBuildItems()
    {
        var items = GetBuildItemsForTool(_buildTool);
        if (_buildTool == "Furnish" && _buildCategory != "All")
            items = items.Where(x => x.Category == _buildCategory);
        if (!string.IsNullOrWhiteSpace(_buildSearch))
        {
            var search = _buildSearch.Trim();
            items = items.Where(x =>
                x.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                x.Key.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        return items.OrderBy(x => x.Category).ThenBy(x => x.Name);
    }

    private IEnumerable<VillagePocTerrainItem> GetVisibleBuildTerrains()
    {
        var items = _scene?.BuildTerrains.AsEnumerable() ?? [];
        if (!string.IsNullOrWhiteSpace(_buildSearch))
        {
            var search = _buildSearch.Trim();
            items = items.Where(x =>
                x.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                x.Key.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        return items.OrderBy(x => x.Name);
    }

    private IEnumerable<VillagePocBrushItem> GetVisibleBuildBrushes()
    {
        var items = _scene?.BuildBrushes.AsEnumerable() ?? [];
        if (!string.IsNullOrWhiteSpace(_buildSearch))
        {
            var search = _buildSearch.Trim();
            items = items.Where(x =>
                x.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                x.Key.Contains(search, StringComparison.OrdinalIgnoreCase));
