            ? "Select an item or painted tile to remove it."
            : string.Empty;

        if (tool == "Paint" &&
            !((_scene?.BuildTerrains.Any(x => x.Key == _selectedBuildKey) ?? false) ||
              (_scene?.BuildBrushes.Any(x => x.Key == _selectedBuildKey) ?? false)))
        {
            _selectedBuildKey = _scene?.BuildTerrains.FirstOrDefault()?.Key ?? string.Empty;
        }
        else if (tool == "Furnish" &&
                 !GetBuildItemsForTool(tool).Any(x => x.Key == _selectedBuildKey))
        {
            _selectedBuildKey = GetBuildItemsForTool(tool).FirstOrDefault()?.Key ?? string.Empty;
        }

        await SyncBuildModeAsync();
        await ReRender();
    }

