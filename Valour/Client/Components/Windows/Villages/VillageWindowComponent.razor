@inherits WindowContentComponent<Planet>
@implements IAsyncDisposable
@inject IJSRuntime JsRuntime
@inject Valour.Sdk.Services.VillageService VillageService
@inject Valour.Client.Components.Calls.GlobalCallSessionService CallSession
@inject Valour.Sdk.Services.MessageService MessageService
@inject ValourClient Client
@using System.Text.Json
@using Valour.Shared.Models
@using Valour.Shared.Villages
@using Channel = Valour.Sdk.Models.Channel

@if (_loading)
{
    <Loading Title="Loading village..." Spin="@true" />
}
else if (_error is not null)
{
    <div class="village-empty-state">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@_error</span>
    </div>
}
else
{
    <div class="village-window @(_activeVoiceChannel is not null ? "has-call" : string.Empty) @(_buildMode ? "build-mode-active" : string.Empty)">
        <canvas id="@_canvasId" class="village-canvas"></canvas>

        <div class="village-overlay village-world-header">
            <div class="overlay-card village-brand-card">
                <div class="village-kicker">Valour Village</div>
                <div class="village-title">@_scene!.Title</div>
                <div class="village-subtitle">@_scene.Subtitle</div>
            </div>
            <div class="overlay-inline-group">
                <span class="hud-chip"><i class="bi bi-geo-alt-fill"></i> @(_currentMap?.Name ?? "Unknown Map")</span>
                <span class="hud-chip live"><span class="live-dot"></span> @(VillageService.Presences.Count + 1) here</span>
            </div>
        </div>

        <div class="village-overlay village-quick-controls">
            <div class="quick-control-bar">
                @if (CanBuildCurrentMap)
                {
                    <button class="village-icon-button @(_buildMode ? "active" : string.Empty)"
                            @onclick="ToggleBuildModeAsync"
                            title="@(_buildMode ? "Close build mode" : "Furnish and paint")"
                            aria-label="@(_buildMode ? "Close build mode" : "Open build mode")">
                        <i class="bi bi-hammer"></i>
                    </button>
                }
                <div class="village-zoom-control" role="group" aria-label="Map zoom">
                    <button class="village-zoom-button"
                            disabled="@(_zoomPercent <= 50)"
                            @onclick="ZoomOutAsync"
                            title="Zoom out (or scroll down)"
                            aria-label="Zoom out">
                        <i class="bi bi-dash-lg"></i>
                    </button>
                    <button class="village-zoom-level"
                            @onclick="ResetZoomAsync"
                            title="Reset zoom to 100%"
                            aria-label="Reset zoom to 100 percent">
                        @_zoomPercent%
                    </button>
                    <button class="village-zoom-button"
                            disabled="@(_zoomPercent >= 200)"
                            @onclick="ZoomInAsync"
                            title="Zoom in (or scroll up)"
                            aria-label="Zoom in">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                @if (_currentMap?.MapKind == "Interior")
                {
                    <button class="village-icon-button" @onclick="ReturnOutsideAsync" title="Leave building" aria-label="Leave building">
                        <i class="bi bi-door-open-fill"></i>
                    </button>
                }
                <label class="village-icon-toggle @(_proximityVoice ? "active" : string.Empty)" title="Spatial proximity voice">
                    <input type="checkbox" checked="@_proximityVoice" @onchange="OnToggleProximityVoice" />
                    <i class="bi bi-soundwave"></i>
                    <span>Spatial</span>
                </label>
                <label class="village-icon-toggle @(_autoJoinVoice ? "active" : string.Empty)" title="Automatically follow building voice rooms">
                    <input type="checkbox" checked="@_autoJoinVoice" @onchange="OnToggleAutoJoin" />
                    <i class="bi bi-mic-fill"></i>
                    <span>Auto join</span>
                </label>
            </div>
        </div>

        @if (_activeVoiceChannel is not null)
        {
            <aside class="village-call-surface @(_voicePanelCollapsed ? "collapsed" : string.Empty)">
                <div class="village-call-titlebar">
                    <div>
                        <span class="eyebrow">@(_activeVoiceVideoMode ? "Video room" : "Voice room")</span>
                        <strong>@(_activeVoiceBuildingName ?? _activeVoiceChannel.Name)</strong>
                    </div>
                    <button class="village-icon-button compact"
                            @onclick="ToggleVoicePanel"
                            title="@(_voicePanelCollapsed ? "Expand meeting" : "Minimize meeting")">
                        <i class="bi @(_voicePanelCollapsed ? "bi-chevron-up" : "bi-chevron-down")"></i>
                    </button>
                </div>
                @if (!_voicePanelCollapsed)
                {
                    <div class="village-call-body">
                        <CallPanelComponent @key="_activeVoiceChannel.Id"
                                            Channel="_activeVoiceChannel"
                                            VideoMode="_activeVoiceVideoMode" />
                    </div>
                }
            </aside>
        }

        @if (!_buildMode && (_selectedBuilding is not null || _selectedPlot is not null))
        {
            <aside class="village-overlay village-inspector">
                <div class="overlay-card village-building-card">
                    @if (_selectedBuilding is not null)
                    {
                        <div class="inspector-heading">
                            <div class="place-icon"><i class="bi bi-building-fill"></i></div>
                            <div>
                                <div class="overlay-card-title">Place</div>
                                <div class="sidebar-building-name">@_selectedBuilding.Name</div>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_selectedBuilding.Hint))
                        {
                            <div class="overlay-card-body">@_selectedBuilding.Hint</div>
                        }
                        <div class="place-facts">
                            @if (_selectedBuilding.IsOwnedByLocalMember)
                            {
                                <span class="place-fact owned"><i class="bi bi-key-fill"></i> Yours</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(_selectedBuilding.OwnerName))
                            {
                                <span class="place-fact"><i class="bi bi-person-fill"></i> @_selectedBuilding.OwnerName</span>
                            }
                            else
                            {
                                <span class="place-fact"><i class="bi bi-people-fill"></i> Community property</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(_selectedBuilding.ChannelName))
                            {
                                <span class="place-fact"><i class="bi bi-hash"></i> @_selectedBuilding.ChannelName</span>
                            }
                            else if (_selectedBuilding.VoiceMode == VillageVoiceMode.AutoRoom)
                            {
                                <span class="place-fact"><i class="bi bi-stars"></i> Private area room</span>
                            }
                            @if (_selectedBuilding.ForSale)
                            {
                                <span class="place-fact sale"><i class="bi bi-tag-fill"></i> @FormatPrice(_selectedBuilding.Price)</span>
                            }
                        </div>
                        @if (CanEditProperty(_selectedBuilding.IsOwnedByLocalMember))
                        {
                            <button class="manage-toggle @(_editingProperty ? "open" : string.Empty)" @onclick="ToggleEditProperty">
                                <i class="bi bi-gear-fill"></i>
                                @(_editingProperty ? "Close manage panel" : "Manage this building")
                            </button>
                        }
                        @if (_editingProperty && CanEditProperty(_selectedBuilding.IsOwnedByLocalMember))
                        {
                            <div class="manage-editor">
                                <label class="manage-field">
                                    <span>Name</span>
                                    <input maxlength="48"
                                           value="@_editName"
                                           @oninput="e => _editName = e.Value?.ToString() ?? string.Empty"
                                           aria-label="Building name" />
                                </label>
                                <label class="manage-field">
                                    <span>Description</span>
                                    <textarea maxlength="256"
                                              rows="2"
                                              value="@_editDescription"
                                              @oninput="e => _editDescription = e.Value?.ToString() ?? string.Empty"
                                              aria-label="Building description"></textarea>
                                </label>
                                @if (_scene?.CanManageVillage == true)
                                {
                                    <label class="manage-field">
                                        <span>Linked channel</span>
                                        <select value="@_editChannelValue"
                                                @onchange="e => _editChannelValue = e.Value?.ToString() ?? string.Empty"
                                                aria-label="Linked channel">
                                            <option value="">None — private area room</option>
                                            @foreach (var channel in GetLinkableChannels())
                                            {
                                                <option value="@channel.Id">@ChannelOptionLabel(channel)</option>
                                            }
                                        </select>
                                    </label>
                                }
                                <button class="v-btn secondary"
                                        disabled="@_editInProgress"
                                        @onclick="SaveSelectedBuildingEditsAsync">
                                    @(_editInProgress ? "Saving…" : "Save changes")
                                </button>
                            </div>
                        }
                        @if (CanEditProperty(_selectedBuilding.IsOwnedByLocalMember))
                        {
                            <div class="listing-editor">
                                <div class="listing-price-field">
                                    <span>@(_scene?.CurrencySymbol ?? string.Empty)</span>
                                    <input type="number"
                                           min="0"
                                           step="any"
                                           value="@_listingPriceText"
                                           @oninput="OnListingPriceChanged"
                                           aria-label="Building sale price" />
                                </div>
                                <button class="v-btn secondary"
                                        disabled="@_listingInProgress"
                                        @onclick="() => SetSelectedBuildingListingAsync(true)">
                                    @(_selectedBuilding.ForSale ? "Update listing" : "List for sale")
                                </button>
                                @if (_selectedBuilding.ForSale)
                                {
                                    <button class="listing-remove" @onclick="() => SetSelectedBuildingListingAsync(false)">Remove</button>
                                }
                            </div>
                        }
                        <div class="overlay-button-column">
                            @if (_selectedBuilding.ForSale && !_selectedBuilding.IsOwnedByLocalMember)
                            {
                                <button class="v-btn village-primary-action"
                                        disabled="@_purchaseInProgress"
                                        @onclick="ConfirmPurchaseSelectedBuilding">
                                    <i class="bi bi-bag-check-fill"></i>
                                    @(_purchaseInProgress ? "Completing purchase…" : $"Buy for {FormatPrice(_selectedBuilding.Price)}")
                                </button>
                            }
                            @if (_selectedBuilding.InteriorMapId is not null)
                            {
                                <button class="v-btn" @onclick="EnterSelectedBuildingAsync">
                                    <i class="bi bi-door-open-fill"></i> Enter
                                </button>
                            }
                            @if (CanOpenChat(_selectedBuilding))
                            {
                                <button class="v-btn secondary" @onclick="OpenSelectedChannelAsync">
                                    <i class="bi bi-chat-left-text-fill"></i>
                                    @(_selectedBuilding.ChannelId is null ? "Open area chat" : "Open channel")
                                </button>
                            }
                            @if (CanJoinVoiceFromHere(_selectedBuilding) && _activeVoiceBuildingId != _selectedBuilding.Id)
                            {
                                <button class="v-btn secondary" @onclick="() => JoinBuildingVoiceAsync(_selectedBuilding)">
                                    <i class="bi bi-headset"></i> Join meeting here
                                </button>
                            }
                        </div>
                    }
                    else if (_selectedPlot is not null)
                    {
                        <div class="inspector-heading">
                            <div class="place-icon plot"><i class="bi bi-bounding-box"></i></div>
                            <div>
                                <div class="overlay-card-title">Land parcel</div>
                                <div class="sidebar-building-name">@_selectedPlot.Name</div>
                            </div>
                        </div>
                        <div class="place-facts">
                            <span class="place-fact"><i class="bi bi-aspect-ratio-fill"></i> @_selectedPlot.Width × @_selectedPlot.Height tiles</span>
                            @if (_selectedPlot.IsOwnedByLocalMember)
                            {
                                <span class="place-fact owned"><i class="bi bi-key-fill"></i> Yours</span>
                            }
                            else if (!string.IsNullOrWhiteSpace(_selectedPlot.OwnerName))
                            {
                                <span class="place-fact"><i class="bi bi-person-fill"></i> @_selectedPlot.OwnerName</span>
                            }
                            else
                            {
                                <span class="place-fact"><i class="bi bi-people-fill"></i> Community land</span>
                            }
                            @if (_selectedPlot.ForSale)
                            {
                                <span class="place-fact sale"><i class="bi bi-tag-fill"></i> @FormatPrice(_selectedPlot.Price)</span>
                            }
                        </div>
                        @if (CanEditProperty(_selectedPlot.IsOwnedByLocalMember))
                        {
                            <button class="manage-toggle @(_editingProperty ? "open" : string.Empty)" @onclick="ToggleEditProperty">
                                <i class="bi bi-gear-fill"></i>
                                @(_editingProperty ? "Close manage panel" : "Manage this parcel")
                            </button>
                        }
                        @if (_editingProperty && CanEditProperty(_selectedPlot.IsOwnedByLocalMember))
                        {
                            <div class="manage-editor">
                                <label class="manage-field">
                                    <span>Name</span>
                                    <input maxlength="48"
                                           value="@_editName"
                                           @oninput="e => _editName = e.Value?.ToString() ?? string.Empty"
                                           aria-label="Parcel name" />
                                </label>
                                <button class="v-btn secondary"
                                        disabled="@_editInProgress"
                                        @onclick="SaveSelectedPlotEditsAsync">
                                    @(_editInProgress ? "Saving…" : "Save changes")
                                </button>
                            </div>
                        }
                        @if (CanEditProperty(_selectedPlot.IsOwnedByLocalMember))
                        {
                            <div class="listing-editor">
                                <div class="listing-price-field">
                                    <span>@(_scene?.CurrencySymbol ?? string.Empty)</span>
                                    <input type="number"
                                           min="0"
                                           step="any"
                                           value="@_listingPriceText"
                                           @oninput="OnListingPriceChanged"
                                           aria-label="Parcel sale price" />
                                </div>
                                <button class="v-btn secondary"
                                        disabled="@_listingInProgress"
                                        @onclick="() => SetSelectedPlotListingAsync(true)">
                                    @(_selectedPlot.ForSale ? "Update listing" : "List for sale")
                                </button>
                                @if (_selectedPlot.ForSale)
                                {
                                    <button class="listing-remove" @onclick="() => SetSelectedPlotListingAsync(false)">Remove</button>
                                }
                            </div>
                        }
                        @if (_selectedPlot.ForSale && !_selectedPlot.IsOwnedByLocalMember)
                        {
                            <button class="v-btn village-primary-action"
                                    disabled="@_purchaseInProgress"
                                    @onclick="ConfirmPurchaseSelectedPlot">
                                <i class="bi bi-bag-check-fill"></i>
                                @(_purchaseInProgress ? "Claiming parcel…" : $"Claim for {FormatPrice(_selectedPlot.Price)}")
                            </button>
                        }
                    }
                </div>
            </aside>
        }

        @if (_buildMode)
        {
            <aside class="village-build-panel" aria-label="Village build mode">
                <div class="build-panel-header">
                    <div>
                        <span class="eyebrow">Build mode</span>
                        <strong>@GetBuildScopeLabel()</strong>
                    </div>
                    <div class="build-panel-actions">
                        @if (_buildEditInProgress)
                        {
                            <span class="build-saving"><i class="bi bi-arrow-repeat"></i> Saving</span>
                        }
                        <button class="village-icon-button compact" @onclick="ToggleBuildModeAsync" title="Done building">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>

                <div class="build-tool-row" role="tablist" aria-label="Build tools">
                    <button class="@GetBuildToolClass("Furnish")" @onclick='() => SetBuildToolAsync("Furnish")'>
                        <i class="bi bi-lamp-fill"></i><span>Furnish</span>
                    </button>
                    <button class="@GetBuildToolClass("Paint")" @onclick='() => SetBuildToolAsync("Paint")'>
                        <i class="bi bi-paint-bucket"></i><span>Paint</span>
                    </button>
                    <button class="@GetBuildToolClass("Erase")" @onclick='() => SetBuildToolAsync("Erase")'>
                        <i class="bi bi-eraser-fill"></i><span>Erase</span>
                    </button>
                </div>

                @if (_buildTool == "Erase")
                {
                    <div class="build-erase-hint">
                        <i class="bi bi-cursor-fill"></i>
                        <span>Select furniture or a painted tile in your editable area to remove it.</span>
                    </div>
                }
                else
                {
                    <div class="build-catalog-controls">
                        <label class="build-search">
                            <i class="bi bi-search"></i>
                            <input value="@_buildSearch"
                                   @oninput="e => _buildSearch = e.Value?.ToString() ?? string.Empty"
                                   placeholder="Search the catalog…"
                                   aria-label="Search build catalog" />
                        </label>
                        @if (_buildTool == "Furnish")
                        {
                            <div class="build-categories">
                                @foreach (var category in GetBuildCategories())
                                {
                                    <button class="@(_buildCategory == category ? "active" : string.Empty)"
                                            @onclick="() => SetBuildCategory(category)">@category</button>
                                }
                            </div>
                        }
                    </div>

                    <div class="build-catalog">
                        @if (_buildTool == "Paint")
                        {
                            <div class="build-catalog-section-title">
                                <span>Auto terrain</span>
                                <small>Edges connect</small>
                            </div>
                            @foreach (var terrain in GetVisibleBuildTerrains())
                            {
                                <button class="build-catalog-item @(_selectedBuildKey == terrain.Key ? "active" : string.Empty)"
                                        title="@terrain.Name terrain brush"
                                        @onclick="() => SelectBuildTerrainAsync(terrain)">
                                    <span class="build-item-preview">
                                        <span class="build-item-sprite" style="@GetBuildPreviewStyle(terrain)"></span>
                                    </span>
                                    <span class="build-item-name">@terrain.Name</span>
                                    <span class="build-item-size terrain"><i class="bi bi-bezier2"></i> Auto</span>
                                </button>
                            }
                            @if (!GetVisibleBuildTerrains().Any())
                            {
                                <div class="build-empty">No terrain brushes match that search.</div>
                            }

                            <div class="build-catalog-section-title">
                                <span>Manual brushes</span>
                                <small>Exact authored pattern</small>
                            </div>
                            @foreach (var brush in GetVisibleBuildBrushes())
                            {
                                <button class="build-catalog-item @(_selectedBuildKey == brush.Key ? "active" : string.Empty)"
                                        title="@brush.Name manual brush"
                                        @onclick="() => SelectBuildBrushAsync(brush)">
                                    <span class="build-item-preview">
                                        <span class="manual-brush-pattern" style="@GetBuildBrushPreviewStyle(brush)">
                                            @foreach (var cell in brush.Cells)
                                            {
                                                <span style="@GetBuildBrushCellStyle(cell)"></span>
                                            }
                                        </span>
                                    </span>
                                    <span class="build-item-name">@brush.Name</span>
                                    <span class="build-item-size manual">@brush.Size×@brush.Size</span>
                                </button>
                            }
                            @if (!GetVisibleBuildBrushes().Any())
                            {
                                <div class="build-empty">No manual brushes match that search.</div>
                            }
                        }
                        else
                        {
                            @foreach (var item in GetVisibleBuildItems())
                            {
                                <button class="build-catalog-item @(_selectedBuildKey == item.Key ? "active" : string.Empty)"
                                        title="@item.Name"
                                        @onclick="() => SelectBuildItemAsync(item)">
                                    <span class="build-item-preview">
                                        <span class="build-item-sprite" style="@GetBuildPreviewStyle(item)"></span>
                                    </span>
                                    <span class="build-item-name">@item.Name</span>
                                    @if (item.FootprintWidth > 1 || item.FootprintHeight > 1)
                                    {
                                        <span class="build-item-size">@item.FootprintWidth×@item.FootprintHeight</span>
                                    }
                                </button>
                            }
                            @if (!GetVisibleBuildItems().Any())
                            {
                                <div class="build-empty">No catalog items match that search.</div>
                            }
                        }
                    </div>
                }

                <div class="build-panel-footer">
                    @if (_buildTool == "Paint")
                    {
                        <span><kbd>Shift</kbd> drag to fill an area</span>
                    }
                    else
                    {
                        <span><i class="bi bi-cursor-fill"></i> Click a tile to @_buildTool.ToLowerInvariant()</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(_buildStatus))
                    {
                        <span class="build-status">@_buildStatus</span>
                    }
                </div>
            </aside>
        }

        @if (!_buildMode && _activeChatChannel is not null)
        {
            <div class="village-overlay village-chat-composer">
                <div class="composer-context">
                    <span>Speaking in</span>
                    <strong>@(_currentBuildingName ?? _activeChatChannel.Name)</strong>
                </div>
                <div class="composer-row">
                    <input value="@_chatDraft"
                           @oninput="OnChatDraftChanged"
                           @onkeydown="OnChatKeyDown"
                           maxlength="120"
                           disabled="@_sendingChat"
                           placeholder="Say something nearby…" />
                    <button class="composer-send"
                            disabled="@(_sendingChat || string.IsNullOrWhiteSpace(_chatDraft))"
                            @onclick="SendVillageMessageAsync"
                            title="Send message">
                        <i class="bi bi-send-fill"></i>
                    </button>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_actionMessage))
        {
            <div class="village-toast @(_actionIsError ? "error" : string.Empty)">
                <i class="bi @(_actionIsError ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill")"></i>
                <span>@_actionMessage</span>
                <button @onclick="DismissActionMessage" aria-label="Dismiss"><i class="bi bi-x-lg"></i></button>
            </div>
        }

        <div class="village-movement-hint @(_buildMode ? "building" : string.Empty)">
            @if (_buildMode)
            {
                <i class="bi bi-grid-3x3-gap-fill"></i><span>Editable tiles glow · choose Done to walk normally</span>
            }
            else if (DeviceInfo.IsMobile)
            {
                <i class="bi bi-hand-index-thumb-fill"></i><span>Drag anywhere to move · tap places to inspect</span>
            }
            else
            {
                <span class="keycap">W</span><span class="keycap">A</span><span class="keycap">S</span><span class="keycap">D</span>
                <span>Move · walk into glowing doors</span>
            }
        </div>
    </div>
}

@code {
    private readonly string _canvasId = $"village-canvas-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private IJSObjectReference? _runtime;
    private DotNetObjectReference<VillageWindowComponent>? _selfRef;
    private VillagePocScene? _scene;
    private VillagePocMap? _currentMap;
    private VillagePocBuilding? _selectedBuilding;
    private VillagePocPlot? _selectedPlot;
    private bool _loading = true;
    private bool _initializing;
    private bool _disposed;
    private string? _error;
    private bool _proximityVoice;
    private bool _autoJoinVoice;
    private int _zoomPercent = 100;
    private long? _currentBuildingId;
    private string? _currentBuildingName;
    private long? _activeVoiceBuildingId;
    private string? _activeVoiceBuildingName;
    private Channel? _activeVoiceChannel;
    private Channel? _activeChatChannel;
    private VillageEphemeralRoom? _ephemeralRoom;
    private long? _ephemeralRoomBuildingId;
    private bool _activeVoiceVideoMode;
    private bool _voicePanelCollapsed;
    private string _chatDraft = string.Empty;
    private bool _sendingChat;
    private bool _purchaseInProgress;
    private bool _listingInProgress;
    private string _listingPriceText = "0";
    private bool _editingProperty;
    private bool _editInProgress;
    private string _editName = string.Empty;
    private string _editDescription = string.Empty;
    private string _editChannelValue = string.Empty;
    private string? _actionMessage;
    private bool _actionIsError;
    private bool _buildMode;
    private bool _buildEditInProgress;
    private string _buildTool = "Furnish";
    private string _buildCategory = "All";
    private string _buildSearch = string.Empty;
    private string _selectedBuildKey = string.Empty;
    private string _buildStatus = string.Empty;
    private DateTime _ignoreObjectRefreshUntil;

    protected override async Task OnInitializedAsync()
    {
        Instances.Add(this);
        SelectionsChanged?.Invoke();
        CallSession.StateChanged += OnCallSessionStateChanged;

        _loading = true;
        _error = null;

        if (Data is null)
        {
            _error = "Village demo could not resolve the target planet.";
            _loading = false;
            await ReRender();
            return;
        }

        var result = await VillageService.FetchProofOfConceptSceneAsync(Data.Id);
        if (!result.Success || result.Data is null)
        {
            _error = result.Message ?? "Village demo failed to load.";
            _loading = false;
            await ReRender();
            return;
        }

        _scene = result.Data;
        _currentMap = _scene.Maps.FirstOrDefault(x => x.Id == _scene.StartingMapId);
        _selectedBuildKey = _scene.BuildCatalog
            .FirstOrDefault(x => string.Equals(x.Kind, "Sprite", StringComparison.OrdinalIgnoreCase))?.Key
            ?? _scene.BuildCatalog.FirstOrDefault()?.Key
            ?? string.Empty;

        // A restored window can reach this point before the planet's channel
        // list has loaded, and the manage panel's channel picker needs it.
        if (Data.Channels.Count == 0)
            await Data.FetchChannelsAsync();

        _loading = false;
        await ReRender();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scene is null || _error is not null || _runtime is not null || _initializing || _disposed)
            return;

        // The scene arrives after the first render, so we cannot key off firstRender.
        // _runtime is only assigned after two awaits, so it cannot guard re-entry on its own.
        _initializing = true;
        try
        {
            _selfRef = DotNetObjectReference.Create(this);
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./_content/Valour.Client/Components/Windows/Villages/VillageWindowComponent.razor.js");

            if (_disposed)
                return;

            _runtime = await _module.InvokeAsync<IJSObjectReference>("init", _canvasId, _selfRef, _scene, DeviceInfo.IsMobile);

            if (_disposed)
            {
                await ShutdownRuntimeAsync();
                return;
            }

            VillageService.PresenceChanged += OnPresenceChanged;
            VillageService.MapRejoined += OnVillageMapRejoined;
            MessageService.MessageReceived += OnMessageReceived;
            Data.VillageBuildings.Changed += OnVillageBuildingChanged;
            Data.VillagePlots.Changed += OnVillagePlotChanged;
            Data.VillageObjects.Changed += OnVillageObjectChanged;
            await JoinCurrentMapAsync();
            await OnBuildingContextChangedAsync();
            await PushVoicePeersAsync();
        }
        finally
        {
            _initializing = false;
        }
    }

    // Snowflake ids exceed JavaScript's 2^53 float precision, so the runtime
    // traffics in string ids: a rounded double coming back from JS would fail
    // every exact lookup below and the inspector would never open.
    private static long? ParseId(string? id) =>
        long.TryParse(id, out var parsed) ? parsed : null;

    [JSInvokable]
    public async Task OnBuildingSelected(string? buildingIdRaw, string? currentMapIdRaw)
    {
        if (_scene is null || _disposed)
            return;

        var buildingId = ParseId(buildingIdRaw);
        var currentMapId = ParseId(currentMapIdRaw);

        _currentMap = _scene.Maps.FirstOrDefault(x => x.Id == currentMapId) ?? _currentMap;
        var previousId = _selectedBuilding?.Id;
        _selectedBuilding = _scene.Maps
            .SelectMany(x => x.Buildings)
            .FirstOrDefault(x => x.Id == buildingId);
        if (_selectedBuilding is not null)
        {
            _selectedPlot = null;
            _listingPriceText = _selectedBuilding.Price.ToString(System.Globalization.CultureInfo.InvariantCulture);
            if (previousId != _selectedBuilding.Id)
                _editingProperty = false;
        }

        await ReRender();
    }

    [JSInvokable]
    public async Task OnPlotSelected(string? plotIdRaw, string? currentMapIdRaw)
    {
        if (_scene is null || _disposed)
            return;

        var plotId = ParseId(plotIdRaw);
        var currentMapId = ParseId(currentMapIdRaw);

        _currentMap = _scene.Maps.FirstOrDefault(x => x.Id == currentMapId) ?? _currentMap;
        var previousId = _selectedPlot?.Id;
        _selectedPlot = _scene.Maps
            .SelectMany(x => x.Plots)
            .FirstOrDefault(x => x.Id == plotId);
        if (_selectedPlot is not null)
        {
            _selectedBuilding = null;
            _listingPriceText = _selectedPlot.Price.ToString(System.Globalization.CultureInfo.InvariantCulture);
            if (previousId != _selectedPlot.Id)
                _editingProperty = false;
        }

        await ReRender();
    }

    [JSInvokable]
    public async Task OnMapChanged(string? mapIdRaw, int x, int y)
    {
        if (_scene is null || _disposed)
            return;

        var mapId = ParseId(mapIdRaw);

        _currentMap = _scene.Maps.FirstOrDefault(x => x.Id == mapId) ?? _currentMap;
        _currentBuildingId = _currentMap?.ParentBuildingId;

        if (_buildMode && !CanBuildCurrentMap)
            _buildMode = false;
        await SyncBuildModeAsync();

        // The room endpoint only leases to members who are actually present in
        // the area. Join at the runtime's real destination before resolving the
        // area's temporary chat/call.
        await JoinCurrentMapAsync(x, y);
        await OnBuildingContextChangedAsync();

        // Stepping back outside clears the inspector; the building panel only makes
        // sense while its own interior is the active map.
        if (_currentMap?.MapKind == "Outdoor" && _selectedBuilding?.InteriorMapId != mapId)
            _selectedBuilding = null;

        // Presence is per-map, so stepping through a door moves us between
        // realtime groups as well as between maps.
        await ReRender();
    }

    [JSInvokable]
    public async Task OnZoomChanged(int percent)
    {
        if (_disposed)
            return;

        _zoomPercent = Math.Clamp(percent, 50, 200);
        await ReRender();
    }

    /// <summary>
    /// Announces us on the map we are standing on and seeds everyone already
    /// there. Called on open and again whenever we walk through a door, since
    /// presence is scoped per map rather than per planet.
    /// </summary>
    private async Task JoinCurrentMapAsync(int? x = null, int? y = null)
    {
        if (Data is null || _currentMap is null || _disposed)
            return;

        var spawn = _currentMap.SpawnTile;
        await VillageService.JoinMapAsync(
            Data,
            _currentMap.Id,
            x ?? spawn?.X ?? 0,
            y ?? spawn?.Y ?? 0,
            _currentBuildingId);
        await PushPresencesAsync();
    }

    /// <summary>
    /// Surfaces chat as a bubble above the speaker, but only for people who are
    /// actually standing in this village. A planet's channels carry far more
    /// traffic than the map has occupants, so anything else would be noise from
    /// members who are not even here.
    /// </summary>
    private void OnMessageReceived(Message message)
    {
        if (_disposed || _runtime is null || message is null)
            return;

        if (string.IsNullOrWhiteSpace(message.Content))
            return;

        // Only chat from the room the member is standing in, plus their own
        // messages, belongs on the map.
        if (!IsMessageAudibleHere(message))
            return;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await _runtime.InvokeVoidAsync("pushBubble", message.AuthorUserId.ToString(), message.Content);
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        });
    }

    private bool IsMessageAudibleHere(Message message)
    {
        var isLocal = message.AuthorUserId == Client.Me?.Id;
        var speakerIsHere = isLocal || VillageService.Presences.Any(x => x.UserId == message.AuthorUserId);

        if (!speakerIsHere)
            return false;

        // A message counts when it was sent in the channel bound to the building
        // the speaker is standing in.
        var speakerBuildingId = isLocal
            ? _currentBuildingId
            : VillageService.Presences.FirstOrDefault(x => x.UserId == message.AuthorUserId)?.BuildingId;

        if (speakerBuildingId is null)
            return _currentBuildingId is null &&
                   _scene?.DefaultChatChannelId == message.ChannelId;

        var building = _scene?.Maps
            .SelectMany(x => x.Buildings)
            .FirstOrDefault(x => x.Id == speakerBuildingId);

        if (building?.ChatChannelId == message.ChannelId)
            return true;

        return speakerBuildingId == _ephemeralRoomBuildingId &&
               _ephemeralRoom?.ChatChannelId == message.ChannelId;
    }

    private CancellationTokenSource? _sceneRefreshCts;

    private void OnVillageBuildingChanged(Valour.Sdk.ModelLogic.IModelEvent<VillageBuilding> _) =>
        QueueSceneRefresh();

    private void OnVillagePlotChanged(Valour.Sdk.ModelLogic.IModelEvent<VillagePlot> _) =>
        QueueSceneRefresh();

    private void OnVillageObjectChanged(
        Valour.Sdk.ModelLogic.IModelEvent<Valour.Sdk.Models.VillageObject> _)
    {
        // The edit response already contains the exact local delta. Ignore our
        // own immediately echoed model event; remote edits still refresh once.
        if (DateTime.UtcNow >= _ignoreObjectRefreshUntil)
            QueueSceneRefresh();
    }

    /// <summary>
    /// Property changes arrive over the realtime hub whenever anyone buys,
    /// lists, or edits a building or parcel. The scene is refetched rather than
    /// patched - ownership changes ripple into names, prices, and tint colors -
    /// and the delay coalesces bursts (a purchase updates several models).
    /// </summary>
    private void QueueSceneRefresh()
    {
        if (_disposed)
            return;

        _sceneRefreshCts?.Cancel();
        var cts = new CancellationTokenSource();
        _sceneRefreshCts = cts;

        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(400, cts.Token);
            }
            catch (TaskCanceledException)
            {
                return;
            }

            if (_disposed || cts.IsCancellationRequested)
                return;

            await RefreshSceneAsync(_selectedBuilding?.Id, _selectedPlot?.Id);
            await ReRender();
        });
    }

    private void OnPresenceChanged()
    {
        // Fired from the hub, so hop back onto the renderer's context.
        _ = InvokeAsync(async () =>
        {
            await PushPresencesAsync();
            await ReRender();
        });
    }

    /// <summary>
    /// A SignalR reconnect drops server-side presence and temporary-room
    /// occupancy. Presence has already been restored by VillageService; renew
    /// the room lease as well, and only rebuild the call when the server had to
    /// replace its ephemeral channel during a restart.
    /// </summary>
    private async Task OnVillageMapRejoined()
    {
        if (_disposed)
            return;

        await InvokeAsync(async () =>
        {
            var previousVoiceBuildingId = _activeVoiceBuildingId;
            var previousVoiceChannelId = _activeVoiceChannel?.Id;
            var currentBuilding = _currentBuildingId is null
                ? null
                : _scene?.Maps
                    .SelectMany(x => x.Buildings)
                    .FirstOrDefault(x => x.Id == _currentBuildingId.Value);
            var usesEphemeralRoom = currentBuilding?.VoiceMode == VillageVoiceMode.AutoRoom &&
                                    currentBuilding.ChannelId is null;

            // The server released this user's lease on disconnect. Clearing
            // the local handle forces EnsureEphemeralRoomAsync to reacquire it
            // instead of returning the now-stale cached response.
            if (usesEphemeralRoom)
            {
                _ephemeralRoom = null;
                _ephemeralRoomBuildingId = null;
            }

            await OnBuildingContextChangedAsync();

            if (usesEphemeralRoom &&
                previousVoiceBuildingId is not null &&
                previousVoiceBuildingId == _currentBuildingId &&
                previousVoiceChannelId != _ephemeralRoom?.ChannelId)
            {
                await LeaveVoiceAsync();
                if (currentBuilding is not null && _ephemeralRoom is not null)
                    await JoinBuildingVoiceAsync(currentBuilding);
            }

            await PushPresencesAsync();
            await ReRender();
        });
    }

    /// <summary>
    /// Hands the current occupancy to the canvas runtime. The runtime owns
    /// interpolation, so it receives target tiles rather than pixel positions.
    /// </summary>
    private async Task PushPresencesAsync()
    {
        if (_runtime is null || _disposed)
            return;

        // Ids go over as strings: snowflakes overflow JS number precision, and
        // the runtime only ever compares them for equality anyway.
        var others = VillageService.Presences
            .Select(x => new
            {
                userId = x.UserId.ToString(),
                name = x.Name,
                avatarUrl = x.AvatarUrl,
                x = x.X,
                y = x.Y,
                facing = (int)x.Facing,
                buildingId = x.BuildingId?.ToString(),
            })
            .ToArray();

        try
        {
            await _runtime.InvokeVoidAsync("setPresences", others);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    /// <summary>
    /// Called by the runtime each time the local player finishes a step.
    /// </summary>
    [JSInvokable]
    public async Task OnLocalMoved(int x, int y, int facing, string? buildingIdRaw)
    {
        if (_disposed)
            return;

        var buildingId = ParseId(buildingIdRaw);

        // Await the hub send when changing spatial context so the server sees us
        // inside the area before its room lease request arrives over HTTP.
        await VillageService.ReportMoveAsync(x, y, (VillageFacing)facing, buildingId);

        if (buildingId == _currentBuildingId)
            return;

        _currentBuildingId = buildingId;
        await OnBuildingContextChangedAsync();
    }

    private static bool CanHostVoice(VillagePocBuilding building) =>
        building.VoiceMode == VillageVoiceMode.AutoRoom ||
        (building.ChannelId is not null &&
         building.ChannelType is not null &&
         ISharedChannel.VoiceChannelTypes.Contains(building.ChannelType.Value));

    private bool CanOpenChat(VillagePocBuilding building) =>
        building.ChatChannelId is not null ||
        (building.VoiceMode == VillageVoiceMode.AutoRoom &&
         building.Id == _currentBuildingId);

    private bool CanJoinVoiceFromHere(VillagePocBuilding building) =>
        CanHostVoice(building) &&
        (building.ChannelId is not null || building.Id == _currentBuildingId);

    /// <summary>
    /// Walking in or out of a building follows the voice room, but only once the
    /// member has opted in. Joining a call the moment someone wanders through a
    /// door would open their microphone without them asking.
    /// </summary>
    private async Task OnBuildingContextChangedAsync()
    {
        var building = _currentBuildingId is null
            ? null
            : _scene?.Maps.SelectMany(x => x.Buildings).FirstOrDefault(x => x.Id == _currentBuildingId);
        var usesEphemeralRoom = building?.VoiceMode == VillageVoiceMode.AutoRoom &&
                                building.ChannelId is null;
        var activeVoiceWasHere = building is not null && _activeVoiceBuildingId == building.Id;

        if (_ephemeralRoomBuildingId is not null &&
            (_ephemeralRoomBuildingId != building?.Id || !usesEphemeralRoom))
        {
            if (_activeVoiceBuildingId == _ephemeralRoomBuildingId)
                await LeaveVoiceAsync();

            await ReleaseEphemeralRoomAsync();
        }

        _currentBuildingName = building?.Name;
        _activeChatChannel = null;

        long? chatChannelId;
        VillageEphemeralRoom? room = null;
        if (usesEphemeralRoom)
        {
            room = await EnsureEphemeralRoomAsync(building!);
            chatChannelId = room?.ChatChannelId;
        }
        else
        {
            chatChannelId = building is null
                ? _scene?.DefaultChatChannelId
                : building.ChatChannelId;
        }

        if (chatChannelId is not null && Data is not null)
        {
            var contextChannel = await Data.FetchChannelAsync(chatChannelId.Value);
            if (contextChannel?.IsChatChannel == true)
                _activeChatChannel = contextChannel;
        }

        var expectedVoiceChannelId = building is null || !CanHostVoice(building)
            ? null
            : building.ChannelId ?? room?.ChannelId;

        // A scene refresh can rebind this same building to a different channel.
        // Building-id equality alone is not enough: preserve the user's active
        // call intent while moving the call to the new authoritative channel.
        if (activeVoiceWasHere && _activeVoiceChannel?.Id != expectedVoiceChannelId)
        {
            if (_activeVoiceBuildingId is not null)
                await LeaveVoiceAsync();

            if (building is not null && expectedVoiceChannelId is not null)
                await JoinBuildingVoiceAsync(building);
        }

        if (!_autoJoinVoice)
        {
            await ReRender();
            return;
        }

        if (building is null || !CanHostVoice(building))
        {
            if (_activeVoiceBuildingId is not null)
                await LeaveVoiceAsync();

            await ReRender();
            return;
        }

        if (_activeVoiceBuildingId == building.Id)
            return;

        await JoinBuildingVoiceAsync(building);
    }

    private async Task JoinBuildingVoiceAsync(VillagePocBuilding building)
    {
        if (Data is null)
            return;

        var channelId = building.ChannelId;
        if (channelId is null && building.VoiceMode == VillageVoiceMode.AutoRoom)
        {
            var room = await EnsureEphemeralRoomAsync(building);
            channelId = room?.ChannelId;
        }

        if (channelId is null)
            return;

        var channel = await Data.FetchChannelAsync(channelId.Value);
        if (channel is null || !ISharedChannel.VoiceChannelTypes.Contains(channel.ChannelType))
            return;

        _activeVoiceBuildingId = building.Id;
        _activeVoiceBuildingName = building.Name;
        _activeVoiceChannel = channel;
        _activeVoiceVideoMode = channel.ChannelType == ChannelTypeEnum.PlanetVideo;
        _voicePanelCollapsed = false;
        await CallSession.InitializeAsync(channel, _activeVoiceVideoMode);
        await PushVoicePeersAsync();
        await ReRender();
    }

    private async Task<VillageEphemeralRoom?> EnsureEphemeralRoomAsync(VillagePocBuilding building)
    {
        if (Data is null)
            return null;

        if (_ephemeralRoomBuildingId == building.Id && _ephemeralRoom is not null)
            return _ephemeralRoom;

        if (_ephemeralRoomBuildingId is not null)
            await ReleaseEphemeralRoomAsync();

        var result = await VillageService.AcquireBuildingRoomAsync(Data, building.Id);
        if (!result.Success || result.Data is null)
        {
            ShowActionMessage(result.Message ?? "Could not open this area's temporary room.", true);
            return null;
        }

        _ephemeralRoom = result.Data;
        _ephemeralRoomBuildingId = building.Id;
        return _ephemeralRoom;
    }

    private async Task ReleaseEphemeralRoomAsync()
    {
        var buildingId = _ephemeralRoomBuildingId;
        _ephemeralRoom = null;
        _ephemeralRoomBuildingId = null;

        if (buildingId is null || Data is null)
            return;

        await VillageService.ReleaseBuildingRoomAsync(Data, buildingId.Value);
    }

    private async Task LeaveVoiceAsync()
    {
        _activeVoiceBuildingId = null;
        _activeVoiceBuildingName = null;
        _activeVoiceChannel = null;
        _activeVoiceVideoMode = false;

        await CallSession.LeaveAsync(clearChannel: true);
        await PushVoicePeersAsync();
        await ReRender();
    }

    private void OnCallSessionStateChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await PushVoicePeersAsync();
            await ReRender();
        });
    }

    private async Task PushVoicePeersAsync()
    {
        if (_runtime is null || _disposed)
            return;

        var peers = CallSession.ParticipantsSnapshot?.Participants
            .Where(x => !x.IsSelf && !string.IsNullOrWhiteSpace(x.PeerId))
            .Select(x => new
            {
                userId = ResolveVoiceUserId(x.CustomParticipantId, x.UserId),
                peerId = x.PeerId,
            })
            .Where(x => x.userId > 0)
            .Select(x => new { userId = x.userId.ToString(), x.peerId })
            .ToArray() ?? [];

        try
        {
            await _runtime.InvokeVoidAsync("setVoicePeers", peers);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private static long ResolveVoiceUserId(string? customParticipantId, string? userId)
    {
        var source = string.IsNullOrWhiteSpace(customParticipantId) ? userId : customParticipantId;
        if (string.IsNullOrWhiteSpace(source))
            return 0;

        var separator = source.IndexOf(':');
        var value = separator > 0 ? source[..separator] : source;
        return long.TryParse(value, out var parsed) ? parsed : 0;
    }

    private async Task OnToggleProximityVoice(ChangeEventArgs e)
    {
        _proximityVoice = e.Value is true;

        if (_runtime is not null)
        {
            await _runtime.InvokeVoidAsync("setSpatialAudioEnabled", _proximityVoice);
            await PushVoicePeersAsync();
        }

        // The toggle's active styling tracks this flag, and the window base
        // suppresses automatic renders.
        await ReRender();
    }

    private async Task OnToggleAutoJoin(ChangeEventArgs e)
    {
        _autoJoinVoice = e.Value is true;

        // Entering the toggle while already standing inside a room should take
        // effect immediately rather than on the next step.
        await OnBuildingContextChangedAsync();
        await ReRender();
    }

    private async Task ToggleVoicePanel()
    {
        _voicePanelCollapsed = !_voicePanelCollapsed;
        await ReRender();
    }

    // The send button's disabled state tracks the draft, so each keystroke must
    // render or the button never lights up.
    private async Task OnChatDraftChanged(ChangeEventArgs e)
    {
        _chatDraft = e.Value?.ToString() ?? string.Empty;
        await ReRender();
    }

    private async Task OnChatKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendVillageMessageAsync();
    }

    private async Task SendVillageMessageAsync()
    {
        var channel = _activeChatChannel;
        var content = _chatDraft.Trim();
        if (channel is null || string.IsNullOrWhiteSpace(content) || _sendingChat)
            return;

        _sendingChat = true;
        _chatDraft = string.Empty;
        await ReRender();

        var result = await channel.SendMessageAsync(content);
        if (!result.Success)
        {
            _chatDraft = content;
            ShowActionMessage(result.Message ?? "That message could not be sent.", isError: true);
        }
        else if (_runtime is not null && Client.Me is not null)
        {
            // The server echo will refresh the same bubble; rendering immediately
            // makes the composer feel local even on a high-latency community node.
            await _runtime.InvokeVoidAsync("pushBubble", Client.Me.Id.ToString(), content);
        }

        _sendingChat = false;
        await ReRender();
    }

    /// <summary>
    /// Money moves on confirm, so the platform's confirmation modal sits
    /// between the button and the transaction - a mis-tap in the world must
    /// not spend someone's currency.
    /// </summary>
    private void ConfirmPurchaseSelectedBuilding()
    {
        if (_selectedBuilding is null)
            return;

        var building = _selectedBuilding;
        var modalData = new ConfirmModalComponent.ModalParams(
            $"Buy {building.Name}?",
            building.Price > 0
                ? $"This will transfer {FormatPrice(building.Price)} from your account to the seller."
                : "This property is free to claim.",
            building.Price > 0 ? "Confirm purchase" : "Claim it",
            "Cancel",
            PurchaseSelectedBuildingAsync,
            () => Task.CompletedTask);

        ModalRoot.Instance?.OpenModal<ConfirmModalComponent>(modalData);
    }

    private void ConfirmPurchaseSelectedPlot()
    {
        if (_selectedPlot is null)
            return;

        var plot = _selectedPlot;
        var modalData = new ConfirmModalComponent.ModalParams(
            $"Claim {plot.Name}?",
            plot.Price > 0
                ? $"This will transfer {FormatPrice(plot.Price)} from your account to the seller."
                : "This parcel is free to claim.",
            plot.Price > 0 ? "Confirm purchase" : "Claim it",
            "Cancel",
            PurchaseSelectedPlotAsync,
            () => Task.CompletedTask);

        ModalRoot.Instance?.OpenModal<ConfirmModalComponent>(modalData);
    }

    private async Task PurchaseSelectedBuildingAsync()
    {
        if (Data is null || _selectedBuilding is null || _purchaseInProgress)
            return;

        var buildingId = _selectedBuilding.Id;
        _purchaseInProgress = true;
        var result = await VillageService.PurchaseBuildingAsync(Data, buildingId);
        _purchaseInProgress = false;

        if (!result.Success)
        {
            ShowActionMessage(result.Message ?? "The building purchase could not be completed.", isError: true);
            await ReRender();
            return;
        }

        await RefreshSceneAsync(buildingId, null);
        ShowActionMessage("The deed is yours. Welcome home.");
        await ReRender();
    }

    private async Task PurchaseSelectedPlotAsync()
    {
        if (Data is null || _selectedPlot is null || _purchaseInProgress)
            return;

        var plotId = _selectedPlot.Id;
        _purchaseInProgress = true;
        var result = await VillageService.PurchasePlotAsync(Data, plotId);
        _purchaseInProgress = false;

        if (!result.Success)
        {
            ShowActionMessage(result.Message ?? "The parcel could not be claimed.", isError: true);
            await ReRender();
            return;
        }

        await RefreshSceneAsync(null, plotId);
        ShowActionMessage("Parcel claimed. This corner of the village is now yours.");
        await ReRender();
    }

    private void OnListingPriceChanged(ChangeEventArgs e) =>
        _listingPriceText = e.Value?.ToString() ?? "0";

    /// <summary>
    /// Owners may edit their own property; ManageVillage may edit anything.
    /// The server re-checks both, so this only decides what UI to offer.
    /// </summary>
    private bool CanEditProperty(bool ownedByLocalMember) =>
        ownedByLocalMember || _scene?.CanManageVillage == true;

    // The window base suppresses automatic renders, so handlers must ReRender.
    private async Task ToggleEditProperty()
    {
        if (_editingProperty)
        {
            _editingProperty = false;
            await ReRender();
            return;
        }

        _editName = _selectedBuilding?.Name ?? _selectedPlot?.Name ?? string.Empty;
        _editDescription = _selectedBuilding?.Hint ?? string.Empty;
        _editChannelValue = _selectedBuilding?.ChannelId?.ToString() ?? string.Empty;
        _editingProperty = true;
        await ReRender();
    }

    /// <summary>
    /// Channels a building can surface: chat for nearby text, voice and video
    /// for meeting rooms. Other channel types (categories, direct chats) make
    /// no sense bound to a door.
    /// </summary>
    private IEnumerable<Channel> GetLinkableChannels() =>
        Data is null
            ? Enumerable.Empty<Channel>()
            : Data.Channels.Where(x => x.ChannelType is ChannelTypeEnum.PlanetChat
                or ChannelTypeEnum.PlanetVoice
                or ChannelTypeEnum.PlanetVideo);

    private static string ChannelOptionLabel(Channel channel) =>
        channel.ChannelType switch
        {
            ChannelTypeEnum.PlanetVoice => $"🔊 {channel.Name}",
            ChannelTypeEnum.PlanetVideo => $"🎥 {channel.Name}",
            _ => $"# {channel.Name}",
        };

    private async Task SaveSelectedBuildingEditsAsync()
    {
        if (Data is null || _selectedBuilding is null || _editInProgress)
            return;

        var name = _editName.Trim();
        if (name.Length == 0)
        {
            ShowActionMessage("A building needs a name.", isError: true);
            return;
        }

        var buildingId = _selectedBuilding.Id;
        var updateChannel = _scene?.CanManageVillage == true;
        long? channelId = long.TryParse(_editChannelValue, out var parsed) ? parsed : null;

        _editInProgress = true;
        var result = await VillageService.UpdateBuildingAsync(
            Data, buildingId, name, _editDescription, updateChannel, channelId);
        _editInProgress = false;

        if (!result.Success)
        {
            ShowActionMessage(result.Message ?? "The building could not be updated.", isError: true);
            await ReRender();
            return;
        }

        await RefreshSceneAsync(buildingId, null);
        _editingProperty = false;
        ShowActionMessage("Building updated.");
        await ReRender();
    }

    private async Task SaveSelectedPlotEditsAsync()
    {
        if (Data is null || _selectedPlot is null || _editInProgress)
            return;

        var name = _editName.Trim();
        if (name.Length == 0)
        {
            ShowActionMessage("A parcel needs a name.", isError: true);
            return;
        }

        var plotId = _selectedPlot.Id;
        _editInProgress = true;
        var result = await VillageService.UpdatePlotAsync(Data, plotId, name);
        _editInProgress = false;

        if (!result.Success)
        {
            ShowActionMessage(result.Message ?? "The parcel could not be updated.", isError: true);
            await ReRender();
            return;
        }

        await RefreshSceneAsync(null, plotId);
        _editingProperty = false;
        ShowActionMessage("Parcel updated.");
        await ReRender();
    }

    private bool TryGetListingPrice(out decimal price)
    {
        if (decimal.TryParse(
                _listingPriceText,
                System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture,
                out price) &&
            price >= 0)
        {
            return true;
        }

        ShowActionMessage("Enter a valid sale price of zero or more.", isError: true);
        return false;
    }

    private async Task SetSelectedBuildingListingAsync(bool forSale)
    {
        if (Data is null || _selectedBuilding is null || _listingInProgress)
            return;

        var buildingId = _selectedBuilding.Id;
        var price = 0m;
        if (forSale && !TryGetListingPrice(out price))
        {
            await ReRender();
            return;
        }

        _listingInProgress = true;
        var result = await VillageService.SetBuildingListingAsync(Data, buildingId, forSale, price);
        _listingInProgress = false;
        if (!result.Success)
        {
            ShowActionMessage(result.Message ?? "The listing could not be changed.", isError: true);
            await ReRender();
            return;
        }

        await RefreshSceneAsync(buildingId, null);
        ShowActionMessage(forSale ? "Building listed on the village market." : "Building removed from the market.");
        await ReRender();
    }

