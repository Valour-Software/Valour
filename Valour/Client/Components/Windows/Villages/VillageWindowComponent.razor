    private IEnumerable<string> GetBuildCategories() =>
        new[] { "All" }.Concat(GetBuildItemsForTool("Furnish")
            .Select(x => x.Category)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x));

