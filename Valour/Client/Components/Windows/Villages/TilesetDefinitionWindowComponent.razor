    public class TilesetDefinitionDraft
    {
        public string Kind { get; set; } = "Tile";
        public string Name { get; set; } = string.Empty;
        public string Key { get; set; } = string.Empty;
        public string GroupKey { get; set; } = string.Empty;
        public string GroupRole { get; set; } = "Base";
        public string VariantKey { get; set; } = string.Empty;
        public string Direction { get; set; } = "None";
        public string TerrainKey { get; set; } = string.Empty;
        public string TerrainRole { get; set; } = "Base";
        public string TerrainDirection { get; set; } = "None";
        public string TerrainAgainst { get; set; } = string.Empty;
        public int TerrainWeight { get; set; } = 1;
        public int X { get; set; }
        public int Y { get; set; }
        public int Width { get; set; } = 1;
        public int Height { get; set; } = 1;
        public List<bool> Collision { get; set; } = new() { false };

        public static TilesetDefinitionDraft CreateDefault() => new();

        public TilesetDefinitionDraft Clone() => new()
        {
            Kind = Kind,
            Name = Name,
            Key = Key,
            GroupKey = GroupKey,
            GroupRole = GroupRole,
            VariantKey = VariantKey,
            Direction = Direction,
            TerrainKey = TerrainKey,
            TerrainRole = TerrainRole,
            TerrainDirection = TerrainDirection,
            TerrainAgainst = TerrainAgainst,
