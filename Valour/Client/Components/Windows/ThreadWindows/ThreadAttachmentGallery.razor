@using Valour.Client.Components.Menus.Modals.Attachments
@using Valour.Client.Messages
@inject ValourClient Client

@if (_visible.Count > 0)
{
    <div class="thread-gallery count-@Math.Min(_visible.Count, 4)">
        @for (var i = 0; i < _visible.Count && i < MaxVisible; i++)
        {
            var index = i;
            var attachment = _visible[index];
            var url = _urls.GetValueOrDefault(attachment);

            <div class="gallery-item" @onclick="@(() => OnClickItem(attachment))" @onclick:stopPropagation="true">
                @if (attachment.Type == MessageAttachmentType.Image)
                {
                    <img src="@url" alt="@attachment.FileName" loading="lazy"/>
                }
                else if (attachment.Type == MessageAttachmentType.Video)
                {
                    @if (_visible.Count == 1)
                    {
                        <video src="@url" controls preload="none" @onclick:stopPropagation="true"></video>
                    }
                    else
                    {
                        <video src="@url" preload="none" muted></video>
                        <div class="play-overlay">
                            <i class="bi bi-play-circle-fill"></i>
                        </div>
                    }
                }
                else
                {
                    <div class="file-chip">
                        <i class="bi bi-file-earmark-fill"></i>
                        <span>@(attachment.FileName ?? "File")</span>
                    </div>
                }

                @if (index == MaxVisible - 1 && _visible.Count > MaxVisible)
                {
                    <div class="more-overlay">+@(_visible.Count - MaxVisible)</div>
                }
            </div>
        }
    </div>
}

@if (_embeds.Count > 0)
{
    @* Embeds nested in an embedded thread preview are left out, so threads
       that link to each other cannot nest without end. *@
    <CascadingValue Name="ThreadEmbedNested" Value="true" IsFixed="true">
        <div class="thread-embeds">
            @foreach (var attachment in _embeds)
            {
                <div class="thread-embed" @onclick:stopPropagation="true">
                    @if (attachment.IsSpoiler && !_revealedSpoilers.Contains(attachment))
                    {
                        <button type="button" class="embed-spoiler-placeholder" @onclick="@(() => _revealedSpoilers.Add(attachment))">
                            Spoiler: click to reveal embed
                        </button>
                    }
                    else
                    {
                        <DynamicComponent Type="@attachment.GetComponentType()" Parameters="@GetEmbedParameters(attachment)"/>
                    }
                </div>
            }
        </div>
    </CascadingValue>
}

@code {
    private const int MaxVisible = 4;

    [CascadingParameter]
    public ModalRoot ModalRoot { get; set; }

    [Parameter]
    public List<MessageAttachment> Attachments { get; set; }

    [Parameter]
    public long PlanetId { get; set; }

    /// <summary>
    /// When false, clicking items does nothing (used inside clickable cards that
    /// should not hijack the navigation click)
    /// </summary>
    [Parameter]
    public bool Expandable { get; set; } = true;

    [CascadingParameter(Name = "ThreadEmbedNested")]
    public bool Nested { get; set; }

    /// <summary>
    /// Link embeds are drawn in the post with the same components as chat,
    /// instead of as tiles in the media grid.
    /// </summary>
    private static readonly HashSet<MessageAttachmentType> EmbedTypes =
    [
        MessageAttachmentType.SitePreview,
        MessageAttachmentType.YouTube,
        MessageAttachmentType.Vimeo,
        MessageAttachmentType.Twitch,
        MessageAttachmentType.TikTok,
        MessageAttachmentType.Twitter,
        MessageAttachmentType.Reddit,
        MessageAttachmentType.Instagram,
        MessageAttachmentType.Bluesky,
        MessageAttachmentType.Spotify,
        MessageAttachmentType.SoundCloud,
        MessageAttachmentType.GitHub,
        MessageAttachmentType.ValourThread,
        MessageAttachmentType.ValourWikiPage,
    ];

    private List<MessageAttachment> _visible = new();
    private List<MessageAttachment> _embeds = new();
    private readonly HashSet<MessageAttachment> _revealedSpoilers = new();
    private readonly Dictionary<MessageAttachment, string> _urls = new();
    private Message _embedMessage;

    protected override async Task OnParametersSetAsync()
    {
        var attachments = Attachments?.Where(x => x is not null && !x.Missing).ToList() ?? new List<MessageAttachment>();
        _visible = attachments.Where(x => !EmbedTypes.Contains(x.Type)).ToList();
        _embeds = Nested
            ? new List<MessageAttachment>()
            : attachments.Where(x => EmbedTypes.Contains(x.Type)).ToList();

        // Thread and wiki previews read the planet from the message they belong to.
        if (_embedMessage?.PlanetId != PlanetId)
            _embedMessage = new Message(Client) { PlanetId = PlanetId };

        var node = Client.NodeService.GetKnownByPlanet(PlanetId) ?? Client.PrimaryNode;

        foreach (var attachment in _visible)
        {
            if (_urls.ContainsKey(attachment))
                continue;

            var url = await attachment.GetSignedUrl(Client, node);
            if (url is not null)
                _urls[attachment] = url;
        }
    }

    private Dictionary<string, object> GetEmbedParameters(MessageAttachment attachment) => new()
    {
        { "Attachment", attachment },
        { "Message", _embedMessage },
    };

    private void OnClickItem(MessageAttachment attachment)
    {
        if (!Expandable || ModalRoot is null)
            return;

        // AttachmentModal needs a message for client/node resolution
        var stub = new Message(Client)
        {
            PlanetId = PlanetId
        };

        ModalRoot.OpenModal<AttachmentModal>(new AttachmentModal.ModalParams()
        {
            Message = stub,
            Attachment = attachment
        });
    }
}
