@implements IDisposable
@inject ContextMenuService ContextMenuService
@inject ValourClient Client
@inject ChannelService ChannelService
@inject ChannelStateService ChannelStateService
@inject UnreadService UnreadService
@inject NotificationService NotificationService

<div class="friend-row @(_isUnread || _notificationCount > 0 ? "unread" : "") @(_isOffline ? "offline" : "")" @onclick="OnClick" @oncontextpress="OnContextMenu">
    <div class="left">
        <UserAvatar User="@Friend" Size="32" ShowState="true"/>
        <span class="info">
            <span class="name">@Friend.Name</span>
            @if (!string.IsNullOrWhiteSpace(_statusText))
            {
                <span class="status">@_statusText</span>
            }
        </span>
    </div>
    <div class="right">
        @if (_notificationCount > 0)
        {
            <span class="count">@(_notificationCount > 99 ? "99+" : _notificationCount)</span>
        }
        else if (_isUnread)
        {
            <span class="unread-dot" aria-label="Unread"></span>
        }
    </div>
</div>

@code {
    [Parameter]
    public User Friend { get; set; }

    [Parameter]
    public WindowContent WindowCtx { get; set; }

    [Parameter]
    public HomeWindowComponent HomeWindowComponent { get; set; }

    private bool _isUnread;
    private int _notificationCount;
    private bool _isOffline;
    private string _statusText;

    protected override void OnInitialized()
    {
        CalculateStatus();

        Friend.Updated += OnFriendUpdated;
        HomeWindowComponent.OnRerenderFriendCards += Refresh;
    }

    private void CalculateStatus()
    {
        var state = Friend.UserState;
        _isOffline = state.Value == UserState.Offline.Value;

        if (!string.IsNullOrWhiteSpace(Friend.Status))
            _statusText = Friend.Status;
        else
            _statusText = _isOffline ? null : state.Name;
    }

    private void OnFriendUpdated(ModelUpdatedEvent<User> eventData)
    {
        if (!eventData.Changes.On(x => x.UserStateCode) &&
            !eventData.Changes.On(x => x.TimeLastActive) &&
            !eventData.Changes.On(x => x.Status) &&
            !eventData.Changes.On(x => x.Name))
            return;

        InvokeAsync(() =>
        {
            CalculateStatus();
            StateHasChanged();
        });
    }

    private void OnContextMenu(ContextPressEventArgs e)
    {
        ContextMenuService.Root.OpenMenu<UserContextMenu>(e,
            new UserContextMenu.UserContextParams()
            {
                User = Friend
            }
        );
    }

    private Task Refresh()
    {
        return InvokeAsync(() =>
        {
            var channel = ChannelService.DirectChatChannels.FirstOrDefault(x => x.Members.Any(m => m.UserId == Friend.Id));

            if (channel is null)
            {
                _isUnread = false;
                _notificationCount = 0;
            }
            else
            {
                _isUnread = UnreadService.IsChannelUnread(channel.PlanetId, channel.Id);
                _notificationCount = NotificationService.GetChannelNotifications(channel.Id);
            }

            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Friend.Updated -= OnFriendUpdated;
        HomeWindowComponent.OnRerenderFriendCards -= Refresh;
    }

    private async Task OnClick()
    {
        var channel = await ChannelService.FetchDmChannelAsync(Friend.Id, create: true);
        var newWindowContent = await ChatWindowComponent.GetDefaultContent(channel);
        await WindowService.OpenWindowAtFocused(newWindowContent, WindowCtx.Tab);
    }
}
