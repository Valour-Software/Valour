@using Valour.Shared.Models.Themes
@inject IAppStorage LocalStorage

<div id="theme">
    <style>
        :root {
            --font-family-app: @((MarkupString)ISharedTheme.NormalizeFontFamily(CurrentTheme.FontFamily));
            --radius-xs: @CurrentTheme.RadiusXs;
            --radius-sm: @CurrentTheme.RadiusSm;
            --radius-md: @CurrentTheme.RadiusMd;
            --radius-lg: @CurrentTheme.RadiusLg;
            --radius-xl: @CurrentTheme.RadiusXl;
            --radius-full: @CurrentTheme.RadiusFull;

            --font-color: @CurrentTheme.FontColor;
            --font-alt-color: @CurrentTheme.FontAltColor;
            --font-color-muted: var(--font-alt-color);
            --font-color-mid: color-mix(in srgb, var(--font-color) 60%, var(--font-alt-color));
            --link-color: @CurrentTheme.LinkColor;

            --main-1: @CurrentTheme.MainColor1;
            --main-2: @CurrentTheme.MainColor2;
            --main-3: @CurrentTheme.MainColor3;
            --main-4: @CurrentTheme.MainColor4;
            --main-5: @CurrentTheme.MainColor5;

            --modal-main: @(CurrentTheme.MainColor1 + "55");
            --modal-medium: @(CurrentTheme.MainColor1 + "aa");
            --modal-dark: @(CurrentTheme.MainColor1 + "cc");

            --tint: @CurrentTheme.TintColor;
            --slight-tint: @(CurrentTheme.TintColor + "15");
            --medium-tint: @(CurrentTheme.TintColor + "30");
            --strong-tint: @(CurrentTheme.TintColor + "55");

            --color-primary: @CurrentTheme.VibrantCyan;
            --color-primary-contrast: @ContrastFor(CurrentTheme.VibrantCyan);
            --color-primary-soft: color-mix(in srgb, var(--color-primary) 15%, transparent);
            --color-primary-border: color-mix(in srgb, var(--color-primary) 35%, transparent);
            --color-primary-dimmed: color-mix(in srgb, var(--color-primary) 75%, transparent);

            --color-secondary: @CurrentTheme.VibrantPurple;
            --color-secondary-contrast: @ContrastFor(CurrentTheme.VibrantPurple);
            --color-secondary-soft: color-mix(in srgb, var(--color-secondary) 15%, transparent);
            --color-secondary-border: color-mix(in srgb, var(--color-secondary) 35%, transparent);
            --color-secondary-dimmed: color-mix(in srgb, var(--color-secondary) 75%, transparent);

            --color-accent: @CurrentTheme.PastelCyanPurple;
            --color-accent-contrast: @ContrastFor(CurrentTheme.PastelCyanPurple);
            --color-accent-soft: color-mix(in srgb, var(--color-accent) 15%, transparent);
            --color-accent-border: color-mix(in srgb, var(--color-accent) 35%, transparent);
            --color-accent-dimmed: color-mix(in srgb, var(--color-accent) 75%, transparent);

            --color-info: var(--color-primary);
            --color-info-contrast: var(--color-primary-contrast);
            --color-info-soft: color-mix(in srgb, var(--color-info) 15%, transparent);
            --color-info-border: color-mix(in srgb, var(--color-info) 35%, transparent);
            --color-info-dimmed: color-mix(in srgb, var(--color-info) 75%, transparent);

            --color-success: #6fd49a;
            --color-success-contrast: #06150d;
            --color-success-soft: color-mix(in srgb, var(--color-success) 15%, transparent);
            --color-success-border: color-mix(in srgb, var(--color-success) 35%, transparent);
            --color-success-dimmed: color-mix(in srgb, var(--color-success) 75%, transparent);

            --color-warning: #f5c76a;
            --color-warning-contrast: #1a1204;
            --color-warning-soft: color-mix(in srgb, var(--color-warning) 15%, transparent);
            --color-warning-border: color-mix(in srgb, var(--color-warning) 35%, transparent);
            --color-warning-dimmed: color-mix(in srgb, var(--color-warning) 75%, transparent);

            --color-danger: @CurrentTheme.PastelRed;
            --color-danger-contrast: @ContrastFor(CurrentTheme.PastelRed);
            --color-danger-soft: color-mix(in srgb, var(--color-danger) 15%, transparent);
            --color-danger-border: color-mix(in srgb, var(--color-danger) 35%, transparent);
            --color-danger-dimmed: color-mix(in srgb, var(--color-danger) 75%, transparent);

            --color-staff: @CurrentTheme.VibrantCyan;
            --color-staff-contrast: @ContrastFor(CurrentTheme.VibrantCyan);
            --color-bot: @CurrentTheme.VibrantPurple;
            --color-bot-contrast: @ContrastFor(CurrentTheme.VibrantPurple);
            --color-staff-soft: color-mix(in srgb, var(--color-staff) 12%, transparent);
            --color-staff-border: color-mix(in srgb, var(--color-staff) 30%, transparent);
            --color-bot-soft: color-mix(in srgb, var(--color-bot) 12%, transparent);
            --color-bot-border: color-mix(in srgb, var(--color-bot) 30%, transparent);

            --pastel-cyan: @CurrentTheme.PastelCyan;
            --pastel-cyan-purple: @CurrentTheme.PastelCyanPurple;
            --pastel-purple: @CurrentTheme.PastelPurple;
            --pastel-red: @CurrentTheme.PastelRed;

            /* Legacy palette aliases. New component CSS should use the semantic colors above. */
            --v-purple: var(--color-bot);
            --v-blue:   @CurrentTheme.VibrantBlue;
            --v-cyan:   var(--color-staff);

            --p-cyan:        var(--pastel-cyan);
            --p-cyan-purple: var(--pastel-cyan-purple);
            --p-purple:      var(--pastel-purple);
            --p-red:         var(--pastel-red);
            --p-green:       var(--color-success);
            --p-orange:      var(--color-warning);

            /* Theme asset variables */
            @foreach (var asset in CurrentTheme.Assets ?? Enumerable.Empty<ThemeAssetInfo>())
            {
                @if (asset.AssetType != "font")
                {
                    <text>--theme-asset-@asset.Name: url(@asset.Url);</text>
                }
            }
        }

        /* Theme font assets */
        @foreach (var asset in CurrentTheme.Assets ?? Enumerable.Empty<ThemeAssetInfo>())
        {
            @if (asset.AssetType == "font")
            {
                <text>
                @@font-face {
                    font-family: "theme-font-@asset.Name";
                    src: url("@asset.Url") format("@GetFontFormat(asset.Url)");
                }
                </text>
            }
        }

        /* Custom CSS */
        @GetSanitizedCustomCss()
    </style>
</div>

@code {
    public static ThemeComponent Instance;

    public Theme CurrentTheme { get; set; } = Theme.Default;
    public static event Action OnThemeChanged;

    public async Task InstallTheme(Theme theme)
    {
        if (theme.Id == Theme.Default.Id)
        {
            await UninstallThemeAsync();
            return;
        }

        theme.FontFamily = ISharedTheme.NormalizeFontFamily(theme.FontFamily);
        NormalizeThemeRadii(theme);
        CurrentTheme = theme;
        await LocalStorage.SetStringAsync("ACTIVE_THEME", JsonSerializer.Serialize(CurrentTheme));
        StateHasChanged();
        OnThemeChanged?.Invoke();
    }
    public async Task UninstallThemeAsync()
    {
        CurrentTheme = Theme.Default;
        if (await LocalStorage.ContainsKeyAsync("ACTIVE_THEME"))
            await LocalStorage.RemoveAsync("ACTIVE_THEME");
        StateHasChanged();
        OnThemeChanged?.Invoke();
    }

    private const string DarkContrast = "#0a0d12";
    private const string LightContrast = "#ffffff";

    /// <summary>
    /// Picks the text color with the higher WCAG contrast against a fill color, so
    /// light accents get dark text and dark accents get white text.
    /// </summary>
    private static string ContrastFor(string hex)
    {
        if (!TryGetLuminance(hex, out var luminance))
            return LightContrast;

        const double darkLuminance = 0.0038;
        var againstWhite = 1.05 / (luminance + 0.05);
        var againstDark = (luminance + 0.05) / (darkLuminance + 0.05);
        return againstDark > againstWhite ? DarkContrast : LightContrast;
    }

    private static bool TryGetLuminance(string hex, out double luminance)
    {
        luminance = 0;
        if (string.IsNullOrWhiteSpace(hex))
            return false;

        var value = hex.Trim().TrimStart('#');
        if (value.Length == 3)
            value = string.Concat(value.Select(c => $"{c}{c}"));
        if (value.Length < 6 || !int.TryParse(value[..6], System.Globalization.NumberStyles.HexNumber, null, out var rgb))
            return false;

        static double Channel(int c)
        {
            var s = c / 255.0;
            return s <= 0.03928 ? s / 12.92 : Math.Pow((s + 0.055) / 1.055, 2.4);
        }

        luminance = 0.2126 * Channel((rgb >> 16) & 0xff) + 0.7152 * Channel((rgb >> 8) & 0xff) + 0.0722 * Channel(rgb & 0xff);
        return true;
    }

    private static string GetFontFormat(string url)
    {
        if (string.IsNullOrEmpty(url))
            return "woff2";

        var ext = url.Split('.').LastOrDefault()?.ToLowerInvariant();
        return ext switch
        {
            "woff2" => "woff2",
            "woff" => "woff",
            "ttf" => "truetype",
            "otf" => "opentype",
            _ => "woff2",
        };
    }

    private string GetSanitizedCustomCss()
    {
        if (string.IsNullOrWhiteSpace(CurrentTheme.CustomCss))
            return string.Empty;

        try
        {
            var css = CurrentTheme.CustomCss;

            // Defense-in-depth: apply the server's rules on the client too, since
            // themes saved before a rule existed may still be stored or cached.
            if (!ThemeCustomCss.IsSafe(css))
                return string.Empty;

            return css; // Return original CSS, preserving comments/formatting
        }
        catch (Exception e)
        {
            Console.WriteLine(e);
            return string.Empty;
        }
    }

    private bool AreBracketsValid(string input)
    {
        int count = 0;

        foreach (char c in input)
        {
            if (c == '{')
            {
                count++;
            }
            else if (c == '}')
            {
                count--;
                if (count < 0)
                {
                    return false; // More closing brackets than opening brackets
                }
            }
        }

        return count == 0; // True if opening and closing brackets match
    }

    protected override async Task OnInitializedAsync()
    {
        Instance = this;

        // Load from local storage
        if (await LocalStorage.ContainsKeyAsync("ACTIVE_THEME"))
        {
            var stored = JsonSerializer.Deserialize<Theme>(await LocalStorage.GetStringAsync("ACTIVE_THEME"));

            // The default theme is defined in code, so a stored copy of it would pin
            // this device to whatever the default looked like when it was saved.
            if (stored is null || stored.Id == Theme.Default.Id)
            {
                await LocalStorage.RemoveAsync("ACTIVE_THEME");
                return;
            }

            CurrentTheme = stored;
            CurrentTheme.FontFamily = ISharedTheme.NormalizeFontFamily(CurrentTheme.FontFamily);
            NormalizeThemeRadii(CurrentTheme);
            StateHasChanged();
        }
    }


    private static void NormalizeThemeRadii(Theme theme)
    {
        theme.RadiusXs = ISharedTheme.NormalizeRadius(theme.RadiusXs, ISharedTheme.DefaultRadiusXs);
        theme.RadiusSm = ISharedTheme.NormalizeRadius(theme.RadiusSm, ISharedTheme.DefaultRadiusSm);
        theme.RadiusMd = ISharedTheme.NormalizeRadius(theme.RadiusMd, ISharedTheme.DefaultRadiusMd);
        theme.RadiusLg = ISharedTheme.NormalizeRadius(theme.RadiusLg, ISharedTheme.DefaultRadiusLg);
        theme.RadiusXl = ISharedTheme.NormalizeRadius(theme.RadiusXl, ISharedTheme.DefaultRadiusXl);
        theme.RadiusFull = ISharedTheme.NormalizeRadius(theme.RadiusFull, ISharedTheme.DefaultRadiusFull);
    }


    public void Refresh()
    {
        StateHasChanged();
    }
}
