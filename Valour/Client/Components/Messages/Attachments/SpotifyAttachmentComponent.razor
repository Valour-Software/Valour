@inherits AttachmentComponent

@if (_src is not null)
{
    <div class="spotify-container">
        <iframe
            class="spotify-embed"
            src="@_src"
            style="width: 100%; max-width: @(Attachment.Width > 0 ? Attachment.Width : 300)px;"
            height="@(Attachment.Height > 0 ? Attachment.Height : 80)"
            frameborder="0"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy">
        </iframe>
    </div>
}

@code {
    private string _src;

    protected override void OnParametersSet()
    {
        _src = GetTrustedEmbedSource("open.spotify.com");
    }
}
