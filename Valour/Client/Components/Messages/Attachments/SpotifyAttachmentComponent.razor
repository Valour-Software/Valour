@inherits AttachmentComponent

@if (_src is not null)
{
    <div class="spotify-container">
        <iframe
            class="spotify-embed"
            src="@_src"
            width="@(Attachment.Width > 0 ? Attachment.Width : 300)"
            height="@(Attachment.Height > 0 ? Attachment.Height : 80)"
            frameborder="0"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            loading="lazy">
        </iframe>
    </div>
}

<style>
    .spotify-container {
        border-radius: var(--radius-lg);
        overflow: hidden;
    }

    .spotify-embed {
        border: none;
        border-radius: var(--radius-lg);
    }
</style>

@code {
    private string _src;

    protected override void OnParametersSet()
    {
        _src = GetTrustedEmbedSource("open.spotify.com");
    }
}
