@inherits AttachmentComponent

@if (_src is not null)
{
    <div class="bluesky-container">
        <iframe
            class="bluesky-embed"
            src="@_src"
            width="@(Attachment.Width > 0 ? Attachment.Width : 400)"
            height="@(Attachment.Height > 0 ? Attachment.Height : 300)"
            frameborder="0"
            scrolling="no">
        </iframe>
    </div>
}

<style>
    .bluesky-container {
        max-width: 400px;
        border-radius: var(--radius-md);
        overflow: hidden;
    }

    .bluesky-embed {
        border: none;
        border-radius: var(--radius-md);
    }
</style>

@code {
    private string _src;

    protected override void OnParametersSet()
    {
        _src = GetTrustedEmbedSource("embed.bsky.app");
    }
}
