@inherits AttachmentComponent

@if (Attachment?.Missing == true || (_resolved && string.IsNullOrWhiteSpace(_location)))
{
    <FileAttachmentComponent Message="@Message" Attachment="@Attachment" />
}
else
{
    @* The player shows at its full size while the signed URL loads. Setting
       src (rather than adding a source element later) makes it load then. *@
    <audio controls preload="auto" playsinline src="@(_resolved ? _location : null)"></audio>
}

@code {
    [Parameter]
    public string CustomStyle { get; set; }
    
    private string _location;
    private bool _resolved;

    protected override async Task OnInitializedAsync()
    {
        _location = await Attachment.GetSignedUrl(Message.Client, Message.Node);
        _resolved = true;
    }

}

