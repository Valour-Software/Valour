@inherits AttachmentComponent

@if (_src is not null)
{
    @* Shorts are stored with a 9:16 size; other videos are 16:9. *@
    @if (Attachment.Height > Attachment.Width)
    {
        <AspectEmbedFrame Src="@_src" Title="YouTube Short" AspectWidth="9" AspectHeight="16" MaxWidth="315"/>
    }
    else
    {
        <AspectEmbedFrame Src="@_src" Title="YouTube video"/>
    }
}

@code {
    private string _src;

    protected override void OnParametersSet()
    {
        _src = GetTrustedEmbedSource("www.youtube.com", "youtube.com", "www.youtube-nocookie.com", "youtube-nocookie.com", "music.youtube.com");
    }
}
