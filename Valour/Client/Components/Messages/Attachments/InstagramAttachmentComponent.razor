@inherits AttachmentComponent

@if (_src is not null)
{
    <ProviderEmbedFrame Provider="instagram"
                        EmbedId="@_src"
                        Src="@_src"
                        Title="Post on Instagram"
                        DefaultHeight="500"
                        MaxWidth="540"/>
}

@code {
    private string _src;

    protected override void OnParametersSet()
    {
        _src = GetTrustedEmbedSource("www.instagram.com", "instagram.com");
    }
}
