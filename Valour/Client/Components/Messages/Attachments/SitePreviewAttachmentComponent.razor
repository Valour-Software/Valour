@inherits AttachmentComponent
@using Valour.Sdk.Cdn
@using Valour.Shared.Hosting

<a href="@_href" target="_blank" rel="noopener noreferrer ugc" class="link-card @(_largeImage ? "large" : "compact")">
    <div class="link-card-text">
        <div class="link-card-site">
            @if (_icon is not null && !_iconFailed)
            {
                <img class="link-card-icon" src="@_icon" alt="" width="16" height="16" loading="lazy" @onerror="@(() => _iconFailed = true)" />
            }
            else
            {
                <i class="bi bi-globe2 link-card-icon" aria-hidden="true"></i>
            }
            <span class="link-card-site-name">@_siteName</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(_openGraph?.Title))
        {
            <span class="link-card-title">@_openGraph.Title</span>
        }
        @if (!string.IsNullOrWhiteSpace(_openGraph?.Description))
        {
            <span class="link-card-description">@_openGraph.Description</span>
        }
    </div>
    @if (_image is not null)
    {
        @* The box keeps the image's shape (within limits) before it loads. A
           failed image leaves the empty box rather than moving the card. *@
        <div class="link-card-image" style="@_imageStyle">
            @if (!_imageFailed)
            {
                <img src="@_image" alt="@(_openGraph.ImageAlt ?? string.Empty)" loading="lazy" decoding="async" @onerror="@(() => _imageFailed = true)" />
            }
        </div>
    }
</a>

@code {
    // Pages ask for a large image with this card type; otherwise a wide,
    // large image earns one too.
    private const string LargeImageCard = "summary_large_image";
    private const int MinLargeImageWidth = 300;

    private OpenGraphData _openGraph;
    private string _href;
    private string _siteName;
    private string _image;
    private string _icon;
    private string _imageStyle;
    private bool _largeImage;
    private bool _imageFailed;
    private bool _iconFailed;

    protected override void OnParametersSet()
    {
        _openGraph = Attachment?.OpenGraph;
        _href = Valour.Shared.Utilities.SafeUrl.Sanitize(Attachment?.Location);

        Uri.TryCreate(Attachment?.Location, UriKind.Absolute, out var link);
        var host = link?.Host ?? string.Empty;
        if (host.StartsWith("www.", StringComparison.OrdinalIgnoreCase))
            host = host[4..];
        _siteName = string.IsNullOrWhiteSpace(_openGraph?.SiteName) ? host : _openGraph.SiteName;

        // The server serves a page's images through its media proxy on the
        // content CDN; anything else is not loaded, so readers never fetch
        // images from the linked site.
        _image = FromContentCdn(_openGraph?.Image);
        _icon = FromContentCdn(_openGraph?.Icon);

        var width = _openGraph?.ImageWidth ?? 0;
        var height = _openGraph?.ImageHeight ?? 0;
        var ratio = width > 0 && height > 0 ? (double)width / height : 1.91;

        _largeImage = _image is not null && width >= MinLargeImageWidth &&
                      (_openGraph.Card == LargeImageCard || (_openGraph.Card is null && ratio >= 1.3 && width >= 600));

        // Very tall or very wide images are cropped to a sensible banner.
        _imageStyle = _largeImage
            ? $"aspect-ratio: {Math.Clamp(ratio, 1.0, 2.4).ToString(System.Globalization.CultureInfo.InvariantCulture)};"
            : null;
    }

    private static string FromContentCdn(string url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri) && MediaUriHelper.MatchesConfiguredOrigin(uri, ValourHosts.ContentCdnHost)
            ? uri.AbsoluteUri
            : null;
}
