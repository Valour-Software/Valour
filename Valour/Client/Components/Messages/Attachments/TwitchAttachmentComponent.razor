@inherits AttachmentComponent

@if (_src is not null)
{
    <AspectEmbedFrame Src="@($"{_src}&parent={Valour.Shared.Hosting.ValourHosts.AppHost}&autoplay=false")" Title="Twitch player"/>
}

@code {
    private string _src;

    protected override void OnParametersSet()
    {
        _src = GetTrustedEmbedSource("player.twitch.tv", "clips.twitch.tv");
    }
}
