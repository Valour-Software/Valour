@inherits AttachmentComponent

@if (_src is not null)
{
    <div class="twitch-container">
        <iframe
            class="twitch-embed"
            src="@($"{_src}&parent={Valour.Shared.Hosting.ValourHosts.AppHost}&autoplay=false")"
            width="560"
            height="315"
            allowfullscreen>
        </iframe>
    </div>
}

@code {
    private string _src;

    protected override void OnParametersSet()
    {
        _src = GetTrustedEmbedSource("player.twitch.tv", "clips.twitch.tv");
    }
}
