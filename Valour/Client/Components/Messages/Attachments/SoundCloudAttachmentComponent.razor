@inherits AttachmentComponent
@using System.Net
@using System.Text.RegularExpressions

@if (_src is not null)
{
    <iframe class="soundcloud-embed"
            src="@_src"
            title="SoundCloud player"
            style="height: @(_height)px;"
            loading="lazy"
            allow="autoplay"></iframe>
}

@code {
    // SoundCloud's oEmbed markup is a single player iframe; only its source is used.
    private static readonly Regex PlayerSource = new(
        @"src=""(https://w\.soundcloud\.com/player/\?[^""]+)""",
        RegexOptions.CultureInvariant);

    private string _src;
    private int _height;

    protected override void OnParametersSet()
    {
        var match = PlayerSource.Match(Attachment?.Data ?? string.Empty);
        var src = match.Success ? WebUtility.HtmlDecode(match.Groups[1].Value) : null;

        _src = Uri.TryCreate(src, UriKind.Absolute, out var uri) &&
               uri.Scheme == Uri.UriSchemeHttps &&
               uri.Host == "w.soundcloud.com" &&
               string.IsNullOrEmpty(uri.UserInfo)
            ? uri.AbsoluteUri
            : null;
        _height = Attachment?.Height > 0 ? Attachment.Height : 166;
    }
}
