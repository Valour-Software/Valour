@inherits AttachmentComponent
@using System.Text.Json

@* Gists render from the preview the server stored, so no GitHub script
   runs in the app. Older gist attachments without one show a link card. *@
<a class="gist-card" href="@_href" target="_blank" rel="noopener noreferrer">
    <div class="gist-header">
        <i class="bi bi-github" aria-hidden="true"></i>
        <span class="gist-title">@(_preview?.Owner is { Length: > 0 } owner ? $"{owner} / " : string.Empty)@(_firstFile?.Name ?? "Gist")</span>
        @if (_preview?.FileCount > 1)
        {
            <span class="gist-files">@_preview.FileCount files</span>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(_preview?.Description))
    {
        <div class="gist-description">@_preview.Description</div>
    }
    @if (_firstFile is not null)
    {
        <pre class="gist-code"><code>@string.Join("\n", _firstFile.Lines)</code></pre>
        @if (_firstFile.TotalLines > _firstFile.Lines.Count)
        {
            <div class="gist-more">@(_firstFile.TotalLines - _firstFile.Lines.Count) more lines</div>
        }
    }
</a>

@code {
    private GistPreview _preview;
    private GistPreviewFile _firstFile;
    private string _href;

    protected override void OnParametersSet()
    {
        _href = Valour.Shared.Utilities.SafeUrl.Sanitize(Attachment?.Location);
        _preview = null;

        if (!string.IsNullOrWhiteSpace(Attachment?.Data))
        {
            try
            {
                _preview = JsonSerializer.Deserialize<GistPreview>(Attachment.Data);
            }
            catch (JsonException)
            {
                // Older attachments stored nothing or other markup here.
            }
        }

        _firstFile = _preview?.Files?.FirstOrDefault();
    }
}
