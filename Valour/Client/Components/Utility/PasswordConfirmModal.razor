@inherits Modal<PasswordConfirmModal.Params>

<BasicModalLayout Title="@Data.Title" Icon="lock-fill" MaxWidth="300px">
    <MainArea>
        <p>@Data.Description</p>
        <div class="form-group">
            <PasswordInput placeholder="Enter Password..." id="password-input" autocomplete="current-password" @bind-Value="@_password"/>
            @if (Data.RequireMfaCode)
            {
                <label class="mt-2">Authenticator code</label>
                <input class="v-input" inputmode="numeric" autocomplete="one-time-code" maxlength="8"
                       placeholder="000000" @bind="_mfaCode" />
            }
            <ResultLabel Style="margin-top: 1em" Result="@_result" />
        </div>
    </MainArea>
    <ButtonArea>
        <div class="basic-modal-buttons">
            <button @onclick="@OnCancel" class="btn v-btn d-inline-block">Cancel</button>
            <button @onclick="@OnConfirm" class="btn v-btn primary d-inline-block">Confirm</button>
        </div>
    </ButtonArea>
</BasicModalLayout>

@code {

    public class Params
    {
        public string Title = "Password Required";
        public string Description;
        public Func<string, Task<TaskResult>> OnConfirmAsync;

        /// <summary>
        /// Also asks for an authenticator code and passes it to
        /// <see cref="OnConfirmWithMfaAsync"/> instead of <see cref="OnConfirmAsync"/>.
        /// </summary>
        public bool RequireMfaCode;
        public Func<string, string, Task<TaskResult>> OnConfirmWithMfaAsync;
    }

    private string _password = "";
    private string _mfaCode = "";
    private ITaskResult _result;

    private async Task OnConfirm()
    {
        var pending = Data.RequireMfaCode && Data.OnConfirmWithMfaAsync is not null
            ? Data.OnConfirmWithMfaAsync.Invoke(_password, _mfaCode?.Trim())
            : Data.OnConfirmAsync?.Invoke(_password);

        if (pending is not null)
        {
            var result = await pending;
            _result = result;
            
            if (result.Success)
            {
                Close();
            }
            else
            {
                StateHasChanged();
            }
        }
    }

    private void OnCancel() => Close();
}