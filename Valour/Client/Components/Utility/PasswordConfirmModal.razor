@inherits Modal<PasswordConfirmModal.Params>

<BasicModalLayout Title="@Data.Title" Icon="lock-fill" MaxWidth="340px">
    <MainArea>
        <p>@Data.Description</p>
        <div class="form-group">
            <ConfirmIdentityInputs @bind-Password="@_password" OnLoaded="@OnIdentityLoaded" OnConfirmed="@OnConfirmedWithProof" />
            @if (Data.RequireMfaCode)
            {
                <label class="mt-2">Authenticator code</label>
                <input class="v-input" inputmode="numeric" autocomplete="one-time-code" maxlength="8"
                       placeholder="000000" @bind="_mfaCode" />
            }
            <ResultLabel Style="margin-top: 1em" Result="@_result" />
        </div>
    </MainArea>
    <ButtonArea>
        <div class="basic-modal-buttons">
            <button @onclick="@OnCancel" class="btn v-btn d-inline-block">Cancel</button>
            @if (_hasPassword)
            {
                <button @onclick="@OnConfirm" class="btn v-btn primary d-inline-block">Confirm</button>
            }
        </div>
    </ButtonArea>
</BasicModalLayout>

@code {

    public class Params
    {
        public string Title = "Password Required";
        public string Description;
        public Func<string, Task<TaskResult>> OnConfirmAsync;

        /// <summary>
        /// Also asks for an authenticator code and passes it to
        /// <see cref="OnConfirmWithMfaAsync"/> instead of <see cref="OnConfirmAsync"/>.
        /// </summary>
        public bool RequireMfaCode;
        public Func<string, string, Task<TaskResult>> OnConfirmWithMfaAsync;

        /// <summary>
        /// Runs after the person confirms with their password, a linked account,
        /// or fingerprint, with the authenticator code when one is required.
        /// Takes precedence over the password-only callbacks.
        /// </summary>
        public Func<IdentityConfirmation, string, Task<TaskResult>> OnConfirmIdentityAsync;

        /// <summary>Runs if the person closes the dialog without confirming.</summary>
        public Action OnCancel;
    }

    private string _password = "";
    private string _mfaCode = "";
    private ITaskResult _result;
    private bool _hasPassword = true;

    private void OnIdentityLoaded(bool hasPassword) => _hasPassword = hasPassword;

    private Task OnConfirm() => RunAsync(new IdentityConfirmation(_password, null));

    private Task OnConfirmedWithProof(IdentityConfirmation confirmation) => RunAsync(confirmation);

    private async Task RunAsync(IdentityConfirmation confirmation)
    {
        var code = _mfaCode?.Trim();
        var pending = Data.OnConfirmIdentityAsync is not null
            ? Data.OnConfirmIdentityAsync.Invoke(confirmation, code)
            : Data.RequireMfaCode && Data.OnConfirmWithMfaAsync is not null
                ? Data.OnConfirmWithMfaAsync.Invoke(confirmation.Password, code)
                : Data.OnConfirmAsync?.Invoke(confirmation.Password);

        if (pending is not null)
        {
            var result = await pending;
            _result = result;
            
            if (result.Success)
            {
                Close();
            }
            else
            {
                StateHasChanged();
            }
        }
    }

    private void OnCancel()
    {
        Data.OnCancel?.Invoke();
        Close();
    }
}