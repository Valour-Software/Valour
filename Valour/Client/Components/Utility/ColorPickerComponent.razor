@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div id="@_id" class="color-picker @ButtonClass" style="@ButtonStyle"></div>

@code{

    [Parameter] 
    public Func<string, Task> OnColorChange { get; set; }
    
    [Parameter]
    public string StartColor { get; set; }
    
    [Parameter]
    public bool UseAsButton { get; set; }
    
    [Parameter]
    public string ButtonStyle { get; set; }
    
    [Parameter]
    public string ButtonClass { get; set; }
    
    /// <summary>
    /// Module for calling Javascript functions
    /// </summary>
    private IJSObjectReference _jsModule;

    private DotNetObjectReference<ColorPickerComponent> _dotnetRef;

    private bool _disposed;
    private bool _initializing;
    private Task _cleanupTask;

    private string _id = "pickr-" + Guid.NewGuid().ToString();
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;

        _initializing = true;
        try
        {
            _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Valour.Client/Components/Utility/ColorPickerComponent.razor.js?version=$(SHORTHASH)");
            if (_disposed)
                return;
            _dotnetRef = DotNetObjectReference.Create(this);
            await _jsModule.InvokeVoidAsync("init", _id, _dotnetRef, StartColor, UseAsButton);
        }
        finally
        {
            _initializing = false;
            if (_disposed)
                await CleanupAsync();
        }
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        return _initializing ? ValueTask.CompletedTask : new ValueTask(CleanupAsync());
    }

    private Task CleanupAsync() => _cleanupTask ??= ReleaseReferencesAsync();

    private async Task ReleaseReferencesAsync()
    {
        var module = _jsModule;
        _jsModule = null;
        try
        {
            if (module is not null)
            {
                try { await module.InvokeVoidAsync("destroy", _id); }
                catch (JSException) { }
                catch (ObjectDisposedException) { }
                try { await module.DisposeAsync(); }
                catch (JSException) { }
                catch (ObjectDisposedException) { }
            }
        }
        finally
        {
            _dotnetRef?.Dispose();
            _dotnetRef = null;
        }
    }

    [JSInvokable]
    public async Task ColorChange(string newColor)
    {
        if (!_disposed && OnColorChange is not null)
            await OnColorChange.Invoke(newColor);
    }
}
