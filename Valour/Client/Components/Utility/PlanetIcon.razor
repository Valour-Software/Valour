@* Circular planet icon. Planets without a custom icon show their generated globe. *@
@implements IDisposable

@if (Planet is null)
{
    return;
}

<div class="planet-icon @(Planet.HasCustomIcon ? "" : "globe") @(Unread ? "unread" : "")" style="--planet-icon-size: @(Size)px">
    @if (!Planet.HasCustomIcon)
    {
        <PlanetGlobe Seed="@_seed" Plain="true" Radius="0.46" Lights="@Lights" />
    }
    else
    {
        <LazyImage CssClass="planet-icon-img"
                   Alt="@($"{Planet.Name}'s icon")"
                   Src="@_iconUrl"
                   FallbackSrc="_content/Valour.Client/media/logo-circle.svg">
            <Placeholder>
                <div class="planet-icon-img placeholder"></div>
            </Placeholder>
        </LazyImage>
    }
</div>

@code {
    [Parameter]
    public Planet Planet { get; set; }

    [Parameter]
    public int Size { get; set; } = 36;

    /// <summary>
    /// Marks the planet as having unread activity with a small dot. Rows that show
    /// unread state on the name leave this off.
    /// </summary>
    [Parameter]
    public bool Unread { get; set; }

    /// <summary>
    /// Night-side lights for generated globes. See <see cref="PlanetGlobe.LightsFor"/>.
    /// </summary>
    [Parameter]
    public double Lights { get; set; } = 0.6;

    [Parameter]
    public IconFormat Format { get; set; } = IconFormat.WebpAnimated64;

    private string _iconUrl;
    private string _seed;
    private Planet _observed;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_observed, Planet))
        {
            if (_observed is not null)
                _observed.Updated -= OnPlanetUpdated;

            _observed = Planet;

            if (_observed is not null)
                _observed.Updated += OnPlanetUpdated;
        }

        if (Planet is null)
            return;

        _seed = NebulaPalettes.WorldSeed(Planet);
        _iconUrl = Planet.HasCustomIcon ? Planet.GetIconUrl(Format) : null;
    }

    private void OnPlanetUpdated(ModelUpdatedEvent<Planet> eventData)
    {
        if (eventData.Changes is not null && !eventData.Changes.On(x => x.WorldVariant))
            return;

        _ = InvokeAsync(() =>
        {
            if (Planet is null)
                return;

            _seed = NebulaPalettes.WorldSeed(Planet);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        if (_observed is not null)
            _observed.Updated -= OnPlanetUpdated;
    }
}
