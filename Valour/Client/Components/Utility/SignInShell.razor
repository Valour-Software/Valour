@* The page layout shared by sign-in, registration help and account pages: a sky
   with Victor and his constellation on one side, and a panel for content. *@

<div class="page sign-in">
    <div class="sign-in-sky" aria-hidden="true">
        <NebulaSky Seed="valour" Palette="valour" Intensity="1.3" Scale="2.6" Spread="0.4" FocusX="0.72" FocusY="0.35" />
        <PlanetGlobe Seed="valour-home" Kind="terra" Plain="true" Radius="0.5" CenterX="0.8" CenterY="1.19" Lights="1.4" Light="@HomeLight" />
        <svg class="constellation" viewBox="100 40 380 420">
            @foreach (var (a, b) in ConstellationEdges)
            {
                <line x1="@ConstellationStars[a].X" y1="@ConstellationStars[a].Y" x2="@ConstellationStars[b].X" y2="@ConstellationStars[b].Y" />
            }
            @foreach (var star in ConstellationStars.Values)
            {
                <circle class="halo" cx="@star.X" cy="@star.Y" r="@(star.Size * 4)" />
                <circle cx="@star.X" cy="@star.Y" r="@star.Size" />
            }
        </svg>
        <span class="sky-caption constellation-caption">canis victor · the good boy</span>
        <div class="sign-in-victor">
            <img src="_content/Valour.Client/media/victor/victor-astronaut.svg" alt="" draggable="false" />
            <span class="sky-caption">victor · out for a spacewalk</span>
        </div>
    </div>
    <div class="sign-in-panel">
        <div class="sign-in-content">
            <a class="brand" href="/">
                <Victor Color="currentColor" Style="width: 30px; height: 30px;" />
                <span>Valour</span>
            </a>
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    private static readonly double[] HomeLight = [0.12, -0.38, -0.92];

    // Canis Victor: stars placed on Victor's own outline (head, visor, eyes and
    // bowtie), in the coordinate space of his artwork.
    private static readonly Dictionary<char, (int X, int Y, double Size)> ConstellationStars = new()
    {
        ['A'] = (292, 72, 3.2), ['B'] = (190, 130, 2.4), ['C'] = (129, 273, 2.4), ['D'] = (170, 352, 2.4),
        ['E'] = (256, 367, 2.4), ['F'] = (292, 178, 2.4), ['G'] = (401, 160, 2.4), ['H'] = (446, 178, 3.2),
        ['I'] = (424, 262, 2.4), ['J'] = (305, 352, 2.4), ['K'] = (211, 200, 3.6), ['L'] = (328, 245, 3.6),
        ['M'] = (140, 412, 2.4), ['N'] = (201, 427, 3.6), ['O'] = (268, 433, 2.4)
    };

    private static readonly (char, char)[] ConstellationEdges =
    [
        ('A', 'B'), ('B', 'C'), ('C', 'D'), ('D', 'E'), ('A', 'F'), ('F', 'G'), ('G', 'H'),
        ('H', 'I'), ('I', 'J'), ('J', 'E'), ('M', 'N'), ('N', 'O'), ('E', 'N')
    ];
}
