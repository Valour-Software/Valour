@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<canvas class="planet-globe @CssClass" @ref="_canvas" aria-hidden="true"></canvas>

@code {
    /// <summary>
    /// The planet's id. Everything about the world (its kind, colors, surface,
    /// rings and moons) is derived from it, so a planet looks the same everywhere.
    /// </summary>
    [Parameter]
    public string Seed { get; set; }

    /// <summary>
    /// Brightness of the lights on the night side, from 0 (dark) to about 1.5.
    /// Callers usually derive it from how many members are online.
    /// </summary>
    [Parameter]
    public double Lights { get; set; } = 0.6;

    /// <summary>
    /// Planet radius as a fraction of the canvas height. Rings and moons extend
    /// beyond it.
    /// </summary>
    [Parameter]
    public double Radius { get; set; } = 0.4;

    /// <summary>
    /// Horizontal center of the planet, from 0 (left) to 1 (right).
    /// </summary>
    [Parameter]
    public double CenterX { get; set; } = 0.5;

    /// <summary>
    /// Vertical center of the planet, from 0 (top) to 1 (bottom).
    /// </summary>
    [Parameter]
    public double CenterY { get; set; } = 0.5;

    /// <summary>
    /// Pins the kind of world instead of deriving it from the seed, for scenes
    /// such as a character standing on a rock moon. One of terra, ocean, desert,
    /// gas, ice, rock or lava.
    /// </summary>
    [Parameter]
    public string Kind { get; set; }

    /// <summary>
    /// Leaves out rings and moons, for planets used as ground or a horizon.
    /// </summary>
    [Parameter]
    public bool Plain { get; set; }

    /// <summary>
    /// Direction the sunlight comes from, as x, y and z. Negative z lights the
    /// planet from behind, leaving a thin crescent and the night side facing you.
    /// </summary>
    [Parameter]
    public double[] Light { get; set; }

    [Parameter]
    public string CssClass { get; set; }

    private ElementReference _canvas;
    private IJSObjectReference _module;
    private IJSObjectReference _instance;
    private GlobeOptions _sent;
    private bool _disposed;

    private record GlobeOptions(string Seed, double Lights, double Radius, double CenterX, double CenterY, string Kind, bool Plain, double[] Light)
    {
        public virtual bool Equals(GlobeOptions other) =>
            other is not null && Seed == other.Seed && Lights == other.Lights && Radius == other.Radius &&
            CenterX == other.CenterX && CenterY == other.CenterY && Kind == other.Kind && Plain == other.Plain &&
            (Light ?? []).SequenceEqual(other.Light ?? []);

        public override int GetHashCode() => HashCode.Combine(Seed, Lights, Radius, CenterX, CenterY, Kind, Plain);
    }

    private GlobeOptions CurrentOptions => new(Seed, Lights, Radius, CenterX, CenterY, Kind, Plain, Light);

    /// <summary>
    /// Night-side brightness for a planet with the given member and online counts.
    /// Busy planets glow; quiet ones stay mostly dark.
    /// </summary>
    public static double LightsFor(int members, int online)
    {
        if (members <= 0 || online <= 0)
            return 0;

        var share = (double)online / members;
        return Math.Min(1.5, 0.25 + share * 12 + Math.Log10(online) * 0.1);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                var module = await JsRuntime.InvokeAsync<IJSObjectReference>("import",
                    "./_content/Valour.Client/Components/Utility/PlanetGlobe.razor.js");
                if (_disposed)
                {
                    await module.DisposeAsync();
                    return;
                }

                _module = module;
                _sent = CurrentOptions;
                var instance = await _module.InvokeAsync<IJSObjectReference>("init", _canvas, _sent);
                if (_disposed)
                {
                    await instance.InvokeVoidAsync("dispose");
                    await instance.DisposeAsync();
                    return;
                }

                _instance = instance;
                return;
            }

            var options = CurrentOptions;
            if (_instance is not null && options != _sent)
            {
                _sent = options;
                await _instance.InvokeVoidAsync("update", options);
            }
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_instance is not null)
            {
                await _instance.InvokeVoidAsync("dispose");
                await _instance.DisposeAsync();
            }

            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
