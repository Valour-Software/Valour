<div class="complex-nebula-container">
    <div class="nebula-sky-layer">
        <NebulaSky Seed="@Seed" Palette="@Palette" Intensity="@Intensity" Scale="2.4" FocusX="0.7" FocusY="0.35" Spread="0.42" />
    </div>
    <div class="nebula-content @ContentClasses">
        @ChildContent
    </div>
</div>

@code {
    #nullable enable
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? ContentClasses { get; set; }

    /// <summary>
    /// Seeds the sky. Brand surfaces keep the default.
    /// </summary>
    [Parameter] public string Seed { get; set; } = "valour";

    /// <summary>
    /// A palette name from nebula.js; the brand palette by default.
    /// </summary>
    [Parameter] public string? Palette { get; set; } = "valour";

    [Parameter] public double Intensity { get; set; } = 1.2;
}
