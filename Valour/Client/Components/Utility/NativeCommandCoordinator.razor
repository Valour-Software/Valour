@implements IDisposable
@inject ValourClient Client

@code {
    // Carries out commands from the native shell, such as the Settings item in
    // the Mac menu bar, which can't reach the app's modals directly.

    [CascadingParameter]
    public ModalRoot ModalRoot { get; set; }

    protected override void OnInitialized()
    {
        AppLifecycle.SettingsRequested += OnSettingsRequested;
    }

    private void OnSettingsRequested()
    {
        _ = InvokeAsync(() =>
        {
            if (Client.Me is null || ModalRoot is null)
                return;

            ModalRoot.OpenModal<EditUserComponent>(new EditUserComponent.ModalParams
            {
                User = Client.Me
            });
        });
    }

    public void Dispose()
    {
        AppLifecycle.SettingsRequested -= OnSettingsRequested;
    }
}
