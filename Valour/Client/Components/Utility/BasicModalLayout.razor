<div class="basic-modal" role="@Role" aria-modal="@(Role is null ? null : "true")" aria-label="@(Role is null ? null : Title)"
     style="max-width: min(90vw, @MaxWidth); @(MinWidth is null ? "" : $"min-width: {MinWidth};")"
>
    <div class="top">
        @if (Icon is not null)
        {
            <i class="bi bi-@Icon"></i>
        }
        
        <span class="title">@Title</span>
    </div>
    <div class="content" style="@ContentStyles">
        @MainArea
    </div>
    <div class="bottom">
        @ButtonArea
    </div>
</div>

@code {
    [Parameter]
    public string MaxWidth { get; set; } = "300px";
    
    [Parameter]
    public string MinWidth { get; set; } = null;
    
    [Parameter]
    public string Title { get; set; }
    
    [Parameter]
    public string Icon { get; set; }
    
    [Parameter]
    public string ContentStyles { get; set; } = "";
    
    [Parameter]
    public RenderFragment MainArea { get; set; }
    
    [Parameter]
    public RenderFragment ButtonArea { get; set; }

    /// <summary>
    /// An ARIA role for the modal, such as "dialog" or "alertdialog". When
    /// set, the title labels the modal for screen readers.
    /// </summary>
    [Parameter]
    public string Role { get; set; }
}