@inject ValourClient Client

<div class="storage-meter @StateClass @(Compact ? "compact" : "")" role="group" aria-label="Attachment storage">
    @if (_info is null)
    {
        <div class="meter-loading">@(_failed ? "Storage unavailable" : "Checking storage...")</div>
    }
    else
    {
        <div class="meter-head">
            <span class="meter-title">Storage</span>
            @if (_info.Unlimited)
            {
                <span class="meter-numbers numeric">@UserStorageInfo.FormatBytes(_info.UsedBytes) used</span>
            }
            else
            {
                <span class="meter-numbers numeric">@UserStorageInfo.FormatBytes(_info.UsedBytes) of @UserStorageInfo.FormatBytes(_info.QuotaBytes)</span>
            }
        </div>
        @if (!_info.Unlimited)
        {
            <div class="meter-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Percent">
                <div class="meter-fill" style="width: @Percent%"></div>
            </div>
        }
        @if (!Compact && !_info.Unlimited)
        {
            <div class="meter-foot">
                @if (_info.DriveIsDefault)
                {
                    <span>New uploads go to Google Drive, so they are never turned away.</span>
                }
                else if (_info.IsFull)
                {
                    <span>@(_info.PlansAvailable ? "Full. Free up space or upgrade to add more attachments." : "Full. Free up space to add more attachments.")</span>
                }
                else
                {
                    <span class="numeric">@UserStorageInfo.FormatBytes(_info.AvailableBytes) available</span>
                }
            </div>
        }
    }
</div>

@code {
    /// <summary>
    /// The numbers to show. When left out, the meter loads its own.
    /// </summary>
    [Parameter]
    public UserStorageInfo Info { get; set; }

    /// <summary>
    /// A single-line version for tight spaces such as the attach menu.
    /// </summary>
    [Parameter]
    public bool Compact { get; set; }

    private UserStorageInfo _info;
    private bool _failed;

    private int Percent => _info is null ? 0 : (int)Math.Round(_info.UsedFraction * 100);

    // A Drive account is never refused for space, so running high isn't a warning.
    private string StateClass => _info is null || _info.DriveIsDefault ? "" : _info.UsedFraction >= UserStorageInfo.CriticalFraction ? "full" : _info.UsedFraction >= UserStorageInfo.WarningFraction ? "warn" : "";

    protected override async Task OnInitializedAsync()
    {
        if (Info is null)
            await RefreshAsync();
    }

    protected override void OnParametersSet()
    {
        if (Info is not null)
            _info = Info;
    }

    public async Task RefreshAsync()
    {
        var result = await Client.AttachmentService.GetStorageAsync();
        _failed = !result.Success;
        if (result.Success)
            _info = result.Data;

        StateHasChanged();
    }
}
