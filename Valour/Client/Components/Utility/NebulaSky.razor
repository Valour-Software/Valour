@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<canvas class="nebula-sky @CssClass" @ref="_canvas" aria-hidden="true"></canvas>

@code {
    /// <summary>
    /// Makes the sky deterministic. Planets pass their id so each one keeps the
    /// same sky everywhere it appears.
    /// </summary>
    [Parameter]
    public string Seed { get; set; } = "valour";

    /// <summary>
    /// A palette name from wwwroot/js/nebula.js, such as "carina" or "eagle".
    /// When empty, a palette is picked from the seed.
    /// </summary>
    [Parameter]
    public string Palette { get; set; }

    /// <summary>
    /// Overall brightness of the gas. Atmosphere behind content stays near 1;
    /// hero surfaces can go higher.
    /// </summary>
    [Parameter]
    public double Intensity { get; set; } = 1;

    /// <summary>
    /// Horizontal center of the brightest region, from 0 (left) to 1 (right).
    /// </summary>
    [Parameter]
    public double FocusX { get; set; } = 0.62;

    /// <summary>
    /// Vertical center of the brightest region, from 0 (top) to 1 (bottom).
    /// </summary>
    [Parameter]
    public double FocusY { get; set; } = 0.42;

    /// <summary>
    /// How far the gas reaches from the focus point, relative to the height.
    /// </summary>
    [Parameter]
    public double Spread { get; set; } = 0.45;

    /// <summary>
    /// Structure density. Larger values fit more clouds into the same area.
    /// </summary>
    [Parameter]
    public double Scale { get; set; } = 2.2;

    /// <summary>
    /// Stars per million pixels.
    /// </summary>
    [Parameter]
    public int Stars { get; set; } = 260;

    [Parameter]
    public string CssClass { get; set; }

    private ElementReference _canvas;
    private IJSObjectReference _module;
    private IJSObjectReference _instance;
    private SkyOptions _sent;
    private bool _disposed;

    private record SkyOptions(string Seed, string Palette, double Intensity, double FocusX, double FocusY, double Spread, double Scale, int Stars);

    private SkyOptions CurrentOptions => new(Seed, Palette, Intensity, FocusX, FocusY, Spread, Scale, Stars);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                var module = await JsRuntime.InvokeAsync<IJSObjectReference>("import",
                    "./_content/Valour.Client/Components/Utility/NebulaSky.razor.js");
                if (_disposed)
                {
                    await module.DisposeAsync();
                    return;
                }

                _module = module;
                _sent = CurrentOptions;
                var instance = await _module.InvokeAsync<IJSObjectReference>("init", _canvas, _sent);
                if (_disposed)
                {
                    await instance.InvokeVoidAsync("dispose");
                    await instance.DisposeAsync();
                    return;
                }

                _instance = instance;
                return;
            }

            var options = CurrentOptions;
            if (_instance is not null && options != _sent)
            {
                _sent = options;
                await _instance.InvokeVoidAsync("update", options);
            }
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_instance is not null)
            {
                await _instance.InvokeVoidAsync("dispose");
                await _instance.DisposeAsync();
            }

            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
