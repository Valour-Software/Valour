<div class="tilt-card" style="@CssStyle">
  @ChildContent
</div>

@code {

  [Parameter]
  public RenderFragment ChildContent { get; set; }

  /// <summary>
  /// Kept for compatibility. The card no longer moves on hover.
  /// </summary>
  [Parameter]
  public string HoverMargin { get; set; } = "0px";

  [Parameter]
  public string CssStyle { get; set; }

  /// <summary>
  /// Kept for compatibility. The card no longer draws a hover shine.
  /// </summary>
  [Parameter]
  public string ShineCssStyle { get; set; }
}
