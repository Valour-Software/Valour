@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

@code {

    /// <summary>
    /// Event called when the mouse is moved. Private so we can track number of subscribers.
    /// </summary>
    private static event Func<MousePosition, Task> OnMouseMove;
    
    /// <summary>
    /// Event called when the mouse click goes up. Private so we can track number of subscribers.
    /// </summary>
    private static event Func<MouseUpEvent, Task> OnMouseUp;

    // Interop variables
    private DotNetObjectReference<MouseListener> _thisRef;
    private IJSObjectReference _jsModule;
    private IJSObjectReference _jsService;
    
    private static MouseListener _current;
    private bool _disposed;
    private bool _initializing;
    private Task _cleanupTask;

    /// <summary>
    /// The last known pointer position. It is updated by mouse moves while
    /// a move subscriber exists, and by every mouse release.
    /// </summary>
    public static MousePosition Position { get; private set; }

    // The move subscription state last sent to JS
    private bool _jsMoveActive;

    /// <summary>
    /// Subscribes to mouse moves. The JS mousemove listener only runs while
    /// at least one subscriber exists, and moves are delivered at most once
    /// per animation frame with the movement accumulated since the last one.
    /// </summary>
    public static void SubscribeMouseMove(Func<MousePosition, Task> callback)
    {
        OnMouseMove += callback;
        _current?.SyncMoveListener();
    }

    public static void UnsubscribeMouseMove(Func<MousePosition, Task> callback)
    {
        OnMouseMove -= callback;
        _current?.SyncMoveListener();
    }

    public static void SubscribeMouseUp(Func<MouseUpEvent, Task> callback)
    {
        OnMouseUp += callback;
    }

    public static void UnsubscribeMouseUp(Func<MouseUpEvent, Task> callback)
    {
        OnMouseUp -= callback;
    }

    /// <summary>
    /// Attaches or detaches the JS move listener when the subscriber set
    /// becomes non-empty or empty.
    /// </summary>
    private void SyncMoveListener()
    {
        var service = _jsService;
        if (_disposed || service is null)
            return; // Initialization sends the current state

        var active = OnMouseMove is not null;
        if (active == _jsMoveActive)
            return;

        _jsMoveActive = active;
        _ = SetJsMoveSubscribedAsync(service, active);
    }

    private static async Task SetJsMoveSubscribedAsync(IJSObjectReference service, bool active)
    {
        try { await service.InvokeVoidAsync("setMoveSubscribed", active); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (TaskCanceledException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;
        _current = this;
        _initializing = true;
        _thisRef = DotNetObjectReference.Create(this);
        try
        {
            _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Valour.Client/Components/Utility/MouseListener.razor.js");
            if (_disposed) return;
            _jsService = await _jsModule.InvokeAsync<IJSObjectReference>("init", _thisRef);
            if (_disposed) return;
            _jsMoveActive = OnMouseMove is not null;
            await _jsService.InvokeVoidAsync("setMoveSubscribed", _jsMoveActive);
            if (_disposed) return;
            await _jsService.InvokeVoidAsync("startUpListener");
        }
        finally
        {
            _initializing = false;
            if (_disposed) await CleanupAsync();
        }
    }

    /// <summary>
    /// Starts JS-side drag mode. The element will be moved directly by JS
    /// on mousemove without any .NET interop round-trips.
    /// </summary>
    public static async Task StartDrag(string elementId, IJSObjectReference scannerRef)
    {
        var service = _current?._jsService;
        if (service is not null)
            await service.InvokeVoidAsync("startDrag", elementId, scannerRef);
    }

    /// <summary>
    /// Stops JS-side drag mode and returns the final [x, y] position,
    /// or null if no drag was active.
    /// </summary>
    public static async Task<float[]> StopDrag()
    {
        var service = _current?._jsService;
        if (service is not null)
            return await service.InvokeAsync<float[]>("stopDrag");
        return null;
    }

    [JSInvokable("NotifyMouseMove")]
    public async Task NotifyMouseMove(
        float x, 
        float y, 
        float pageX,
        float pageY,
        float deltaX, 
        float deltaY)
    {
        var handlers = OnMouseMove;
        if (_disposed || handlers is null) return;
        var position = new MousePosition()
        {
            ClientX = x,
            ClientY = y,
            PageX = pageX,
            PageY = pageY,
            DeltaX = deltaX,
            DeltaY = deltaY
        };
        Position = position;
        await Task.WhenAll(handlers.GetInvocationList().Cast<Func<MousePosition, Task>>().Select(handler => handler(position)));
    }
    
    [JSInvokable("NotifyMouseUp")]
    public async Task NotifyMouseUp(float x, float y, float pageX, float pageY)
    {
        if (_disposed) return;

        // Keep Position current for click-driven placement (such as new
        // floating windows) while no move listener is attached.
        Position = new MousePosition()
        {
            ClientX = x,
            ClientY = y,
            PageX = pageX,
            PageY = pageY
        };

        var handlers = OnMouseUp;
        if (handlers is null) return;
        var mouseUp = new MouseUpEvent()
        {
            X = x,
            Y = y
        };
        await Task.WhenAll(handlers.GetInvocationList().Cast<Func<MouseUpEvent, Task>>().Select(handler => handler(mouseUp)));
    }
    
    public ValueTask DisposeAsync()
    {
        _disposed = true;
        if (ReferenceEquals(_current, this)) _current = null;
        return _initializing ? ValueTask.CompletedTask : new ValueTask(CleanupAsync());
    }

    private Task CleanupAsync() => _cleanupTask ??= ReleaseReferencesAsync();

    private async Task ReleaseReferencesAsync()
    {
        if (_jsService is not null)
        {
            foreach (var method in new[] { "stopMoveListener", "stopUpListener", "stopDrag" })
            {
                try { await _jsService.InvokeVoidAsync(method); }
                catch (JSException) { }
                catch (JSDisconnectedException) { }
                catch (ObjectDisposedException) { }
            }
            try { await _jsService.DisposeAsync(); }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
        if (_jsModule is not null)
        {
            try { await _jsModule.DisposeAsync(); }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
        }
        _jsService = null;
        _jsModule = null;
        _thisRef?.Dispose();
        _thisRef = null;
    }
}
