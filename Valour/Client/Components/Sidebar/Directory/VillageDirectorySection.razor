@implements IDisposable
@inject ValourClient Client
@using Valour.Client.Components.Windows.Villages

<button class="channel planet-village @(_isOpen ? "open" : "")" type="button" @onclick="OnClickHeader">
    <i class="bi bi-house-heart planet-pseudo-icon"></i>
    <span class="name">Village</span>
</button>

@code {
    [Parameter]
    public Planet Planet { get; set; }

    private bool _isOpen;

    protected override void OnInitialized()
    {
        VillageWindowComponent.SelectionsChanged += OnVillageWindowsChanged;
        _isOpen = VillageWindowComponent.IsOpenForPlanet(Planet.Id);
    }

    /// <summary>
    /// Lights the row up like an open channel while any village window for this
    /// planet is open
    /// </summary>
    private void OnVillageWindowsChanged()
    {
        var open = VillageWindowComponent.IsOpenForPlanet(Planet.Id);
        if (open == _isOpen)
            return;

        _isOpen = open;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnClickHeader()
    {
        var content = VillageWindowComponent.GetDefaultContent(Planet);
        await WindowService.OpenWindowAtFocused(content);
        await Sidebar.TryCloseMobileSidebarExternalAsync();
    }

    public void Dispose()
    {
        VillageWindowComponent.SelectionsChanged -= OnVillageWindowsChanged;
    }
}
