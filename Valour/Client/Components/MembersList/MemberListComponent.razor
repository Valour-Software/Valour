@inject PlanetService PlanetService
@inject ValourClient Client
@inject IAppStorage LocalStorage
@implements IDisposable

@if (!_visible)
{
    return;
}

<CascadingValue Value="this">
    <div class="role-list-wrapper" @ref="_wrapper">
        <div class="role-list hide-scrollbar">

            @if (_planet?.Members is not null && _displayedRoles is not null)
            {
                <Virtualize Items="_mainDisplay" ItemSize="48">
                    @if (context.IsTitle)
                    {
                        <p class="role-title">
                            @if (context.TitleColor is not null)
                            {
                                <span class="role-dot" style="background-color: @context.TitleColor;"></span>
                            }
                            @context.TitleName
                        </p>
                    }
                    else
                    {
                        <UserInfoComponent Member="@context.Member" @key="@context.Key"/>
                    }
                </Virtualize>
            }
        </div>
    </div>
</CascadingValue>

@code {
    
    [Parameter]
    public Channel Channel { get; set; }
    
    // Desktop windows open the list the way the user last left it.
    private bool _visible = !DeviceInfo.IsMobile && DevicePreferences.MemberListVisible;

    public class DisplayItem
    {
        public object Key;
        public bool IsTitle;
        public string TitleColor;
        public string TitleName;
        public string PositionClass;
        public PlanetMember Member;
    }

    private List<DisplayItem> _mainDisplay = new();
    private ElementReference _wrapper;
    private bool _disposed;
    private List<PlanetRole> _displayedRoles;
    private Dictionary<long, List<PlanetMember>> _displayedRoleMembers = new();


    // MemberId, RoleId
    private Dictionary<long, long> _lastMemberRoles = new();
    private Planet _planet;
    private NameComparer _comparer;
    
    private Timer _reloadTimer;
    private const int ReloadIntervalMs = 1000 * 30;

    // Set when a periodic reload was skipped while the list was hidden.
    private bool _reloadPending;

    // The chat window re-renders for every message and passes the same
    // Channel each time. Render only for internal changes or a new channel.
    private bool _shouldRender;
    private Channel _lastChannel;

    public CancellationToken ReloadToken { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _comparer = new NameComparer();

        _displayedRoleMembers.Add(0, new());
        _displayedRoleMembers.Add(1, new());

        PlanetService.PlanetDisconnected += OnPlanetDisconnected;
        BrowserUtils.Focused += OnBrowserFocused;
        WindowService.FocusedTabChanged += OnFocusedTabChanged;
        
        // Reload every 30s. SetPlanet performs the initial build.
        _reloadTimer = new Timer(Reload, null, ReloadIntervalMs, ReloadIntervalMs);

        SetPlanet(Channel.Planet);
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Channel, _lastChannel))
        {
            _lastChannel = Channel;
            _shouldRender = true;
        }

        if (Channel?.Planet != _planet)
            SetPlanet(Channel?.Planet);
    }

    protected override bool ShouldRender() => _shouldRender;

    protected override void OnAfterRender(bool firstRender)
    {
        _shouldRender = false;
    }

    private void Refresh()
    {
        if (_visible)
            BuildDisplayItems();

        _shouldRender = true;
        StateHasChanged();
    }

    private void BuildDisplayItems()
    {
        var display = new List<DisplayItem>();

        if (_planet?.Members is not null && _displayedRoles is not null)
        {
            foreach (var role in _displayedRoles)
            {
                if (_displayedRoleMembers.TryGetValue(role.Id, out var members))
                    AddSection(display, members, role.Id, role.Name, role.Color);
            }

            if (_displayedRoleMembers.TryGetValue(0, out var online))
                AddSection(display, online, "online", "Online", null);

            if (_displayedRoleMembers.TryGetValue(1, out var offline))
                AddSection(display, offline, "offline", "Offline", null);
        }

        _mainDisplay = display;
    }

    private static void AddSection(List<DisplayItem> display, List<PlanetMember> members, object key, string title, string color)
    {
        if (members.Count == 0)
            return;

        display.Add(new DisplayItem
        {
            TitleName = title,
            TitleColor = color,
            IsTitle = true,
            Key = key
        });

        foreach (var member in members)
        {
            display.Add(new DisplayItem
            {
                Member = member,
                IsTitle = false,
                Key = member.Id
            });
        }
    }

    private void Reload(object state)
    {
        if (_disposed)
            return;

        // Online state and activity can change without member events, so the
        // list is rebuilt periodically. A list nobody can see waits until it
        // is shown again.
        _ = InvokeAsync(RebuildIfShownAsync);
    }

    private async Task RebuildIfShownAsync()
    {
        if (_disposed || _planet is null)
            return;

        if (!_visible || !BrowserUtils.IsFocused || !await IsLaidOutAsync())
        {
            _reloadPending = true;
            return;
        }

        if (!_disposed && _planet is not null)
            BuildRoleLists();
    }

    private async Task<bool> IsLaidOutAsync()
    {
        var dimensions = await BrowserUtils.GetElementDimensions(_wrapper);
        return dimensions.Width > 0;
    }

    private Task OnBrowserFocused() => InvokeAsync(ResumePendingReloadAsync);

    private Task OnFocusedTabChanged(WindowTab tab) => InvokeAsync(ResumePendingReloadAsync);

    private async Task ResumePendingReloadAsync()
    {
        if (!_reloadPending)
            return;

        // The newly focused tab is displayed by the next render.
        await Task.Delay(250);
        await RebuildIfShownAsync();
    }

    public Task OnMemberDelete(PlanetMember member)
    {
        if (member.PlanetId != WindowService.FocusedPlanet.Id)
            return Task.CompletedTask;

        return InvokeAsync(() =>
        {
            var lastRole = _lastMemberRoles[member.Id];
            _displayedRoleMembers[lastRole].Remove(member);
            Refresh();
        });
    }

    public void DetermineDisplayedRole(PlanetMember member)
    {
        InvokeAsync(() =>
        {
            if (member is null)
                return;

            if (!_lastMemberRoles.TryGetValue(member.Id, out var lastRole))
                return;

            var newRole = DetermineDisplayRoleId(member);

            if (lastRole != newRole)
            {
                if (_displayedRoleMembers.TryGetValue(lastRole, out var oldList))
                    oldList.Remove(member);

                if (_displayedRoleMembers.TryGetValue(newRole, out var newRoleMembers))
                {
                    newRoleMembers.Add(member);
                    newRoleMembers.Sort(_comparer);
                }

                _lastMemberRoles[member.Id] = newRole;

                Refresh();
            }
        });
    }

    public void OnMemberListChange(IModelEvent<PlanetMember> eventData)
    {
        InvokeAsync(() =>
        {
            switch (eventData)
            {
                case ModelAddedEvent<PlanetMember> added:
                {
                    var member = added.Model;

                    // Member is new - calculate their value and insert accordingly
                    var roleId = DetermineDisplayRoleId(member);
                    if (_displayedRoleMembers.TryGetValue(roleId, out var roleList))
                    {
                        _lastMemberRoles[member.Id] = roleId;
                        roleList.Add(member);
                        roleList.Sort(_comparer);
                    }

                    break;
                }
                case ModelUpdatedEvent<PlanetMember> updated:
                {
                    // Gaining/losing a role can move the member to a different
                    // section - name/avatar-only changes don't need a re-bucket.
                    if (updated.Changes.On(x => x.RoleMembership))
                    {
                        DetermineDisplayedRole(updated.Model);
                    }

                    break;
                }
                case ModelRemovedEvent<PlanetMember> deleted:
                {
                    var member = deleted.Model;

                    // Member is removed (left planet), remove from display
                    var roleId = DetermineDisplayRoleId(member);
                    if (_displayedRoleMembers.TryGetValue(roleId, out var roleList))
                    {
                        roleList.Remove(member);
                    }

                    _lastMemberRoles.Remove(member.Id);
                    break;
                }
            }

            Refresh();
        });
    }
    
    private void OnPlanetRolesChange(IModelEvent<PlanetRole> eventData)
    {
        InvokeAsync(() =>
        {
            switch (eventData)
            {
                case ModelsSetEvent<PlanetRole>:
                {
                    _displayedRoles = _planet.Roles.Where(x => x.HasDisplayRole).ToList();
                    return;
                }
                case ModelAddedEvent<PlanetRole> added:
                {
                    var role = added.Model;

                    if (role.HasDisplayRole)
                    {
                        _displayedRoleMembers[role.Id] = new();
                        _displayedRoles.Add(role);
                        BuildRoleLists();
                    }

                    return;
                }
                case ModelUpdatedEvent<PlanetRole> updated:
                {
                    var role = updated.Model;

                    if (_displayedRoleMembers.ContainsKey(role.Id))
                    {
                        if (!role.HasDisplayRole)
                        {
                            foreach (var member in _displayedRoleMembers[role.Id])
                            {
                                var newRoleId = DetermineDisplayRoleId(member);
                                var newRoleList = _displayedRoleMembers[newRoleId];
                                newRoleList.Add(member);
                                newRoleList.Sort(_comparer);
                                _lastMemberRoles[member.Id] = newRoleId;
                            }

                            _displayedRoles.Remove(role);
                            _displayedRoleMembers.Remove(role.Id);
                        }

                        Refresh();
                    }
                    else
                    {
                        if (role.HasDisplayRole)
                        {
                            _displayedRoleMembers[role.Id] = new();
                            _displayedRoles.Add(role);
                            _displayedRoles.Sort((a, b) => a.Position.CompareTo(b.Position));
                            BuildRoleLists();
                        }
                    }

                    return;
                }
                case ModelRemovedEvent<PlanetRole> removed:
                {
                    var role = removed.Model;

                    if (role.PlanetId != WindowService.FocusedPlanet.Id)
                        return;

                    if (!_displayedRoleMembers.TryGetValue(role.Id, out var members))
                    {
                        return;
                    }

                    foreach (var member in members)
                    {
                        var newRoleId = DetermineDisplayRoleId(member, exclude: role.Id);
                        var newRoleList = _displayedRoleMembers[newRoleId];
                        newRoleList.Add(member);
                        newRoleList.Sort(_comparer);
                        _lastMemberRoles[member.Id] = newRoleId;
                    }

                    _displayedRoleMembers.Remove(role.Id);
                    _displayedRoles.Remove(role);

                    Refresh();

                    return;
                }
            }
        });
    }

    /// <summary>
    /// Rebuilds every displayed list from the planet's members. Lists are
    /// cleared first, so a member appears in at most one list.
    /// </summary>
    private void BuildRoleLists()
    {
        _reloadPending = false;

        foreach (var list in _displayedRoleMembers.Values)
        {
            list.Clear();
        }

        foreach (var member in _planet.Members)
        {
            var roleId = DetermineDisplayRoleId(member);
            if (roleId != -1)
            {
                _lastMemberRoles[member.Id] = roleId;
                _displayedRoleMembers[roleId].Add(member);
            }
        }

        Refresh();
    }

    /// <summary>
    /// Given a member, determines the id of the role they should be
    /// displayed in.
    /// </summary>
    private long DetermineDisplayRoleId(PlanetMember member, long exclude = long.MaxValue)
    {
        // Don't list at all if this is true
        if (ShouldHideMember(member, Client.Me.Id))
            return -1;

        // Throw directly into offline group
        if (member.User.UserState.Value == UserState.Offline.Value)
        {
            return 1;
        }
        
        // Try for a role
        foreach (var role in _displayedRoles)
        {
            if (role.Id == exclude)
                continue;

            // Ensure role should be listed
            if (!role.HasDisplayRole)
                continue;
            
            // Member has role
            for (int i = 0; i < member.Roles.Count; i++)
            {
                if (member.Roles[i].Id == role.Id)
                {
                    return role.Id;
                }
            }
            
            // TODO: Optimize using role hashes
        }

        // Online without display role
        return 0;
    }

    internal static bool ShouldHideMember(PlanetMember? member, long currentUserId)
        => member?.User is null ||
           (member.User.Id != currentUserId && member.User.LastActiveSpan.TotalDays > 7);

    private void ClearPlanetState()
    {
        _lastMemberRoles?.Clear();
        _displayedRoleMembers.Clear();
        _displayedRoleMembers.Add(0, new());
        _displayedRoleMembers.Add(1, new());

        foreach (var role in _displayedRoles ?? [])
        {
            _displayedRoleMembers.Add(role.Id, new());
        }
    }

    private void OnPlanetDisconnected(Planet planet)
    {
        InvokeAsync(() =>
        {
            if (_planet?.Id != planet.Id)
                return;

            SetPlanet(null);
        });
    }

    public void OnPlanetChange(Planet? planet)
    {
        _ = InvokeAsync(() => SetPlanet(planet));
    }

    private void SetPlanet(Planet? planet)
    {
        if (_planet == planet)
            return;

        if (_planet is not null)
        {
            _planet.Roles.Changed -= OnPlanetRolesChange;
            _planet.Members.Changed -= OnMemberListChange;
        }

        _planet = planet;
        _displayedRoles = planet?.Roles.Where(x => x.HasDisplayRole).ToList() ?? [];
        ClearPlanetState();

        if (planet is not null)
        {
            planet.Roles.Changed += OnPlanetRolesChange;
            planet.Members.Changed += OnMemberListChange;
            Client.Logger.Log<MemberListComponent>($"Member list is updating to {planet.Name}", "cyan");
            BuildRoleLists();
        }

        Refresh();
    }
    
    public void ToggleVisible()
    {
        _visible = !_visible;

        if (!DeviceInfo.IsMobile)
            _ = DevicePreferences.SetMemberListVisible(_visible, LocalStorage);

        if (_visible && _reloadPending && _planet is not null)
            BuildRoleLists(); // Also requests a render
        else
            Refresh();
    }

    public void Dispose()
    {
        _disposed = true;
        _reloadTimer?.Dispose();
        PlanetService.PlanetDisconnected -= OnPlanetDisconnected;
        BrowserUtils.Focused -= OnBrowserFocused;
        WindowService.FocusedTabChanged -= OnFocusedTabChanged;

        if (_planet is not null)
        {
            _planet.Roles.Changed -= OnPlanetRolesChange;
            _planet.Members.Changed -= OnMemberListChange;
        }
    }

    public class ActivityComparer : IComparer<PlanetMember>
    {
        public int Compare(PlanetMember a, PlanetMember b)
        {
            var greater = (a?.User.TimeLastActive.Ticks ?? 0) >
                           (b?.User.TimeLastActive.Ticks ?? 0);

            return greater ? -1 : 1;
        }
    }
    
    public class NameComparer : IComparer<PlanetMember>
    {
        public int Compare(PlanetMember a, PlanetMember b)
        {
            if (string.Compare(a?.Name, b?.Name, StringComparison.OrdinalIgnoreCase) == 0)
            {
                return -1;
            }
            return string.Compare(a?.Name, b?.Name, StringComparison.OrdinalIgnoreCase);
        }
    }
}
