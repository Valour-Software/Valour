@*
    Demo engine loader for recording marketing/demo videos.
    Inert unless the page is loaded with ?demo=1 (the JS modules are only imported then).

    URL params:
      &planet=Some%20Planet  target planet (default "Valour Central")
      &scene=ad              auto-play a scene once the app shell is ready
      &deck=0                hide the director control deck

    The engine lives in wwwroot/demo/ (camera rig, exploded layers, overlay
    kit, timeline + scenes). Only drives the viewer's own session - synthetic
    input runs as the logged-in user.
*@
@inject NavigationManager NavManager
@inject IJSRuntime JsRuntime
@implements IAsyncDisposable

@code {
    private IJSObjectReference _module;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var uri = new Uri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (query["demo"] != "1")
            return;

        _module = await JsRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/Valour.Client/demo/director.js");

        await _module.InvokeVoidAsync("init", query["planet"]);
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("cleanup");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }
}
