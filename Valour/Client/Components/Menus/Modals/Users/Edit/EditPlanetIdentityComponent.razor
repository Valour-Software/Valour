@inject ValourClient Client

<div class="settings-page identity-settings">
    @if (_planets.Count == 0)
    {
        <div class="empty-state">Join a planet to create a planet-specific identity.</div>
    }
    else
    {
        <div class="editor-section">
            <h3 class="editor-section-title">
                <i class="bi bi-globe2"></i>
                Planet
            </h3>

            <div class="form-group planet-picker">
                <label>Planet</label>
                <CustomDropdown TItem="Planet"
                                Items="@_planets"
                                InitialItem="@_selectedPlanet"
                                Placeholder="Select a planet..."
                                SearchFunc="@PlanetSearch"
                                SelectedItemChanged="@OnPlanetSelectedAsync">
                    <ItemTemplate Context="planet">
                        <div class="planet-option">
                            <PlanetIcon Planet="@planet" Size="20" />
                            <span class="planet-option-name">@planet.Name</span>
                        </div>
                    </ItemTemplate>
                </CustomDropdown>
                <p class="helper-text">Choose which planet-specific profile you want to edit.</p>
            </div>
        </div>

        @if (_member is null)
        {
            <div class="editor-section">
                <Loading Subtext="Loading your planet identity..." />
            </div>
        }
        else
        {
            <EditIdentity Member="@_member" />
        }
    }
</div>

@code {
    private List<Planet> _planets = new();
    private Planet _selectedPlanet;
    private PlanetMember _member;

    private static bool PlanetSearch(Planet planet, string search) =>
        planet.Name.Contains(search, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _planets = Client.PlanetService.JoinedPlanets.OrderBy(x => x.Name).ToList();
        if (_planets.Count == 0)
            return;

        _selectedPlanet = _planets[0];
        await LoadSelectedMemberAsync();
    }

    private async Task OnPlanetSelectedAsync(Planet planet)
    {
        if (planet is null || planet.Id == _selectedPlanet?.Id)
            return;

        _selectedPlanet = planet;
        _member = null;
        await LoadSelectedMemberAsync();
    }

    private async Task LoadSelectedMemberAsync()
    {
        _member = _selectedPlanet?.MyMember;
        if (_member is null && _selectedPlanet is not null)
            _member = await Client.PlanetService.FetchMemberByUserAsync(Client.Me.Id, _selectedPlanet, true);
    }
}
