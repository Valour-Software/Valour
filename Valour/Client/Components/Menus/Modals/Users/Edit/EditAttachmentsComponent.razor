@using Valour.Client.Components.Menus.Modals.Attachments
@using Valour.Shared.Cdn
@using Valour.Shared.Queries
@inject ValourClient Client
@implements IDisposable

<div class="attachments-panel">
    <div class="storage-card">
        <StorageMeter Info="@_storage" />
        <VButton Variant="secondary" Icon="trash3" OnClick="@OpenCleanup">Cleanup</VButton>
    </div>

    <DriveConnectionCard @ref="_driveCard" OnChanged="@OnDriveChangedAsync" />

    <div class="attachments-toolbar">
        <VSearchBox Placeholder="Search filenames, MIME types, or hashes..."
                    Value="@_search"
                    ValueChanged="@OnSearchChanged" />

        <div class="attachments-controls">
            <select class="form-select sort-select" @onchange="OnSortChanged">
                <option value="createdAt" selected>Newest</option>
                <option value="fileName">Filename</option>
                <option value="sizeBytes">Size</option>
                <option value="mimeType">Type</option>
                <option value="category">Category</option>
            </select>
            <VButton Variant="secondary" Icon="arrow-clockwise" Disabled="@_loading" OnClick="@RefreshAsync">Refresh</VButton>
        </div>
    </div>

    <div class="attachments-note">
        Deleting an attachment replaces it with a known “Attachment not found” placeholder anywhere it was used.
    </div>

    @if (_loading && _attachments.Count == 0)
    {
        <div class="empty-state">Loading your attachments...</div>
    }
    else if (_attachments.Count == 0)
    {
        <div class="empty-state">No attachments found.</div>
    }
    else
    {
        <div class="attachments-grid">
            @foreach (var attachment in _attachments)
            {
                <div class="attachment-card" @key="attachment.Id">
                    <div class="attachment-preview">
                        @if (IsImage(attachment))
                        {
                            <img src="@GetAttachmentUrl(attachment)" alt="@attachment.FileName" loading="lazy" />
                        }
                        else if (IsVideo(attachment))
                        {
                            <video controls preload="metadata" playsinline src="@GetAttachmentUrl(attachment)" type="@attachment.MimeType"></video>
                        }
                        else if (IsAudio(attachment))
                        {
                            <div class="audio-preview-art">
                                <i class="bi bi-music-note-beamed"></i>
                            </div>
                            <audio controls preload="metadata" src="@GetAttachmentUrl(attachment)"></audio>
                        }
                        else
                        {
                            <div class="attachment-icon">
                                <i class="bi bi-@GetCategoryIcon(attachment.Category)"></i>
                            </div>
                        }
                    </div>
                    <div class="attachment-main">
                        <div class="attachment-name" title="@attachment.FileName">@attachment.FileName</div>
                        <div class="attachment-meta">
                            <span>@attachment.MimeType</span>
                            <span class="numeric">@FormatBytes(attachment.SizeBytes)</span>
                            <span class="numeric">@attachment.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                            @if (ShowLocation(attachment))
                            {
                                <span class="location-chip @GetLocationClass(attachment)">@GetLocationText(attachment)</span>
                            }
                        </div>
                        <div class="attachment-hash">@attachment.Hash</div>
                    </div>
                    <div class="attachment-actions">
                        @if (_driveActive && GetMoveAction(attachment) is { } move)
                        {
                            <button class="v-btn secondary"
                                    disabled="@(_movingIds.Contains(attachment.Id) || move.Disabled)"
                                    title="@move.Title"
                                    @onclick="() => MoveAsync(attachment)">
                                @move.Label
                            </button>
                        }
                        <a class="v-btn secondary" href="@GetAttachmentUrl(attachment)" target="_blank" rel="noopener noreferrer">
                            Open
                        </a>
                        <button class="v-btn danger"
                                disabled="@_deletingIds.Contains(attachment.Id)"
                                @onclick="() => ConfirmDelete(attachment)">
                            Delete
                        </button>
                    </div>
                </div>
            }
        </div>

        @if (_attachments.Count < _totalCount)
        {
            <button class="v-btn load-more" @onclick="LoadMoreAsync" disabled="@_loading">
                Load more (@_attachments.Count / @_totalCount)
            </button>
        }
    }
</div>

@code {
    [CascadingParameter]
    public ModalRoot ModalRoot { get; set; }

    private const int PageSize = 50;
    private readonly HashSet<string> _deletingIds = new();

    private List<UserAttachmentInfo> _attachments = new();
    private int _totalCount;
    private bool _loading;
    private string _search = string.Empty;
    private string _sortField = "createdAt";

    private UserStorageInfo _storage;

    private DriveConnectionCard _driveCard;
    private bool _driveActive;
    private readonly HashSet<string> _movingIds = new();
    private Timer _poll;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(QueryAsync(reset: true), LoadStorageAsync(), LoadDriveAsync());

        // Files sent to Drive move in the background, so keep their rows current.
        _poll = new Timer(async _ =>
        {
            if (_loading || !_attachments.Any(x => x.StorageLocation == AttachmentStorageLocation.SendingToDrive))
                return;

            await RefreshLoadedAsync();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(6), TimeSpan.FromSeconds(6));
    }

    public void Dispose() => _poll?.Dispose();

    private async Task LoadDriveAsync()
    {
        var result = await Client.AttachmentService.GetDriveAsync();
        _driveActive = result.Success && result.Data is { Connected: true, Status: DriveConnectionStatus.Active };
    }

    private async Task OnDriveChangedAsync()
    {
        await Task.WhenAll(LoadStorageAsync(), LoadDriveAsync());
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Reloads the rows already on screen without losing the person's place.</summary>
    private async Task RefreshLoadedAsync()
    {
        var result = await Client.AttachmentService.QueryAsync(new QueryRequest
        {
            Skip = 0,
            Take = Math.Max(PageSize, _attachments.Count),
            Options = new QueryOptions
            {
                Filters = new Dictionary<string, string> { ["search"] = _search },
                Sort = new QuerySort { Field = _sortField, Descending = true }
            }
        });

        if (result.Success)
        {
            _totalCount = result.Data.TotalCount;
            _attachments = result.Data.Items;
        }

        await Task.WhenAll(LoadStorageAsync(), _driveCard?.RefreshAsync() ?? Task.CompletedTask);
    }

    // Moving files between Valour and Google Drive //

    private record MoveAction(string Label, string Title, bool Disabled);

    private static bool ShowLocation(UserAttachmentInfo attachment) =>
        attachment.StorageLocation != AttachmentStorageLocation.Valour;

    private static string GetLocationClass(UserAttachmentInfo attachment) => attachment.StorageLocation switch
    {
        AttachmentStorageLocation.DriveFailed => "failed",
        AttachmentStorageLocation.SendingToDrive => "pending",
        _ => "drive",
    };

    private static string GetLocationText(UserAttachmentInfo attachment) => attachment.StorageLocation switch
    {
        AttachmentStorageLocation.SendingToDrive => "Sending to Google Drive...",
        AttachmentStorageLocation.DriveWithValourCopy when attachment.StorageExpiresAt is { } expires =>
            $"In Google Drive. Valour copy until {expires.ToLocalTime():MMM d}",
        AttachmentStorageLocation.DriveWithValourCopy => "In Google Drive",
        AttachmentStorageLocation.DriveOnly => "Only in Google Drive",
        AttachmentStorageLocation.DriveFailed => attachment.DriveError ?? "Could not send to Google Drive",
        _ => "On Valour",
    };

    /// <summary>
    /// The one move a row offers: from Valour to Drive, or from Drive back to Valour.
    /// </summary>
    private static MoveAction GetMoveAction(UserAttachmentInfo attachment) => attachment.StorageLocation switch
    {
        AttachmentStorageLocation.SendingToDrive => new MoveAction("Sending...", "Waiting for the copy to finish", true),
        AttachmentStorageLocation.DriveWithValourCopy or AttachmentStorageLocation.DriveOnly =>
            new MoveAction("Move to Valour", "Keep this file on Valour storage", false),
        _ => new MoveAction("Send to Drive", "Copy this file to Google Drive and remove it from Valour", false),
    };

    private async Task MoveAsync(UserAttachmentInfo attachment)
    {
        var toValour = attachment.StorageLocation is AttachmentStorageLocation.DriveWithValourCopy or AttachmentStorageLocation.DriveOnly;

        _movingIds.Add(attachment.Id);
        StateHasChanged();

        try
        {
            var result = toValour
                ? await Client.AttachmentService.MoveToValourAsync(attachment.Category, attachment.Hash)
                : await Client.AttachmentService.SendToDriveAsync(attachment.Category, attachment.Hash);

            if (!result.Success)
            {
                ToastContainer.Instance.AddToast(new ToastData(
                    toValour ? "Could not move to Valour" : "Could not send to Google Drive",
                    result.Message, ToastProgressState.Failure));
                return;
            }

            // Keep the row's address, which carries the signed link.
            var updated = result.Data;
            updated.SignedUrl = attachment.SignedUrl;
            var index = _attachments.FindIndex(x => x.Id == attachment.Id);
            if (index >= 0)
                _attachments[index] = updated;

            await Task.WhenAll(LoadStorageAsync(), _driveCard?.RefreshAsync() ?? Task.CompletedTask);
        }
        finally
        {
            _movingIds.Remove(attachment.Id);
            StateHasChanged();
        }
    }

    private async Task LoadStorageAsync()
    {
        var result = await Client.AttachmentService.GetStorageAsync();
        if (result.Success)
            _storage = result.Data;
    }

    private async Task RefreshAsync()
    {
        await Task.WhenAll(QueryAsync(reset: true), LoadStorageAsync());
    }

    private void OpenCleanup()
    {
        ModalRoot.OpenModal<AttachmentCleanupModal>(new AttachmentCleanupModal.ModalParams
        {
            OnDeleted = async () =>
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private async Task LoadMoreAsync()
    {
        await QueryAsync(reset: false);
    }

    private CancellationTokenSource _searchCts;

    private async Task OnSearchChanged(string search)
    {
        _search = search ?? string.Empty;

        // Debounce so we don't query on every keystroke
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(250, token);
            await QueryAsync(reset: true);
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Superseded by newer input
        }
    }

    private async Task OnSortChanged(ChangeEventArgs e)
    {
        _sortField = e.Value?.ToString() ?? "createdAt";
        await QueryAsync(reset: true);
    }

    private async Task QueryAsync(bool reset)
    {
        if (_loading)
            return;

        _loading = true;

        var request = new QueryRequest
        {
            Skip = reset ? 0 : _attachments.Count,
            Take = PageSize,
            Options = new QueryOptions
            {
                Filters = new Dictionary<string, string>
                {
                    ["search"] = _search
                },
                Sort = new QuerySort
                {
                    Field = _sortField,
                    Descending = true
                }
            }
        };

        var result = await Client.AttachmentService.QueryAsync(request);
        if (result.Success)
        {
            _totalCount = result.Data.TotalCount;
            _attachments = reset
                ? result.Data.Items
                : _attachments.Concat(result.Data.Items).ToList();
        }
        else
        {
            ToastContainer.Instance.AddToast(new ToastData("Could not load attachments", result.Message, ToastProgressState.Failure));
        }

        _loading = false;
    }

    private Task ConfirmDelete(UserAttachmentInfo attachment)
    {
        ModalRoot.OpenModal<ConfirmModalComponent>(new ConfirmModalComponent.ModalParams()
        {
            Title = "Delete attachment?",
            Description = $"This will replace \"{attachment.FileName}\" with an Attachment not found placeholder everywhere it was used.",
            ConfirmText = "Delete",
            CancelText = "Cancel",
            ConfirmEvent = async () => await DeleteAsync(attachment)
        });

        return Task.CompletedTask;
    }

    private async Task DeleteAsync(UserAttachmentInfo attachment)
    {
        _deletingIds.Add(attachment.Id);

        var result = await ToastContainer.Instance.WaitToastWithTaskResult(new ProgressToastData<TaskResult>
        {
            Title = "Deleting attachment",
            Message = "Detaching attachment from messages...",
            SuccessMessage = "Attachment deleted",
            ProgressTask = Client.AttachmentService.DeleteAsync(attachment)
        });

        _deletingIds.Remove(attachment.Id);

        if (result.Success)
        {
            _attachments.RemoveAll(x => x.Id == attachment.Id);
            _totalCount = Math.Max(0, _totalCount - 1);
            await LoadStorageAsync();
        }
    }

    private static string GetCategoryIcon(ContentCategory category)
    {
        return category switch
        {
            ContentCategory.Image => "image",
            ContentCategory.Audio => "music-note-beamed",
            ContentCategory.Video => "film",
            _ => "paperclip"
        };
    }

    private static bool IsImage(UserAttachmentInfo attachment)
    {
        return attachment.Category == ContentCategory.Image ||
               attachment.MimeType?.StartsWith("image/", StringComparison.OrdinalIgnoreCase) == true;
    }

    private static bool IsAudio(UserAttachmentInfo attachment)
    {
        return attachment.Category == ContentCategory.Audio ||
               attachment.MimeType?.StartsWith("audio/", StringComparison.OrdinalIgnoreCase) == true;
    }

    private static bool IsVideo(UserAttachmentInfo attachment)
    {
        return attachment.Category == ContentCategory.Video ||
               attachment.MimeType?.StartsWith("video/", StringComparison.OrdinalIgnoreCase) == true;
    }

    private static string GetAttachmentUrl(UserAttachmentInfo attachment)
    {
        return string.IsNullOrWhiteSpace(attachment.SignedUrl)
            ? attachment.Url
            : attachment.SignedUrl;
    }

    private static string FormatBytes(int bytes)
    {
        string[] units = ["B", "KB", "MB", "GB"];
        var value = (double)bytes;
        var unit = 0;

        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return $"{value:0.#} {units[unit]}";
    }
}
