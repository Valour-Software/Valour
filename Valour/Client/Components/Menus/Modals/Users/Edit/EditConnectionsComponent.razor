@inject AuthService AuthService
@inject ValourClient Client
@inject ExternalSignInService ExternalSignIn

<div class="settings-page">

<div class="editor-section">
    <h3 class="editor-section-title">
        <i class="bi bi-box-arrow-in-right"></i>
        Ways to sign in
    </h3>
    <p class="helper-text">Link accounts to sign in with them. Your account always keeps at least one way to sign in from a new device.</p>

    @if (_methods is null)
    {
        <div class="loading-indicator"></div>
    }
    else
    {
        <div class="method-list">
            <div class="method-item">
                <div class="method-row">
                    <i class="bi bi-key"></i>
                    <div class="method-copy">
                        <span class="method-name">Password</span>
                        <span class="method-meta">@(_password is not null ? _password.DisplayName : "No password. You sign in with a linked account.")</span>
                    </div>
                    @if (_password is not null)
                    {
                        <VButton Variant="danger" Size="sm" Disabled="@(_busy || !CanRemove(_password))"
                                 Title="@RemoveTitle(_password)" OnClick="@(() => OnClickRemove(_password))">Remove</VButton>
                    }
                    else if (!_addingPassword)
                    {
                        <VButton Variant="primary" Size="sm" Disabled="@_busy" OnClick="@(() => _addingPassword = true)">Add password</VButton>
                    }
                </div>

                @if (_addingPassword)
                {
                    <div class="method-form">
                        <PasswordInput placeholder="New password" autocomplete="new-password" @bind-Value="@_newPassword" />
                        <PasswordInput placeholder="Type it once more" autocomplete="new-password" @bind-Value="@_newPasswordConfirm" />
                        <div class="method-form-actions">
                            <VButton Variant="secondary" Size="sm" OnClick="@(() => _addingPassword = false)">Cancel</VButton>
                            <VButton Variant="primary" Size="sm" Disabled="@_busy" OnClick="@OnClickSavePassword">Save password</VButton>
                        </div>
                    </div>
                }
            </div>

            @foreach (var provider in _providers)
            {
                var linked = _methods.FirstOrDefault(x => ExternalSignInService.FromCredentialType(x.Type) == provider);
                <div class="method-item">
                    <div class="method-row">
                        <i class="bi @ExternalSignInService.GetIcon(provider) method-@provider"></i>
                        <div class="method-copy">
                            <span class="method-name">@ExternalSignInService.GetName(provider)</span>
                            <span class="method-meta">@(linked is not null ? $"Linked to {linked.DisplayName}" : "Not linked")</span>
                        </div>
                        @if (linked is not null)
                        {
                            <VButton Variant="danger" Size="sm" Disabled="@(_busy || !CanRemove(linked))"
                                     Title="@RemoveTitle(linked)" OnClick="@(() => OnClickRemove(linked))">Unlink</VButton>
                        }
                        else
                        {
                            <VButton Variant="primary" Size="sm" Disabled="@_busy" OnClick="@(() => OnClickLink(provider))">Link</VButton>
                        }
                    </div>
                </div>
            }
        </div>
    }

    <ResultLabel Result="@_result" />
</div>

</div>

@code {
    [CascadingParameter]
    public ModalRoot ModalRoot { get; set; }

    private List<SignInMethodInfo> _methods;
    private List<string> _providers = new();
    private SignInMethodInfo _password;

    private bool _busy;
    private ITaskResult _result;

    private bool _addingPassword;
    private string _newPassword;
    private string _newPasswordConfirm;

    protected override async Task OnInitializedAsync()
    {
        _providers = await ExternalSignIn.GetProvidersAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _methods = await AuthService.GetSignInMethodsAsync();
        _password = _methods.FirstOrDefault(x => x.Type == "Password");
    }

    // Mirrors the server rule: a password or linked account can only be
    // removed while another one remains. Fingerprint keys don't count.
    private bool CanRemove(SignInMethodInfo method) =>
        _methods.Any(x => x.Id != method.Id && x.Type != "DeviceKey");

    private string RemoveTitle(SignInMethodInfo method) =>
        CanRemove(method) ? null : "This is your only way to sign in. Add a password or link another account first.";

    private void Show(string message, bool isError)
    {
        _result = isError ? TaskResult.FromFailure(message) : TaskResult.FromSuccess(message);
    }

    private Task<string> GetReauthProofAsync() =>
        ExternalSignIn.ConfirmIdentityAsync(ModalRoot, "Confirm it's you to change how you sign in.");

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _result = null;
        StateHasChanged();

        try
        {
            await action();
            await LoadAsync();
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private Task OnClickLink(string provider) => RunAsync(async () =>
    {
        var proof = await GetReauthProofAsync();
        if (proof is null)
            return;

        var outcome = await ExternalSignIn.RunAsync(provider, ExternalAuthIntent.Link, proof);
        if (outcome.Result == ExternalAuthResults.Linked)
            Show($"{ExternalSignInService.GetName(provider)} is linked. You can sign in with it now.", false);
        else
            Show(outcome.Message, true);
    });

    private Task OnClickRemove(SignInMethodInfo method) => RunAsync(async () =>
    {
        var proof = await GetReauthProofAsync();
        if (proof is null)
            return;

        var result = await AuthService.RemoveSignInMethodAsync(method.Id, proof);
        if (!result.Success)
        {
            Show(result.Message, true);
            return;
        }

        Show(method.Type == "Password" ? "Your password is removed." : $"{method.Type} is unlinked.", false);
    });

    private Task OnClickSavePassword() => RunAsync(async () =>
    {
        if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword != _newPasswordConfirm)
        {
            Show("Those passwords do not match.", true);
            return;
        }

        var proof = await GetReauthProofAsync();
        if (proof is null)
            return;

        var result = await AuthService.AddPasswordAsync(_newPassword, proof);
        if (!result.Success)
        {
            Show(result.Message, true);
            return;
        }

        _addingPassword = false;
        _newPassword = _newPasswordConfirm = null;
        Show("Your password is set. You can sign in with your email and password.", false);
    });
}
