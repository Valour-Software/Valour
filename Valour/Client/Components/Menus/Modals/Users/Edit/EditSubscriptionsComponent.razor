@using Microsoft.Extensions.DependencyInjection
@inject IJSRuntime JsRuntime
@inject NavigationManager NavManager
@inject ValourClient Client
@inject IServiceProvider Services

<div class="settings-page subscriptions-page">
<fieldset class="subscription-controls" disabled="@_busy" aria-busy="@(_busy || _loading)">
@if (Client.InstanceManifest is not null && !Client.InstanceManifest.Capabilities.Payments)
{
    <div class="editor-section"><p class="helper-text">Subscriptions are not available on this instance.</p></div>
}
else if (_loading)
{
    <div class="editor-section" role="status"><p class="helper-text">Loading your subscription...</p></div>
}
else if (_loadError is not null)
{
    <div class="editor-section" role="alert">
        <p class="helper-text">@_loadError</p>
        <button type="button" class="v-btn secondary" @onclick="OnInitializedAsync">Try again</button>
    </div>
}
else if (_page == SubPage.Redirecting)
{


    <div class="editor-section" role="status">
        <h3 class="editor-section-title">@_redirectingMessage</h3>
        <p>@_redirectingDetail</p>

        @if (!string.IsNullOrWhiteSpace(_errorSpan))
        {
            <span class="v-text-red mt-4">@_errorSpan</span>
        }

        <button class="v-btn mt-4" @onclick="BackToMain">Go back</button>
    </div>
}
else if (_page == SubPage.Result)
{

    <div class="editor-section" role="status">
        <h3 class="editor-section-title">@_resultTitle</h3>
        <p>@_resultMessage</p>

        <button class="v-btn mt-4" @onclick="BackToMain">Back to subscriptions</button>
    </div>
}
else
{
    <section class="editor-section">
        <h3 class="editor-section-title"><i class="bi bi-credit-card"></i>Your subscription</h3>
    @* Active Subscription Banner *@
    @if (_activeSub is not null)
    {
        <div class="settings-row active-banner @GetBannerStatusClass()">
            <div class="banner-content">
                <div class="banner-info">
                    <div class="banner-header">
                        <span class="banner-tier-name">@_activeSub.Type</span>
                        <span class="status-badge @GetBadgeClass()">@GetStatusText()</span>
                    </div>
                    <span class="banner-billing">@GetBillingText()</span>
                    @if (_activeSub.StripePaymentFailed)
                    {
                        <span class="banner-warning">@(IsGooglePlaySub
                            ? "Your last Google Play payment failed. Update your payment method in Google Play."
                            : "Your last payment failed. Please update your payment method.")</span>
                    }
                    @if (_activeSub.Cancelled && !IsVcSub)
                    {
                        <span class="banner-note">Active until end of billing period</span>
                    }
                    @if (_activeSub.PendingType is not null)
                    {
                        <span class="banner-note">Changing to @_activeSub.PendingType next billing cycle</span>
                    }
                </div>
                <div class="banner-actions">
                    @if (_activeSub.PendingType is not null)
                    {
                        <button class="v-btn" @onclick="OnClickCancelPending">Undo downgrade</button>
                    }
                    @if (IsGooglePlaySub && _store is not null)
                    {
                        <button class="v-btn" @onclick="OnClickManageStoreSubscription">Manage in @_store.StoreName</button>
                    }
                    @if (_activeSub.Cancelled && IsVcSub)
                    {
                        <button class="v-btn primary" @onclick="OnClickReactivate">Reactivate</button>
                    }
                    else if (!_activeSub.Cancelled)
                    {
                        @if (!_confirmingCancel)
                        {
                            <button class="v-btn danger" @onclick="() => { _confirmingCancel = true; StateHasChanged(); }">Cancel subscription</button>
                        }
                        else
                        {
                            <span class="cancel-confirm-text">Are you sure?</span>
                            <div class="cancel-confirm-buttons">
                                <button class="v-btn danger" @onclick="OnConfirmCancel">Yes, cancel</button>
                                <button class="v-btn" @onclick="() => { _confirmingCancel = false; StateHasChanged(); }">Keep subscription</button>
                            </div>
                        }
                    }
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(_errorSpan) && _selectedTier is null)
            {
                <span class="v-text-red mt-2" role="alert">@_errorSpan</span>
            }
        </div>
    }

    else
    {
        <p class="helper-text">You do not have an active subscription. Choose a plan below to support Valour and unlock profile features.</p>
    }
    </section>

    @if (!string.IsNullOrWhiteSpace(_errorSpan) && _activeSub is null && _selectedTier is null)
    {
        <p class="v-text-red" role="alert">@_errorSpan</p>
    }
    @* Subscription Tiers *@
    <div class="editor-section">
        <div class="editor-section-title">
            <i class="bi bi-star-fill"></i>
            Plans
        </div>

        <div class="tier-grid">
            @foreach (var tier in _allTiers)
            {
                var isActive = _activeSub is not null && _activeSub.Type == tier.Name && !_activeSub.Cancelled;
                var isPending = _activeSub is not null && _activeSub.PendingType == tier.Name;
                var isExpanded = _selectedTier == tier;
                var tierAction = GetTierAction(tier);

                <div class="tier-card @(isActive ? "active" : "") @(isPending ? "pending" : "") @(isExpanded ? "expanded" : "")">
                    <div class="tier-summary">
                    <div class="tier-header">
                        <span class="tier-name">@tier.Name</span>
                        @if (isActive)
                        {
                            <span class="status-badge active">Current</span>
                        }
                        else if (isPending)
                        {
                            <span class="status-badge pending">Next cycle</span>
                        }
                    </div>
                    <div class="tier-pricing">
                        <span class="tier-price-vc"><span class="amount">@tier.Price VC</span> / month</span>
                        @if (_store is null)
                        {
                            <span class="tier-price-usd"><span class="amount">$@((tier.StripePriceCents / 100m).ToString("0.00"))</span> / month</span>
                        }
                        else if (GetStorePrice(tier.GooglePlayProductId) is { } storePrice)
                        {
                            <span class="tier-price-usd"><span class="amount">@storePrice</span> / month</span>
                        }
                    </div>
                    <p class="tier-desc">@tier.Description</p>
                    <details class="tier-benefits">
                        <summary>Included features</summary>
                    <ul class="tier-perks">
                        @foreach (var perk in GetPerks(tier.Name))
                        {
                            <li>@perk</li>
                        }
                    </ul>
                    </details>
                    </div>
                    <div class="tier-actions">
                    @if (isActive || isPending)
                    {
                        @if (_activeSub.PendingType is not null && isPending)
                        {
                            <button class="v-btn tier-subscribe-btn" @onclick="OnClickCancelPending">
                                Undo downgrade
                            </button>
                            <span class="upgrade-note">Keep @_activeSub.Type and remove the scheduled change to @_activeSub.PendingType.</span>
                        }

                        @if (isActive && IsVcSub && _store is null)
                        {
                            <button class="v-btn secondary tier-subscribe-btn" @onclick="() => OnClickStripeSubscribe(tier)">
                                Switch to card billing
                            </button>
                            <span class="upgrade-note">Keep this tier, move billing to Stripe, and apply your unused VC time as first-month credit.</span>
                        }
                    }
                    else if (isExpanded && tierAction == TierAction.Subscribe)
                    {
                        @* New subscription — show payment choice *@
                        <div class="payment-choice">
                            <button class="v-btn primary" @onclick="() => OnClickSubscribe(tier)">
                                Pay with VC (@tier.Price  VC / month)
                            </button>
                            @if (_globalAccount is not null && _globalAccount.BalanceValue < _dueNow)
                            {
                                <span class="balance-warning">Balance: @(_globalAccount.BalanceValue) VC (not enough)</span>
                            }
                            else if (_dueNow != tier.Price)
                            {
                                <span class="upgrade-note">Due now: @(_dueNow) VC (upgrade credit applied)</span>
                            }

                            @if (_store is not null)
                            {
                                <button class="v-btn secondary" @onclick="() => OnClickStoreSubscribe(tier)">
                                    Subscribe with @_store.StoreName (@(GetStorePrice(tier.GooglePlayProductId) ?? "price unavailable") / month + @(tier.VcReward) VC reward)
                                </button>
                                @if (IsStripeSub)
                                {
                                    <span class="upgrade-note">Your current plan is billed by card. Cancel it first so you are not billed twice.</span>
                                }
                            }
                            else
                            {
                                <button class="v-btn secondary" @onclick="() => OnClickStripeSubscribe(tier)">
                                    Pay with card ($@((tier.StripePriceCents / 100m).ToString("0.00")) / month + @(tier.VcReward) VC reward)
                                </button>
                            }

                            <button class="v-btn" @onclick="() => { _selectedTier = null; _errorSpan = null; StateHasChanged(); }">Back</button>

                            @if (!string.IsNullOrWhiteSpace(_errorSpan))
                            {
                                <span class="v-text-red mt-2">@_errorSpan</span>
                            }
                        </div>
                    }
                    else if (isExpanded && tierAction == TierAction.Upgrade)
                    {
                        @* Upgrade — show prorated cost and confirm *@
                        <div class="payment-choice">
                            @if (GetExternalBillingNote() is { } billingNote)
                            {
                                <span class="upgrade-note">@billingNote</span>
                            }
                            else if (IsGooglePlaySub)
                            {
                                <button class="v-btn primary" @onclick="() => OnClickStoreSubscribe(tier)">
                                    Upgrade in @_store.StoreName (@(GetStorePrice(tier.GooglePlayProductId) ?? "price unavailable") / month)
                                </button>
                                <span class="upgrade-note">The new plan starts now. Time left on your current plan is credited toward it.</span>
                            }
                            else if (IsStripeSub)
                            {
                                <button class="v-btn primary" @onclick="() => OnClickStripeChange(tier)">
                                    Confirm upgrade ($@((tier.StripePriceCents / 100m).ToString("0.00")) / month)
                                </button>
                                <span class="upgrade-note">Prorated charges will apply for the current period.</span>
                            }
                            else
                            {
                                <button class="v-btn primary" @onclick="() => OnClickSubscribe(tier)">
                                    Confirm upgrade (@(_dueNow) VC due now)
                                </button>
                                @if (_globalAccount is not null && _globalAccount.BalanceValue < _dueNow)
                                {
                                    <span class="balance-warning">Balance: @(_globalAccount.BalanceValue) VC (not enough)</span>
                                }

                                @if (_store is null)
                                {
                                    <button class="v-btn secondary" @onclick="() => OnClickStripeSubscribe(tier)">
                                        Switch to card billing ($@((tier.StripePriceCents / 100m).ToString("0.00")) / month + @(tier.VcReward) VC reward)
                                    </button>
                                    <span class="upgrade-note">Use Stripe billing, with unused VC time credited on your first Stripe month.</span>
                                }
                            }

                            <button class="v-btn" @onclick="() => { _selectedTier = null; _errorSpan = null; StateHasChanged(); }">Back</button>

                            @if (!string.IsNullOrWhiteSpace(_errorSpan))
                            {
                                <span class="v-text-red mt-2">@_errorSpan</span>
                            }
                        </div>
                    }
                    else if (isExpanded && tierAction == TierAction.Downgrade)
                    {
                        @* Downgrade — takes effect next billing cycle *@
                        <div class="payment-choice">
                            @if (GetExternalBillingNote() is { } billingNote)
                            {
                                <span class="upgrade-note">@billingNote</span>
                            }
                            else if (IsGooglePlaySub)
                            {
                                <button class="v-btn primary" @onclick="() => OnClickStoreSubscribe(tier)">
                                    Downgrade in @_store.StoreName (@(GetStorePrice(tier.GooglePlayProductId) ?? "price unavailable") / month)
                                </button>
                                <span class="upgrade-note">The new plan starts now. Time left on your current plan is credited toward it.</span>
                            }
                            else if (IsStripeSub)
                            {
                                <button class="v-btn primary" @onclick="() => OnClickStripeChange(tier)">
                                    Confirm downgrade
                                </button>
                                <span class="upgrade-note">Takes effect at your next billing cycle. No charge now.</span>
                            }
                            else
                            {
                                <button class="v-btn primary" @onclick="() => OnClickSubscribe(tier)">
                                    Confirm downgrade
                                </button>

                                @if (_store is null)
                                {
                                    <button class="v-btn secondary" @onclick="() => OnClickStripeSubscribe(tier)">
                                        Switch to card billing ($@((tier.StripePriceCents / 100m).ToString("0.00")) / month + @(tier.VcReward) VC reward)
                                    </button>
                                    <span class="upgrade-note">VC downgrade takes effect next cycle. Stripe switch applies after checkout.</span>
                                }
                                else
                                {
                                    <span class="upgrade-note">Takes effect at your next billing cycle.</span>
                                }
                            }

                            <button class="v-btn" @onclick="() => { _selectedTier = null; _errorSpan = null; StateHasChanged(); }">Back</button>

                            @if (!string.IsNullOrWhiteSpace(_errorSpan))
                            {
                                <span class="v-text-red mt-2">@_errorSpan</span>
                            }
                        </div>
                    }
                    else if (tierAction == TierAction.Subscribe)
                    {
                        <button class="v-btn tier-subscribe-btn" @onclick="async () => await OnSelectTier(tier)">Subscribe</button>
                    }
                    else if (tierAction == TierAction.Upgrade)
                    {
                        <button class="v-btn tier-subscribe-btn" @onclick="async () => await OnSelectTier(tier)">Upgrade</button>
                    }
                    else if (tierAction == TierAction.Downgrade)
                    {
                        <button class="v-btn tier-subscribe-btn" @onclick="async () => await OnSelectTier(tier)">Downgrade</button>
                    }
                    </div>
                </div>
            }
        </div>
    </div>

    @* Buy VC Credits *@
    <div class="editor-section">
        <div class="editor-section-title">
            <i class="bi bi-coin"></i>
            Valour Credits
        </div>

        <p class="helper-text">Use Valour Credits for subscriptions and the community economy. @(_store is null ? "Purchases open secure checkout." : $"Purchases go through {_store.StoreName}.")</p>
        @if (_globalAccount is not null)
        {
            <p class="credit-balance">Your balance: <strong class="amount">@_globalAccount.BalanceValue VC</strong></p>
        }
        @if (_store is not null)
        {
            <div class="vc-grid">
                @foreach (var (productId, credits) in GooglePlayProducts.CreditPacks)
                {
                    <button type="button" class="vc-card" @onclick="() => OnClickStoreBuyCredits(productId)">
                        <span class="vc-amount">@credits VC</span>
                        @if (GetStorePrice(productId) is { } packPrice)
                        {
                            <span class="vc-price">@packPrice</span>
                        }
                    </button>
                }
            </div>
        }
        else
        {
        <div class="vc-grid">
            <button type="button" class="vc-card" @onclick="async () => await OnClickBuyCredits(500)">
                <span class="vc-amount">500 VC</span>
                <span class="vc-price">$5</span>
                <span class="vc-desc">$1 / 100 VC</span>
            </button>
            <button type="button" class="vc-card" @onclick="async () => await OnClickBuyCredits(1000)">
                <span class="vc-amount">1000 VC</span>
                <span class="vc-price">$9.50</span>
                <span class="vc-savings">Save 5%</span>
                <span class="vc-desc">$0.95 / 100 VC</span>
            </button>
            <button type="button" class="vc-card" @onclick="async () => await OnClickBuyCredits(2000)">
                <span class="vc-amount">2000 VC</span>
                <span class="vc-price">$18</span>
                <span class="vc-savings">Save 10%</span>
                <span class="vc-desc">$0.90 / 100 VC</span>
            </button>
        </div>
        }
    </div>
}

</fieldset>
</div>

<div class="page-wrapper">
    <div class="top-confetti-container"></div>
</div>


@code {
    private enum SubPage { Main, Redirecting, Result }
    private enum TierAction { Subscribe, Upgrade, Downgrade }

    private IJSObjectReference _jsModule;

    private SubPage _page = SubPage.Main;
    private UserSubscriptionType _selectedTier = null;
    private bool _confirmingCancel = false;
    private bool _loading = true;
    private bool _busy;
    private string _loadError;

    private EcoAccount _globalAccount = null;
    private UserSubscription _activeSub = null;

    private string _errorSpan = null;
    private decimal _dueNow = 0;

    private string _redirectingMessage;
    private string _redirectingDetail;
    private string _resultTitle;
    private string _resultMessage;

    private IStoreBillingService _store;
    private IReadOnlyDictionary<string, string> _storePrices = new Dictionary<string, string>();

    private bool IsStripeSub => _activeSub?.StripeSubscriptionId is not null;
    private bool IsGooglePlaySub => _activeSub?.GooglePlayPurchaseToken is not null;
    private bool IsVcSub => _activeSub is not null && !IsStripeSub && !IsGooglePlaySub;

    private static readonly List<UserSubscriptionType> _allTiers = new()
    {
        UserSubscriptionTypes.Stargazer,
        UserSubscriptionTypes.StargazerPlus,
        UserSubscriptionTypes.StargazerPro
    };

    protected override async Task OnInitializedAsync()
    {
        if (Client.InstanceManifest?.Capabilities.Payments == false)
        {
            _loading = false;
            return;
        }

        _loading = true;
        _loadError = null;
        try
        {
            _store = Services.GetService<IStoreBillingService>();
            if (_store is not null)
                await LoadStoreAsync();

            _globalAccount = await Client.EcoService.GetSelfGlobalAccountAsync();
            _activeSub = await Client.SubscriptionService.GetActiveSubscriptionAsync();

            // Check for Stripe return query params
            var uri = new Uri(NavManager.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            var stripeResult = query["stripe"];
            if (stripeResult == "success")
            {
                _page = SubPage.Result;
                _resultTitle = "Thank you for your purchase!";
                _resultMessage = "Your Valour Credits will be delivered to your account shortly.";
            }
            else if (stripeResult == "cancel")
            {
                _page = SubPage.Result;
                _resultTitle = "Purchase Cancelled";
                _resultMessage = "Your purchase was cancelled. No charges were made.";
            }
            else if (stripeResult == "sub_success")
            {
                _page = SubPage.Result;
                _resultTitle = "Subscription Activated!";
                _resultMessage = "Your subscription is now active. Thank you for supporting Valour!";
                _activeSub = await Client.SubscriptionService.GetActiveSubscriptionAsync();
            }
            else if (stripeResult == "sub_cancel")
            {
                _page = SubPage.Result;
                _resultTitle = "Subscription Setup Cancelled";
                _resultMessage = "Your subscription setup was cancelled. No charges were made.";
            }
        }
        catch (Exception)
        {
            _loadError = "Could not load your subscription. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/Valour.Client/Components/Menus/Modals/Users/Edit/EditSubscriptionsComponent.razor.js");
        }
    }

    private void BackToMain()
    {
        _page = SubPage.Main;
        _selectedTier = null;
        _confirmingCancel = false;
        _errorSpan = null;
        StateHasChanged();
    }

    private async Task OnSelectTier(UserSubscriptionType tier)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            _selectedTier = tier;
            _errorSpan = null;
            _dueNow = tier.Price;
            _dueNow = await Client.SubscriptionService.GetSubscriptionPriceAsync(tier.Name);
            StateHasChanged();
        }
        catch (Exception)
        {
            _errorSpan = "Could not complete the request. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnClickSubscribe(UserSubscriptionType tier)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            _errorSpan = null;

            var result = await Client.SubscriptionService.SubscribeAsync(tier.Name);
            if (!result.Success)
            {
                _errorSpan = result.Message;
                StateHasChanged();
                return;
            }

            Client.Me.SubscriptionType = tier.Name;
            await _jsModule.InvokeVoidAsync("init");

            _activeSub = await Client.SubscriptionService.GetActiveSubscriptionAsync();
            _selectedTier = null;
            StateHasChanged();
        }
        catch (Exception)
        {
            _errorSpan = "Could not complete the request. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnClickStripeSubscribe(UserSubscriptionType tier)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var isVcToStripeMigration = _activeSub is not null
            && _activeSub.StripeSubscriptionId is null;

            _page = SubPage.Redirecting;
            _redirectingMessage = isVcToStripeMigration
            ? "Switching to card billing..."
            : "Setting up your subscription...";
            _redirectingDetail = isVcToStripeMigration
            ? $"You will be redirected to Stripe to switch from VC billing to the {tier.Name} card subscription. Any unused VC billing time will be credited on your first month."
            : $"You will be redirected to Stripe to set up your {tier.Name} subscription.";
            _errorSpan = null;
            StateHasChanged();

            var response = await Client.PrimaryNode.PostAsyncWithResponse<CheckoutResponse>($"api/stripe/subscribe/{tier.Name}");
            if (!response.Success || response.Data?.SessionUrl is null)
            {
                _errorSpan = response.Message ?? "Failed to create checkout session.";
                StateHasChanged();
                return;
            }

            NavManager.NavigateTo(response.Data.SessionUrl, forceLoad: true);
        }
        catch (Exception)
        {
            _errorSpan = "Could not complete the request. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnConfirmCancel()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            _errorSpan = null;

            TaskResult result;
            if (_activeSub.StripeSubscriptionId is not null)
            {
                result = await Client.SubscriptionService.CancelStripeSubscriptionAsync();
            }
            else
            {
                result = await Client.SubscriptionService.UnsubscribeAsync();
            }

            if (!result.Success)
            {
                _errorSpan = result.Message;
                StateHasChanged();
                return;
            }

            _activeSub.Cancelled = true;
            _confirmingCancel = false;
            StateHasChanged();
        }
        catch (Exception)
        {
            _errorSpan = "Could not complete the request. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnClickReactivate()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            _errorSpan = null;

            var type = UserSubscriptionTypes.TypeMap.GetValueOrDefault(_activeSub.Type);
            if (type is null) return;

            var result = await Client.SubscriptionService.SubscribeAsync(type.Name);
            if (!result.Success)
            {
                _errorSpan = result.Message;
                StateHasChanged();
                return;
            }

            _activeSub = await Client.SubscriptionService.GetActiveSubscriptionAsync();
            StateHasChanged();
        }
        catch (Exception)
        {
            _errorSpan = "Could not complete the request. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnClickStripeChange(UserSubscriptionType tier)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            _errorSpan = null;

            var result = await Client.SubscriptionService.ChangeStripeSubscriptionAsync(tier.Name);
            if (!result.Success)
            {
                _errorSpan = result.Message;
                StateHasChanged();
                return;
            }

            _activeSub = await Client.SubscriptionService.GetActiveSubscriptionAsync();
            _selectedTier = null;

            if (_activeSub is not null)
                Client.Me.SubscriptionType = _activeSub.Type;

            StateHasChanged();
        }
        catch (Exception)
        {
            _errorSpan = "Could not complete the request. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnClickCancelPending()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            _errorSpan = null;

            var result = await Client.SubscriptionService.CancelPendingChangeAsync();
            if (!result.Success)
            {
                _errorSpan = result.Message;
                StateHasChanged();
                return;
            }

            _activeSub = await Client.SubscriptionService.GetActiveSubscriptionAsync();
            StateHasChanged();
        }
        catch (Exception)
        {
            _errorSpan = "Could not complete the request. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Loads store prices and reports any purchase that never reached the
    /// server, for example because the app closed during checkout.
    /// </summary>
    private async Task LoadStoreAsync()
    {
        try
        {
            _storePrices = await _store.GetPricesAsync();

            foreach (var purchase in await _store.GetUnfinishedPurchasesAsync())
                await ClaimStorePurchaseAsync(purchase);
        }
        catch (Exception)
        {
            // Without the store the page still shows the subscription; buying
            // reports its own errors.
        }
    }

    private Task<TaskResult> ClaimStorePurchaseAsync(StorePurchase purchase) => purchase.IsSubscription
        ? Client.SubscriptionService.ClaimGooglePlaySubscriptionAsync(purchase.ProductId, purchase.PurchaseToken)
        : Client.SubscriptionService.ClaimGooglePlayCreditsAsync(purchase.ProductId, purchase.PurchaseToken);

    private string GetStorePrice(string productId) =>
        productId is not null && _storePrices.TryGetValue(productId, out var price) ? price : null;

    /// <summary>
    /// Explains why a plan change has to happen somewhere else: subscriptions
    /// billed by card cannot be changed in a store build, and Google Play
    /// subscriptions can only be changed where Google Play checkout is available.
    /// </summary>
    private string GetExternalBillingNote()
    {
        if (IsGooglePlaySub && _store is null)
            return "Your plan is billed through Google Play. Change it in the Valour Android app.";

        if (IsStripeSub && _store is not null)
            return $"Your plan is billed by card. Change it at {ValourHosts.AppHost}.";

        return null;
    }

    private async Task OnClickStoreSubscribe(UserSubscriptionType tier)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            _errorSpan = null;
            StateHasChanged();

            var result = await _store.PurchaseAsync(tier.GooglePlayProductId, true, Client.Me.Id);
            await HandleStorePurchaseAsync(result,
                "Subscription activated!", $"Your {tier.Name} subscription is now active. Thank you for supporting Valour!");
        }
        catch (Exception)
        {
            _errorSpan = "Could not complete the request. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnClickStoreBuyCredits(string productId)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            _errorSpan = null;
            StateHasChanged();

            var result = await _store.PurchaseAsync(productId, false, Client.Me.Id);
            await HandleStorePurchaseAsync(result,
                "Thank you for your purchase!", $"{GooglePlayProducts.CreditPacks[productId]} Valour Credits were added to your account.");
        }
        catch (Exception)
        {
            _errorSpan = "Could not complete the request. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task HandleStorePurchaseAsync(StorePurchaseResult result, string successTitle, string successMessage)
    {
        switch (result.Status)
        {
            case StorePurchaseStatus.Cancelled:
                return;

            case StorePurchaseStatus.Failed:
                _errorSpan = result.Message;
                StateHasChanged();
                return;

            case StorePurchaseStatus.Pending:
                _page = SubPage.Result;
                _resultTitle = "Payment pending";
                _resultMessage = result.Message;
                StateHasChanged();
                return;
        }

        var claim = await ClaimStorePurchaseAsync(result.Purchase);

        _page = SubPage.Result;
        if (claim.Success)
        {
            _resultTitle = successTitle;
            _resultMessage = successMessage;
        }
        else
        {
            // Google Play also notifies the server directly, so a purchase
            // that could not be confirmed here still arrives.
            _resultTitle = "We received your purchase";
            _resultMessage = $"It will be added to your account shortly. ({claim.Message})";
        }

        _globalAccount = await Client.EcoService.GetSelfGlobalAccountAsync();
        _activeSub = await Client.SubscriptionService.GetActiveSubscriptionAsync();
        Client.Me.SubscriptionType = _activeSub?.Type;
        _selectedTier = null;
        StateHasChanged();

        if (claim.Success && result.Purchase.IsSubscription && _jsModule is not null)
            await _jsModule.InvokeVoidAsync("init");
    }

    private async Task OnClickManageStoreSubscription()
    {
        var productId = UserSubscriptionTypes.TypeMap.GetValueOrDefault(_activeSub.Type)?.GooglePlayProductId;
        await _store.OpenManageSubscriptionAsync(productId);
    }

    private TierAction GetTierAction(UserSubscriptionType tier)
    {
        if (_activeSub is null || _activeSub.Cancelled)
            return TierAction.Subscribe;

        if (!UserSubscriptionTypes.TypeMap.TryGetValue(_activeSub.Type, out var currentType))
            return TierAction.Subscribe;

        if (tier.Price > currentType.Price)
            return TierAction.Upgrade;

        return TierAction.Downgrade;
    }

    private async Task OnClickBuyCredits(int plan)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            _page = SubPage.Redirecting;
            _redirectingMessage = "Purchasing Valour Credits...";
            _redirectingDetail = $"You will be redirected to Stripe to complete your purchase of {plan} Valour Credits.";
            _errorSpan = null;
            StateHasChanged();

            var response = await Client.PrimaryNode.PostAsyncWithResponse<CheckoutResponse>($"api/stripe/checkout/VC{plan}");
            if (!response.Success || response.Data?.SessionUrl is null)
            {
                _errorSpan = response.Message ?? "Failed to create checkout session.";
                StateHasChanged();
                return;
            }

            NavManager.NavigateTo(response.Data.SessionUrl, forceLoad: true);
        }
        catch (Exception)
        {
            _errorSpan = "Could not complete the request. Please try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private static string[] GetPerks(string name) => name switch
    {
        "Stargazer" => new[] { "Profile gradient borders", "Profile animations", "Stargazer badge", "50 MB upload limit" },
        "Stargazer Plus" => new[] { "All Stargazer perks", "100 MB upload limit" },
        "Stargazer Pro" => new[] { "All Stargazer Plus perks", "250 MB upload limit" },
        _ => Array.Empty<string>()
    };

    private string GetBannerStatusClass()
    {
        if (_activeSub.StripePaymentFailed) return "payment-failed";
        if (_activeSub.Cancelled) return "cancelled";
        return "active";
    }

    private string GetBadgeClass()
    {
        if (_activeSub.StripePaymentFailed) return "failed";
        if (_activeSub.Cancelled) return "cancelled";
        return "active";
    }

    private string GetStatusText()
    {
        if (_activeSub.StripePaymentFailed) return "Payment Failed";
        if (_activeSub.Cancelled) return "Cancelled";
        return "Active";
    }

    private string GetBillingText()
    {
        if (IsStripeSub)
            return "Billed monthly via Stripe";
        if (IsGooglePlaySub)
            return "Billed monthly via Google Play";
        return "Billed monthly in VC";
    }

    private class CheckoutResponse
    {
        public string SessionUrl { get; set; }
    }
