@inject ValourClient Client
@using Valour.Shared.Villages
@using Valour.Client.Components.Windows.Villages

<div class="template-editor">
    <div class="template-heading">
        <span class="template-eyebrow">World studio</span>
        <h2>Default village</h2>
        <p>Design the first place every new community calls home.</p>
    </div>
    @if (_status is not null)
    {
        <div class="template-publication">
            <i aria-hidden="true" class="bi bi-globe2"></i>
            <div>
                <strong>Published · revision @_status.Revision</strong>
                <p>@_status.PublishedMapCount maps · @(_status.IsBuiltIn ? "Valour starter world" : $"Published by {_status.PublishedBy} on {_status.PublishedAt?.ToLocalTime():g}")</p>
            </div>
            <button class="v-btn" disabled="@_busy" @onclick="LoadAsync" aria-label="Refresh template status"><i aria-hidden="true" class="bi bi-arrow-clockwise"></i></button>
        </div>
        <section class="template-section">
            <span class="template-eyebrow">1 · Draft</span>
            <h3>@(_status.DraftPlanetName ?? "Choose your workshop")</h3>
            <p>Use a village you manage as the shared draft. Build and furnish it normally; edits stay in the draft until you publish.</p>
            <label for="template-source">Workshop village</label>
            <select id="template-source" class="v-input" @bind="_planetId" disabled="@_busy">
                <option value="0">Choose a village…</option>
                @foreach (var planet in Client.PlanetService.JoinedPlanets.Where(x => x.EnableVillage).OrderBy(x => x.Name))
                {
                    <option value="@planet.Id">@planet.Name</option>
                }
            </select>
            <div class="template-actions">
                <button class="v-btn" disabled="@(_busy || _planetId == 0)" @onclick="OpenSelectedAsync"><i aria-hidden="true" class="bi bi-box-arrow-up-right"></i> Open village</button>
                <button class="v-btn" disabled="@(_busy || _planetId == 0 || _planetId == _status.DraftPlanetId)" @onclick="SelectDraftAsync">Use as draft</button>
                @if (_status.DraftPlanetId is not null)
                {
                    <button class="v-btn primary" disabled="@_busy" @onclick="OpenDraftAsync"><i aria-hidden="true" class="bi bi-hammer"></i> Edit &amp; preview draft</button>
                }
            </div>
        </section>
        <section class="template-section">
            <span class="template-eyebrow">2 · Publish</span>
            <h3>A fresh start for new worlds</h3>
            <p>Publishing copies all @_status.DraftMapCount draft maps, buildings, floors and furnishings. New worlds get their own objects, ownership and channel connections.</p>
            <label class="template-check">
                <input type="checkbox" @bind="_resetExisting" disabled="@_busy" />
                <span>Also replace existing worlds <small>Existing layouts and property ownership will be cleared the next time each village opens. The draft is excluded.</small></span>
            </label>
            <button class="v-btn primary" disabled="@(_busy || _status.DraftPlanetId is null || _status.DraftMapCount == 0)" @onclick="PublishAsync">
                <i aria-hidden="true" class="bi bi-cloud-arrow-up"></i> @(_busy ? "Working…" : $"Publish revision {_status.Revision + 1}")
            </button>
        </section>
        <details class="template-section">
            <summary>Reset one village</summary>
            <p>Replace the selected workshop village above with the published template. Its existing layouts and property ownership will be cleared. The active draft cannot be reset.</p>
            <label class="template-check"><input type="checkbox" @bind="_confirmReset" /><span>Replace this village’s contents</span></label>
            <button class="v-btn danger" disabled="@(_busy || !_confirmReset || _planetId == 0 || _planetId == _status.DraftPlanetId)" @onclick="ResetAsync">Reset selected village</button>
        </details>
    }
    else if (_busy)
    {
        <p role="status">Loading template…</p>
    }
    <ResultLabel Result="@_result" />
</div>

@code {
    [CascadingParameter] public ModalRoot? ModalRoot { get; set; }
    private VillageTemplateStatus? _status;
    private ITaskResult? _result;
    private long _planetId;
    private bool _busy, _resetExisting, _confirmReset;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            var result = await Client.PrimaryNode.GetJsonAsync<VillageTemplateStatus>("api/staff/village-template", cacheDurationMs: null);
            _result = result;
            if (result.Success)
            {
                _status = result.Data;
                if (_planetId == 0) _planetId = _status?.DraftPlanetId ?? 0;
            }
        }
        finally { _busy = false; }
    }

    private async Task OpenAsync(long id)
    {
        var planet = await Client.PlanetService.FetchPlanetAsync(id);
        if (planet is not null)
        {
            if (ModalRoot is not null) await ModalRoot.CloseTopModal();
            await WindowService.OpenWindowAtFocused(VillageWindowComponent.GetDefaultContent(planet));
            await Valour.Client.Components.Sidebar.Sidebar.TryCloseMobileSidebarExternalAsync();
        }
        else _result = new TaskResult(false, "The village could not be opened. Check your membership and try again.");
    }
    private Task OpenSelectedAsync() => OpenAsync(_planetId);
    private Task OpenDraftAsync() => OpenAsync(_status!.DraftPlanetId!.Value);

    private async Task SelectDraftAsync()
    {
        _busy = true;
        try
        {
            var result = await Client.PrimaryNode.PutAsyncWithResponse<VillageTemplateStatus>("api/staff/village-template/draft",
                new VillageTemplateDraftRequest { PlanetId = _planetId, ExpectedRevision = _status!.Revision });
            _result = result;
            if (result.Success) _status = result.Data;
        }
        finally { _busy = false; }
    }
    private async Task PublishAsync()
    {
        _busy = true;
        try
        {
            var result = await Client.PrimaryNode.PostAsyncWithResponse<VillageTemplateStatus>("api/staff/village-template/publish",
                new VillageTemplatePublishRequest { ExpectedRevision = _status!.Revision, DraftPlanetId = _status.DraftPlanetId!.Value, ResetExisting = _resetExisting });
            _result = result.Success ? new TaskResult(true, "Published. New villages will start with this world.") : result;
            if (result.Success) { _status = result.Data; _resetExisting = false; }
        }
        finally { _busy = false; }
    }
    private async Task ResetAsync()
    {
        _busy = true;
        try
        {
            _result = await Client.PrimaryNode.PostAsync($"api/staff/village-template/reset/{_planetId}", new { });
            if (_result.Success) { _confirmReset = false; _result = new TaskResult(true, "Village reset to the published template. Open the village to explore it."); }
        }
        finally { _busy = false; }
    }
}
