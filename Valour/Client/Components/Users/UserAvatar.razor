@implements IDisposable

@* Round user avatar with an optional presence dot and badge overlay *@

@if (User is null)
{
    return;
}

@if (HasPresenceDot || HasBadges)
{
    <div class="user-avatar @(OnClick.HasDelegate ? "clickable" : "") @(ShowState ? "with-state" : "") @(Unread ? "unread" : "")"
         style="--user-avatar-size: @(Size)px"
         @onclick="@OnClick">
        <div class="user-avatar-img avatar-@User.Id @(HasAnimatedUrl ? AnimatedImageStyle.HoverClass : "") @(ShowState ? _statusClass : "")"
             style="@BackgroundStyle"
             role="img"
             aria-label="@User.Name's profile picture"></div>
        @if (HasPresenceDot)
        {
            <span class="user-avatar-presence @_statusClass" role="img" aria-label="@_statusName"></span>
        }
        @if (HasBadges)
        {
            <div class="user-avatar-badges">
                <UserBadges User="@User"/>
            </div>
        }
    </div>
}
else
{
    <div class="user-avatar flat avatar-@User.Id @(HasAnimatedUrl ? AnimatedImageStyle.HoverClass : "") @(OnClick.HasDelegate ? "clickable" : "") @(ShowState ? "with-state " + _statusClass : "") @(Unread ? "unread" : "")"
         style="--user-avatar-size: @(Size)px; @BackgroundStyle"
         role="img"
         aria-label="@User.Name's profile picture"
         @onclick="@OnClick"></div>
}

@code {
    [Parameter]
    public User User { get; set; }

    /// <summary>
    /// Optional - used for member-specific avatars
    /// </summary>
    [Parameter]
    public PlanetMember Member { get; set; }

    [Parameter]
    public int Size { get; set; } = 32;

    [Parameter]
    public bool ShowBadges { get; set; }

    /// <summary>
    /// Shows presence as a small dot at the bottom right of the avatar. Offline users
    /// show no dot. The dot's outline uses --avatar-cutout, which defaults to
    /// --surface-canvas; containers on other surfaces set it to their background.
    /// </summary>
    [Parameter]
    public bool ShowState { get; set; }

    /// <summary>
    /// Marks unread activity with a small dot at the top right, matching PlanetIcon.
    /// Rows that show unread state on the name leave this off.
    /// </summary>
    [Parameter]
    public bool Unread { get; set; }

    /// <summary>
    /// Animated version of the avatar. Containers that react to hover (see
    /// .anim-hover in globals.css) play it while hovered.
    /// </summary>
    [Parameter]
    public string AnimatedUrl { get; set; }

    [Parameter]
    public AvatarFormat Format { get; set; } = AvatarFormat.Webp128;

    /// <summary>
    /// When set, this URL is shown instead of the user's or member's avatar
    /// (webhook messages carry their own avatar).
    /// </summary>
    [Parameter]
    public string OverrideUrl { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string _avatarUrl;
    private string _failedAvatarUrl;
    private bool HasAnimatedUrl => !string.IsNullOrWhiteSpace(AnimatedUrl);
    private bool HasPresenceDot => ShowState && _statusClass != "offline";
    private bool HasBadges => ShowBadges && UserBadges.HasBadges(User);

    private string BackgroundStyle => AnimatedImageStyle.Build(_avatarUrl, _failedAvatarUrl, AnimatedUrl);

    private string _statusClass = "offline";
    private string _statusName = UserState.Offline.Name;

    protected override void OnInitialized()
    {
        if (User is not null)
            User.Updated += OnUserUpdated;

        if (Member is not null)
            Member.Updated += OnMemberUpdated;

        CalculateAvatar();
        CalculateStatus();
    }

    private void CalculateAvatar()
    {
        _avatarUrl = OverrideUrl ?? Member?.GetAvatar(Format) ?? User?.GetAvatar(Format) ?? ISharedUser.DefaultAvatar;
        _failedAvatarUrl = User?.GetFailedAvatar() ?? ISharedUser.DefaultAvatar;
    }

    private void CalculateStatus()
    {
        var state = User?.UserState;

        _statusClass = string.IsNullOrWhiteSpace(state?.CssClassName)
            ? "offline"
            : state.CssClassName;

        _statusName = state?.Name ?? UserState.Offline.Name;
    }

    private void OnUserUpdated(ModelUpdatedEvent<User> eventData)
    {
        var avatarChanged = eventData.Changes.On(x => x.HasCustomAvatar) ||
                            eventData.Changes.On(x => x.Version);

        var stateChanged = eventData.Changes.On(x => x.UserStateCode) ||
                           eventData.Changes.On(x => x.TimeLastActive);

        if (!avatarChanged && !stateChanged)
            return;

        InvokeAsync(() =>
        {
            if (avatarChanged)
                CalculateAvatar();

            if (stateChanged)
                CalculateStatus();

            StateHasChanged();
        });
    }

    private void OnMemberUpdated(ModelUpdatedEvent<PlanetMember> eventData)
    {
        if (!eventData.Changes.On(x => x.MemberAvatar))
            return;

        InvokeAsync(() =>
        {
            CalculateAvatar();
            StateHasChanged();
        });
    }

    void IDisposable.Dispose()
    {
        if (User is not null)
            User.Updated -= OnUserUpdated;

        if (Member is not null)
            Member.Updated -= OnMemberUpdated;
    }
}
