@using Valour.Client.Components.Windows.ChannelWindows
@implements IAsyncDisposable
@implements ITerminalHost
@inject ValourClient Client
@inject IJSRuntime JsRuntime

@* ValourOS: Ctrl+/ or Cmd+/ swaps the app for a terminal. The script builds
   everything inside this element, so Blazor never re-renders its content. *@
<div class="vos-root" @ref="_root"></div>

@code {
    private ElementReference _root;
    private IJSObjectReference _module;
    private IJSObjectReference _terminal;
    private DotNetObjectReference<ValourTerminal> _dotnetRef;
    private TerminalShell _shell;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _shell = new TerminalShell(Client, this);
    }

    protected override bool ShouldRender() => false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _dotnetRef = DotNetObjectReference.Create(this);
        try
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Valour.Client/Components/Terminal/ValourTerminal.razor.js?version=$(SHORTHASH)");
            _terminal = await _module.InvokeAsync<IJSObjectReference>("create", _root, _dotnetRef);
        }
        catch (JSException e)
        {
            // The terminal is an extra; the app keeps working without it.
            Client.Logger.Log<ValourTerminal>($"ValourOS terminal failed to load: {e.Message}", "yellow");
        }
    }

    ///////////////////////
    // Calls from script //
    ///////////////////////

    [JSInvokable]
    public Task<TermBoot> OpenAsync(string theme) => _shell.OpenAsync(theme);

    [JSInvokable]
    public Task ExecuteAsync(string line) => _shell.ExecuteAsync(line);

    [JSInvokable]
    public Task<TermCompletion> CompleteAsync(string line, int cursor) => _shell.CompleteAsync(line, cursor);

    [JSInvokable]
    public void Interrupt() => _shell.Interrupt();

    [JSInvokable]
    public Task EndOfInputAsync() => _shell.EndOfInputAsync();

    [JSInvokable]
    public Task TypingAsync() => _shell.NotifyTypingAsync();

    [JSInvokable]
    public Task SuspendAsync() => _shell.SuspendAsync();

    ////////////////////
    // ITerminalHost  //
    ////////////////////

    // Shell output can come from realtime events on other threads, so every
    // call to the script goes through the renderer's dispatcher.
    private Task CallAsync(string method, params object[] args)
    {
        if (_disposed || _terminal is null)
            return Task.CompletedTask;

        return InvokeAsync(async () =>
        {
            try
            {
                await _terminal.InvokeVoidAsync(method, args);
            }
            catch (JSDisconnectedException)
            {
                // The page is going away.
            }
            catch (ObjectDisposedException)
            {
                // The terminal was disposed while output was in flight.
            }
        });
    }

    public Task PrintAsync(IReadOnlyList<TermLine> lines) =>
        lines.Count == 0 ? Task.CompletedTask : CallAsync("print", lines);

    public Task ReplaceAsync(string id, TermLine line) => CallAsync("replace", id, line);

    public Task SetPromptAsync(List<TermSeg> prompt, string mode) => CallAsync("setPrompt", prompt, mode);

    public Task SetStatusAsync(TermStatus status) => CallAsync("setStatus", status);

    public Task ClearAsync() => CallAsync("clear");

    public Task SetThemeAsync(string theme) => CallAsync("setTheme", theme);

    public Task CloseAsync() => CallAsync("close");

    public async Task<bool> OpenInGuiAsync(Channel channel)
    {
        var content = await ChannelWindowFactory.GetDefaultContent(channel);
        if (content is null)
            return false;

        await CloseAsync();
        await InvokeAsync(() => WindowService.OpenWindowAtFocused(content));
        return true;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        await _shell.DisposeAsync();

        try
        {
            if (_terminal is not null)
            {
                await _terminal.InvokeVoidAsync("dispose");
                await _terminal.DisposeAsync();
            }

            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is going away.
        }

        _dotnetRef?.Dispose();
    }
}
