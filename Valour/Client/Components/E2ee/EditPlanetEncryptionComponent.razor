@implements IDisposable
@inject ValourClient Client
@inject IJSRuntime JsRuntime

<div class="settings-page">
    <div class="editor-section">
        <h3 class="editor-section-title">
            <i class="bi bi-lock-fill"></i>
            End-to-end encryption
        </h3>
        <p class="helper-text">
            Messages in this planet are end-to-end encrypted. Only members who hold its keys can read them, and
            Valour stores them without the keys. Members' apps share keys with each other automatically. Choose who
            they share keys with.
        </p>

        <div class="mode-options">
            @foreach (var option in ModeOptions)
            {
                var selected = _mode == option.Mode;
                var locked = option.Mode == PlanetEncryptionMode.Open && Planet.EncryptionMode == PlanetEncryptionMode.InviteOnly;
                <button type="button" class="mode-option @(selected ? "selected" : "")"
                        disabled="@(!IsOwner || locked)" @onclick="@(() => _mode = option.Mode)">
                    <i class="bi @option.Icon"></i>
                    <span class="mode-copy">
                        <strong>@option.Title</strong>
                        <span>@option.Description</span>
                    </span>
                </button>
            }
        </div>

        <div class="toggle-item">
            <div class="toggle-header">
                <span class="toggle-title">New members can read earlier messages</span>
                <label class="switch">
                    <input type="checkbox" @bind="_sharesHistory" disabled="@(!IsOwner)" />
                    <span class="slider round"></span>
                </label>
            </div>
            <p class="toggle-description">
                When off, people who join start from their first visit and cannot read anything sent before.
            </p>
        </div>

        @if (IsOwner)
        {
            @if (Planet.EncryptionMode != PlanetEncryptionMode.InviteOnly && _mode == PlanetEncryptionMode.InviteOnly)
            {
                <p class="helper-text warning-text">
                    <i class="bi bi-exclamation-triangle"></i>
                    An invite-only planet cannot become open again. Members' apps keep enforcing the membership log,
                    so the change cannot be reversed by anyone, including Valour.
                </p>
            }
            @if (Client.E2eeService.Status != E2eeStatus.Ready)
            {
                <p class="helper-text warning-text">Verify this device in Settings, under Encryption, before changing this.</p>
            }
            <div class="actions">
                <VButton Variant="primary" Disabled="@(!HasChanges || _working || Client.E2eeService.Status != E2eeStatus.Ready)"
                         OnClick="SaveAsync">
                    @(_working ? "Saving..." : "Save")
                </VButton>
            </div>
        }
        else
        {
            <p class="helper-text">Only the planet owner can change these settings.</p>
        }
        <ResultLabel Result="@_result" />
    </div>

    @if (Planet.EncryptionMode == PlanetEncryptionMode.InviteOnly && _isAccessAdmin)
    {
        <div class="editor-section">
            <h3 class="editor-section-title">
                <i class="bi bi-person-check"></i>
                Waiting for admission
            </h3>
            <p class="helper-text">
                These members joined but cannot read anything until an admin admits them from their own device.
                Valour cannot admit anyone.
            </p>
            @if (_pending is null)
            {
                <div class="loading-indicator"></div>
            }
            else if (_pending.Count == 0)
            {
                <p class="empty">No one is waiting.</p>
            }
            else
            {
                <div class="people">
                    @foreach (var person in _pending)
                    {
                        <div class="person">
                            <span class="person-name">@(_names.GetValueOrDefault(person.UserId) ?? "Unknown user")</span>
                            @if (!person.HasKeys)
                            {
                                <span class="person-note">Hasn't signed in since encryption started</span>
                            }
                            else if (person.KeysChanged && _confirming == person)
                            {
                                <span class="person-note">
                                    Ask them to read you their security code in person or on a call. If every digit
                                    matches this one, it's really them.
                                </span>
                                <span class="safety-number">@person.SafetyNumber</span>
                                <VButton Size="sm" Variant="secondary" OnClick="@(() => _confirming = null)">Cancel</VButton>
                                <VButton Size="sm" Variant="primary" Disabled="@_working" OnClick="@(() => ConfirmKeysAsync(person))">Yes, it's them</VButton>
                            }
                            else if (person.KeysChanged)
                            {
                                <span class="person-note">Security code changed</span>
                                <VButton Size="sm" Variant="secondary" OnClick="@(() => _confirming = person)">Check it's them</VButton>
                            }
                            else
                            {
                                <VButton Size="sm" Variant="primary" OnClick="@(() => AdmitAsync([person.UserId]))">Admit</VButton>
                            }
                        </div>
                    }
                </div>
                @if (_pending.Count(p => !p.KeysChanged && p.HasKeys) > 1)
                {
                    <div class="actions">
                        <VButton Variant="primary" OnClick="@(() => AdmitAsync(_pending.Where(p => !p.KeysChanged && p.HasKeys).Select(p => p.UserId).ToList()))">Admit everyone</VButton>
                    </div>
                }
            }

            @if (_stale is { Count: > 0 })
            {
                <h4 class="subsection-title">No longer members</h4>
                <p class="helper-text">
                    These people left or were removed but are still admitted. Remove them so rejoining does not give
                    them access again.
                </p>
                <div class="actions">
                    <VButton Variant="danger" OnClick="RemoveStaleAsync">Remove @_stale.Count from admission</VButton>
                </div>
            }
        </div>

        <div class="editor-section">
            <h3 class="editor-section-title">
                <i class="bi bi-link-45deg"></i>
                Signed invite link
            </h3>
            <p class="helper-text">
                A signed invite admits whoever uses it without waiting for an admin. The key is in the part of the
                link after the # sign, which is never sent to Valour, so share the whole link privately.
            </p>
            <div class="invite-row">
                <div class="form-group">
                    <label>Uses</label>
                    <input class="v-input" type="number" min="0" @bind="_inviteUses" placeholder="0 = unlimited" />
                </div>
                <div class="form-group">
                    <label>Expires in (days)</label>
                    <input class="v-input" type="number" min="0" @bind="_inviteDays" placeholder="0 = never" />
                </div>
                <VButton Variant="primary" Disabled="@_working" OnClick="CreateInviteAsync">Create link</VButton>
            </div>
            @if (_inviteLink is not null)
            {
                <div class="invite-link">
                    <code>@_inviteLink</code>
                    <VButton Size="sm" Variant="secondary" Icon="clipboard" OnClick="CopyInviteAsync">Copy</VButton>
                </div>
            }
        </div>

        @if (IsOwner)
        {
            <div class="editor-section">
                <h3 class="editor-section-title">
                    <i class="bi bi-shield-check"></i>
                    Admission admins
                </h3>
                <p class="helper-text">Admins can admit and remove members and create signed invites.</p>
                <div class="people">
                    @foreach (var adminId in _admins)
                    {
                        <div class="person">
                            <span class="person-name">@(_names.GetValueOrDefault(adminId) ?? "Unknown user")</span>
                            <VButton Size="sm" Variant="danger" OnClick="@(() => SetAdminAsync(adminId, false))">Remove admin</VButton>
                        </div>
                    }
                </div>
                <div class="invite-row">
                    <div class="form-group">
                        <label>Add an admitted member by name</label>
                        <input class="v-input" @bind="_adminName" placeholder="Name" />
                    </div>
                    <VButton Variant="secondary" OnClick="AddAdminAsync">Add admin</VButton>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter]
    public Planet Planet { get; set; }

    private sealed record ModeOption(PlanetEncryptionMode Mode, string Icon, string Title, string Description);

    private static readonly ModeOption[] ModeOptions =
    [
        new(PlanetEncryptionMode.Open, "bi-lock", "Open",
            "Anyone the planet's permissions let view a channel can read it. Each channel's encryption details list everyone who can."),
        new(PlanetEncryptionMode.InviteOnly, "bi-shield-lock", "Invite-only",
            "Only people an admin admitted, or who joined with an invite link, can read messages. Valour cannot let itself in.")
    ];

    private PlanetEncryptionMode _mode;
    private bool _sharesHistory;
    private bool _working;
    private bool _isAccessAdmin;
    private ITaskResult _result;
    private List<PendingAdmission> _pending;

    // The member whose new security number is shown for comparison.
    private PendingAdmission _confirming;
    private List<long> _stale;
    private List<long> _admins = new();
    private readonly Dictionary<long, string> _names = new();
    private int _inviteUses = 1;
    private int _inviteDays = 7;
    private string _inviteLink;
    private string _adminName;

    private bool IsOwner => Planet.OwnerId == Client.Me.Id;

    private bool HasChanges => _mode != Planet.EncryptionMode || _sharesHistory != Planet.EncryptionSharesHistory;

    protected override async Task OnInitializedAsync()
    {
        _mode = Planet.EncryptionMode;
        _sharesHistory = Planet.EncryptionSharesHistory;
        Planet.Updated += OnPlanetUpdated;
        await LoadAdmissionsAsync();
    }

    private void OnPlanetUpdated(ModelUpdatedEvent<Planet> update) => _ = InvokeAsync(StateHasChanged);

    private async Task LoadAdmissionsAsync()
    {
        if (Planet.EncryptionMode != PlanetEncryptionMode.InviteOnly)
            return;

        _isAccessAdmin = await Client.E2eeService.IsPlanetAccessAdminAsync(Planet);
        if (!_isAccessAdmin)
            return;

        _pending = await Client.E2eeService.GetPendingAdmissionsAsync(Planet);
        _stale = await Client.E2eeService.GetStaleAdmissionsAsync(Planet);
        var log = await Client.E2eeService.GetAccessLogStateAsync(AccessLogScope.Planet, Planet.Id, Planet.Node);
        _admins = log?.Admins.Keys.ToList() ?? [];

        foreach (var userId in _pending.Select(p => p.UserId).Concat(_admins).Distinct())
            _names[userId] = (await Client.UserService.FetchUserAsync(userId))?.Name;
    }

    private async Task SaveAsync()
    {
        _working = true;
        _result = null;
        StateHasChanged();

        _result = await ToastContainer.Instance.WaitToastWithTaskResult(new ProgressToastData<TaskResult>
        {
            ProgressTask = Client.E2eeService.SetPlanetEncryptionAsync(Planet, _mode, _sharesHistory),
            Title = "Updating encryption",
            Message = "Signing and publishing keys...",
            SuccessMessage = "Encryption settings saved."
        });

        _working = false;
        await LoadAdmissionsAsync();
    }

    private async Task AdmitAsync(List<long> userIds)
    {
        _result = await Client.E2eeService.AdmitPlanetMembersAsync(Planet, userIds);
        await LoadAdmissionsAsync();
    }

    private async Task ConfirmKeysAsync(PendingAdmission person)
    {
        _working = true;
        _result = await Client.E2eeService.ConfirmMemberKeysAsync(AccessLogScope.Planet, Planet.Id, Planet.Node,
            person.UserId, person.SafetyNumber);
        _working = false;
        _confirming = null;
        await LoadAdmissionsAsync();
    }

    private async Task RemoveStaleAsync()
    {
        _result = await Client.E2eeService.RemovePlanetMembersAsync(Planet, _stale);
        await LoadAdmissionsAsync();
    }

    private async Task SetAdminAsync(long userId, bool isAdmin)
    {
        _result = await Client.E2eeService.SetPlanetAccessAdminAsync(Planet, userId, isAdmin);
        await LoadAdmissionsAsync();
    }

    private async Task AddAdminAsync()
    {
        if (string.IsNullOrWhiteSpace(_adminName))
            return;

        var query = Planet.GetMemberQueryEngine();
        query.SetFilter("search", _adminName.Trim(), apply: true);
        var results = await query.GetPageAsync(0, 10);
        var match = results.FirstOrDefault(m => string.Equals(m.Name, _adminName.Trim(), StringComparison.OrdinalIgnoreCase))
                    ?? (results.Count == 1 ? results[0] : null);
        if (match is null)
        {
            _result = TaskResult.FromFailure(results.Count > 1
                ? "Several members match that name. Type the full name."
                : "No member with that name was found.");
            return;
        }

        await SetAdminAsync(match.UserId, true);
        _adminName = null;
    }

    private async Task CreateInviteAsync()
    {
        _working = true;
        _result = null;

        // The server's invite and the signed admission expire together.
        DateTime? expires = _inviteDays > 0 ? DateTime.UtcNow.AddDays(_inviteDays) : null;
        var serverInvite = await Planet.Node.PostAsyncWithResponse<PlanetInvite>("api/invites", new PlanetInvite(Client)
        {
            PlanetId = Planet.Id,
            IssuerId = Client.Me.Id,
            TimeCreated = DateTime.UtcNow,
            TimeExpires = expires
        });

        if (!serverInvite.Success)
        {
            _result = serverInvite;
            _working = false;
            return;
        }

        var signed = await Client.E2eeService.CreatePlanetInviteAsync(Planet, expires, Math.Max(0, _inviteUses));
        _working = false;
        if (!signed.Success)
        {
            _result = signed;
            return;
        }

        _inviteLink = $"{ClientHosts.AppBaseUrl}/i/{serverInvite.Data.Id}{signed.Data.Fragment}";
    }

    private async Task CopyInviteAsync()
    {
        await JsRuntime.InvokeVoidAsync("clipboardCopy.copyText", _inviteLink);
        ToastContainer.Instance.AddToast(new ToastData("Copied", "Invite link copied. Share it privately.", ToastProgressState.Success));
    }

    public void Dispose()
    {
        Planet.Updated -= OnPlanetUpdated;
    }
}
