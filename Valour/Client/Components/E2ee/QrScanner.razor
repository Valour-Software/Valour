@implements IAsyncDisposable
@inject IJSRuntime JsRuntime

<div class="qr-scanner">
    <video @ref="_video" class="qr-video" muted playsinline></video>
    <div class="qr-frame"></div>
</div>
@if (_error is not null)
{
    <p class="qr-error" role="alert"><i class="bi bi-camera-video-off" aria-hidden="true"></i> @_error</p>
}
else
{
    <p class="helper-text">Point the camera at the code on your other device.</p>
}

@code {
    /// <summary>Called once with the text of the first code scanned.</summary>
    [Parameter]
    public EventCallback<string> OnScanned { get; set; }

    /// <summary>
    /// What the person can do instead when the camera cannot scan, such as
    /// "Go back and enter the code instead." It is added after the reason.
    /// </summary>
    [Parameter]
    public string Fallback { get; set; }

    private ElementReference _video;
    private IJSObjectReference _module;
    private IJSObjectReference _session;
    private DotNetObjectReference<QrScanner> _reference;
    private string _error;
    private bool _disposed;
    private bool _scanned;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import",
                "./_content/Valour.Client/Components/E2ee/QrScanner.razor.js?version=$(SHORTHASH)");
            _reference = DotNetObjectReference.Create(this);
            var session = await _module.InvokeAsync<IJSObjectReference>("start", _video, _reference,
                "./_content/Valour.Client/js/vendor/jsQR.min.js?version=$(SHORTHASH)");

            // The component may have been closed while the camera started.
            if (_disposed)
            {
                await session.InvokeVoidAsync("stop");
                await session.DisposeAsync();
                return;
            }

            _session = session;
        }
        catch (JSException e)
        {
            if (_disposed)
                return;
            _error = DescribeStartError(ErrorName(e.Message));
            StateHasChanged();
        }
    }

    // The script reports failures as "qr-scanner:" and the browser's error name.
    private static string ErrorName(string message)
    {
        const string prefix = "qr-scanner:";
        var start = message?.IndexOf(prefix, StringComparison.Ordinal) ?? -1;
        if (start < 0)
            return null;

        start += prefix.Length;
        var end = start;
        while (end < message.Length && char.IsLetterOrDigit(message[end]))
            end++;
        return message[start..end];
    }

    private string WithFallback(string reason) =>
        string.IsNullOrWhiteSpace(Fallback) ? reason : $"{reason} {Fallback}";

    private string DescribeStartError(string name) => WithFallback(name switch
    {
        "NotAllowedError" or "SecurityError" =>
            "Camera access was blocked. Allow camera access in your browser or device settings and try again.",
        "NotFoundError" or "OverconstrainedError" => "No camera was found on this device.",
        "NotReadableError" or "AbortError" => "The camera is being used by another app.",
        _ => "The camera could not be started."
    });

    [JSInvokable]
    public async Task OnCodeScanned(string text)
    {
        if (_scanned || _disposed)
            return;
        _scanned = true;
        await OnScanned.InvokeAsync(text);
    }

    [JSInvokable]
    public Task OnScanError()
    {
        if (_disposed)
            return Task.CompletedTask;
        _error = WithFallback("The code could not be read.");
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_session is not null)
            {
                await _session.InvokeVoidAsync("stop");
                await _session.DisposeAsync();
            }

            if (_module is not null)
                await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is gone; the browser releases the camera with it.
        }
        catch (JSException)
        {
            // The camera was already stopped.
        }

        _reference?.Dispose();
    }
}
