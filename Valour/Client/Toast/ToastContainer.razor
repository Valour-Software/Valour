@implements IDisposable

<CascadingValue Value="@this">
    @ChildContent
    <div class="toast-container">
        @for (int i = 0; i < ActiveToasts.Count; i++)
        {
            var toast = ActiveToasts[i];
            <ToastCard @key="@toast" @ref="@toast.Card" TopOffset="@(50 * i)" Toast="@toast" />
        }
    </div>
</CascadingValue>

@code {
    public static ToastContainer Instance { get; set; }
    private const string FailureMessage = "An error occurred. Please try again later.";
    private readonly CancellationTokenSource _lifetime = new();
    private bool _disposed;

    [Parameter]
    public RenderFragment ChildContent { get; set; }

    public List<ToastData> ActiveToasts { get; set; } = new();

    protected override void OnInitialized() => Instance = this;

    private Task UpdateAsync(Action update) => _disposed ? Task.CompletedTask : InvokeAsync(() =>
    {
        if (_disposed) return;
        update();
        StateHasChanged();
    });

    public Task ErrorToast(ToastData toast) => UpdateAsync(() =>
    {
        toast.Type = ToastProgressState.Failure;
        ActiveToasts.Add(toast);
    });

    public async Task WaitToast(ProgressToastData toast)
    {
        await UpdateAsync(() => ActiveToasts.Add(toast));
        bool success;
        try
        {
            await toast.ProgressTask;
            success = true;
        }
        catch (Exception e)
        {
            success = false;
            Console.WriteLine($"Exception in Toast Task: {e.Message}");
        }
        await CompleteAsync(toast, success, success ? toast.Message : FailureMessage);
    }

    public async Task<T> WaitToastWithTaskResult<T>(ProgressToastData<T> toast) where T : ITaskResult, new()
    {
        await UpdateAsync(() => ActiveToasts.Add(toast));
        T result;
        try
        {
            result = await toast.ProgressTask;
        }
        catch (Exception e)
        {
            result = new T { Success = false, Message = FailureMessage };
            Console.WriteLine($"Exception in Toast Task: {e.Message}");
        }
        await CompleteAsync(toast, result.Success, result.Message);
        return result;
    }

    public async Task<T> WaitToastWithResult<T>(ProgressToastData<T> toast)
    {
        await UpdateAsync(() => ActiveToasts.Add(toast));
        T result = default;
        bool success;
        try
        {
            result = await toast.ProgressTask;
            success = true;
        }
        catch (Exception e)
        {
            success = false;
            Console.WriteLine($"Exception in Toast Task: {e.Message}");
        }
        await CompleteAsync(toast, success, success ? toast.Message : FailureMessage);
        return result;
    }

    private async Task CompleteAsync(ProgressToastDataBase toast, bool success, string message)
    {
        await UpdateAsync(() =>
        {
            toast.Message = (success ? toast.SuccessMessage : toast.FailureMessage) ?? message;
            toast.ProgressState = success ? ToastProgressState.Success : ToastProgressState.Failure;
        });
        if (!_disposed) _ = RemoveCompletedAsync(toast);
    }

    private async Task RemoveCompletedAsync(ToastData toast)
    {
        try
        {
            await Task.Delay(500, _lifetime.Token);
            await InvokeAsync(async () =>
            {
                if (_disposed) return;
                if (toast.Card is { } card) await card.ShrinkAndRemove();
                else RemoveToast(toast);
            });
        }
        catch (OperationCanceledException) when (_disposed) { }
    }

    public void AddToast(ToastData toast) => _ = UpdateAsync(() => ActiveToasts.Add(toast));

    public void RemoveToast(ToastData toast) => _ = UpdateAsync(() => ActiveToasts.Remove(toast));

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        _lifetime.Cancel();
        _lifetime.Dispose();
        ActiveToasts.Clear();
        if (ReferenceEquals(Instance, this)) Instance = null;
    }
}
