@page "/"
@page "/planetchannels/{StartPlanetId:long}/{StartChannelId:long}/{StartMessageId:long}"
@page "/directchannels/{StartChannelId:long}/{StartMessageId:long}"
@page "/planetthreads/{StartPlanetId:long}/{StartThreadId:long}"
@page "/planetthreads/{StartPlanetId:long}"
@page "/planetwiki/{StartPlanetId:long}/{StartPageId:long}"
@page "/planetwiki/{StartPlanetId:long}"
@using Valour.Sdk.Services
@implements IDisposable

@inject ValourClient Client
@inject AuthService AuthService
@inject IJSRuntime JsRuntime
@inject NavigationManager NavigationManager

<PushSubscriptionsComponent />
<Valour.Client.Components.Demo.DemoDirector />

<!-- Check login status -->
@if (!Client.IsLoggedIn)
{
	<LoginComponent FromVerified="false"></LoginComponent>
	return;
}

<!-- 
<ChangeLogComponent />
-->

<SafetyPopup />
<ProfilePopup />
<CustomDropdownContent />

@* Removed for one render while the layout switches; see OnLayoutModeChanged. *@
@if (!_rebuildingShell)
{
<div class="mobile-holder @MobileClass @EmbeddedClass">
	<ToastContainer>
		<!-- Modal management -->
		<ModalRoot>
			<ValourErrorBoundary>
				<ContextMenuRoot>

					<ModalInjector/>
					<E2eeCoordinator/>
					<FingerprintOfferCoordinator/>
					<NativeCommandCoordinator/>

					<AppRecedeLayer>
					<body class="mainrow">
					<Sidebar></Sidebar>
					<div class="channel-and-topbar" id="mainwindow">
						<div class="topbar">
							@if (DeviceInfo.IsMobile)
							{
								<button class="sidebar-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" @onclick="Sidebar.ToggleMobileSidebar"><i class="bi bi-list" aria-hidden="true"></i></button>
							}
							<QuickNotifComponent />
							@if (DeviceInfo.IsMobile)
							{
								<button class="home" type="button" aria-label="Go Home" title="Go Home" @onclick="OnClickHome"><i class="bi bi-house-door-fill" aria-hidden="true"></i></button>
							}
						</div>
						<!-- It's so nice when it's hidden away, just like my fears -->
						<WindowDockComponent StartRoute="@_startRoute" />
					</div>
					<MobileSidebarCoach />
					@* 
				       @if (!DeviceInfo.IsMobile)
					   {
   						<Sidebar Flip="@true"></Sidebar>
					   }
					*@

					</body>
					</AppRecedeLayer>
				</ContextMenuRoot>
			</ValourErrorBoundary>
		</ModalRoot>
	</ToastContainer>
</div>
}

@* Ctrl+/ or Cmd+/ swaps the app for the ValourOS terminal. *@
<ValourTerminal />


@code {
	// The relative route the app launched with (e.g. a notification deep link or
	// a shared Valour URL). The dock parses it via ValourRouteParser to open the
	// right channel/thread as the initial window.
	private string _startRoute;

	// These route parameters are required so the @page templates bind, but the
	// dock now resolves the destination straight from the URL.
	[Parameter]
	public long? StartPlanetId { get; set; }
	
	[Parameter]
	public long? StartChannelId { get; set; }
	
	[Parameter]
	public long? StartMessageId { get; set; }

	[Parameter]
	public long? StartThreadId { get; set; }

	[Parameter]
	public long? StartPageId { get; set; }

	private bool _rebuildingShell;

	private string MobileClass => DeviceInfo.IsMobile ? "mobile" : "desktop";
	
	private string EmbeddedClass => DeviceInfo.IsEmbedded ? "embedded" : "";

	protected override async Task OnInitializedAsync()
	{
		_startRoute = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

		await base.OnInitializedAsync();

		WindowService.FocusedPlanetChanged += OnPlanetChange;
		AuthService.LoggedIn += OnLoginAsync;
		DeviceInfo.LayoutModeChanged += OnLayoutModeChanged;
	}

	private async Task OnLoginAsync(User user)
	{
		await InvokeAsync(StateHasChanged);
	}

	// Folding an iPhone Duo or resizing an iPad window can switch between the
	// phone and wide layouts. Components read DeviceInfo.IsMobile when they are
	// created, so the shell is rebuilt instead of updated in place. The dock
	// saves its layout first and restores it on load, collapsing it to the
	// focused tab for the phone layout. The shell is removed for one render
	// before it returns, so the old dock is disposed before the new one
	// registers as the main dock.
	private void OnLayoutModeChanged(bool mobile) => _ = InvokeAsync(RebuildShellAsync);

	private async Task RebuildShellAsync()
	{
		if (_rebuildingShell)
			return;

		var dock = WindowService.MainDock;
		if (dock?.Layout is not null)
			await dock.SaveLayout();

		// The launch route was already opened; reopening it would undo where the user went since.
		_startRoute = null;

		_rebuildingShell = true;
		StateHasChanged();
		await Task.Yield();

		_rebuildingShell = false;
		StateHasChanged();
	}

	public void Dispose()
	{
		WindowService.FocusedPlanetChanged -= OnPlanetChange;
		DeviceInfo.LayoutModeChanged -= OnLayoutModeChanged;
		AuthService.LoggedIn -= OnLoginAsync;
	}

	private Task OnPlanetChange(Planet planet)
	{
		if (planet != null)
		{
			Console.WriteLine("Index planet change: " + planet.Name);
		}
		else
		{
			Console.WriteLine("Index planet change: null");
		}

		return Task.CompletedTask;
	}

	private async Task OnClickHome()
	{
		await WindowService.OpenWindowAtFocused(ThreadsWindowComponent.DefaultContent);
	}

	public void ForceRefresh()
	{
		StateHasChanged();
	}
}
