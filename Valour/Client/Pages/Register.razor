@page "/Register"
@page "/Register/I/{InviteCode}"
@page "/Register/from/{Source}"
@page "/Register/referral/{Referral}"

@inject AuthService AuthService

<PageTitle>Join Valour</PageTitle>

<main class="register-page">
    <div class="register-shell">
        <aside class="register-intro">
            <a class="register-brand" href="/" aria-label="Valour home">
                <img src="_content/Valour.Client/media/logo/logo-64.png" alt="" />
                <span>Valour</span>
            </a>

            <div class="register-intro-copy">
                <p class="register-eyebrow">A home for your people</p>
                <h1>Find your Planet.</h1>
                <p>
                    Join other Valournauts building communities with chat, threads, voice, wikis, and a little more personality.
                </p>
            </div>

            <div class="register-perks" aria-label="Valour highlights">
                <span><i class="bi bi-code-slash"></i> Open source</span>
                <span><i class="bi bi-badge-ad"></i> No ads</span>
                <span><i class="bi bi-person-bounding-box"></i> No ID checks</span>
            </div>

            <p class="register-sign-in">
                Already a Valournaut? <a href="/">Log in</a>
            </p>
        </aside>

        <section class="register-panel" aria-labelledby="register-title">
            @if (!_completed)
            {
                <header class="register-header">
                    <p class="register-eyebrow">New transmission</p>
                    <h2 id="register-title">Become a Valournaut</h2>
                    <p>No phone number, face scan, or government ID required.</p>
                </header>

                <form class="register-form" @onsubmit="OnSubmit" @onsubmit:preventDefault>
                    <div class="register-fields">
                        <div class="register-field">
                            <label for="register-username">Username</label>
                            <input id="register-username" class="form-control" autocomplete="username" placeholder="How Valournauts will know you" @bind-value="@_username" />
                        </div>

                        <div class="register-field">
                            <label for="register-email">Email</label>
                            <input id="register-email" type="email" class="form-control" autocomplete="email" placeholder="you@example.com" @bind-value="@_email" />
                        </div>

                        <div class="register-field">
                            <label for="register-password">Password</label>
                            <PasswordInput id="register-password" autocomplete="new-password" placeholder="Choose a strong password" @bind-Value="@_password" />
                        </div>

                        <div class="register-field">
                            <label for="register-password-confirm">Confirm password</label>
                            <PasswordInput id="register-password-confirm" autocomplete="new-password" placeholder="Type it once more" @bind-Value="@_passwordConf" />
                        </div>

                        <div class="register-field">
                            <label for="register-birthday">Birthday</label>
                            <InputDate id="register-birthday" @bind-Value="@_dob" class="form-control" />
                            @if (!string.IsNullOrWhiteSpace(_dobSpan))
                            {
                                <span id="date-span" class="register-field-error">@_dobSpan</span>
                            }
                        </div>

                        <div class="register-field">
                            <label for="register-referral">Referral <span>Optional</span></label>
                            <input id="register-referral" type="text" class="form-control" autocomplete="off" placeholder="Valournaut#0000" @bind-value="@_referral" disabled="@_lockReferral" />
                            <small>@(_lockReferral ? "Referral added from your invite." : "The Valournaut who sent you.")</small>
                        </div>
                    </div>

                    <div class="register-agreements">
                        <div class="register-agreement">
                            <input id="texas-residency" type="checkbox" @bind-value="@_isNotTexasResident" />
                            <label for="texas-residency">
                                I am not a legal resident of the <a href="https://valour.gg/texas/" target="_blank" rel="noopener noreferrer">State of Texas</a>.
                            </label>
                        </div>

                        <div class="register-agreement">
                            <input id="valour-terms" type="checkbox" @bind-value="@_termsAgreed" />
                            <label for="valour-terms">
                                I agree to Valour's <a href="https://github.com/SpikeViper/Valour/blob/main/TERMS_OF_SERVICE.md" target="_blank" rel="noopener noreferrer">Terms of Service</a>,
                                <a href="https://github.com/SpikeViper/Valour/blob/main/PLATFORM_RULES.md" target="_blank" rel="noopener noreferrer">Platform Rules</a>, and
                                <a href="https://github.com/SpikeViper/Valour/blob/main/PLATFORM_ECO_RULES.md" target="_blank" rel="noopener noreferrer">Eco Rules</a>.
                            </label>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_errorSpan))
                    {
                        <div id="error-span" class="register-error" role="alert">
                            <i class="bi bi-exclamation-circle"></i>
                            <span>@_errorSpan</span>
                        </div>
                    }

                    <button type="submit" class="v-btn primary register-submit" disabled="@_submitting">
                        @if (_submitting)
                        {
                            <span>Creating your account...</span>
                        }
                        else
                        {
                            <span>Create account</span>
                            <i class="bi bi-arrow-right"></i>
                        }
                    </button>
                </form>
            }
            else
            {
                <div class="register-confirmation">
                    <ConfirmationEmailComponent RegisterRequest="@_regRequest"></ConfirmationEmailComponent>
                </div>
            }
        </section>
    </div>
</main>

@code {

    [Parameter]
    public string InviteCode { get; set; }
    
    [Parameter]
    public string Source { get; set; }
    
    [Parameter]
    public string Referral { get; set; }

    private bool _completed;
    
    private RegisterUserRequest _regRequest;
    
    // Input fields
    private string _email;
    private string _password;
    private string _passwordConf;
    private string _username;
    private string _referral;
    private bool _lockReferral;
    private DateTime? _dob;
    private bool _termsAgreed;
    private bool _isNotTexasResident;
    private bool _submitting;

    // Spans
    private string _errorSpan;
    private string _dobSpan;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Referral))
        {
            _referral = Referral;
            _lockReferral = true;
        }
    }

    private async Task OnSubmit()
    {
        if (_submitting)
            return;

        _errorSpan = "";
        _dobSpan = "";

        if (!_isNotTexasResident)
        {
            _errorSpan = "Valour is not accepting new registrations from legal residents of Texas. Please read the Texas registration notice.";
            return;
        }

        if (!_termsAgreed)
        {
            _errorSpan = "You must read and accept the Terms of Service and Platform Rules to use Valour.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_email))
        {
            _errorSpan = "Please enter your email.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_password))
        {
            _errorSpan = "Please enter a password.";
            return;
        }

        if (!string.Equals(_password, _passwordConf))
        {
            _errorSpan = "Those passwords do not match.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_username))
        {
            _errorSpan = "Please choose a username.";
            return;
        }

        if (!_dob.HasValue)
        {
            _dobSpan = "Please enter your birthday.";
            return;
        }

        var now = DateTime.Today;
        var dateOfBirth = _dob.Value;
        var age = now.Year - dateOfBirth.Year;
        if (dateOfBirth > now.AddYears(-age)) age--;
        
        switch (age)
        {
            case 0:
                _dobSpan = "Welcome to life newborn! We may not know how you even wrote the date but unfortunately you are going to have to wait till 13 years to use Valour.";
                return;
            case < 0:
                _dobSpan = $"Congratulations on not being born! Maybe try again when you are 13 in {Math.Abs(age) + 13} years?";
                return;
            case < 13:
                _dobSpan = "You must be 13 years of age or older to use Valour.";
                return;
            case > 120:
                _dobSpan = $"If you are actually {age} years old, please contact us at support@valour.gg and we will buy you a cake.";
                return;
        }

        _regRequest = new RegisterUserRequest()
        {
            Username = _username,
            Email = _email,
            Password = _password,
            Referrer = _referral,
            DateOfBirth = dateOfBirth,
            InviteCode = InviteCode,
            Source = Source,
            IsNotTexasResident = _isNotTexasResident,
        };

        _submitting = true;

        try
        {
            var result = await AuthService.RegisterAsync(_regRequest);

            if (!result.Success)
            {
                if (result.Code == 409)
                {
                    // Email exists but is not verified — show the confirmation/resend screen
                    _completed = true;
                }
                else
                {
                    _errorSpan = result.Message;
                }
            }
            else
            {
                _completed = true;
            }
        }
        finally
        {
            _submitting = false;
        }
    }
}
