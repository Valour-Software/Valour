@page "/I/{InviteCode}"

@inject ValourClient Client
@inject PlanetService PlanetService
@inject NavigationManager NavigationManager
@inject EncryptedInviteRedeemer InviteRedeemer

<PlanetJoinLanding Result="@_inviteDataResult"
                   JoinAsync="@JoinAsync"
                   OnMemberAsync="@OnMemberAsync"
                   LoginReturnPath="@($"/I/{InviteCode}")"
                   RegisterUrl="@($"/register/i/{InviteCode}")" />

@code {

    [Parameter]
    public string InviteCode { get; set; }

    private TaskResult<PlanetListInfo>? _inviteDataResult;

    protected override async Task OnInitializedAsync()
    {
        // Invite-only encrypted planets put an admission key in the fragment.
        var fragment = new Uri(NavigationManager.Uri).Fragment;
        await InviteRedeemer.RememberAsync(InviteCode, fragment);

        // The key is stored now, so it is removed from the address bar and
        // the browser's history.
        if (!string.IsNullOrEmpty(fragment))
            NavigationManager.NavigateTo($"/I/{InviteCode}", replace: true);

        var inviteDataTask = PlanetService.FetchInviteScreenDataAsync(InviteCode);
        var joinedPlanetsTask = Client.IsLoggedIn ? PlanetService.FetchJoinedPlanetsAsync() : Task.CompletedTask;
        await joinedPlanetsTask;
        _inviteDataResult = await inviteDataTask;
    }

    private Task<TaskResult<PlanetMember>> JoinAsync(long planetId) =>
        PlanetService.JoinPlanetAsync(planetId, InviteCode);

    // Joining, already being a member, and joining a community-hosted planet
    // all redeem the encryption key carried in the link.
    private Task OnMemberAsync(long planetId) =>
        InviteRedeemer.OnJoinedAsync(InviteCode, planetId);
}
