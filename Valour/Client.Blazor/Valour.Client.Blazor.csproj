<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly" TreatAsLocalProperty="SelfContained">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <ImplicitUsings>true</ImplicitUsings>
    <DebugType>portable</DebugType>
    <SelfContained>true</SelfContained>
    <!--
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmEnableSIMD>false</WasmEnableSIMD>
    <WasmBuildNative>true</WasmBuildNative>
    -->
  </PropertyGroup>
  <ItemGroup>
<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0-rc.1.26425.128" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Sentry.AspNetCore.Blazor.WebAssembly" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sdk\Valour.Sdk.csproj" />
    <ProjectReference Include="..\Client\Valour.Client.csproj" />
    <ProjectReference Include="..\Shared\Valour.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <!--
    BouncyCastle is not marked trimmable, so partial trimming would ship the
    whole library. The SDK only uses its P-256 types directly (FederationProofKey).
    -->
    <TrimmableAssembly Include="BouncyCastle.Cryptography" />
  </ItemGroup>

</Project>
