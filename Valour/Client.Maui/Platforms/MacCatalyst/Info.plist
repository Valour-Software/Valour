<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSCameraUsageDescription</key>
    <string>Valour uses the camera for video calls and to scan the code that links a new device to your encrypted messages.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Valour uses the microphone for voice and video calls.</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.social-networking</string>
    <!-- Family 6 is the Mac idiom. With the iPad idiom (2), macOS scales the whole
         window to 77% and the web view receives touch-style input, which makes
         trackpad scrolling, hover, and text rendering behave like an iPad. -->
    <key>UIDeviceFamily</key>
    <array>
        <integer>6</integer>
    </array>
    <key>XSAppIconAssets</key>
    <string>Assets.xcassets/appicon.appiconset</string>
</dict>
</plist>
