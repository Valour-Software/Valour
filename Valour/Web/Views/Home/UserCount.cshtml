@{
    ViewData["Title"] = "Valour Account Count";
    ViewData["Description"] = "The number of registered Valour accounts, updated every ten seconds.";
    ViewData["Robots"] = "noindex, follow";
}

<section class="container count-page">
    <p class="eyebrow">Valournauts</p>
    <p class="count-value" id="current-count" aria-live="polite">0</p>
    <p class="count-label">registered accounts, updated every 10 seconds</p>
    <div class="count-names" id="name-holder" aria-live="polite"></div>
</section>

<script>
    (function () {
        const counter = document.getElementById('current-count');
        const nameHolder = document.getElementById('name-holder');
        const formatter = new Intl.NumberFormat('en-US');
        let lastCount = null;

        function checkCount() {
            fetch('https://api.valour.gg/api/users/count')
                .then(response => response.json())
                .then(onCount)
                .catch(() => {});
        }

        function onCount(newCount) {
            counter.textContent = formatter.format(newCount);

            if (lastCount === null || newCount <= lastCount) {
                lastCount = newCount;
                return;
            }

            const difference = newCount - lastCount;
            lastCount = newCount;

            fetch('https://api.valour.gg/api/users/new/' + difference)
                .then(response => response.json())
                .then(showNames)
                .catch(() => {});
        }

        function showNames(names) {
            for (const child of nameHolder.children) {
                child.classList.add('fading');
            }

            setTimeout(() => {
                nameHolder.replaceChildren(...names.map(name => {
                    const element = document.createElement('span');
                    element.className = 'count-name';
                    element.textContent = name;
                    return element;
                }));
            }, 500);
        }

        checkCount();
        setInterval(checkCount, 10000);
    })();
</script>
