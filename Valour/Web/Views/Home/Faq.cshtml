@{
    ViewData["Title"] = "Valour FAQ | Frequently Asked Questions";
    ViewData["Description"] = "What Valour is, how it protects your privacy, and what makes it different from other community platforms.";

    var faqs = new (string Question, string Answer)[]
    {
        ("What is Valour?",
         "Valour is an open-source community platform that combines real-time chat, thread feeds, community wikis, and voice channels in one place. Communities live on planets, spaces you shape with roles, permissions, themes, and your own economy."),

        ("How do I use Valour?",
         "Use Valour in any browser at app.valour.gg, or download the Windows and Android apps from our GitHub releases. Your account works everywhere."),

        ("Is Valour free?",
         "Yes. Valour is free to use. Optional Stargazer subscriptions add perks like larger upload limits and profile flair, and help fund the platform."),

        ("Do I need to show ID or a phone number?",
         "No. Valour only requires an email address to register. We do not ask for government ID, face scans, or phone verification."),

        ("What does open source mean for Valour?",
         "The complete source code for both the client and server is public under the AGPL license. Anyone can audit how Valour works, contribute improvements, or run their own instance."),

        ("Can I host Valour myself?",
         "Yes. A single docker compose command runs a full instance with automatic HTTPS. Communities on official infrastructure can also migrate to independently operated community nodes through federation."),

        ("Is Valour a Discord knock-off?",
         "No. Valour is built on a different stack around a broader idea. Multi-window chat, thread feeds, public community wikis, end-to-end encryption, and built-in economies sit alongside channels and voice, so a community has a home rather than a single room."),

        ("Can I bring my existing community?",
         "Yes. Valour has a built-in Discord importer, incoming webhooks, an open API, and bot support, so moving and integrating an existing community is straightforward."),

        ("Are my messages encrypted?",
         "Yes. Every chat message on Valour is end-to-end encrypted, including direct messages, group chats, and planet channels. Text is encrypted on your device, and the server stores and relays ciphertext it cannot read. Threads and wiki pages are public publishing features, so they are not encrypted and can appear on the web."),

        ("How do you protect my privacy?",
         "We don't sell your data, we don't run ads, and we only use vetted partners where necessary, such as for email delivery. Valour is funded by optional subscriptions, not by your data."),
    };

    var faqJsonLd = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "FAQPage",
        ["mainEntity"] = faqs.Select(f => new Dictionary<string, object?>
        {
            ["@type"] = "Question",
            ["name"] = f.Question,
            ["acceptedAnswer"] = new Dictionary<string, object?>
            {
                ["@type"] = "Answer",
                ["text"] = f.Answer,
            },
        }).ToList(),
    });
}

<script type="application/ld+json">@Html.Raw(faqJsonLd)</script>

<div class="container doc-page">
    <article class="prose doc-single">
        <h1>Frequently asked questions</h1>
        <p class="doc-lede">What Valour is, how it handles your data, and how to get started.</p>

        <div class="faq-list">
            @foreach (var faq in faqs)
            {
                <section class="faq-item">
                    <h2>@faq.Question</h2>
                    <p>@faq.Answer</p>
                </section>
            }
        </div>

        <div class="doc-closing">
            <img src="/media/victor/victor-sleeping.svg" alt="" width="120" height="120" loading="lazy" draggable="false" />
            <p>
                Didn't find your answer? Email <a href="mailto:support@valour.gg">support@valour.gg</a>
                or <a href="https://github.com/Valour-Software/Valour/issues">open an issue on GitHub</a>.
            </p>
        </div>
    </article>
</div>
