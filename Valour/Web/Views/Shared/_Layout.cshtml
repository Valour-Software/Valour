@{
    var headerOverlay = ViewData["HeaderOverlay"] is true;
    var path = Context.Request.Path.Value ?? "/";
    var inPolicies = LegalDocumentLibrary.All.Any(document => document.Path == path) || path == "/delete-account/";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="robots" content="@(ViewData["Robots"] as string ?? "index, follow")">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link rel="icon" href="/favicon.ico"/>

    @{
        /* Canonical: trailing-slash form matches the static-export redirects */
        var canonicalPath = Context.Request.Path.Value ?? "/";
        if (canonicalPath != "/" && !canonicalPath.EndsWith('/'))
            canonicalPath += "/";
        var canonicalUrl = $"https://valour.gg{(canonicalPath == "/" ? "" : canonicalPath)}";

        /* Title */
        ViewData.TryGetValue("Title", out var title);
        title ??= "Valour: Built for Communities";
        <title>@title</title>
        <meta property="og:title" content="@title">
        <meta name="twitter:title" content="@title">

        /* Description */
        ViewData.TryGetValue("Description", out var description);
        description ??= "Valour is an open-source community platform with end-to-end encrypted chat, threads, wikis and voice.";
        <meta name="description" content="@description">
        <meta property="og:description" content="@description">
        <meta name="twitter:description" content="@description">

        /* Keywords */
        ViewData.TryGetValue("Keywords", out var keywords);
        keywords ??= "Discord alternative, community chat, end-to-end encrypted chat, open source chat, voice chat, community platform, privacy";
        <meta name="keywords" content="@keywords">

        /* Card Type */
        ViewData.TryGetValue("CardType", out var cardType);
        cardType ??= "summary_large_image";
        <meta name="twitter:card" content="@cardType"/>

        /* Image */
        ViewData.TryGetValue("Image", out var image);
        image ??= "https://valour.gg/media/twitter-card.png";
        <meta property="og:image" content="@image">
        <meta name="twitter:image" content="@image">

        /* Image Alt */
        ViewData.TryGetValue("ImageAlt", out var imageAlt);
        imageAlt ??= "The Valour logo";
        <meta property="og:image:alt" content="@imageAlt">
        <meta name="twitter:image:alt" content="@imageAlt">

        /* Open Graph Type */
        ViewData.TryGetValue("OpenGraphType", out var openGraphType);
        openGraphType ??= "website";
        <meta property="og:type" content="@openGraphType">

        <meta property="og:url" content="@canonicalUrl">
        <link rel="canonical" href="@canonicalUrl">
    }

    <meta property="og:site_name" content="Valour">
    <meta property="og:locale" content="en_US">
    <meta name="twitter:site" content="@@valourapp">

    @{
        // Emitted via Html.Raw: Razor entity-encodes the + in "ld+json" when
        // the element is treated as dynamic, which breaks structured-data
        // parsing. WebSite is what Google's site-name feature reads.
        var structuredData = """
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@graph": [
                {
                    "@type": "Organization",
                    "name": "Valour",
                    "url": "https://valour.gg",
                    "logo": "https://valour.gg/media/logo/logo-256.png",
                    "sameAs": [
                        "https://github.com/Valour-Software/Valour",
                        "https://x.com/valourapp"
                    ]
                },
                {
                    "@type": "WebSite",
                    "name": "Valour",
                    "alternateName": ["valour.gg", "Valour Chat"],
                    "url": "https://valour.gg"
                }
            ]
        }
        </script>
        """;
    }
    @Html.Raw(structuredData)
    <meta name="msapplication-TileColor" content="#0a0d12">
    <meta name="theme-color" content="#0a0d12">
    <link rel="preload" href="/css/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/bootstrap-icons.css"/>
    <link rel="stylesheet" href="/css/site.css"/>
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header @(headerOverlay ? "overlay" : null)">
        <div class="container header-inner">
            <a class="brand" href="/" aria-label="Valour home">
                <partial name="_VictorMark" />
                <span>Valour</span>
            </a>

            <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Menu" data-menu-toggle>
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>

            <nav class="site-nav" id="site-nav" aria-label="Main">
                <a href="/#features">Features</a>
                <a href="/#download">Download</a>
                <a href="/discord-alternative/" aria-current="@(path == "/discord-alternative/" ? "page" : null)">Switch from Discord</a>
                <a href="/faq/" aria-current="@(path == "/faq/" ? "page" : null)">FAQ</a>
                <a href="/privacy/" aria-current="@(inPolicies ? "page" : null)">Policies</a>
                <a href="https://github.com/Valour-Software/Valour">Source</a>
                <a class="btn btn-primary btn-sm" href="https://app.valour.gg">Open Valour</a>
            </nav>
        </div>
    </header>

    <main id="main" class="@(ViewData.TryGetValue("main-class", out var mainClass) ? mainClass : "main-content")">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <img class="footer-victor" src="/media/victor/victor-peeking.svg" alt="" width="120" height="120" loading="lazy" draggable="false" />
        <div class="container">
            <div class="footer-grid">
                <div class="footer-about">
                    <a class="brand" href="/" aria-label="Valour home">
                        <partial name="_VictorMark" />
                        <span>Valour</span>
                    </a>
                    <p>Open-source community chat with end-to-end encryption and no ID checks. Made by Valour Software LLC and its contributors.</p>
                </div>
                <nav class="footer-column" aria-label="Valour">
                    <h2>Valour</h2>
                    <a href="https://app.valour.gg">Open Valour</a>
                    <a href="/#download">Download</a>
                    <a href="/discord-alternative/">Switch from Discord</a>
                    <a href="/faq/">FAQ</a>
                    <a href="/texas/">Why we don't check IDs</a>
                    <a href="https://app.valour.gg/swagger/index.html">API reference</a>
                    <a href="https://github.com/Valour-Software/Valour">Source code</a>
                </nav>
                <nav class="footer-column" aria-label="Policies">
                    <h2>Policies</h2>
                    <a href="/privacy/">Privacy Policy</a>
                    <a href="/terms/">Terms of Service</a>
                    <a href="/rules/">Platform Rules</a>
                    <a href="/rules/economy/">Economy Rules</a>
                    <a href="/delete-account/">Delete your account</a>
                </nav>
                <nav class="footer-column" aria-label="Contact">
                    <h2>Contact</h2>
                    <a href="mailto:support@valour.gg">support@valour.gg</a>
                    <a href="https://discord.gg/qTMyJa4trF">Discord</a>
                    <a href="https://x.com/valourapp">X</a>
                    <a href="https://github.com/Valour-Software/Valour/issues">Report an issue</a>
                </nav>
            </div>
            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year Valour Software LLC</span>
                <span>AGPL-3.0</span>
            </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>
    <script src="/js/download.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
