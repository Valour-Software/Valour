#!/bin/sh
set -eu

python3 Tools/Villages/restore-release-assets.py

# Install the .NET 11 preview SDK pinned by global.json
curl -sSL https://dot.net/v1/dotnet-install.sh > dotnet-install.sh
chmod +x dotnet-install.sh
./dotnet-install.sh --version 11.0.100-rc.1.26425.128 -InstallDir ./dotnet
export PATH="$PWD/dotnet:$PATH"
dotnet --version

# Build Valour Client.Blazor for Cloudflare Pages
dotnet workload restore Valour/Client.Blazor/Valour.Client.Blazor.csproj
dotnet workload install wasm-tools

# Resolve a short commit hash for source + asset version placeholders.
SHORT_HASH="${CF_PAGES_COMMIT_SHA:-}"
if [ -z "$SHORT_HASH" ]; then
  SHORT_HASH="$(git rev-parse --short=8 HEAD 2>/dev/null || true)"
fi
if [ -z "$SHORT_HASH" ]; then
  SHORT_HASH="dev"
fi
SHORT_HASH="$(printf '%s' "$SHORT_HASH" | cut -c1-8)"
echo "Using SHORTHASH=${SHORT_HASH}"
export VALOUR_SHORT_HASH="$SHORT_HASH"

# Replace SHORTHASH placeholders in source before publish so:
# - compiled constants (e.g. Valour.Shared.Version.ShortHash) are correct
# - published static assets keep valid Blazor service-worker SRI hashes
SHORTHASH_FILE_LIST="$(mktemp)"
SHORTHASH_BACKUP_DIR="$(mktemp -d)"
trap '
  if [ -f "$SHORTHASH_FILE_LIST" ]; then
    while IFS= read -r file; do
      if [ -f "$SHORTHASH_BACKUP_DIR/$file" ]; then
        cp "$SHORTHASH_BACKUP_DIR/$file" "$file"
      fi
    done < "$SHORTHASH_FILE_LIST"
  fi
  rm -rf "$SHORTHASH_BACKUP_DIR"
  rm -f "$SHORTHASH_FILE_LIST"
' EXIT

grep -RIl '\$(SHORTHASH)' Valour > "$SHORTHASH_FILE_LIST" || true
while IFS= read -r file; do
  [ -n "$file" ] || continue
  mkdir -p "$SHORTHASH_BACKUP_DIR/$(dirname "$file")"
  cp "$file" "$SHORTHASH_BACKUP_DIR/$file"
  perl -pi -e 's/\$\(SHORTHASH\)/$ENV{VALOUR_SHORT_HASH}/g' "$file"
done < "$SHORTHASH_FILE_LIST"

# Cloudflare Pages expects the configured output directory to contain index.html at its root.
# dotnet publish for Blazor WASM places the site in <publish>/wwwroot, so flatten it into ./output.
PUBLISH_DIR=cf-publish
OUTPUT_DIR=output

rm -rf "$PUBLISH_DIR" "$OUTPUT_DIR"

# Cloudflare Pages can kill MSBuild child nodes during the WASM pipeline on larger apps.
# Keep publish single-process for stability. AOT can be toggled separately if needed.
PAGES_WASM_AOT="${VALOUR_PAGES_WASM_AOT-false}"
PUBLISH_PROPS="-m:1"
if [ "$PAGES_WASM_AOT" = "true" ]; then
  PUBLISH_PROPS="$PUBLISH_PROPS -p:RunAOTCompilation=true"
else
  PUBLISH_PROPS="$PUBLISH_PROPS -p:RunAOTCompilation=false"
fi
echo "Using VALOUR_PAGES_WASM_AOT=${PAGES_WASM_AOT}"
dotnet publish Valour/Client.Blazor/Valour.Client.Blazor.csproj -c Release -o "$PUBLISH_DIR" $PUBLISH_PROPS
mkdir -p "$OUTPUT_DIR"

# Blazor publish output layout can vary by SDK/version. Prefer <publish>/wwwroot,
# but fall back to the publish root when that is the web root.
PUBLISH_WEBROOT=""
if [ -d "$PUBLISH_DIR/wwwroot" ] && [ -e "$PUBLISH_DIR/wwwroot/_framework/blazor.webassembly.js" ]; then
  PUBLISH_WEBROOT="$PUBLISH_DIR/wwwroot"
elif [ -e "$PUBLISH_DIR/_framework/blazor.webassembly.js" ]; then
  PUBLISH_WEBROOT="$PUBLISH_DIR"
else
  echo "Could not locate Blazor publish web root in $PUBLISH_DIR"
  find "$PUBLISH_DIR" -maxdepth 3 -type f | sed -n '1,120p'
  exit 1
fi

cp -R "$PUBLISH_WEBROOT"/. "$OUTPUT_DIR"/

# Ensure referenced RCL static assets exist at the expected path.
# This is safe now because SHORTHASH replacement happens before publish, so copied bytes
# match the published service-worker SRI expectations.
mkdir -p "$OUTPUT_DIR"/_content/Valour.Client
cp -R Valour/Client/wwwroot/. "$OUTPUT_DIR"/_content/Valour.Client/

# Explicit runtime API origin for static Pages deployments.
# Set VALOUR_API_ORIGIN to override, or set it to an empty string for same-origin.
API_ORIGIN="${VALOUR_API_ORIGIN-https://api.valour.gg/}"
echo "Using VALOUR_API_ORIGIN=${API_ORIGIN}"

# Origin serving the static public thread pages.
# Set VALOUR_THREADS_ORIGIN to override, or empty string for the built-in default.
THREADS_ORIGIN="${VALOUR_THREADS_ORIGIN-https://threads.valour.gg}"
echo "Using VALOUR_THREADS_ORIGIN=${THREADS_ORIGIN}"

# The Blazor host page currently lives in the shared Valour.Client project, not Client.Blazor/wwwroot.
# Ensure Cloudflare Pages has a root index.html to serve.
cp Valour/Client/wwwroot/index.html "$OUTPUT_DIR"/index.html

# Override runtime config at the site root (not under _content) so it is not covered by the
# Blazor service-worker SRI manifest generated during publish.
printf 'window.valourRuntimeConfig = window.valourRuntimeConfig || {};\nwindow.valourRuntimeConfig.apiOrigin = "%s";\nwindow.valourRuntimeConfig.threadsOrigin = "%s";\n' "$API_ORIGIN" "$THREADS_ORIGIN" > "$OUTPUT_DIR"/valour-runtime-config.override.js
perl -0pi -e 's#(<script src="_content/Valour\.Client/js/valour-runtime-config\.js[^"]*"></script>)#$1\n<script src="valour-runtime-config.override.js?version=$ENV{VALOUR_SHORT_HASH}"></script>#' "$OUTPUT_DIR"/index.html

# Fail the build if the output is incomplete; otherwise Pages will serve index.html
# via the SPA fallback and browsers will report MIME type errors for missing assets.
for required in \
  index.html \
  _framework/blazor.webassembly.js \
  manifest.json \
  service-worker.js \
  lib/localforage-1.10.0.min.js \
  _content/Valour.Client/js/main.js \
  _content/Valour.Client/css/bundled.min.css
do
  if [ ! -e "$OUTPUT_DIR/$required" ]; then
    echo "Missing required output file: $OUTPUT_DIR/$required"
    exit 1
  fi
done

# SPA fallback for client-side routing (prevents refresh/deep-link 404s on Pages).
printf '/* /index.html 200\n' > "$OUTPUT_DIR/_redirects"

# Content-Security-Policy for the app. This mirrors SecurityHeaders.BuildAppPolicy
# in Valour/Server/Utilities/SecurityHeaders.cs (used when the server hosts the
# app); keep the two in sync. Scripts may not use inline event handler attributes,
# javascript: URLs, or eval; index.html's inline scripts are allowed by hash only.
# Hashes are computed from the output file so edits to those scripts need no manual
# update. Browsers hash script text after normalizing CRLF to LF, as Python's text
# mode does.
INLINE_SCRIPT_HASHES="$(python3 - "$OUTPUT_DIR/index.html" <<'PY'
import base64, hashlib, re, sys
html = open(sys.argv[1], encoding="utf-8-sig", newline=None).read()
hashes = []
for attrs, body in re.findall(r"<script([^>]*)>(.*?)</script>", html, re.S | re.I):
    if "src=" in attrs.lower():
        continue
    digest = hashlib.sha256(body.encode("utf-8")).digest()
    hashes.append("'sha256-%s'" % base64.b64encode(digest).decode())
print(" ".join(hashes))
PY
)"
THIRD_PARTY_SCRIPT_SOURCES="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.2.0/ https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/ https://cdn.jsdelivr.net/npm/@simonwep/pickr/ https://cdn.jsdelivr.net/npm/emoji-mart@5.6.0/ https://unpkg.com/@lottiefiles/lottie-player@2.0.12/ https://s3.tradingview.com https://platform.twitter.com https://cdn.syndication.twimg.com https://embed.reddit.com https://www.tiktok.com https://*.tiktokcdn.com https://*.tiktokcdn-us.com https://*.ttwstatic.com https://gist.github.com"
EMBED_FRAME_SOURCES="https://www.youtube.com https://youtube.com https://music.youtube.com https://player.vimeo.com https://vimeo.com https://player.twitch.tv https://clips.twitch.tv https://www.tiktok.com https://platform.twitter.com https://syndication.twitter.com https://twitter.com https://www.instagram.com https://embed.bsky.app https://open.spotify.com https://w.soundcloud.com https://embed.reddit.com https://s.tradingview.com https://www.tradingview-widget.com"
APP_CSP="default-src 'self'; script-src 'self' 'wasm-unsafe-eval' ${INLINE_SCRIPT_HASHES} ${THIRD_PARTY_SCRIPT_SOURCES}; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://github.githubassets.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-src ${EMBED_FRAME_SOURCES}; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

cat > "$OUTPUT_DIR/_headers" <<EOF
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: ${APP_CSP}

EOF

# Prevent stale host page/runtime config when switching deploy env vars.
cat >> "$OUTPUT_DIR/_headers" <<'EOF'
/index.html
  Cache-Control: no-store

/_content/Valour.Client/js/valour-runtime-config.js
  Cache-Control: no-store

/valour-runtime-config.override.js
  Cache-Control: no-store

/service-worker.js
  Cache-Control: no-cache

/service-worker-assets.js
  Cache-Control: no-cache

# Imported by the service worker; revalidated so worker updates see changes.
/lib/*
  Cache-Control: no-cache

# Framework resources below have content hashes in their filenames, so they get a
# long max-age: a content change produces a different request URL.
#
# Deliberately NOT `immutable`. Pages cannot 404 a missing fingerprint -- the SPA
# fallback in _redirects rewrites it to index.html with a 200, and _headers match
# on request path, so that HTML body is stored under a .wasm URL with these very
# headers. A request that races a deploy (an open tab, or the service worker
# precaching an asset set that just went stale) can therefore poison the browser
# cache. Without `immutable` a normal reload revalidates and repairs the entry;
# with it, nothing short of a hard refresh could. See the boot recovery handler
# in Valour/Client/wwwroot/index.html, which repairs it without any refresh.
/_framework/*.wasm
  Cache-Control: public, max-age=31536000

/_framework/*.dat
  Cache-Control: public, max-age=31536000

/_framework/*.pdb
  Cache-Control: public, max-age=31536000

/_framework/dotnet.native.*.js
  Cache-Control: public, max-age=31536000

/_framework/dotnet.runtime.*.js
  Cache-Control: public, max-age=31536000
EOF
